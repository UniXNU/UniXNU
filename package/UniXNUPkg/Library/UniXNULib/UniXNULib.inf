[Protocols]
  gEfiAcpiTableProtocolGuid         ## SOMETIMES_CONSUMES
  gEfiBlockIoProtocolGuid           ## SOMETIMES_CONSUMES ## SOMETIMES_PRODUCES
  gEfiPartitionInfoProtocolGuid     ## SOMETIMES_CONSUMES
  gEfiDevicePathProtocolGuid        ## CONSUMES
  gEfiFirmwareVolume2ProtocolGuid   ## SOMETIMES_CONSUMES
  gEfiGraphicsOutputProtocolGuid    ## SOMETIMES_CONSUMES
  gEfiLoadedImageProtocolGuid       ## CONSUMES
  gEfiLoadFile2ProtocolGuid         ## SOMETIMES_PRODUCES
  gEfiSerialIoProtocolGuid          ## SOMETIMES_CONSUMES
  gEfiSimpleFileSystemProtocolGuid  ## SOMETIMES_CONSUMES
  gEfiSimpleTextInProtocolGuid      ## SOMETIMES_CONSUMES
  gUniXNULoaderProtocolGuid   ## SOMETIMES_CONSUMES
  gUniXNUMenuPluginProtocolGuid ## SOMETIMES_CONSUMES

[Pcd]
