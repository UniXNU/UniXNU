 /*
+ * The lazy form, boot argument cs-lazy=1 (fixed at boot, so a blob is of one form for its life). Adding a signature
+ * reads nothing. An original 16 KiB block is authenticated when one of its 4 KiB pages is first validated: its pages are
+ * paged in one after the other and copied into a private buffer, the buffer is hashed and compared with the block's
+ * slot of the code directory, and only on a match the hashes of its 4 KiB parts, made from that same buffer, are
+ * recorded and the block becomes ready. A page is then validated against its recorded hash, as in the eager form, so
+ * no byte is accepted that the signed 16 KiB hash does not cover: any buffer that matches the signed hash holds the
+ * signed bytes, whatever the file did meanwhile and however many threads authenticate the block at once. A block whose
+ * buffer does not match becomes bad, and its pages are answered tainted, unless another thread's buffer made it ready.
+ * A block that is neither is answered "not validated, not tainted", the answer for a page without a hash: nothing
+ * accepts the page, no page is marked, and the VM, which asks cs_native4k_lazy_pending before each validation,
+ * authenticates and comes back.
+ *
+ * The states and the derived hashes live in chunks of 127 blocks (four pages for 1.98 MiB of the file), allocated when
+ * a block of theirs is first authenticated and found through a table of chunk pointers. Table and chunks are mapped
+ * read-only before they can be reached, as the eager table is, and are written through the physical aperture, the way
+ * the read-only zone allocator writes its elements on a kernel without a monitor (pmap_ro_zone_memcpy). The pointer to
+ * the table is a field of the blob, which is in that read-only zone.
+ *
+ * Instead of the eager form's refusal of a whole image at load: the structural checks are the same, an image shorter
+ * than its code limit is refused, and a block that does not match its signed hash is found when it is first used and
+ * taints its pages, which is what a kernel with native 16 KiB pages does page by page.
+ */
+#define CS_LAZY_BLOCK           16384
+#define CS_LAZY_SLOT            32      /* bytes kept per derived hash; a larger hash keeps the blob eager */
+#define CS_LAZY_CHUNK_BLOCKS    127
+#define CS_LAZY_CHUNK_SIZE      16384
+#define CS_LAZY_UNKNOWN         0
+#define CS_LAZY_READY           1
+#define CS_LAZY_BAD             2
+/* The answer of cs_validate_hash for a block that is not authenticated, kept inside this file. */
+#define CS_VALIDATE_UNREADY     0x80000000
+
+struct cs_native4k_lazy_chunk {
+	_Atomic uint8_t state[CS_LAZY_CHUNK_BLOCKS + 1];
+	uint8_t         hash[CS_LAZY_CHUNK_BLOCKS][CS_LAZY_BLOCK / 4096][CS_LAZY_SLOT];
+};
+_Static_assert(sizeof(struct cs_native4k_lazy_chunk) == CS_LAZY_CHUNK_SIZE, "a chunk is four pages");
+
+struct cs_native4k_lazy {
+	vm_size_t       allocation;     /* bytes of this table */
+	uint32_t        blocks;         /* original blocks up to the code limit */
+	uint32_t        chunks;
+	struct cs_native4k_lazy_chunk *_Atomic chunk[];
+};
+
+TUNABLE(uint32_t, cs_native4k_lazy, "cs-lazy", 0);
+unsigned long cs_native4k_lazy_blobs = 0;       /* blobs added in the lazy form */
+unsigned long cs_native4k_lazy_blocks = 0;      /* blocks authenticated, ready */
+unsigned long cs_native4k_lazy_bad = 0;         /* blocks that did not match their signed hash */
+unsigned long cs_native4k_lazy_errors = 0;      /* authentications that could not read or allocate */
+unsigned long cs_native4k_lazy_unready = 0;     /* validations answered "not authenticated" */
+uint64_t cs_native4k_lazy_ticks = 0;            /* inside the authentications */
+unsigned long cs_native4k_lazy_counts[CS_LAZY_COUNTERS];
+/* Held only to record an answer, never across a read. */
+static LCK_MTX_DECLARE(cs_native4k_lazy_lock, &cs_native4k_lck_grp);
+
+void
+cs_native4k_lazy_count(unsigned int counter)
+{
+	if (counter < CS_LAZY_COUNTERS) {
+		os_atomic_inc(&cs_native4k_lazy_counts[counter], relaxed);
+	}
+}
+
+static void
+cs_native4k_lazy_wired(unsigned long bytes)
+{
+	const unsigned long table_bytes = os_atomic_add(&cs_native4k_table_bytes, bytes, relaxed);
+	if (table_bytes > os_atomic_load(&cs_native4k_table_bytes_peak, relaxed)) {
+		os_atomic_store(&cs_native4k_table_bytes_peak, table_bytes, relaxed);
+	}
+}
+
+/* Through the writable address of each page (vm_fault_cs_lazy_alias: the physical aperture). */
+static void
+cs_native4k_lazy_write(const void *address, const void *data, size_t length)
+{
+	const uint8_t *to = address, *from = data;
+
+	while (length != 0) {
+		const size_t part = MIN(length, (size_t)PAGE_SIZE - ((uintptr_t)to & PAGE_MASK));
+		memcpy(vm_fault_cs_lazy_alias(to), from, part);
+		to += part;
+		from += part;
+		length -= part;
+	}
+}
+
+static int
+cs_native4k_lazy_prepare(vnode_t vp, struct cs_blob *blob)
+{
+	const CS_CodeDirectory *cd = blob->csb_cd;
+	const struct cs_hash *md = blob->csb_hashtype;
+	vm_offset_t storage = 0;
+	vm_size_t allocation;
+	uint64_t limit;
+	off_t end, size = 0;
+	int error;
+
+	/* What cs_native4k_prepare requires of a signature. */
+	if (PAGE_SHIFT != 12 || blob->csb_hash_pageshift != 14 || cd == NULL || md == NULL ||
+	    md->cs_size == 0 || md->cs_size > CS_HASH_MAX_SIZE ||
+	    md->cs_digest_size > CS_HASH_MAX_SIZE || blob->csb_base_offset < 0 ||
+	    (blob->csb_base_offset & PAGE_MASK) || blob->csb_hash_firstlevel_pageshift ||
+	    ((ntohl(cd->version) >= CS_SUPPORTSSCATTER) && ntohl(cd->scatterOffset))) {
+		return ENOTSUP;
+	}
+	limit = ntohl(cd->codeLimit);
+	if (!limit || ((ntohl(cd->version) >= CS_SUPPORTSCODELIMIT64) &&
+	    ntohll(cd->codeLimit64) && ntohll(cd->codeLimit64) != limit) ||
+	    ntohl(cd->nCodeSlots) != ((limit + 16383) >> 14)) {
+		return ENOTSUP;
+	}
+	if (md->cs_size > CS_LAZY_SLOT) {
+		/* No slot holds this hash: the caller makes the eager table. */
+		return 0;
+	}
+	/* The eager read fails on an image that ends before its code limit. */
+	error = vnode_size(vp, &size, vfs_context_current());
+	if (error != 0) {
+		return error;
+	}
+	if (os_add_overflow(blob->csb_base_offset, (off_t)limit, &end) || end > size) {
+		return EIO;
+	}
+
+	const uint32_t blocks = (uint32_t)((limit + CS_LAZY_BLOCK - 1) / CS_LAZY_BLOCK);
+	const uint32_t chunks = (blocks + CS_LAZY_CHUNK_BLOCKS - 1) / CS_LAZY_CHUNK_BLOCKS;
+	allocation = round_page(sizeof(struct cs_native4k_lazy) + (vm_size_t)chunks * sizeof(struct cs_native4k_lazy_chunk *));
+	if (kmem_alloc(kernel_map, &storage, allocation, KMA_KOBJECT | KMA_ZERO, VM_KERN_MEMORY_SECURITY) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	struct cs_native4k_lazy *lazy = (struct cs_native4k_lazy *)storage;
+	lazy->allocation = allocation;
+	lazy->blocks = blocks;
+	lazy->chunks = chunks;
+	if (mach_vm_protect(kernel_map, storage, allocation, FALSE, VM_PROT_READ) != KERN_SUCCESS) {
+		kmem_free(kernel_map, storage, allocation);
+		return EPERM;
+	}
+	cs_native4k_lazy_wired((unsigned long)allocation);
+	blob->csb_native4k_lazy = lazy;
+	blob->csb_native4k_hash_count = (vm_size_t)((limit + PAGE_MASK) >> PAGE_SHIFT);
+	os_atomic_inc(&cs_native4k_lazy_blobs, relaxed);
+	return 0;
+}
+
+/* The blob is being freed and nothing can validate against it any more. */
+static void
+cs_native4k_lazy_free(struct cs_blob *blob)
+{
+	struct cs_native4k_lazy *lazy = blob->csb_native4k_lazy;
+	unsigned long bytes = (unsigned long)lazy->allocation;
+
+	for (uint32_t i = 0; i < lazy->chunks; i++) {
+		struct cs_native4k_lazy_chunk *chunk = os_atomic_load(&lazy->chunk[i], relaxed);
+		if (chunk != NULL) {
+			kmem_free(kernel_map, (vm_offset_t)chunk, CS_LAZY_CHUNK_SIZE);
+			bytes += CS_LAZY_CHUNK_SIZE;
+		}
+	}
+	kmem_free(kernel_map, (vm_offset_t)lazy, lazy->allocation);
+	os_atomic_sub(&cs_native4k_table_bytes, bytes, relaxed);
+	os_atomic_inc(&cs_native4k_released_blobs, relaxed);
+	if (blob->csb_native4k_touched != NULL) {
+		kfree_data(blob->csb_native4k_touched,
+		    cs_native4k_touched_words(blob->csb_native4k_hash_count) * sizeof(uint32_t));
+		blob->csb_native4k_touched = NULL;
+	}
+	blob->csb_native4k_lazy = NULL;
+	blob->csb_native4k_hash_count = 0;
+}
+
+/* The chunk of a block; with create, a new one is put in the table when there is none (NULL when there is no memory). */
+static struct cs_native4k_lazy_chunk *
+cs_native4k_lazy_chunk(const struct cs_native4k_lazy *lazy, uint32_t block, bool create)
+{
+	const uint32_t index = block / CS_LAZY_CHUNK_BLOCKS;
+	struct cs_native4k_lazy_chunk *chunk = os_atomic_load(&lazy->chunk[index], acquire);
+	vm_offset_t storage = 0;
+
+	if (chunk != NULL || !create) {
+		return chunk;
+	}
+	if (kmem_alloc(kernel_map, &storage, CS_LAZY_CHUNK_SIZE, KMA_KOBJECT | KMA_DATA | KMA_ZERO,
+	    VM_KERN_MEMORY_SECURITY) != KERN_SUCCESS) {
+		return NULL;
+	}
+	if (mach_vm_protect(kernel_map, storage, CS_LAZY_CHUNK_SIZE, FALSE, VM_PROT_READ) != KERN_SUCCESS) {
+		kmem_free(kernel_map, storage, CS_LAZY_CHUNK_SIZE);
+		return NULL;
+	}
+	struct cs_native4k_lazy_chunk *_Atomic *slot = vm_fault_cs_lazy_alias(&lazy->chunk[index]);
+	if (os_atomic_cmpxchgv(slot, NULL, (struct cs_native4k_lazy_chunk *)storage, &chunk, release)) {
+		cs_native4k_lazy_wired(CS_LAZY_CHUNK_SIZE);
+		return (struct cs_native4k_lazy_chunk *)storage;
+	}
+	/* Another thread's chunk is in the table. */
+	kmem_free(kernel_map, storage, CS_LAZY_CHUNK_SIZE);
+	return chunk;
+}
+
+static uint8_t
+cs_native4k_lazy_state(const struct cs_native4k_lazy *lazy, uint32_t block)
+{
+	const struct cs_native4k_lazy_chunk *chunk = cs_native4k_lazy_chunk(lazy, block, false);
+
+	return chunk == NULL ? CS_LAZY_UNKNOWN : os_atomic_load(&chunk->state[block % CS_LAZY_CHUNK_BLOCKS], acquire);
+}
+
+/*
+ * Records the answer for a block: ready with its derived hashes, or bad. Ready is final and its hashes are written once,
+ * before the state; bad gives way to ready (another thread's buffer matched) and never replaces it.
+ */
+static void
+cs_native4k_lazy_record(struct cs_native4k_lazy_chunk *chunk, uint32_t block, const void *derived)
+{
+	const uint32_t at = block % CS_LAZY_CHUNK_BLOCKS;
+	_Atomic uint8_t *state = vm_fault_cs_lazy_alias(&chunk->state[at]);
+
+	lck_mtx_lock(&cs_native4k_lazy_lock);
+	const uint8_t now = os_atomic_load(state, relaxed);
+	if (now != CS_LAZY_READY && derived != NULL) {
+		cs_native4k_lazy_write(chunk->hash[at], derived, sizeof(chunk->hash[at]));
+		os_atomic_store(state, CS_LAZY_READY, release);
+		os_atomic_inc(&cs_native4k_lazy_blocks, relaxed);
+		os_atomic_inc(&cs_native4k_full_blocks, relaxed);
+	} else if (now == CS_LAZY_UNKNOWN) {
+		os_atomic_store(state, CS_LAZY_BAD, release);
+		os_atomic_inc(&cs_native4k_lazy_bad, relaxed);
+		os_atomic_inc(&cs_validate_page_bad_hash, relaxed);
+	}
+	lck_mtx_unlock(&cs_native4k_lazy_lock);
+}
+
+/*
+ * The blob that validates this page of the file, when it is a lazy one and the page has a derived hash; the choice of
+ * the blob is that of cs_validate_hash.
+ */
+static const struct cs_blob *
+cs_native4k_lazy_find(struct vnode *vp, memory_object_offset_t page_offset, uint32_t *block)
+{
+	if (!cs_native4k_lazy || vp == NULL) {
+		return NULL;
+	}
+	for (const struct cs_blob *blob = ubc_get_cs_blobs(vp); blob != NULL; blob = blob->csb_next) {
+		const off_t offset = (off_t)page_offset - blob->csb_base_offset;
+		if (offset < blob->csb_start_offset || offset >= blob->csb_end_offset ||
+		    blob->csb_mem_kaddr == NULL || blob->csb_cd == NULL) {
+			continue;
+		}
+		const struct cs_native4k_lazy *lazy = blob->csb_native4k_lazy;
+		if (lazy == NULL || blob->csb_hash_pageshift != 14 || (offset & PAGE_MASK) ||
+		    offset >= (off_t)ntohl(blob->csb_cd->codeLimit) || (uint64_t)offset / CS_LAZY_BLOCK >= lazy->blocks) {
+			return NULL;
+		}
+		*block = (uint32_t)((uint64_t)offset / CS_LAZY_BLOCK);
+		return blob;
+	}
+	return NULL;
+}
+
+boolean_t
+cs_native4k_lazy_pending(struct vnode *vp, memory_object_offset_t page_offset)
+{
+	uint32_t block = 0;
+	const struct cs_blob *blob = cs_native4k_lazy_find(vp, page_offset, &block);
+
+	return blob != NULL && cs_native4k_lazy_state(blob->csb_native4k_lazy, block) == CS_LAZY_UNKNOWN;
+}
+
+/* Authenticates one block that has no answer yet. */
+static kern_return_t
+cs_native4k_lazy_block(struct vnode *vp, const struct cs_blob *blob, uint32_t block)
+{
+	const struct cs_native4k_lazy *lazy = blob->csb_native4k_lazy;
+	const CS_CodeDirectory *cd = blob->csb_cd;
+	const struct cs_hash *md = blob->csb_hashtype;
+	const uint64_t start = (uint64_t)block * CS_LAZY_BLOCK;
+	const size_t length = (size_t)MIN((uint64_t)CS_LAZY_BLOCK, (uint64_t)ntohl(cd->codeLimit) - start);
+	const memory_object_offset_t position = (memory_object_offset_t)blob->csb_base_offset + start;
+	const memory_object_control_t control = ubc_getobject(vp, UBC_FLAGS_NONE);
+	const uint64_t read_start = mach_absolute_time();
+	uint8_t derived[CS_LAZY_BLOCK / 4096][CS_LAZY_SLOT];
+	uint8_t digest[CS_HASH_MAX_SIZE];
+	union cs_hash_union ctx;
+	kern_return_t kr = KERN_SUCCESS;
+	uint8_t *buffer;
+
+	if (control == MEMORY_OBJECT_CONTROL_NULL) {
+		return KERN_MEMORY_ERROR;
+	}
+	buffer = kalloc_data(CS_LAZY_BLOCK, Z_WAITOK);
+	if (buffer == NULL) {
+		return KERN_RESOURCE_SHORTAGE;
+	}
+	/* One page at a time: no page is held busy while the next one is paged in. */
+	for (size_t sub = 0; sub < length && kr == KERN_SUCCESS; sub += PAGE_SIZE) {
+		kr = vm_fault_cs_lazy_fetch(control, position + sub, position, position + CS_LAZY_BLOCK, buffer + sub);
+	}
+	const uint64_t hash_start = mach_absolute_time();
+	os_atomic_add(&cs_native4k_read_ticks, hash_start - read_start, relaxed);
+	if (kr == KERN_SUCCESS) {
+		const char *lower = blob->csb_mem_kaddr;
+		const uint8_t *expected = hashes(cd, block, md->cs_size, lower, lower + blob->csb_mem_size);
+		bool matches = false;
+
+		os_atomic_add(&cs_native4k_bytes, (uint64_t)length, relaxed);
+		if (expected != NULL) {
+			md->cs_init(&ctx);
+			md->cs_update(&ctx, buffer, length);
+			md->cs_final(digest, &ctx);
+			matches = bcmp(expected, digest, md->cs_size) == 0;
+		}
+		if (matches) {
+			bzero(derived, sizeof(derived));
+			for (size_t sub = 0; sub < length; sub += PAGE_SIZE) {
+				md->cs_init(&ctx);
+				md->cs_update(&ctx, buffer + sub, MIN((size_t)PAGE_SIZE, length - sub));
+				md->cs_final(digest, &ctx);
+				memcpy(derived[sub >> PAGE_SHIFT], digest, md->cs_size);
+			}
+		}
+		struct cs_native4k_lazy_chunk *chunk = cs_native4k_lazy_chunk(lazy, block, true);
+		if (chunk == NULL) {
