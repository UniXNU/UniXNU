+/*
+ * The digests alone. cs_native4k_hash_ticks is the wall time of a window that also holds, in the lazy form, the
+ * allocation and protection of a chunk, the lock that records an answer and any time the thread waited for a processor,
+ * summed over every thread in it at once. These count, per original block, only the cs_init/cs_update/cs_final calls of
+ * the block and of its 4 KiB parts: the wall ticks, the ticks the thread itself ran (recount), and the bytes they hashed,
+ * by the type of the core the block ended on ([0] efficiency cores, [1] the others). Bytes over CPU ticks is the rate of
+ * the digest implementation; wall over CPU is the waiting. In the lazy form chunk_ticks/chunks_made is the making of
+ * chunks and record_ticks the recording of answers, both inside the hash window. A measurement, never read to decide.
+ */
+uint64_t cs_native4k_digest_wall[2], cs_native4k_digest_cpu[2], cs_native4k_digest_bytes[2];
+uint64_t cs_native4k_chunk_ticks = 0, cs_native4k_record_ticks = 0;
+unsigned long cs_native4k_chunks_made = 0;
+
+struct cs_native4k_clock {
+	uint64_t        wall;
+	uint64_t        cpu;
+};
+
+/* recount reads the running thread's time with interrupts off. */
+static void
+cs_native4k_clock_start(struct cs_native4k_clock *clock)
+{
+	const boolean_t enabled = ml_set_interrupts_enabled(FALSE);
+	clock->wall = mach_absolute_time();
+	clock->cpu = recount_current_thread_time_mach();
+	ml_set_interrupts_enabled(enabled);
+}
+
+static void
+cs_native4k_clock_stop(const struct cs_native4k_clock *clock, uint64_t bytes)
+{
+	const boolean_t enabled = ml_set_interrupts_enabled(FALSE);
+	const uint64_t wall = mach_absolute_time() - clock->wall;
+	const uint64_t cpu = recount_current_thread_time_mach() - clock->cpu;
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	const unsigned int id = (unsigned int)cpu_number();
+	const unsigned int kind = (topology != NULL && topology->cpus != NULL && id < topology->num_cpus &&
+	    topology->cpus[id].cpu_id == id && topology->cpus[id].cluster_type == CLUSTER_TYPE_E) ? 0 : 1;
+	ml_set_interrupts_enabled(enabled);
+
+	os_atomic_add(&cs_native4k_digest_wall[kind], wall, relaxed);
+	os_atomic_add(&cs_native4k_digest_cpu[kind], cpu, relaxed);
+	os_atomic_add(&cs_native4k_digest_bytes[kind], bytes, relaxed);
+}
