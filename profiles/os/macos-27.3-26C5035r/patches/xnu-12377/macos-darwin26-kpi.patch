+/*
+ * macOS 27 nonce and policy calls. Each is a command to the code signing
+ * monitor; this kernel has none, so each fails as the macOS kernel does when
+ * the monitor call fails without a monitor error: 3 for a NULL argument (the
+ * policy loaders), 0xffff otherwise.
+ */
+#define IMAGE4_V2_INVALID 3
+#define IMAGE4_V2_MONITOR_FAILED 0xffff
+
+int image4_v2_set_nonce_digest(const void *domain, const void *digest, size_t length);
+int image4_v2_roll_nonce(const void *domain);
+int image4_v2_load_diavlo_root_ca(const void *a, size_t a_length, const void *b, size_t b_length);
+int image4_v2_load_local_policy(const void *policy, size_t length);
+
+int
+image4_v2_set_nonce_digest(__unused const void *domain, __unused const void *digest, __unused size_t length)
+{
+	return IMAGE4_V2_MONITOR_FAILED;
+}
+
+int
+image4_v2_roll_nonce(__unused const void *domain)
+{
+	return IMAGE4_V2_MONITOR_FAILED;
+}
+
+int
+image4_v2_load_diavlo_root_ca(const void *a, size_t a_length, const void *b, size_t b_length)
+{
+	if (a == NULL || a_length == 0 || b == NULL || b_length == 0) {
+		return IMAGE4_V2_INVALID;
+	}
+	return IMAGE4_V2_MONITOR_FAILED;
+}
+
+int
+image4_v2_load_local_policy(const void *policy, size_t length)
+{
+	if (policy == NULL || length == 0) {
+		return IMAGE4_V2_INVALID;
+	}
+	return IMAGE4_V2_MONITOR_FAILED;
+}
