The root is the read-only system volume to macOS. APFS reports vfs.generic.apfs.rosp from the root volume's volume
group, which the owner layout lacks (the root is the unchanged OS image; Data is the owner volume of another device).
With rosp 0, launchd's mount-phase-2 (mount -P 2) remounts / read-write instead of running apfs_boot_util 2, mount_apfs
fails with 66 and launchd stops the boot. On XNU_TARGET_OS_OSX, once the owner Data and its firmlinks are in place, a read
of vfs.generic.apfs.rosp returns 2, the value APFS gives a read-only system volume with its Data volume mounted.
--- a/bsd/kern/kern_newsysctl.c
+++ b/bsd/kern/kern_newsysctl.c
@@ -1730,8 +1730,37 @@
 /*
  * Traverse our tree, and find the right node, execute whatever it points
  * at, and return the resulting error code.
+ */
+
+#if XNU_TARGET_OS_OSX
+/*
+ * The read-only system volume state APFS reports in vfs.generic.apfs.rosp (2: the root is a read-only system volume
+ * and its Data volume is mounted). APFS derives it from the root volume's volume group, which the owner layout lacks:
+ * the root is the unchanged OS image and Data is the owner volume of another device, mounted by the kernel at
+ * /System/Volumes/Data with the firmlinks set (kern_exec.c, native_owner_macos_data_prepare). That code sets 2 here
+ * once Data and the firmlinks are in place; 0 leaves APFS's own answer.
  */
+volatile int native_owner_rosv_state = 0;
 
+SYSCTL_DECL(_vfs_generic);
+
+static bool
+native_owner_apfs_rosp(struct sysctl_oid *oid)
+{
+	if (native_owner_rosv_state == 0 || oid->oid_name == NULL || strcmp(oid->oid_name, "rosp") != 0) {
+		return false;
+	}
+	struct sysctl_oid *node;
+	for (struct sysctl_oid_iterator it = sysctl_oid_iterator_begin(&sysctl__vfs_generic_children);
+	    (node = sysctl_oid_iterator_next_system_order(&it));) {
+		if ((node->oid_kind & CTLTYPE) == CTLTYPE_NODE && node->oid_name != NULL && strcmp(node->oid_name, "apfs") == 0) {
+			return oid->oid_parent == (struct sysctl_oid_list *)node->oid_arg1;
+		}
+	}
+	return false;
+}
+#endif /* XNU_TARGET_OS_OSX */
+
 int
 sysctl_root(boolean_t from_kernel, boolean_t string_is_canonical,
     char *namestring, size_t namestringlen,
@@ -1905,7 +1934,15 @@
 	if (!oid_handler) {
 		error = EINVAL;
 		goto err;
+	}
+
+#if XNU_TARGET_OS_OSX
+	if (req->newptr == USER_ADDR_NULL && native_owner_apfs_rosp(oid)) {
+		int state = native_owner_rosv_state;
+		lck_rw_done(&sysctl_geometry_lock);
+		return SYSCTL_OUT(req, &state, sizeof(state));
 	}
+#endif /* XNU_TARGET_OS_OSX */
 
