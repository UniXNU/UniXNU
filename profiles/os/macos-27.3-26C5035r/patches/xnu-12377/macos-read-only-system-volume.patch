 	 * Reference the OID and drop the geometry lock; this prevents the
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -9426,6 +9426,11 @@
 	if (!error) native_owner_data_stage = 4;
 	if (!error) error = native_owner_data_firmlinks(vfs_context_current());
 	if (!error) native_owner_data_stage = 5;
+	if (!error) {
+		/* The root is the read-only system volume and its Data volume is mounted (kern_newsysctl.c). */
