diff --git a/pexpert/arm/pe_identify_machine.c b/pexpert/arm/pe_identify_machine.c
--- a/pexpert/arm/pe_identify_machine.c
+++ b/pexpert/arm/pe_identify_machine.c
@@ -31,6 +31,39 @@
  *
  * Sets up platform parameters. Returns:    nothing
  */
+/*
+ * The timebase userspace is built for, timebase-hz (macOS-DroidVM 0042) (24 MHz, every Apple arm64 SoC's), over an
+ * architected counter that runs at the host's rate (19.2 MHz on Qualcomm SoCs). iOS userspace assumes Apple's rate:
+ * libswift_Concurrency (swift_dispatchEnqueueWithDeadline) converts a ContinuousClock or SuspendingClock deadline to mach ticks as
+ * ns * 3 / 125, so on a 19.2 MHz counter every Task.sleep, debounce and timeout waited until 1.25 times the counter's value, a
+ * quarter of the host's uptime later (Settings' sidebar never took an update: its channel is debounced). The kernel scales every
+ * counter read by target/hardware (machine_routines.c), converts decrementer values back, and reports the target frequency here.
+ */
+extern uint32_t ml_timebase_scale_num, ml_timebase_scale_den;
+static void
+native_virtual_timebase(void)
+{
+	uint32_t target = 0;
+	const uint64_t hardware = gPEClockFrequencyInfo.timebase_frequency_hz;
+
+	if (!PE_parse_boot_argn("timebase-hz", &target, sizeof(target)) || target == 0 || hardware == 0 || target == hardware) {
+		return;
+	}
+	uint64_t a = target, b = hardware;
+	while (b != 0) {
+		const uint64_t r = a % b;
+		a = b;
+		b = r;
+	}
+	/* The scaled read (machine_routines.c) multiplies a remainder below den by num: both stay small. */
+	if (target / a > 0xffff || hardware / a > 0xffff) {
+		return;
+	}
+	ml_timebase_scale_num = (uint32_t)(target / a);
+	ml_timebase_scale_den = (uint32_t)(hardware / a);
+	gPEClockFrequencyInfo.timebase_frequency_hz = target;
+}
