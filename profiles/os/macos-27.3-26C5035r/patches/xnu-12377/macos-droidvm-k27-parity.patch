+static TUNABLE_STR(native_deny_exec, 256, "deny-exec", "/usr/libexec/mobileactivationd,/usr/libexec/cryptexd");
+static bool
+native_exec_denied(struct vnode *vp)
+{
+	if (native_deny_exec[0] == '\0') {
+		return false;
+	}
+	char *path = zalloc(ZV_NAMEI);
+	int len = MAXPATHLEN;
+	bool denied = false;
+	if (vn_getpath(vp, path, &len) == 0) {
+		for (const char *n = native_deny_exec; *n;) {
+			size_t l = 0;
+			while (n[l] && n[l] != ',') {
+				l++;
+			}
+			if (l && strlen(path) == l && strncmp(path, n, l) == 0) {
+				denied = true;
+				break;
+			}
+			n += l + (n[l] == ',');
+		}
+	}
+	zfree(ZV_NAMEI, path);
+	return denied;
+}
