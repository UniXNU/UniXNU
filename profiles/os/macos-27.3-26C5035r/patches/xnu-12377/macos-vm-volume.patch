/System/Volumes/VM on the owner Data volume.

A Mac mounts the VM role volume there and the kernel keeps its swap files in it (/System/Volumes/VM/swapfileN). The owner layout
has no such volume: the first swap file failed with EROFS ("Failed to open swap file 30"), and once the compressor filled, the
swap threads ran without pause (VM_swapout and VM_cswap_trigger: 12 s of CPU per 10 s on sheng), so the desktop stalled and the
tablet ran hot. The mount point becomes a firmlink to /private/var/vm of the owner Data volume, as /System/Volumes/Hardware does.
Requires macos-hardware-volume.patch.

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index c9e935b..06b8985 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -9330,6 +9330,35 @@ native_owner_macos_cryptex_view(proc_t p, user_addr_t scratch)
 	printf("owner Data: cryptex view stage %d, status %d\n", native_cryptex_os_stage, error);
 }
 
+/*
+ * /System/Volumes/VM: a Mac mounts the root container's VM role volume there and the kernel creates its swap files in it
+ * (SWAP_FILE_NAME, /System/Volumes/VM/swapfile). The owner layout has no such volume, so the first swap file failed with EROFS
+ * ("Failed to open swap file 30") and, with the compressor full, the swap threads ran without pause: two cores busy, the
+ * desktop unusable under memory pressure (sheng macOS run49). The mount point becomes a firmlink to /private/var/vm of the owner
+ * Data volume, the directory the Data template ships for it. Never fatal; the result is recorded.
+ */
+volatile int native_owner_vm_volume_status = -1;
+static void
+native_owner_macos_vm_volume(proc_t p, user_addr_t scratch)
+{
+	vnode_t source = NULLVP, target = NULLVP;
+	vfs_context_t ctx = vfs_context_current();
+	static const char directory[] = "/private/var/vm";
+	struct mkdir_args request = {.path = scratch + 0xc00, .mode = 0755};
+	int32_t result = 0;
+	int error = copyout(directory, request.path, sizeof(directory));
+	/* The Data template has the directory; a store without it gets one. */
+	if (!error) error = mkdir(p, &request, &result);
+	if (error == EEXIST) error = 0;
+	if (!error) error = vnode_lookup("/System/Volumes/VM", VNODE_LOOKUP_NOFOLLOW, &source, ctx);
+	if (!error) error = vnode_lookup("/private/var/vm", VNODE_LOOKUP_NOFOLLOW, &target, ctx);
+	if (!error) error = vnode_setasfirmlink(source, target);
+	if (target) vnode_put(target);
+	if (source) vnode_put(source);
+	native_owner_vm_volume_status = error;
+	printf("owner Data: /System/Volumes/VM -> /private/var/vm: %d\n", error);
+}
+
 #ifdef XNU_OWNER_APP_VOLUME_UUID
 /*
  * The application cryptex (Cryptex1,AppOS: Safari). Data's /Applications/Safari.app links to
@@ -9530,6 +9559,7 @@ native_owner_macos_data_prepare(proc_t p, user_addr_t scratch)
 		native_owner_rosv_state = 2;
 	}
 	if (!error) native_owner_macos_hardware_volume(p, scratch);
+	if (!error) native_owner_macos_vm_volume(p, scratch);
 	if (!error) native_owner_macos_cryptex_view(p, scratch);
 #ifdef XNU_OWNER_APP_VOLUME_UUID
 	if (!error) native_owner_macos_app_cryptex(p, scratch);
