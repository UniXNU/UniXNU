 		if ((kIOMemoryTypePhysical != type) && (kIOMemoryTypePhysical64 != type)) {
 			while (_wireCount) {
@@ -2530,7 +2594,13 @@
 			// (IOMemoryDescriptorReserved) so no reserved access after this point
 			device_pager_deallocate((memory_object_t) reserved->dp.devicePager );
 		} else {
+			// Never mapped: no device pager, so nothing but this descriptor ever named the pages.
+			void (*closeHandler)(void *) = reserved->dp.closeHandler;
+			void * closeContext = reserved->dp.closeContext;
 			IOFreeType(reserved, IOMemoryDescriptorReserved);
+			if (closeHandler) {
+				closeHandler(closeContext);
+			}
 		}
 		reserved = NULL;
 	}
