gpu-addon=1 on macOS: the Metal plugin goes to the Data volume's /Library/GPUBundles instead of a union view over
/System/Library/Extensions. IOGPU loads <MetalPluginName>.bundle only if libsystem_sandbox's gpu_bundle_find_trusted accepts it:
rootless_check_trusted_class(bundle, "KernelExtensionManagement") passes with SIP off, on the authenticated root volume, or when
the bundle's rootless protection lets only that storage class write it. SIP stays on and the root volume has no Apple seal, so
the addon's GPUBundles/ files and their directories get com.apple.rootless = KernelExtensionManagement and SF_RESTRICTED, as kmutil
leaves the bundles it installs. They are written with the kernel's context, so a later boot can replace a protected file.
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8410,7 +8410,78 @@
 		}
 	}
 	return 0;
+}
+#if XNU_TARGET_OS_OSX
+#include <sys/xattr.h>   /* XATTR_NOSECURITY */
+/*
+ * macOS: +[IOGPUMetalDevice registerAcceleratorService:] loads <MetalPluginName>.bundle from the first of /Library/GPUBundles and
+ * /System/Library/Extensions that libsystem_sandbox's gpu_bundle_find_trusted accepts: rootless_check_trusted_class(bundle,
+ * "KernelExtensionManagement") passes when System Integrity Protection is off, when the bundle is on the authenticated root volume, or
+ * when its rootless protection lets only that storage class write it. SIP stays on here and the root volume has no Apple seal, so the
+ * bundle is protected as kmutil leaves the bundles it installs: the com.apple.rootless attribute names KernelExtensionManagement and
+ * the file carries SF_RESTRICTED. The attribute goes first, as a restricted file no longer takes attribute changes from processes.
+ */
+static const char native_gpu_bundle_class[] = "KernelExtensionManagement";
+volatile int native_gpu_bundle_protect_error = 0;
+volatile int native_gpu_bundle_protected = 0;
+static int
+native_gpu_bundle_protect_one(const char *path)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	uio_t auio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+	if (!auio) {
+		vnode_put(vp);
+		return ENOMEM;
+	}
+	uio_addiov(auio, CAST_USER_ADDR_T(native_gpu_bundle_class), sizeof(native_gpu_bundle_class) - 1);
+	error = vn_setxattr(vp, "com.apple.rootless", auio, XATTR_NOSECURITY, ctx);
+	uio_free(auio);
+	if (!error) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_flags);
+		error = vnode_getattr(vp, &va, ctx);
+		if (!error && !(va.va_flags & SF_RESTRICTED)) {
+			uint32_t flags = va.va_flags | SF_RESTRICTED;
+			VATTR_INIT(&va);
+			VATTR_SET(&va, va_flags, flags);
+			error = vnode_setattr(vp, &va, ctx);
+		}
+	}
+	vnode_put(vp);
+	if (!error) {
+		native_gpu_bundle_protected++;
+	}
+	return error;
+}
+/* The file and every directory between /Library/GPUBundles and it (the .bundle directory is what the trust check names). */
+static int
+native_gpu_bundle_protect(const char *path)
+{
+	static const char root[] = "/Library/GPUBundles/";
+	char part[192];
+	strlcpy(part, path, sizeof(part));
+	int first = 0;
+	for (size_t i = sizeof(root) - 1; part[i]; ++i) {
+		if (part[i] != '/') {
+			continue;
+		}
+		part[i] = 0;
+		int error = native_gpu_bundle_protect_one(part);
+		part[i] = '/';
+		if (error && !first) {
+			first = error;
+		}
+	}
+	int error = native_gpu_bundle_protect_one(part);
+	return first ? first : error;
 }
