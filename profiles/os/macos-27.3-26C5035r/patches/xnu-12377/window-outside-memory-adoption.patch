+++ b/osfmk/arm64/machine_routines.c	2026-11-11 06:38:34
@@ -2278,6 +2278,94 @@
 }
 
 /*
+ * The free memory outside the managed span (arm_vm_init.c, arm_vm_outside_base: a DRAM bank below the span) becomes
+ * VM pages, as pages below the page array do when ml_static_mfree returns them: each is mapped in the physical
+ * aperture and marked managed in the pmap, then gets a vm_page and goes to the free list. The pages were never
+ * wired or counted, so only the memory sizes grow. vm.outside_memory reports the pages adopted and the pages the
+ * pmap refused.
+ */
+uint32_t ml_outside_memory_pages;
+uint32_t ml_outside_memory_refused;
+
+/*
+ * Whether a load from a kernel address completes. Memory the firmware's map calls free can belong to another
+ * owner (a hypervisor guest, the secure world): a load from it is a synchronous external abort, which the
+ * platform error handler turns into this function's answer instead of a panic while the probe runs on this CPU.
+ */
+static volatile uint32_t ml_memory_probe_cpu;        /* the probing CPU's number plus one */
+static volatile uint32_t ml_memory_probe_faulted;
+
+bool
+ml_memory_probe_fault(void)
+{
+	if (ml_memory_probe_cpu != (uint32_t)cpu_number() + 1) {
+		return false;
+	}
+	ml_memory_probe_faulted = 1;
+	return true;
+}
+
+bool
+ml_memory_probe(vm_offset_t va)
+{
+	static SIMPLE_LOCK_DECLARE(probe_lock, 0);
+	bool readable;
+
+	simple_lock(&probe_lock, LCK_GRP_NULL);     /* preemption is off until the unlock */
+	ml_memory_probe_faulted = 0;
+	ml_memory_probe_cpu = (uint32_t)cpu_number() + 1;
+	__asm__ volatile ("ldr x9, [%0]" : : "r"(va) : "x9", "memory");
+	__builtin_arm_isb(ISB_SY);
+	ml_memory_probe_cpu = 0;
+	readable = !ml_memory_probe_faulted;
+	simple_unlock(&probe_lock);
+	return readable;
+}
+
+extern bool arm_vm_outside_range(unsigned int index, pmap_paddr_t *base, pmap_paddr_t *end);
+
+__startup_func
+static void
+ml_adopt_outside_memory(void)
+{
+	pmap_paddr_t base, end;
+	uint32_t adopted = 0, refused = 0;
+
+	for (unsigned int i = 0; arm_vm_outside_range(i, &base, &end); i++) {
+		for (pmap_paddr_t pa = base; pa < end; pa += PAGE_SIZE) {
+			const ppnum_t pn = (ppnum_t)atop(pa);
+
+			const kern_return_t kr = pmap_adopt_outside_page(pn);
+
+			if (kr == KERN_PROTECTION_FAILURE) {
+				/* Another owner's memory: the rest of the run is left alone, so a run costs one refused load. */
+				refused += (uint32_t)atop(end - pa);
+				break;
+			}
+			if (kr != KERN_SUCCESS) {
+				refused++;
+				continue;
+			}
+			vm_page_create_canonical(pn);
+			adopted++;
+		}
+	}
+	if (adopted != 0) {
+		const uint64_t bytes = ptoa_64(adopted);
+
+		max_mem += bytes;
+		max_mem_actual += bytes;
+		mem_actual += bytes;
+		sane_size += bytes;
+		machine_info.max_mem += bytes;
+	}
+	ml_outside_memory_pages = adopted;
+	ml_outside_memory_refused = refused;
+	printf("memory outside the span: %u pages adopted, %u refused\n", adopted, refused);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_MIDDLE, ml_adopt_outside_memory);
+
+/*
  *	Routine:        ml_static_mfree
  *	Function:
  */
