The Metal plugin's system shader cache: a directory the render server fills, shown read-only to every process.

The render server compiles the system's shader libraries ahead of use, but its results reached no other process: caches
were per user and per sandbox container, and no path is both writable by the render server's sandbox and readable by the
others. The kernel makes /private/var/tmp/NativeAdrenoMetal.cache for the render server's user (owner 88, mode 0755, set at
every boot, only if it is a directory) and shows it read-only at /Library/GPUBundles/NativeAdrenoMetal.cache, which every
sandbox with graphics access may read. gpu-prime-system=0 leaves it out.

Has not run on hardware.
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -9477,6 +9477,69 @@
 		if (error && !status) status = error;
 	}
 	native_owner_addon_sbin_status = status;
+}
+
+/*
+ * The system shader cache of the Metal plugin. The render server compiles the system's shader libraries ahead of use and every
+ * other process should read the results, but no path is both writable by the render server's sandbox and readable by the other
+ * sandboxes. So the cache is a directory under /private/var/tmp that belongs to the render server's user (_windowserver, 88) and
+ * that nobody else may write, and the same directory is shown read-only under /Library/GPUBundles, which every sandbox with
+ * graphics access may read. The readers trust it only for that owner and mode (the plugin checks every level). Not made with
+ * gpu-prime-system=0; without the directory the plugin keeps its per-process caches. `covered` says /Library/GPUBundles is the
+ * empty cover directory of gpu-bundle-system=1, whose own path the mount point is then made in.
+ * Status: 1 shown, 0 not asked, else 0x100 * step + errno (1 the directory, 2 its attributes, 3 the mount point, 4 the mount).
+ */
+#define NATIVE_GPU_SHADER_CACHE_OWNER 88
+volatile int native_gpu_shader_cache_view = 0;
+static void
+native_owner_macos_gpu_shader_cache(proc_t p, user_addr_t scratch, bool covered)
+{
+	static const char cache[] = "/private/var/tmp/NativeAdrenoMetal.cache";
+	static const char point[] = "/Library/GPUBundles/NativeAdrenoMetal.cache";
+	static const char covered_point[] = "/private/var/ngpu/no-bundles/NativeAdrenoMetal.cache";
+	struct mkdir_args request = {.path = scratch + 0xc00, .mode = 0755};
+	int32_t result = 0;
+	uint32_t asked = 1;
+	vnode_t vp = NULLVP;
+	int step = 1;
+
+	if (PE_parse_boot_argn("gpu-prime-system", &asked, sizeof(asked)) && asked == 0) {
+		return;
+	}
+	int error = copyout(cache, request.path, sizeof(cache));
+	if (!error) error = mkdir(p, &request, &result);
+	if (error == EEXIST) error = 0;
+	if (!error) {
+		step = 2;
+		/* Somebody may have put a link or a file there: only a directory is taken, and its owner and mode are set at every boot. */
+		error = vnode_lookup(cache, VNODE_LOOKUP_NOFOLLOW, &vp, vfs_context_kernel());
+		if (!error) {
+			if (vnode_vtype(vp) != VDIR) {
+				error = ENOTDIR;
+			} else {
+				struct vnode_attr va;
+				VATTR_INIT(&va);
+				VATTR_SET(&va, va_uid, NATIVE_GPU_SHADER_CACHE_OWNER);
+				VATTR_SET(&va, va_gid, 0);
+				VATTR_SET(&va, va_mode, 0755);
+				error = vnode_setattr(vp, &va, vfs_context_kernel());
+			}
+			vnode_put(vp);
+		}
+	}
+	if (!error) {
+		step = 3;
+		const char *made = covered ? covered_point : point;
+		error = copyout(made, request.path, strlen(made) + 1);
+		if (!error) error = mkdir(p, &request, &result);
+		if (error == EEXIST) error = 0;
+	}
+	if (!error) {
+		step = 4;
+		error = native_cryptex_os_bind(p, scratch, cache, point, 0);
+	}
+	native_gpu_shader_cache_view = error ? 0x100 * step + error : 1;
+	printf("owner Data: GPU shader cache %s shown at %s: step %d, %d\n", cache, point, step, error);
 }
 
 /* gpu-bundle-system=1: 1 both mounts made, 0 not asked, 0x1000 + errno the cover failed, else the errno of the union. */
@@ -9520,6 +9583,9 @@
 		native_gpu_bundle_system_view = error ? error : (cover ? 0x1000 + cover : 1);
 		printf("owner Data: GPU bundles over /System/Library/Extensions: %d, /Library/GPUBundles covered: %d\n", error, cover);
 	}
+	if (native_gpu_addon_stage == 5) {
+		native_owner_macos_gpu_shader_cache(p, scratch, native_gpu_bundle_system_view == 1);
+	}
 	printf("owner Data: GPU addon %d files, %d written, %d same, %d failed (%d); GPUBundles stage %d, status %d, protected %d (%d)\n",
 	    native_gpu_addon_files, native_gpu_addon_written, native_gpu_addon_same, native_gpu_addon_failed, native_gpu_addon_error,
 	    native_gpu_addon_stage, native_gpu_addon_status, native_gpu_bundle_protected, native_gpu_bundle_protect_error);
