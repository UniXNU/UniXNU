+/*
+ * Hash the signed bytes of a resident page without undoing its executable fixups. The same vnode pages can be
+ * fetched again for a 16 KiB authentication or a 4 KiB revalidation. Only exact, configured replacement bytes
+ * are substituted; every other byte still has to match the original signature. No allocation or vnode I/O is
+ * permitted here: page validation holds VM object locks. The small snapshot also bounds kernel stack use.
+ */
+static void
+cs_text_fixup_hash(struct vnode *vp, memory_object_offset_t offset, const void *data,
+    size_t length, const struct cs_hash *md, union cs_hash_union *ctx)
+{
+	const uint8_t *source = data;
+	uint8_t snapshot[256];
+	bool affected = false;
+
+	for (uint32_t i = 0; i < cs_text_fixup_count; i++) {
+		const struct cs_text_fixup *f = &cs_text_fixups[i];
+		if (vp == NULLVP || vp->v_name == NULL || strcmp(vp->v_name, f->name) != 0 ||
+		    f->offset < offset || f->offset - offset > length ||
+		    f->length > length - (f->offset - offset)) {
+			continue;
+		}
+		if (memcmp(source + (f->offset - offset), f->replacement, f->length) == 0) {
+			affected = true;
+			break;
+		}
+	}
+	if (!affected) {
+		md->cs_update(ctx, source, length);
+		return;
+	}
+	for (size_t start = 0; start < length;) {
+		const size_t part = MIN(sizeof(snapshot), length - start);
+		memcpy(snapshot, source + start, part);
+		for (uint32_t i = 0; i < cs_text_fixup_count; i++) {
+			const struct cs_text_fixup *f = &cs_text_fixups[i];
+			if (strcmp(vp->v_name, f->name) != 0 || f->offset < offset ||
+			    f->offset - offset > length || f->length > length - (f->offset - offset)) {
+				continue;
+			}
+			const size_t at = (size_t)(f->offset - offset);
+			if (at >= start + part || at + f->length <= start ||
+			    memcmp(source + at, f->replacement, f->length) != 0) {
+				continue;
+			}
+			const size_t first = MAX(at, start), last = MIN(at + f->length, start + part);
+			memcpy(snapshot + first - start, f->original + first - at, last - first);
+		}
+		md->cs_update(ctx, snapshot, part);
+		start += part;
+	}
+}
