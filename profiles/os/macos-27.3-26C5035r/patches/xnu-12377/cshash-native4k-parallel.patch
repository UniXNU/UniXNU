+static void
+cs_native4k_pass_helper(void *parameter, __unused wait_result_t result)
+{
+	struct cs_native4k_pass *pass = parameter;
+
+	cs_native4k_pass_run(pass);
+	lck_mtx_lock(&pass->lock);
+	if (--pass->helpers == 0) {
+		wakeup(&pass->helpers);
+	}
+	lck_mtx_unlock(&pass->lock);
+	thread_terminate(current_thread());
