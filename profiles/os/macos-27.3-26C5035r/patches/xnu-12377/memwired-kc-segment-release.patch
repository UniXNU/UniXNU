+/*
+ * kc-segment-release (default 1, 0 keeps the old behaviour): the segments of the loaded kernel collection that XNU
+ * hands back once it is done with them go to the VM on a kernel without a monitor, without the SPTM and without
+ * ARM_LARGE_MEMORY. They are the collection's __LINKEDIT (OSKext::jettisonFileSetLinkeditSegment, unless keepsyms is
+ * set), the kernel's __BOOTDATA (arm_vm_prot_finalize, once the boot stacks have been replaced) and its __KLD and
+ * __KLDDATA (OSKext::removeKextBootstrap). Their only kernel address is the one in the static region: the physical
+ * aperture of such a kernel aliases the memory in front of the collection and behind topOfKernelData, not the
+ * collection, so ml_static_mfree() used to drop these requests (40 MiB on sheng: 0x2810000 bytes in 5 calls).
+ * arm_vm_prot_init() maps each of them with page mappings and no contiguous hint (granule 0), so ml_static_protect()
+ * can give every page the protections of free memory and the page keeps that address as its kernel address, as
+ * pages of the image tail do (ml_static_in_image_tail). A monitor kernel slides the same segments into the aperture
+ * for this reason (the XNU_MONITOR arm_vm_physmap_init()).
+ */
+SECURITY_READ_ONLY_LATE(static uint32_t) kc_segment_release = 1;
+
+bool arm_vm_static_segment_releasable(vm_offset_t vaddr, vm_size_t size);
+
+bool
+arm_vm_static_segment_releasable(vm_offset_t vaddr, vm_size_t size)
+{
+#if !XNU_MONITOR && !defined(CONFIG_SPTM) && !defined(ARM_LARGE_MEMORY)
+	const struct {
+		vm_offset_t base;
+		vm_size_t   size;
+	} segments[] = {
+		{ segLINKB, segSizeLINK },
+		{ segBOOTDATAB, segSizeBOOTDATA },
+		{ segKLDB, segSizeKLD },
+		{ segKLDDATAB, segSizeKLDDATA },
+	};
+
+	if (kc_segment_release != 1 || size == 0) {
+		return false;
+	}
+	for (unsigned int i = 0; i < sizeof(segments) / sizeof(segments[0]); i++) {
+		if (segments[i].size != 0 && vaddr >= segments[i].base && vaddr - segments[i].base < segments[i].size &&
+		    size <= segments[i].size - (vaddr - segments[i].base)) {
+			return true;
+		}
+	}
+#else
+#pragma unused(vaddr, size)
+#endif
+	return false;
 }
 
