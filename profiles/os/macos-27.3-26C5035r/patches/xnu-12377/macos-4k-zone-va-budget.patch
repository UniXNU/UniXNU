+#if defined(__arm64__) && !defined(ARM_LARGE_MEMORY) && XNU_TARGET_OS_OSX
+/* The small address layout also holds the compressor and shared I/O heaps.
+ * Keep their VA available without changing the zone wired-memory limit. */
