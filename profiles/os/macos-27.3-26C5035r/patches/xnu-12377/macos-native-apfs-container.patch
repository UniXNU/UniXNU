 #if XNU_TARGET_OS_OSX   /* owner root globals: bsd_init (XNU_OWNER_ROOT_TRUST is passed to bsd_init.o only) */
-/*
- * An authenticated open (openat_authenticated_np, kernelmanagerd realizing a driver extension, among others) asks the file system to
- * prove the file comes from a sealed volume (FSIOC_AUTH_FS); APFS answers EAUTH for the owner-verified root, which has no Apple seal.
- * Every block of that read-only volume is checked against the owner-signed manifest before it is used (native_verified_block_root_authorized,
- * bsd_init), the same guarantee the seal gives. So when the original check refuses, the file is opened again without it and kept only
- * if the vnode that was opened is on that root mount; anything else is closed and keeps EAUTH. The check is on the opened vnode, so a
- * path changing between two lookups cannot pass a file from elsewhere.
- */
+/* Authenticated opens on the explicit unsealed development root. The reopened vnode must
+ * remain on that same read-only root mount. This does not provide an Apple seal. */
 volatile int native_owner_root_authenticated_opens = 0;
 static int
 native_owner_root_authenticated_open(struct openat_dprotected_np_args *uap, int32_t *retval)
 {
 	extern volatile int native_owner_root_accepted;
 	extern volatile dev_t native_owner_root_mount_device;
-	if (!native_owner_root_accepted || native_owner_root_mount_device == NODEV) {
+	if (csr_check(CSR_ALLOW_UNAUTHENTICATED_ROOT) != 0 || !native_owner_root_accepted || native_owner_root_mount_device == NODEV) {
 		return EAUTH;
 	}
 	int fd = -1;
diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
