 #include <sys/systm.h>
 #include <sys/filedesc.h>
 #include <sys/kernel.h>
@@ -8175,6 +8176,44 @@ native_owner_cache_checkpoint(int status, int authorized)
 static int
 native_owner_cache_prepare(proc_t p, user_addr_t scratch, user_addr_t *envp)
 {
+#if XNU_TARGET_OS_OSX
+	(void)p;
+	(void)scratch;
+	extern int native_ram_block_root_device(dev_t);
+	mount_t mp = vnode_mount(rootvnode);
+	vnode_t devvp = vfs_devvp(mp);
+	dev_t device = devvp ? vnode_specrdev(devvp) : NODEV;
+	if (devvp) vnode_put(devvp);
+	*envp = USER_ADDR_NULL;
+	/* An unsealed development root, explicitly enabled by local boot policy. */
+	int ready = csr_check(CSR_ALLOW_UNAUTHENTICATED_ROOT) == 0 &&
+	    (vfs_flags(mp) & MNT_RDONLY) && !strcmp(vfs_statfs(mp)->f_fstypename, "apfs") &&
+	    device != NODEV && native_ram_block_root_device(device);
+	int error = ready ? 0 : EAUTH;
+#if defined(XNU_OWNER_BOOT_MANIFEST) && XNU_OWNER_BOOT_MANIFEST
+	struct vfs_attr va;
+	VFSATTR_INIT(&va);
+	VFSATTR_WANTED(&va, f_uuid);
+	uuid_string_t identity;
+	if (!error && (!vfs_getattr(mp, &va, vfs_context_current())) && VFSATTR_IS_SUPPORTED(&va, f_uuid)) {
+		uuid_unparse_upper(va.f_uuid, identity);
+		if (!native_owner_publish_boot_manifest(device, identity, device, identity)) error = EAUTH;
+	} else error = EAUTH;
+#endif
+#if defined(XNU_OWNER_CACHE_STARTUP) && XNU_OWNER_CACHE_STARTUP
+	if (!error) {
+		/* SystemOS contents are already on System; dyld requires no cryptex ignition. */
+		dyld_flags |= UINT64_C(8);
+		commpage_update_dyld_flags(dyld_flags);
+		native_owner_cache_dyld_flags = dyld_flags;
+	}
+#endif
+	native_owner_cache_status = error;
+	native_owner_cache_authorized = !error;
+	native_owner_cache_checkpoint(error, !error);
+	return error;
+#else
+
 #ifndef XNU_OWNER_CACHE_VOLUME_UUID
 #define XNU_OWNER_CACHE_VOLUME_UUID "7A23BAC7-E86D-4DF4-B181-E6D80F212AE5"
 #endif
@@ -9316,6 +9355,7 @@ done:
 	if (data_root) vnode_put(data_root);
 	native_owner_data_status = error;
 	return error;
+#endif
 }
 #endif
 
