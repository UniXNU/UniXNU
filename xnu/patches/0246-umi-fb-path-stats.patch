From d4bf40dc9256f2d52224c9925442dbcdfcc69750 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Wed, 4 Nov 2026 13:37:33 +0100
Subject: [PATCH] umi: framebuffer counts direct presents against copy
 fallbacks every 10 s

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index a93e0dc..7656e99 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -353,6 +353,7 @@ AppleCLCD::start(IOService *provider)
 
 /* defined below: samples the pending frame's surface away from present time */
 static void sweet_fb_dump_idle(AppleCLCD *fb);
+static void sweet_fb_path_stats(void);
 
 void
 AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
@@ -487,6 +488,9 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		IOLog("SWEET FB: %llu drawables released %u vsyncs after their replacement, %llu with the CTL flush bits "
 		    "still set\n", fb->fRetireDrops, fb->fRetireTicks, fb->fRetirePending);
 	}
+	if ((count % 600) == 0) {
+		sweet_fb_path_stats();
+	}
 	sweet_fb_dump_idle(fb);
 	sender->setTimeoutUS(SWEET_FB_VSYNC_US);
 }
@@ -529,6 +533,23 @@ static uint64_t sweet_fb_present_count;
  * picture for the right value (sweetfb_srcbpr=N) */
 static uint32_t sweet_fb_src_bpr = 0xffffffff;
 static uint32_t sweet_fb_direct_fail[4];     /* 0: layer count, 1: no surface, 2: shape, 3: address */
+
+/* (0246) Every 10 s: how many presents went out directly and how many fell back to the copy path (which writes
+ * into the boot framebuffer while the panel scans it - tearing), by reason. Totals since boot. */
+static void
+sweet_fb_path_stats(void)
+{
+	static uint64_t last;
+	if (sweet_fb_present_count == last) {
+		return;
+	}
+	last = sweet_fb_present_count;
+	uint64_t fails = (uint64_t)sweet_fb_direct_fail[0] + sweet_fb_direct_fail[1] + sweet_fb_direct_fail[2] +
+	    sweet_fb_direct_fail[3];
+	IOLog("SWEET FB: presents %llu: direct %llu, copy %llu (layer count %u, no surface %u, shape %u, address %u)\n",
+	    sweet_fb_present_count, sweet_fb_present_count - fails, fails, sweet_fb_direct_fail[0],
+	    sweet_fb_direct_fail[1], sweet_fb_direct_fail[2], sweet_fb_direct_fail[3]);
+}
 static uint32_t sweet_fb_direct_ok_logged;
 
 /* Opt-in COPY-path dump: two 64x32 rectangles and a row profile, after GPU sync
-- 
2.54.0 (Apple Git-157)

