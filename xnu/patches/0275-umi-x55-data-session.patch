From 7104ab7c8921f454ab7ae4676401ca43e7c140a6 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Tue, 10 Nov 2026 23:05:17 +0100
Subject: [PATCH] umi: X55 mobile data session (stage A, sweetmdm=10): WDA set
 data format (raw IP, QMAP, PCIe interface 4), WDS bind mux 1, IP family 4,
 start network, current settings -> kern.sweet_cell_data (0275)

---
 bsd/dev/sweet_mdm.c | 159 +++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 158 insertions(+), 1 deletion(-)

diff --git a/bsd/dev/sweet_mdm.c b/bsd/dev/sweet_mdm.c
index 5aa7600..2be48cd 100644
--- a/bsd/dev/sweet_mdm.c
+++ b/bsd/dev/sweet_mdm.c
@@ -2156,7 +2156,7 @@ mx_qmi_req(uint32_t svc, uint16_t msg, const uint8_t *tlv, uint16_t tlvlen)
 		printf("SWEET MDM: QMI: service %#x not announced\n", svc);
 		return;
 	}
-	uint8_t m[64];
+	uint8_t m[128];
 	uint16_t txn = ++mq.txn;
 	m[0] = 0;
 	m[1] = (uint8_t)txn;
@@ -2262,6 +2262,159 @@ mx_cell_update(void)
 	    mq_usim.state < 8 ? sim[mq_usim.state] : "?", mq.opmode < 9 ? mx_opmode(mq.opmode) : "?");
 }
 
+/*
+ * ---- mobile data, stage A (sweetmdm=10, or sweetmdmdata=1): the data session over QMI, no packets yet ----
+ * Order and values as the OnePlus 8 Pro port found working on the same X55 (facts from its notes): WDA Set Data Format
+ * (link layer raw IP, QMAP aggregation both ways, 4 datagrams of up to 0x1c00 bytes, endpoint PCIe (3) interface 4 =
+ * the hardware IP channel IP_HW0, MHI 100 / 101) -> WDS Bind Mux Data Port (same endpoint, mux 1) -> Set IP Family 4 ->
+ * Start Network Interface (family 4, the default profile, no APN) -> Get Current Settings (address, gateway, mask, DNS,
+ * MTU). Each step waits for the previous answer; a refused step is logged and retried after 30 s from the start.
+ */
+static struct {
+	unsigned step;                  /* the next request to send; odd while its answer is awaited */
+	unsigned at;                    /* not before (ms) */
+	uint32_t handle;
+	uint32_t addr, gw, mask, dns1, dns2, mtu;
+	bool up;
+} mdd;
+
+static char sweet_cell_data[160] = "data=off";
+SYSCTL_STRING(_kern, OID_AUTO, sweet_cell_data, CTLFLAG_RD | CTLFLAG_LOCKED, sweet_cell_data, sizeof(sweet_cell_data),
+    "sweet: the modem's mobile data session (sweetmdm=10)");
+
+static void
+mx_put32(uint8_t *t, unsigned *k, uint8_t type, uint32_t v)
+{
+	t[(*k)++] = type; t[(*k)++] = 4; t[(*k)++] = 0;
+	t[(*k)++] = (uint8_t)v; t[(*k)++] = (uint8_t)(v >> 8); t[(*k)++] = (uint8_t)(v >> 16); t[(*k)++] = (uint8_t)(v >> 24);
+}
+
+static void
+mx_put8(uint8_t *t, unsigned *k, uint8_t type, uint8_t v)
+{
+	t[(*k)++] = type; t[(*k)++] = 1; t[(*k)++] = 0; t[(*k)++] = v;
+}
+
+static void
+mx_ip4(char *b, size_t n, uint32_t a)
+{
+	snprintf(b, n, "%u.%u.%u.%u", a >> 24, (a >> 16) & 0xff, (a >> 8) & 0xff, a & 0xff);
+}
+
+static void
+mx_data_step(unsigned t_ms)
+{
+	unsigned on = md.stage >= 10;   /* sweetmdm=10: the service (9) with mobile data (boot-args are short of room) */
+	(void)PE_parse_boot_argn("sweetmdmdata", &on, sizeof(on));
+	if (!on || mq.reg != 1 || mq.svc_port[0x01] == 0 || mq.svc_port[0x1a] == 0 || (mdd.step & 1) || mdd.up ||
+	    t_ms < mdd.at) {
+		return;
+	}
+	uint8_t t[96];
+	unsigned k = 0;
+	mdd.at = t_ms + 30000;          /* an answer that never comes: the step again in 30 s */
+	switch (mdd.step) {
+	case 0:
+		mx_put32(t, &k, 0x11, 2);               /* link layer: raw IP */
+		mx_put32(t, &k, 0x12, 5);               /* uplink data aggregation: QMAP */
+		mx_put32(t, &k, 0x13, 5);               /* downlink data aggregation: QMAP */
+		mx_put32(t, &k, 0x15, 4);               /* downlink: max datagrams */
+		mx_put32(t, &k, 0x16, 0x1c00);          /* downlink: max size */
+		t[k++] = 0x17; t[k++] = 8; t[k++] = 0;  /* endpoint: type 3 (PCIe), interface 4 (IP_HW0) */
+		t[k++] = 3; t[k++] = 0; t[k++] = 0; t[k++] = 0; t[k++] = 4; t[k++] = 0; t[k++] = 0; t[k++] = 0;
+		printf("SWEET MDM: DATA: WDA set data format (raw IP, QMAP, PCIe interface 4)\n");
+		mx_qmi_req(0x1a, 0x20, t, (uint16_t)k);
+		break;
+	case 2:
+		t[k++] = 0x10; t[k++] = 8; t[k++] = 0;
+		t[k++] = 3; t[k++] = 0; t[k++] = 0; t[k++] = 0; t[k++] = 4; t[k++] = 0; t[k++] = 0; t[k++] = 0;
+		mx_put8(t, &k, 0x11, 1);                /* mux id 1 */
+		printf("SWEET MDM: DATA: WDS bind mux data port (mux 1)\n");
+		mx_qmi_req(0x01, 0xa2, t, (uint16_t)k);
+		break;
+	case 4:
+		mx_put8(t, &k, 0x01, 4);
+		printf("SWEET MDM: DATA: WDS set IP family 4\n");
+		mx_qmi_req(0x01, 0x4d, t, (uint16_t)k);
+		break;
+	case 6:
+		mx_put8(t, &k, 0x19, 4);                /* IP family preference 4; default profile, no APN */
+		printf("SWEET MDM: DATA: WDS start network interface\n");
+		mx_qmi_req(0x01, 0x20, t, (uint16_t)k);
+		break;
+	case 8:
+		mx_put32(t, &k, 0x10, 0xa310);          /* settings wanted: DNS, address, gateway, mask, MTU, family */
+		printf("SWEET MDM: DATA: WDS get current settings\n");
+		mx_qmi_req(0x01, 0x2d, t, (uint16_t)k);
+		break;
+	default:
+		return;
+	}
+	mdd.step++;
+}
+
+/* The answers to mx_data_step's requests; true when the message was one of them. */
+static bool
+mx_data_rx(uint32_t svc, unsigned msg, const uint8_t *m, uint32_t len, unsigned res, unsigned err)
+{
+	uint16_t tl = 0;
+	const uint8_t *v;
+	unsigned want = mdd.step;
+	if (!((svc == 0x1a && msg == 0x20 && want == 1) || (svc == 0x01 && msg == 0xa2 && want == 3) ||
+	    (svc == 0x01 && msg == 0x4d && want == 5) || (svc == 0x01 && msg == 0x20 && want == 7) ||
+	    (svc == 0x01 && msg == 0x2d && want == 9))) {
+		if (svc == 0x01 || svc == 0x1a) {
+			printf("SWEET MDM: DATA: %s message %#x (type %u) result %u error %u\n", svc == 1 ? "WDS" : "WDA", msg,
+			    m[0], res, err);
+		}
+		return svc == 0x01 || svc == 0x1a;
+	}
+	printf("SWEET MDM: DATA: %s %#x -> result %u error %u\n", svc == 1 ? "WDS" : "WDA", msg, res, err);
+	if (res != 0 && !(msg == 0x4d && res != 0xffff)) {
+		if (msg == 0x20 && svc == 0x01) {
+			if ((v = mx_tlv(m, len, 0x10, &tl)) != NULL && tl >= 2) {
+				printf("SWEET MDM: DATA: call end reason %u\n", v[0] | v[1] << 8);
+			}
+			if ((v = mx_tlv(m, len, 0x11, &tl)) != NULL && tl >= 4) {
+				printf("SWEET MDM: DATA: verbose call end reason type %u reason %u\n", v[0] | v[1] << 8, v[2] | v[3] << 8);
+			}
+		}
+		mdd.step = 0;                   /* from the start, in 30 s (mdd.at) */
+		snprintf(sweet_cell_data, sizeof(sweet_cell_data), "data=failed step=%#x error=%u", msg, err);
+		return true;
+	}
+	if (svc == 0x01 && msg == 0x20 && (v = mx_tlv(m, len, 0x01, &tl)) != NULL && tl >= 4) {
+		mdd.handle = (uint32_t)v[0] | (uint32_t)v[1] << 8 | (uint32_t)v[2] << 16 | (uint32_t)v[3] << 24;
+		printf("SWEET MDM: DATA: session started (handle %#x)\n", mdd.handle);
+	}
+	if (svc == 0x01 && msg == 0x2d) {
+		static const struct { uint8_t type; size_t off; } f[] = {
+			{ 0x1e, offsetof(__typeof__(mdd), addr) }, { 0x20, offsetof(__typeof__(mdd), gw) },
+			{ 0x21, offsetof(__typeof__(mdd), mask) }, { 0x15, offsetof(__typeof__(mdd), dns1) },
+			{ 0x16, offsetof(__typeof__(mdd), dns2) }, { 0x29, offsetof(__typeof__(mdd), mtu) },
+		};
+		for (unsigned i = 0; i < sizeof(f) / sizeof(f[0]); ++i) {
+			if ((v = mx_tlv(m, len, f[i].type, &tl)) != NULL && tl >= 4) {
+				*(uint32_t *)((uint8_t *)&mdd + f[i].off) =
+				    (uint32_t)v[0] | (uint32_t)v[1] << 8 | (uint32_t)v[2] << 16 | (uint32_t)v[3] << 24;
+			}
+		}
+		char a[16], g[16], mk[16], d1[16], d2[16];
+		mx_ip4(a, sizeof(a), mdd.addr);
+		mx_ip4(g, sizeof(g), mdd.gw);
+		mx_ip4(mk, sizeof(mk), mdd.mask);
+		mx_ip4(d1, sizeof(d1), mdd.dns1);
+		mx_ip4(d2, sizeof(d2), mdd.dns2);
+		printf("SWEET MDM: DATA: UP: address %s gateway %s mask %s dns %s %s mtu %u\n", a, g, mk, d1, d2, mdd.mtu);
+		snprintf(sweet_cell_data, sizeof(sweet_cell_data), "data=up addr=%s gw=%s mask=%s dns=%s,%s mtu=%u", a, g, mk,
+		    d1, d2, mdd.mtu);
+		mdd.up = true;
+	}
+	mdd.step++;
+	mdd.at = 0;
+	return true;
+}
+
 static void
 mx_qmi_rx(uint32_t node, uint32_t port, const uint8_t *m, uint32_t len)
 {
@@ -2279,6 +2432,9 @@ mx_qmi_rx(uint32_t node, uint32_t port, const uint8_t *m, uint32_t len)
 	const uint8_t *r = mx_tlv(m, len, 0x02, &tl);
 	unsigned res = r && tl >= 4 ? (unsigned)(r[0] | r[1] << 8) : 0xffff;
 	unsigned err = r && tl >= 4 ? (unsigned)(r[2] | r[3] << 8) : 0;
+	if (mx_data_rx(svc, msg, m, len, res, err)) {
+		return;
+	}
 	if (type == 4 && svc == 0x0b && msg == 0x32) {
 		const uint8_t *cv = mx_tlv(m, len, 0x10, &tl);
 		printf("SWEET MDM: UIM card status INDICATION\n");
@@ -2412,6 +2568,7 @@ static void
 mx_qmi_survey(unsigned t_ms)
 {
 	mx_mode_steer(t_ms);
+	mx_data_step(t_ms);
 	if (!mq.asked && mq.svc_port[0x02] && mq.svc_port[0x0b] && mq.svc_port[0x03]) {
 		mq.asked = true;
 		printf("SWEET MDM: QMI: DMS, UIM and NAS announced: asking\n");
-- 
2.54.0 (Apple Git-157)

