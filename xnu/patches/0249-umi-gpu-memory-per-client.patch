From b5b9b847bc2aee784ffecb9a1e6b3a1ef174f3c9 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Thu, 5 Nov 2026 19:14:44 +0100
Subject: [PATCH] umi: GPU memory per Turnip client - every 10 s, at a failed
 BoAlloc (with the failing step), and when a client is freed (0249)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 iokit/Kernel/arm/SweetAdreno.cpp | 99 +++++++++++++++++++++++++++++++-
 1 file changed, 97 insertions(+), 2 deletions(-)

diff --git a/iokit/Kernel/arm/SweetAdreno.cpp b/iokit/Kernel/arm/SweetAdreno.cpp
index 3904535..73553f6 100644
--- a/iokit/Kernel/arm/SweetAdreno.cpp
+++ b/iokit/Kernel/arm/SweetAdreno.cpp
@@ -222,8 +222,69 @@ public:
 	uint32_t       fLastFence;
 	uint32_t       fLogged;        /* bring-up: first calls of each kind get a line */
 	uint32_t       fSubmitLogged;  /* the submit budget is its own: a shared one never reached it */
+	int            fStat;          /* (0249) this client's slot in sa_clients, -1: none */
 };
 
+/*
+ * (0249) GPU memory per client: the 2026-11-05 freeze had 735 BoAllocs of 24 MB refused and no line saying who held
+ * the memory. Each v2 client owns one slot (written only under its fLock, read racily for the log); a closed client
+ * keeps its slot until free() so "closed but not freed" shows up. Printed every sweettop round and at a failed BoAlloc.
+ */
+#define SA_CLIENTS 32
+static struct sa_client_stat {
+	volatile UInt32 used;
+	bool     closed;
+	int      pid;
+	char     name[20];
+	uint64_t alloc_bytes, import_bytes, peak_bytes;
+	uint32_t alloc_n, import_n;
+} sa_clients[SA_CLIENTS];
+static uint32_t sa_alloc_failures;
+extern "C" unsigned int vm_page_wire_count, vm_page_free_count;
+
+static void
+sa_memory_report(const char *why)
+{
+	char line[600];
+	uint64_t total = 0;
+	int n = snprintf(line, sizeof(line), "SWEET ADRENO: memory (%s):", why);
+	for (int i = 0; i < SA_CLIENTS; i++) {
+		struct sa_client_stat *c = &sa_clients[i];
+		if (!c->used) {
+			continue;
+		}
+		uint64_t mine = c->alloc_bytes + c->import_bytes;
+		total += mine;
+		if (n < (int)sizeof(line) - 80) {
+			n += snprintf(line + n, sizeof(line) - n, " %s[%d]%s %llu MB/%u (imp %llu MB/%u, peak %llu MB);", c->name,
+			    c->pid, c->closed ? " CLOSED" : "", c->alloc_bytes >> 20, c->alloc_n, c->import_bytes >> 20, c->import_n,
+			    c->peak_bytes >> 20);
+		}
+	}
+	IOLog("%s total %llu MB; wired %u MB, free %u MB, %u failed allocs\n", line, total >> 20,
+	    (unsigned)(((uint64_t)vm_page_wire_count * PAGE_SIZE) >> 20),
+	    (unsigned)(((uint64_t)vm_page_free_count * PAGE_SIZE) >> 20), sa_alloc_failures);
+}
+
+static void
+sa_stat_add(int slot, bool imported, int64_t bytes)
+{
+	if (slot < 0) {
+		return;
+	}
+	struct sa_client_stat *c = &sa_clients[slot];
+	if (imported) {
+		c->import_bytes += bytes;
+		c->import_n += bytes > 0 ? 1 : -1;
+	} else {
+		c->alloc_bytes += bytes;
+		c->alloc_n += bytes > 0 ? 1 : -1;
+	}
+	if (c->alloc_bytes + c->import_bytes > c->peak_bytes) {
+		c->peak_bytes = c->alloc_bytes + c->import_bytes;
+	}
+}
+
 OSDefineMetaClassAndStructors(SweetAdrenoUserClient, IOUserClient);
 
 /* v2 open types: Turnip's darwin backend opens with 0x4147 ('AG'), tests may use 2 */
@@ -240,7 +301,20 @@ SweetAdrenoUserClient::initWithTask(task_t owningTask, void *securityID, UInt32
 		return false;
 	}
 	fTask = owningTask;
+	fStat = -1;
 	if (type == SWEET_ADRENO_V2_OPEN_AG || type == SWEET_ADRENO_V2_OPEN_2) {
+		for (int i = 0; i < SA_CLIENTS; i++) {      /* (0249) */
+			if (OSCompareAndSwap(0, 1, &sa_clients[i].used)) {
+				struct sa_client_stat *c = &sa_clients[i];
+				c->closed = false;
+				c->pid = proc_selfpid();
+				proc_selfname(c->name, sizeof(c->name));
+				c->alloc_bytes = c->import_bytes = c->peak_bytes = 0;
+				c->alloc_n = c->import_n = 0;
+				fStat = i;
+				break;
+			}
+		}
 		if (!sweet_adreno_service_ready()) {
 			return false;
 		}
@@ -290,6 +364,13 @@ SweetAdrenoUserClient::free(void)
 			fWinSize = 0;
 		}
 	}
+	if (fStat >= 0) {                         /* (0249) after every BO went back */
+		struct sa_client_stat *c = &sa_clients[fStat];
+		IOLog("SWEET ADRENO: v2 client %s[%d] freed (%s), peak %llu MB; left %llu MB\n", c->name, c->pid,
+		    c->closed ? "closed first" : "never closed", c->peak_bytes >> 20, (c->alloc_bytes + c->import_bytes) >> 20);
+		c->used = 0;
+		fStat = -1;
+	}
 	if (fLock != NULL) {
 		IOLockFree(fLock);
 		fLock = NULL;
@@ -310,6 +391,9 @@ SweetAdrenoUserClient::start(IOService *provider)
 IOReturn
 SweetAdrenoUserClient::clientClose(void)
 {
+	if (fStat >= 0) {
+		sa_clients[fStat].closed = true;      /* (0249) */
+	}
 	terminate();
 	return kIOReturnSuccess;
 }
@@ -501,6 +585,7 @@ SweetAdrenoUserClient::v2NewSlot(IOMemoryDescriptor *md, IOMemoryMap *kmap, uint
 	fBO[i].bytes = bytes;
 	fBO[i].iova = 0;
 	fBO[i].imported = imported;
+	sa_stat_add(fStat, imported, (int64_t)bytes);  /* (0249) */
 	*handle = i + 1;
 	return kIOReturnSuccess;
 }
@@ -515,6 +600,7 @@ SweetAdrenoUserClient::v2Release(SweetAdrenoUserClient::BO *bo)
 	if (bo->iova != 0) {
 		sweet_adreno_unmap_at(bo->iova, bo->bytes);
 	}
+	sa_stat_add(fStat, bo->imported, -(int64_t)bo->bytes);  /* (0249) */
 	if (bo->imported) {
 		bo->md->complete();
 	}
@@ -548,6 +634,7 @@ sweet_adreno_method_top(void)
 		}
 	}
 	IOLog("%s\n", line);
+	sa_memory_report("10 s");                 /* (0249) */
 }
 
 /* A WaitFence can block for long and touches no client state; every other method runs alone. */
@@ -630,8 +717,16 @@ SweetAdrenoUserClient::v2Method(uint32_t method, const void *in, uint32_t inSize
 		    kIODirectionInOut | kIOMemoryPageable | kIOMapWriteCombineCache, rq->bytes,
 		    1u << rq->align_log2);
 		IOMemoryMap *kmap = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
-		if (md == NULL || kmap == NULL || md->prepare() != kIOReturnSuccess) {
-			IOLog("SWEET ADRENO: v2 BoAlloc of %llu bytes failed\n", rq->bytes);
+		IOReturn prep = kmap != NULL ? md->prepare() : kIOReturnNotReady;
+		if (md == NULL || kmap == NULL || prep != kIOReturnSuccess) {
+			/* (0249) which step, and who holds the GPU's memory (first failure, then every 100th) */
+			uint32_t nfail = OSIncrementAtomic((volatile SInt32 *)&sa_alloc_failures);
+			if (nfail < 4 || nfail % 100 == 0) {
+				IOLog("SWEET ADRENO: v2 BoAlloc of %llu bytes failed (%s, %#x) for %s[%d]\n", rq->bytes,
+				    md == NULL ? "no descriptor" : kmap == NULL ? "no kernel map" : "prepare/wire", (unsigned)prep,
+				    fStat >= 0 ? sa_clients[fStat].name : "?", fStat >= 0 ? sa_clients[fStat].pid : -1);
+				sa_memory_report("alloc failed");
+			}
 			OSSafeReleaseNULL(kmap);
 			OSSafeReleaseNULL(md);
 			return kIOReturnNoMemory;
-- 
2.54.0 (Apple Git-157)

