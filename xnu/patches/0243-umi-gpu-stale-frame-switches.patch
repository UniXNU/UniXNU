From 0b0bea547d50ed7b056ef4df4f4f7745b6aa5b66 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Wed, 4 Nov 2026 12:15:40 +0100
Subject: [PATCH] umi: stale-frame hunt switches - outer-WB GPU memory
 (sweetgpuattr), memory-vs-cache compare (sweetgpucoh=2), quiet presents
 (sweetfb_quiet); all off

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_adreno.c | 134 ++++++++++++++++++++++++++++++++++++++---
 1 file changed, 127 insertions(+), 7 deletions(-)

diff --git a/bsd/dev/sweet_adreno.c b/bsd/dev/sweet_adreno.c
index 8b094b8..bc5d8c5 100644
--- a/bsd/dev/sweet_adreno.c
+++ b/bsd/dev/sweet_adreno.c
@@ -2587,12 +2587,16 @@ static uint32_t sa_irq_empty;                   /* interrupts in a row with noth
 static struct {
 	uint64_t irqs, waits, polls, slept, sleeps, waited_abs, timeouts;
 } sa_stat, sa_stat_last;
+static struct {
+	uint64_t quiet, spent, timeouts;
+} sa_fin, sa_fin_last;          /* sweet_adreno_finish outcomes (0243) */
 /* sweetgpucoh=1 (0241): sa_coh_check's counters */
-static uint32_t sa_coh_on = 2;                  /* 2: boot-arg not read yet */
+static uint32_t sa_coh_on = ~0u;                /* ~0: boot-arg not read yet; 1 cache modes, 2 memory compare */
 static struct {
 	uint64_t pages, dirty_pages, stale_pages, dirty_words, stale_words;
 } sa_coh, sa_coh_last;
 static uint32_t sa_coh_logged;
+static uint64_t sa_coh_moved, sa_coh_moved_last;
 
 static void
 sa_irq(uint32_t intid)
@@ -2716,11 +2720,24 @@ sweet_adreno_top(uint32_t secs)
 	    sa_stat.slept - sa_stat_last.slept, ns / NSEC_PER_MSEC, sa_stat.sleeps - sa_stat_last.sleeps,
 	    sa_stat.irqs - sa_stat_last.irqs, sa_irq_on ? "on" : "off");
 	sa_stat_last = sa_stat;
+	if (sa_fin.quiet + sa_fin.spent + sa_fin.timeouts != sa_fin_last.quiet + sa_fin_last.spent + sa_fin_last.timeouts) {
+		printf("SWEET ADRENO: presents waited: %llu quiet, %llu budget spent, %llu timed out\n",
+		    sa_fin.quiet - sa_fin_last.quiet, sa_fin.spent - sa_fin_last.spent, sa_fin.timeouts - sa_fin_last.timeouts);
+		sa_fin_last = sa_fin;
+	}
 	if (sa_coh_on == 1) {
 		printf("SWEET ADRENO: coherence %u s: %llu command pages checked, %llu write-combined, %llu NOT\n", secs,
 		    sa_coh.pages - sa_coh_last.pages, sa_coh.stale_pages - sa_coh_last.stale_pages,
 		    sa_coh.dirty_pages - sa_coh_last.dirty_pages);
 		sa_coh_last = sa_coh;
+	} else if (sa_coh_on == 2) {
+		printf("SWEET ADRENO: coherence %u s: %llu pages compared, %llu with dirty lines (%llu words), %llu with stale "
+		    "lines (%llu words), %llu words moved\n", secs, sa_coh.pages - sa_coh_last.pages,
+		    sa_coh.dirty_pages - sa_coh_last.dirty_pages, sa_coh.dirty_words - sa_coh_last.dirty_words,
+		    sa_coh.stale_pages - sa_coh_last.stale_pages, sa_coh.stale_words - sa_coh_last.stale_words,
+		    sa_coh_moved - sa_coh_moved_last);
+		sa_coh_last = sa_coh;
+		sa_coh_moved_last = sa_coh_moved;
 	}
 	sweet_adreno_method_top();
 }
@@ -3200,9 +3217,21 @@ sweet_adreno_map_at(uint64_t iova, const uint64_t *pages, uint32_t n)
 			return EEXIST;
 		}
 	}
+	/* (0243) Clients' memory "inner non-cacheable, outer write-back" (MAIR index 3 = 0xf4), as Linux maps GPU
+	 * memory on an SoC with a system cache (a6xx_create_address_space: IO_PGTABLE_QUIRK_ARM_OUTER_WBWA when the
+	 * GPU has LLCC slices and is not IO-coherent - SM8250). With index 0 (plain non-cacheable) the GPU reads
+	 * past the system cache, where the CPU's write-combined stores to Turnip's command memory may still sit:
+	 * the stale frames that only the walk's clean to the point of coherency fixed (0240e-0242).
+	 * sweetgpuattr=0 = the old plain non-cacheable mapping. */
+	static uint32_t attr = ~0u;
+	if (attr == ~0u) {
+		attr = 0;               /* tested 3 (0243, walk off): "glitchier than before" - default stays 0 */
+		(void)PE_parse_boot_argn("sweetgpuattr", &attr, sizeof(attr));
+		attr &= 7;
+	}
 	int err = 0;
 	for (uint32_t i = 0; i < n; i++) {
-		if (!sa_space_map(&sa_core_space, iova + 4096ull * i, pages[i], PTE_CORE)) {
+		if (!sa_space_map(&sa_core_space, iova + 4096ull * i, pages[i], PTE_CORE | (uint64_t)attr << 2)) {
 			err = ENOMEM;
 			break;
 		}
@@ -3489,9 +3518,86 @@ struct sa_word_cache {
  */
 extern unsigned int pmap_cache_attributes(ppnum_t pn);
 
+/*
+ * (0243, sweetgpucoh=2) Does the walk's clean+invalidate change what is in MEMORY for the pages it visits, and how?
+ * Memory is read through a write-combined mapping of our own (one reserved kernel page, entered and removed with
+ * pmap_enter / pmap_remove per check - unlike ml_io_map's permanent entries, 0241b's panic), the cache through the
+ * physmap, before and after the walk's flush. cache != memory before the flush: "dirty" when memory takes the
+ * cache's value (the CPU wrote these words through a cacheable alias), "stale" when memory keeps its own (a clean
+ * line older than memory). "moved": memory changed during the check with cache == memory (still being written).
+ */
+static vm_offset_t sa_coh_window;
+/* osfmk/vm/pmap.h, private to the VM: */
+extern kern_return_t pmap_enter(pmap_t pmap, vm_map_offset_t v, ppnum_t pn, vm_prot_t prot, vm_prot_t fault_type,
+    unsigned int flags, boolean_t wired);
+extern void pmap_remove(pmap_t map, vm_map_offset_t s, vm_map_offset_t e);
+
+static bool
+sa_coh_read_memory(uint64_t pa, uint32_t out[1024])
+{
+	if (sa_coh_window == 0 &&
+	    kmem_alloc(kernel_map, &sa_coh_window, PAGE_SIZE, KMA_VAONLY, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		sa_coh_window = 0;
+		return false;
+	}
+	if (pmap_enter(kernel_pmap, sa_coh_window, (ppnum_t)(pa >> PAGE_SHIFT), VM_PROT_READ, VM_PROT_NONE,
+	    VM_WIMG_WCOMB, FALSE) != KERN_SUCCESS) {
+		return false;
+	}
+	memcpy(out, (const void *)(sa_coh_window + (vm_offset_t)(pa & PAGE_MASK)), 4096);
+	pmap_remove(kernel_pmap, sa_coh_window, sa_coh_window + PAGE_SIZE);
+	return true;
+}
+
 static void
-sa_coh_check(uint64_t va, uint64_t pa, __unused vm_offset_t cached)
+sa_coh_compare(uint64_t va, uint64_t pa, vm_offset_t cached)
 {
+	static uint32_t mem[1024], pre[1024], post[1024];
+
+	if (!sa_coh_read_memory(pa, mem)) {
+		return;
+	}
+	memcpy(pre, (const void *)cached, 4096);
+	flush_dcache64((addr64_t)cached, 4096, FALSE);
+	if (!sa_coh_read_memory(pa, post)) {
+		return;
+	}
+	uint32_t dirty = 0, stale = 0, moved = 0, first = ~0u;
+	for (uint32_t i = 0; i < 1024; i++) {
+		if (mem[i] != pre[i]) {
+			if (post[i] == pre[i]) {
+				dirty++;
+			} else {
+				stale++;
+			}
+			if (first == ~0u) {
+				first = i;
+			}
+		} else if (post[i] != mem[i]) {
+			moved++;
+		}
+	}
+	sa_coh.pages++;
+	sa_coh.dirty_words += dirty;
+	sa_coh.stale_words += stale;
+	sa_coh.dirty_pages += dirty != 0;
+	sa_coh.stale_pages += stale != 0;
+	sa_coh_moved += moved;
+	if (first != ~0u && sa_coh_logged < 24) {
+		sa_coh_logged++;
+		IOLog("SWEET ADRENO: coherence: page %#llx (pa %#llx): %u dirty, %u stale words; first at +%#x: memory %#x, "
+		    "cache %#x, memory after the flush %#x [fence %u]\n", (unsigned long long)va, (unsigned long long)pa,
+		    dirty, stale, first * 4, mem[first], pre[first], post[first], sa_fence_seqno + 1);
+	}
+}
+
+static void
+sa_coh_check(uint64_t va, uint64_t pa, vm_offset_t cached)
+{
+	if (sa_coh_on == 2) {
+		sa_coh_compare(va, pa, cached);
+		return;
+	}
 	unsigned int wimg = pmap_cache_attributes((ppnum_t)(pa >> PAGE_SHIFT)) & 0xff;
 
 	sa_coh.pages++;
@@ -3536,7 +3642,7 @@ sa_gpu_page_kva(uint64_t va)
 		if ((entry & 3) == PTE_PAGE && pmap_valid_address(pa) && pmap_valid_address(pa + 4095)) {
 			vm_offset_t k = phystokv(pa);
 			if (sa_phys(k) == pa) {
-				if (sa_coh_on == 1) {
+				if (sa_coh_on == 1 || sa_coh_on == 2) {
 					sa_coh_check(va, pa, k);
 				}
 				flush_dcache64((addr64_t)k, 4096, FALSE);
@@ -3713,7 +3819,7 @@ sa_ib_check(uint32_t seqno, uint32_t index, uint64_t start, uint32_t dwords)
 	/* (0240) sweetgpucheck=0 turns the walk off - which shows stale frames (see sa_gpu_word): the walk
 	 * cleans the command and draw-state pages the CP will fetch. Default on, a page at a time. */
 	static int check = -1;
-	if (sa_coh_on == 2) {
+	if (sa_coh_on == ~0u) {
 		sa_coh_on = 0;
 		(void)PE_parse_boot_argn("sweetgpucoh", &sa_coh_on, sizeof(sa_coh_on));
 	}
@@ -3974,12 +4080,14 @@ bool
 sweet_adreno_finish(void)
 {
 	static uint32_t wait_ms;
-	static uint32_t rounds = 4;
+	static uint32_t rounds = 8;
+	static uint32_t quiet_us = 0;     /* tested 4000 (0243c, walk off): still glitchy; off by default */
 
 	if (wait_ms == 0) {
 		wait_ms = 500;
 		PE_parse_boot_argn("sweetfb_finwait", &wait_ms, sizeof(wait_ms));
 		PE_parse_boot_argn("sweetfb_finrounds", &rounds, sizeof(rounds));
+		PE_parse_boot_argn("sweetfb_quiet", &quiet_us, sizeof(quiet_us));
 	}
 
 	for (uint32_t round = 0; round < rounds; round++) {
@@ -3989,12 +4097,24 @@ sweet_adreno_finish(void)
 			return true;          /* nothing was ever submitted: quiet */
 		}
 		if (!sa_fence_wait(seqno, wait_ms)) {
+			sa_fin.timeouts++;
 			return false;         /* the newest fence did not signal within the cap */
 		}
-		if (sa_fence_seqno == seqno) {
+		/* (0243) Quiet means quiet for a while: CoreAnimation submits a frame's passes milliseconds apart, so
+		 * "nothing new right after the fence" (the check before 0243) often caught the gap between two passes
+		 * and the scanout switched to a drawable still being drawn - the stale "previous frames". The per-submit
+		 * walk hid this by slowing every submit down (0243b: its flush changed memory in 1 word of ~450000
+		 * pages; 0242d: 3 ms per submit was not enough). sweetfb_quiet=N us; 0243c's 4000 did not fix it (198 of 207
+		 * presents quiet, still stale frames): off by default. */
+		if (quiet_us != 0 && sa_fence_seqno == seqno) {
+			delay_for_interval(quiet_us, NSEC_PER_USEC);
+		}
+		if (sa_fence_seqno == seqno && (int32_t)(sa_fence_read() - seqno) >= 0) {
+			sa_fin.quiet++;
 			return true;          /* fence signalled and nothing new arrived: quiet */
 		}
 	}
+	sa_fin.spent++;
 	return true;                  /* budget spent: best effort, as before */
 }
 
-- 
2.54.0 (Apple Git-157)

