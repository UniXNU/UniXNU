new file mode 100644
index 0000000..7cc82e8
--- /dev/null
+++ b/bsd/dev/sweet_adsp.c
@@ -0,0 +1,156 @@
+/*
+ * SWEET umi: start the audio DSP (ADSP / LPASS Q6), first step towards sound.
+ * The Mi 10's speaker amps (two Cirrus CS35L41 on QUP SE3 I2C, 0x40 speaker,
+ * 0x42 earpiece) take their samples from an LPASS audio port that the ADSP owns:
+ * Linux (downstream msm-audio, Elite) asks the ADSP over APR for an AFE port, an
+ * ASM stream and an ADM route, and only then programs the amps.
+ *
+ * Same loader and transports as the sensor DSP: sweet_slpi.c compiled again with
+ * the ADSP's values (boot-arg sweetadsp=1, after sweetadspdelay seconds):
+ *   - firmware from the iOS root: /private/var/sweet/adsp/adsp.mdt + adsp.bNN (the
+ *     phone's modem partition, image/; not in git)
+ *   - AOP load_state adsp, lcx/lmx, pas id 1, dt pil_adsp_region 0x8bb00000 + 0x2500000
+ *   - SMEM host 2, SMP2P items 443 in / 429 out (dt qcom,smp2p-adsp), IPCC client 3
+ *     (signal 0 GLINK, 2 SMP2P), crash reason item 423
+ *   - GLINK "IPCRTR" (QRTR + our service locator: avs/audio -> msm/adsp/audio_pd) and
+ *     "apr_audio_svc" (dt qcom,apr_tal_rpmsg)
+ * On "apr_audio_svc": the Q6 core state query Linux's q6core_is_adsp_ready sends
+ * until it reads 1, then the service version list (Elite APR; an AudioReach ADSP
+ * would open "adsp_apps" for GPR instead).
+ */
+#define SL_EDGE_ADSP            1
+#define SL_TAG                  "ADSP"
+#define SL_FW                   "adsp"
+#define SL_ARG                  "sweetadsp"
+#define SL_ENTRY                sweet_adsp_start
+#define SL_DIR                  "/private/var/sweet/adsp/"
+#define SL_PAS_ID               1
+#define SL_REGION               0x8bb00000ull
+#define SL_REGION_SIZE          0x2500000u
+#define SL_HOST                 2
+#define SL_IPCC_CLIENT          3
+#define SL_SMP2P_IN             443
+#define SL_SMP2P_OUT            429
+#define SL_CRASH_ITEM           423
+#define SL_GLINK_SECS           600
+
+#include "sweet_slpi.c"
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+/* ---- APR (downstream msm-audio apr.h / q6core.c; Linux soc/qcom/apr.h header) ---- */
+
+#define APR_HDR_FIELD           0x0150          /* seq cmd, 20-byte header (5 words), version 0 */
+#define APR_DOMAIN_ADSP         4
+#define APR_DOMAIN_APPS         5
+#define APR_SVC_CORE            3
+#define APR_BASIC_RSP_RESULT    0x000110e8
+#define AVCS_GET_VERSIONS       0x00012905
+#define AVCS_GET_VERSIONS_RSP   0x00012906
+#define AVCS_GET_STATE          0x0001290c
+#define AVCS_GET_STATE_RSP      0x0001290d
+
+static int apr_core_state;                      /* 0 asking, 1 ready (versions asked), 2 done */
+static uint32_t apr_asked_ms, apr_token = 1;
+static unsigned apr_logged;
+
+static void
+apr_send(uint8_t svc, uint32_t opcode, const void *payload, uint16_t plen)
+{
+	uint8_t m[20 + 64];
+	uint16_t f = APR_HDR_FIELD, size = (uint16_t)(20 + plen);
+	if (plen > 64) {
+		return;
+	}
+	memcpy(m, &f, 2);
+	memcpy(m + 2, &size, 2);
+	m[4] = svc;                             /* src svc = dest svc, as apr_send_pkt */
+	m[5] = APR_DOMAIN_APPS;
+	memset(m + 6, 0, 2);                    /* src port */
+	m[8] = svc;
+	m[9] = APR_DOMAIN_ADSP;
+	memset(m + 10, 0, 2);                   /* dest port */
+	uint32_t token = apr_token++;
+	memcpy(m + 12, &token, 4);
+	memcpy(m + 16, &opcode, 4);
+	if (plen) {
+		memcpy(m + 20, payload, plen);
+	}
+	(void)gl_send(GL_LCID_RPC, m, size);
+}
+
+static void
+apr_rx(const uint8_t *m, uint32_t len)
+{
+	if (len < 20) {
+		return;
+	}
+	uint16_t f, size;
+	uint32_t token, opcode, p[4] = { 0 };
+	memcpy(&f, m, 2);
+	memcpy(&size, m + 2, 2);
+	memcpy(&token, m + 12, 4);
+	memcpy(&opcode, m + 16, 4);
+	uint32_t hlen = ((f >> 4) & 0xf) * 4;
+	if (hlen < 20 || hlen > len) {
+		hlen = 20;
+	}
+	memcpy(p, m + hlen, MIN(len - hlen, (uint32_t)sizeof(p)));
+	switch (opcode) {
+	case AVCS_GET_STATE_RSP:
+		printf("SWEET ADSP: APR <- core state %u%s\n", p[0], p[0] == 1 ? " (READY)" : "");
+		if (p[0] == 1 && apr_core_state == 0) {
+			apr_core_state = 1;
+			apr_send(APR_SVC_CORE, AVCS_GET_VERSIONS, NULL, 0);
+		}
+		return;
+	case AVCS_GET_VERSIONS_RSP: {
+		/* struct avcs_cmdrsp_get_version { build_id, num_services, { service_id, version }[] } */
+		printf("SWEET ADSP: APR <- versions: build %#x, %u services\n", p[0], p[1]);
+		for (uint32_t i = 0; i < p[1] && hlen + 8 + 8 * i + 8 <= len && i < 40; i++) {
+			uint32_t sv[2];
+			memcpy(sv, m + hlen + 8 + 8 * i, 8);
+			printf("SWEET ADSP: APR    service %#x version %#x\n", sv[0], sv[1]);
+		}
+		apr_core_state = 2;
+		return;
+	}
+	case APR_BASIC_RSP_RESULT:
+		printf("SWEET ADSP: APR <- result for opcode %#x: %#x (svc %u token %u)\n", p[0], p[1], m[4], token);
+		if (p[0] == AVCS_GET_VERSIONS && apr_core_state == 1) {
+			apr_core_state = 2;
+		}
+		return;
+	default:
+		break;
+	}
+	if (apr_logged++ < 16) {
+		printf("SWEET ADSP: APR <- %u bytes, hdr %#x size %u from svc %u domain %u port %u to svc %u port %u, "
+		    "token %u opcode %#x: %#x %#x %#x %#x\n", len, f, size, m[4], m[5], m[6] | m[7] << 8, m[8],
+		    m[10] | m[11] << 8, token, opcode, p[0], p[1], p[2], p[3]);
+	}
+}
+
+/* Every GLINK tick (10 ms): open "apr_audio_svc" if the ADSP has not, ask the core once a second. */
+static void
+apr_poll(uint32_t ms)
+{
+	static bool opened;
+	if (!opened && gl_ch[GL_LCID_RPC - 1].rcid == 0 && ms >= 5000) {
+		opened = true;
+		printf("SWEET ADSP: GLINK: the ADSP has not opened \"apr_audio_svc\" in 5 s; opening it\n");
+		gl_open(GL_LCID_RPC);
+	}
+	if (apr_core_state != 0 || !gl_ch[GL_LCID_RPC - 1].acked || ms - apr_asked_ms < 1000) {
+		return;
+	}
+	apr_asked_ms = ms;
+	static unsigned asks;
+	if (asks++ < 60) {
+		if (asks <= 3 || asks % 10 == 0) {
+			printf("SWEET ADSP: APR -> core state query %u at %u ms\n", asks, ms);
+		}
+		apr_send(APR_SVC_CORE, AVCS_GET_STATE, NULL, 0);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
