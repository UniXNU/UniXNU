 #define SL_MDT_MAX              (64 * 1024)
 #define SL_SEGMENTS_MAX         64
 
+/*
+ * Device mappings shared by both copies of this file: I/O virtual space is nearly full
+ * here, and the ADSP's own 2 MiB map of SMEM failed with KERN_NO_SPACE (0215c).
+ */
+#if SL_EDGE_ADSP
+extern vm_offset_t sweet_dsp_io_map(vm_offset_t pa, vm_size_t size);
+#else
+vm_offset_t sweet_dsp_io_map(vm_offset_t pa, vm_size_t size);
+
+vm_offset_t
+sweet_dsp_io_map(vm_offset_t pa, vm_size_t size)
+{
+	/* no lock: each DSP thread maps at its start, sweetslpidelay / sweetadspdelay apart */
+	static struct {
+		vm_offset_t pa, va;
+		vm_size_t size;
+	} maps[8];
+	unsigned i;
+	for (i = 0; i < 8 && maps[i].va != 0; i++) {
+		if (maps[i].pa == pa && maps[i].size >= size) {
+			return maps[i].va;
+		}
+	}
+	vm_offset_t va = ml_io_map(pa, size);
+	if (i < 8) {
+		maps[i].pa = pa;
+		maps[i].size = size;
+		maps[i].va = va;
+	}
+	return va;
+}
+#endif
+
