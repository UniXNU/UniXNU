 #define CP_EVENT_WRITE          0x46
 #define BLIT_OP_SCALE           3
 #define EVENT_TIMESTAMP         (1u << 30)      /* CP_EVENT_WRITE_0_TIMESTAMP, as Mesa's A6XX __event_write */
+#define EVENT_IRQ               (1u << 31)      /* CP_EVENT_WRITE_0_IRQ: RBBM_INT_0 CP_CACHE_FLUSH_TS when done (Linux a6xx_submit) */
 #define EVENT_CACHE_FLUSH_TS    4
 #define EVENT_CCU_INVALIDATE_DEPTH 24
 #define EVENT_CCU_INVALIDATE_COLOR 25
@@ -2542,7 +2545,7 @@ sa_submit(const struct sa_bo *cmds, uint32_t words)
 	sa_ring((uint32_t)(cmds->gpu >> 32));
 	sa_ring(words);
 	sa_ring_packet(CP_EVENT_WRITE, 4);
-	sa_ring(EVENT_CACHE_FLUSH_TS);
+	sa_ring(EVENT_CACHE_FLUSH_TS | EVENT_IRQ);
 	sa_ring(CORE_FENCE_ADDRESS);
 	sa_ring(0);
 	sa_ring(seqno);
@@ -2558,16 +2561,153 @@ sa_fence_read(void)
 	return *fence;
 }
 
+/*
+ * (0239) Fence interrupts. Every fence is a CACHE_FLUSH_TS with CP_EVENT_WRITE_0_IRQ (Linux a6xx_submit), so the
+ * core raises RBBM_INT_0 CP_CACHE_FLUSH_TS when the fence word is written, on SPI 300 (umi dt kgsl_3d0_irq,
+ * level high). Waiters sleep on sa_fence_irq until the interrupt or a 4 ms safety slice instead of looking at the
+ * fence word every 100 us: delay_for_interval blocks on a timer here (cpu_idle_latency 0), so each waiting thread
+ * took 10000 wake-ups a second, all charged to the waiting process (backboardd) as system time. sweetgpuirq=0
+ * keeps the old 100 us polling. Interrupts are enabled after the steps (sa_irq_start); waits before that poll.
+ */
+#define RBBM_INT_CLEAR_CMD      GPU_WORD(0x0037)
+#define RBBM_INT_0_MASK         GPU_WORD(0x0038)
+#define RBBM_INT_CACHE_FLUSH_TS (1u << 20)
+#define SA_GPU_INTID            (32 + 300)
+#define SA_IRQ_SLICE_US         4000            /* a lost interrupt costs at most this */
+
+extern int get_preemption_level(void);           /* osfmk/arm/cpu_data.h */
+static int sa_fence_irq;                        /* the event waiters sleep on */
+static void sa_service_take_lock(void);
+static void sa_service_drop_lock(void);
+static bool sa_ring_room(uint32_t words);
+static bool sa_irq_on;
+static uint32_t sa_irq_want = 1;
+static uint32_t sa_irq_empty;                   /* interrupts in a row with nothing in RBBM_INT_0_STATUS */
+static struct {
+	uint64_t irqs, waits, polls, slept, sleeps, waited_abs, timeouts;
+} sa_stat, sa_stat_last;
+
+static void
+sa_irq(uint32_t intid)
+{
+	uint32_t status = sa_rd(sa_gpu.base + RBBM_INT_0_STATUS);
+
+	sa_wr(sa_gpu.base + RBBM_INT_CLEAR_CMD, status);
+	sa_stat.irqs++;
+	if (status == 0 && ++sa_irq_empty >= 100000) {
+		/* a source we cannot clear: stop it and go back to polling */
+		sweet_gic_mask(intid);
+		sa_irq_on = false;
+	} else if (status != 0) {
+		sa_irq_empty = 0;
+	}
+	thread_wakeup((event_t)&sa_fence_irq);
+}
+
+static void
+sa_irq_start(void)
+{
+	(void)PE_parse_boot_argn("sweetgpuirq", &sa_irq_want, sizeof(sa_irq_want));
+	if (!sa_irq_want || !sa_core_runs) {
+		printf("SWEET GPU: fence interrupts off (sweetgpuirq=%u): waits poll every 100 us\n", sa_irq_want);
+		return;
+	}
+	sa_wr(sa_gpu.base + RBBM_INT_0_MASK, 0);
+	sa_wr(sa_gpu.base + RBBM_INT_CLEAR_CMD, ~0u);
+	if (!sweet_gic_spi_enable(SA_GPU_INTID, sa_irq)) {
+		printf("SWEET GPU: fence interrupts: SPI %u not available, waits poll\n", SA_GPU_INTID - 32);
+		return;
+	}
+	sa_irq_on = true;
+	sa_wr(sa_gpu.base + RBBM_INT_0_MASK, RBBM_INT_CACHE_FLUSH_TS);
+	uint64_t before = sa_stat.irqs;
+	sa_service_take_lock();                     /* clients may be submitting already */
+	if (!sa_ring_room(5)) {
+		sa_service_drop_lock();
+		printf("SWEET GPU: fence interrupts on (SPI %u), the ring is busy: no test fence\n", SA_GPU_INTID - 32);
+		return;
+	}
+	uint32_t seqno = ++sa_fence_seqno;          /* one empty fence: does its interrupt arrive? */
+	sa_ring_packet(CP_EVENT_WRITE, 4);
+	sa_ring(EVENT_CACHE_FLUSH_TS | EVENT_IRQ);
+	sa_ring(CORE_FENCE_ADDRESS);
+	sa_ring(0);
+	sa_ring(seqno);
+	sa_ring_send();
+	sa_service_drop_lock();
+	sa_sleep_ms(50);
+	printf("SWEET GPU: fence interrupts on (SPI %u): test fence %u %s, %llu interrupt(s), mask %#x, status %#x\n",
+	    SA_GPU_INTID - 32, seqno, (int32_t)(sa_fence_read() - seqno) >= 0 ? "signalled" : "NOT signalled",
+	    sa_stat.irqs - before, sa_rd(sa_gpu.base + RBBM_INT_0_MASK), sa_rd(sa_gpu.base + RBBM_INT_0_STATUS));
+	if (sa_stat.irqs == before) {
+		printf("SWEET GPU: fence interrupts: none arrived, waits poll every %u us instead\n", SA_IRQ_SLICE_US);
+	}
+}
+
+/* Wait until fence `seqno` or the absolute `deadline`; true when it signalled. */
 static bool
-sa_fence_wait(uint32_t seqno, uint32_t ms)
+sa_fence_sleep(uint32_t seqno, uint64_t deadline)
 {
-	for (uint32_t i = 0; i < ms * 10; i++) {
+	uint64_t slice, start = mach_absolute_time();
+	bool done = false, blocked = false;
+
+	nanoseconds_to_absolutetime(SA_IRQ_SLICE_US * NSEC_PER_USEC, &slice);
+	for (;;) {
 		if ((int32_t)(sa_fence_read() - seqno) >= 0) {
-			return true;
+			done = true;
+			break;
 		}
-		delay_for_interval(100, NSEC_PER_USEC);
+		uint64_t now = mach_absolute_time();
+		if (now >= deadline) {
+			break;
+		}
+		blocked = true;
+		if (!sa_irq_on || get_preemption_level() != 0 || !ml_get_interrupts_enabled()) {
+			delay_for_interval(100, NSEC_PER_USEC);
+			continue;
+		}
+		assert_wait_deadline((event_t)&sa_fence_irq, THREAD_UNINT, MIN(deadline, now + slice));
+		if ((int32_t)(sa_fence_read() - seqno) >= 0) {   /* signalled before the wait was armed */
+			clear_wait(current_thread(), THREAD_AWAKENED);
+			done = true;
+			break;
+		}
+		sa_stat.sleeps++;
+		thread_block(THREAD_CONTINUE_NULL);
 	}
-	return (int32_t)(sa_fence_read() - seqno) >= 0;
+	if (blocked) {
+		sa_stat.slept++;
+		sa_stat.waited_abs += mach_absolute_time() - start;
+	}
+	return done;
+}
+
+static bool
+sa_fence_wait(uint32_t seqno, uint32_t ms)
+{
+	uint64_t deadline;
+
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &deadline);
+	return sa_fence_sleep(seqno, mach_absolute_time() + deadline);
+}
+
+/* One line every sweettop round (sweet_sample.c): what the GPU's waiters did since the last one. */
+void sweet_adreno_top(uint32_t secs);
+void
+sweet_adreno_top(uint32_t secs)
+{
+	uint64_t ns;
+
+	if (!sa_core_runs) {
+		return;
+	}
+	absolutetime_to_nanoseconds(sa_stat.waited_abs - sa_stat_last.waited_abs, &ns);
+	printf("SWEET ADRENO: %u s: fence %u (submitted %u), %llu waits (%llu polls, %llu timed out), %llu waited "
+	    "%llu ms in %llu sleeps, %llu interrupts (%s)\n", secs, sa_fence_read(), sa_fence_seqno,
+	    sa_stat.waits - sa_stat_last.waits, sa_stat.polls - sa_stat_last.polls, sa_stat.timeouts - sa_stat_last.timeouts,
+	    sa_stat.slept - sa_stat_last.slept, ns / NSEC_PER_MSEC, sa_stat.sleeps - sa_stat_last.sleeps,
+	    sa_stat.irqs - sa_stat_last.irqs, sa_irq_on ? "on" : "off");
+	sa_stat_last = sa_stat;
 }
 
 static bool
@@ -2899,7 +3039,7 @@ sweet_adreno_submit(uint64_t handle, uint32_t offset_dwords, uint32_t dwords, ui
 		sa_ring((uint32_t)(ib >> 32));
 		sa_ring(dwords);
 		sa_ring_packet(CP_EVENT_WRITE, 4);
-		sa_ring(EVENT_CACHE_FLUSH_TS);
+		sa_ring(EVENT_CACHE_FLUSH_TS | EVENT_IRQ);
 		sa_ring(CORE_FENCE_ADDRESS);
 		sa_ring(0);
 		sa_ring(seqno);
@@ -3165,7 +3305,7 @@ sweet_adreno_submit_v2(const uint64_t *iova, const uint32_t *dwords, uint32_t n,
 	}
 	sa_submit_next = (sa_submit_next + 1) % SA_SUBMIT_HISTORY;
 	sa_ring_packet(CP_EVENT_WRITE, 4);
-	sa_ring(EVENT_CACHE_FLUSH_TS);
+	sa_ring(EVENT_CACHE_FLUSH_TS | EVENT_IRQ);
 	sa_ring(CORE_FENCE_ADDRESS);
 	sa_ring(0);
 	sa_ring(seqno);
@@ -3547,15 +3687,14 @@ sweet_adreno_wait_fence_ns(uint32_t fence, uint64_t timeout_ns)
 	}
 	nanoseconds_to_absolutetime(timeout_ns, &deadline);
 	deadline += mach_absolute_time();
-	do {
-		if ((int32_t)(sa_fence_read() - fence) >= 0) {
-			return true;
-		}
-		delay_for_interval(100, NSEC_PER_USEC);
-	} while (mach_absolute_time() < deadline);
-	if ((int32_t)(sa_fence_read() - fence) >= 0) {
+	sa_stat.waits++;
+	if (timeout_ns == 0) {
+		sa_stat.polls++;
+	}
+	if (sa_fence_sleep(fence, deadline)) {
 		return true;
 	}
+	sa_stat.timeouts++;
 	/* Keyed on the core's progress, not on the fence waited for: clients that take turns
 	 * waiting on two fences (0189: 662 and 663, forever) restarted a per-fence timer on
 	 * every call, and the dump never ran. The fence word standing still for 2 s while
@@ -3672,6 +3811,7 @@ sa_thread(__unused void *arg, __unused wait_result_t wr)
 	if (sa_core_on) {
 		printf("SWEET GPU: the 3D core was asked for: leaving the GPU block as it is (%u writes not undone)\n",
 		    sa_undo_count);
+		sa_irq_start();
 	} else {
 		sa_zap_release();
 		sa_undo_all();
@@ -3701,4 +3841,6 @@ sweet_adreno_init(void)
 #else
 void sweet_adreno_init(void);
 void sweet_adreno_init(void) {}
+void sweet_adreno_top(uint32_t secs);
+void sweet_adreno_top(__unused uint32_t secs) {}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
