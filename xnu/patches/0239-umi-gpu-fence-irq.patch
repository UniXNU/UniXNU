+
+/*
+ * (0239) An SPI that one of our drivers takes (the GPU's fence interrupt): a level-triggered
+ * Group 1 source routed to the CPU that asks, with the same priority as the timer and IPIs.
+ * sleh_irq calls the handler in interrupt context, before the "nobody handles it, mask it" path;
+ * the handler must clear the source before it returns. A few slots, set once each.
+ */
+#define SWEET_SPI_MAX 4
+static struct {
+	uint32_t intid;
+	void (*handler)(uint32_t intid);
+} sweet_spis[SWEET_SPI_MAX];
+
+bool
+sweet_gic_spi_handle(uint32_t intid)
+{
+	for (unsigned i = 0; i < SWEET_SPI_MAX; i++) {
+		void (*handler)(uint32_t) = os_atomic_load(&sweet_spis[i].handler, acquire);
+		if (handler != NULL && sweet_spis[i].intid == intid) {
+			handler(intid);
+			return true;
+		}
+	}
+	return false;
+}
+
+bool
+sweet_gic_spi_enable(uint32_t intid, void (*handler)(uint32_t intid))
+{
+	unsigned i;
+
+	if (gicd_base == 0 || intid < 32 || intid >= 1020 || handler == NULL) {
+		return false;
+	}
+	for (i = 0; i < SWEET_SPI_MAX && sweet_spis[i].handler != NULL; i++) {
+		;
+	}
+	if (i == SWEET_SPI_MAX) {
+		return false;
+	}
+	sweet_spis[i].intid = intid;
+	os_atomic_store(&sweet_spis[i].handler, handler, release);
+
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+	uint64_t route = (mpidr & 0xFFFFFFull) | ((mpidr >> 32) & 0xFFull) << 32;   /* this CPU's Aff3.Aff2.Aff1.Aff0 */
+	uint32_t bit = 1U << (intid % 32);
+
+	gicd_write32(GICD_ICENABLER + (intid / 32) * 4, bit);
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+	gicd_write32(GICD_IGROUPR + (intid / 32) * 4, gicd_read32(GICD_IGROUPR + (intid / 32) * 4) | bit);  /* WI if secure */
+	*(volatile uint8_t *)(gicd_base + GICD_IPRIORITYR + intid) = 0xA0;
+	uint32_t cfg = gicd_read32(GICD_ICFGR + (intid / 16) * 4);
+	gicd_write32(GICD_ICFGR + (intid / 16) * 4, cfg & ~(2U << ((intid % 16) * 2)));   /* level */
+	*(volatile uint64_t *)(gicd_base + GICD_IROUTER + 8 * intid) = route;
+	gicd_write32(GICD_ICPENDR + (intid / 32) * 4, bit);
+	gicd_write32(GICD_ISENABLER + (intid / 32) * 4, bit);
+	kprintf("SWEET GIC: SPI %u (INTID %u) on, routed to %#llx, group bits %#x, enabled %u\n", intid - 32, intid,
+	    route, gicd_read32(GICD_IGROUPR + (intid / 32) * 4), (gicd_read32(GICD_ISENABLER + (intid / 32) * 4) & bit) != 0);
+	return true;
+}
 #endif
