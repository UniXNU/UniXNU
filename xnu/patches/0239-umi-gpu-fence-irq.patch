+/*
+ * (0239) A thread "top" for sweettop (bsd/dev/sweet_sample.c): the `count` threads that ran most since the last
+ * call, as "TOP thread process/name#tid P% (sys S%)" (% of one core over `window_ns`; sys = time in the kernel,
+ * syscalls and traps on the thread's behalf). Every thread's run time (recount_thread_times) is remembered by
+ * thread id in an open-addressed table from one call to the next; a thread first seen counts with its whole run
+ * time. Idle threads are left out. The idea is ios-apollo's xnu 0155 top (github.com/aTechGeekDev/ios-apollo, MIT,
+ * Copyright (c) 2026 Leo Malik); this is our own code over the same XNU interfaces.
+ */
+#define SWEET_TT_SLOTS 2048
+#define SWEET_TT_BEST 12
+static struct sweet_tt_slot {
+	uint64_t tid, user, sys;
+	uint32_t gen;
+} sweet_tt[SWEET_TT_SLOTS];
+static uint32_t sweet_tt_gen;
+
+void sweet_top_threads(uint64_t window_ns, unsigned count);
+
+void
+sweet_top_threads(uint64_t window_ns, unsigned count)
+{
+	struct {
+		uint64_t du, ds;
+		char who[64];
+	} best[SWEET_TT_BEST];
+	unsigned nbest = 0, seen = 0;
+	thread_t thread;
+
+	if (count > SWEET_TT_BEST) {
+		count = SWEET_TT_BEST;
+	}
+	sweet_tt_gen++;
+	lck_mtx_lock(&tasks_threads_lock);
+	queue_iterate(&threads, thread, thread_t, threads) {
+		if (thread->state & TH_IDLE) {
+			continue;
+		}
+		seen++;
+		struct recount_times_mach t = recount_thread_times(thread);
+		uint32_t h = (uint32_t)(thread->thread_id * 0x9e3779b1u) % SWEET_TT_SLOTS;
+		struct sweet_tt_slot *slot = NULL;
+		for (uint32_t k = 0; k < 64; k++) {
+			struct sweet_tt_slot *e = &sweet_tt[(h + k) % SWEET_TT_SLOTS];
+			if (e->gen != 0 && e->tid == thread->thread_id) {
+				slot = e;
+				break;
+			}
+			/* free: never used, or its thread not seen in this call nor the last (gone) */
+			if (slot == NULL && (e->gen == 0 || e->gen + 1 < sweet_tt_gen)) {
+				slot = e;
+			}
+		}
+		uint64_t du = t.rtm_user, ds = t.rtm_system;
+		if (slot != NULL && slot->gen != 0 && slot->tid == thread->thread_id) {
+			du = t.rtm_user >= slot->user ? t.rtm_user - slot->user : 0;
+			ds = t.rtm_system >= slot->sys ? t.rtm_system - slot->sys : 0;
+		}
+		if (slot != NULL) {
+			slot->tid = thread->thread_id;
+			slot->user = t.rtm_user;
+			slot->sys = t.rtm_system;
+			slot->gen = sweet_tt_gen;
+		}
+		/* keep the `count` busiest, by insertion */
+		unsigned at = nbest;
+		while (at > 0 && best[at - 1].du + best[at - 1].ds < du + ds) {
+			at--;
+		}
+		if (at >= count || du + ds == 0) {
+			continue;
+		}
+		if (nbest < count) {
+			nbest++;
+		}
+		for (unsigned k = nbest - 1; k > at; k--) {
+			best[k] = best[k - 1];
+		}
+		best[at].du = du;
+		best[at].ds = ds;
+		task_t task = get_threadtask(thread);
+		void *bsd = task != TASK_NULL ? get_bsdtask_info(task) : NULL;
+		const char *pname = task == kernel_task ? "kernel_task" : bsd != NULL ? proc_name_address(bsd) : "?";
+		char tname[MAXTHREADNAMESIZE];
+		tname[0] = '\0';
+		thread_get_thread_name(thread, tname);
+		tname[MAXTHREADNAMESIZE - 1] = '\0';
+		snprintf(best[at].who, sizeof(best[at].who), "%s/%s#%llu", pname, tname, thread->thread_id);
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+	for (unsigned k = 0; k < nbest; k++) {
+		uint64_t un, sn;
+		absolutetime_to_nanoseconds(best[k].du, &un);
+		absolutetime_to_nanoseconds(best[k].ds, &sn);
+		if ((un + sn) * 100 / window_ns == 0) {
+			break;
+		}
+		printf("TOP thread %s %llu%% (sys %llu%%)\n", best[k].who, (un + sn) * 100 / window_ns, sn * 100 / window_ns);
+	}
+	(void)seen;
+}
+
 void sweet_sample_task(const char *name, int pid, task_t task);
 
