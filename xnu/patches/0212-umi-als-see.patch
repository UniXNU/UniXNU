From 6f0e5162c85eb6559826d185978543ea61072e0f Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Sat, 31 Oct 2026 19:29:04 +0100
Subject: [PATCH] umi: read the ambient light sensor through SEE

A SEE client (QMI service 400 over QRTR, protobuf payloads; message ids
and TLVs as LineageOS's kernel SEE client and Qualcomm's SEE sample,
no code taken): after the sensor PD has settled, SUID lookup of
"ambient_light" (register_updates, default_only), on-change config to
the SUID it returns, sensor events decoded (data[0] = lux) into
sweet_als_lux / sweet_als_time. Driven from the GLINK pump of the
FastRPC listener, which now waits for the next call without a deadline.

On the phone: the first SUID event is empty, the next one gives
"amsTCS3701ALS___"; on-change config is accepted and events come: 163.8,
146.6, 132.4, 153.8, 132.8, 153.3 lux while the user covered the
sensor and pointed the phone at a lamp (raw values of an under-display
sensor; the spread is small).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_slpi.c | 328 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 328 insertions(+)

diff --git a/bsd/dev/sweet_slpi.c b/bsd/dev/sweet_slpi.c
index 84d8244..06b92b9 100644
--- a/bsd/dev/sweet_slpi.c
+++ b/bsd/dev/sweet_slpi.c
@@ -772,6 +772,327 @@ pdm_request(uint32_t src_node, uint32_t src_port, const uint8_t *q, uint32_t len
 	qr_send(QR_TYPE_DATA, QR_PORT_PDM, src_node, src_port, r, at);
 }
 
+
+/* ---- SEE: the sensor client service (QMI 400) for the ambient light sensor ---- */
+
+/*
+ * QMI over QRTR to the SLPI's service 400 (node 9): request 0x20 with TLV 0x01 = a
+ * protobuf sns_client_request_msg; response 0x20 (TLVs 0x02 result, 0x10 client id,
+ * 0x11 SEE result); indications 0x21 / 0x22 (TLV 0x01 client id, 0x02 protobuf
+ * sns_client_event_msg). Message ids and TLVs as LineageOS's kernel SEE client
+ * (camera_floral cam_sensor_vsync.h, GPL; no code taken) and Qualcomm's SEE
+ * sample (sample-apps-for-robotics-platforms ROS2-IMU, BSD): SUID lookup 512 ->
+ * event 768 at SUID 0xabab..ab, on-change config 514, sensor event 1025
+ * (repeated float data: ambient_light data[0] = lux).
+ */
+#define SEE_SERVICE             400
+#define SEE_PORT                0x4000          /* our QRTR client port */
+#define SEE_REQ                 0x20
+#define SEE_IND                 0x21
+#define SEE_JUMBO_IND           0x22
+#define SEE_MSG_SUID_REQ        512
+#define SEE_MSG_SUID_EVENT      768
+#define SEE_MSG_ON_CHANGE       514
+#define SEE_MSG_SENSOR_EVENT    1025
+
+static uint32_t see_node, see_port;             /* where service 400 lives */
+static int see_state;                           /* 0 idle, 1 lookup sent, 2 enabled */
+static uint16_t see_txn = 1;
+static uint64_t see_suid[2];
+static uint64_t see_start;
+int32_t sweet_als_lux = -1;                     /* latest ambient light, lux (-1: none yet) */
+uint64_t sweet_als_time;                        /* mach_absolute_time of it */
+static unsigned see_logged;
+
+static uint32_t
+pb_varint(uint8_t *o, uint64_t v)
+{
+	uint32_t n = 0;
+	do {
+		o[n] = (uint8_t)(v & 0x7f);
+		v >>= 7;
+		if (v) {
+			o[n] |= 0x80;
+		}
+		n++;
+	} while (v);
+	return n;
+}
+
+static bool
+pb_read_varint(const uint8_t *p, uint32_t len, uint32_t *at, uint64_t *v)
+{
+	*v = 0;
+	for (int sh = 0; *at < len && sh < 64; sh += 7) {
+		uint8_t b = p[(*at)++];
+		*v |= (uint64_t)(b & 0x7f) << sh;
+		if (!(b & 0x80)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Next field of a protobuf message: tag, and for wire type 2 the data and length. */
+static bool
+pb_next(const uint8_t *p, uint32_t len, uint32_t *at, uint32_t *field, uint32_t *wt, uint64_t *v,
+    const uint8_t **data, uint32_t *dlen)
+{
+	uint64_t tag;
+	if (*at >= len || !pb_read_varint(p, len, at, &tag)) {
+		return false;
+	}
+	*field = (uint32_t)(tag >> 3);
+	*wt = (uint32_t)(tag & 7);
+	*data = NULL;
+	*dlen = 0;
+	switch (*wt) {
+	case 0:
+		return pb_read_varint(p, len, at, v);
+	case 1:
+		if (*at + 8 > len) {
+			return false;
+		}
+		memcpy(v, p + *at, 8);
+		*at += 8;
+		return true;
+	case 5:
+		if (*at + 4 > len) {
+			return false;
+		}
+		*v = 0;
+		memcpy(v, p + *at, 4);
+		*at += 4;
+		return true;
+	case 2:
+		if (!pb_read_varint(p, len, at, v) || *at + *v > len) {
+			return false;
+		}
+		*data = p + *at;
+		*dlen = (uint32_t)*v;
+		*at += (uint32_t)*v;
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* sns_client_request_msg { suid 1, fixed32 msg_id 2, susp_config 3 { APSS, WAKEUP }, request 4 { payload 2 } } */
+static void
+see_send(const uint64_t *suid, uint32_t msg_id, const uint8_t *payload, uint32_t plen)
+{
+	uint8_t pb[300], q[340];
+	uint32_t n = 0;
+	pb[n++] = 0x0a;
+	pb[n++] = 18;
+	pb[n++] = 0x09;
+	memcpy(pb + n, &suid[0], 8);
+	n += 8;
+	pb[n++] = 0x11;
+	memcpy(pb + n, &suid[1], 8);
+	n += 8;
+	pb[n++] = 0x15;
+	memcpy(pb + n, &msg_id, 4);
+	n += 4;
+	pb[n++] = 0x1a;
+	pb[n++] = 4;
+	pb[n++] = 0x08;
+	pb[n++] = 1;                            /* SNS_STD_CLIENT_PROCESSOR_APSS */
+	pb[n++] = 0x10;
+	pb[n++] = 0;                            /* SNS_CLIENT_DELIVERY_WAKEUP */
+	pb[n++] = 0x22;
+	uint8_t req[200];
+	uint32_t rn = 0;
+	if (plen) {
+		req[rn++] = 0x12;
+		rn += pb_varint(req + rn, plen);
+		memcpy(req + rn, payload, plen);
+		rn += plen;
+	}
+	n += pb_varint(pb + n, rn);
+	memcpy(pb + n, req, rn);
+	n += rn;
+	/* QMI request: header + TLV 0x01 { u16 length, bytes } */
+	uint16_t txn = see_txn++, msg = SEE_REQ, tl = (uint16_t)(n + 2), ln = (uint16_t)n, mlen = (uint16_t)(3 + tl);
+	q[0] = 0;
+	memcpy(q + 1, &txn, 2);
+	memcpy(q + 3, &msg, 2);
+	memcpy(q + 5, &mlen, 2);
+	q[7] = 0x01;
+	memcpy(q + 8, &tl, 2);
+	memcpy(q + 10, &ln, 2);
+	memcpy(q + 12, pb, n);
+	qr_send(QR_TYPE_DATA, SEE_PORT, see_node, see_port, q, 12 + n);
+}
+
+static void
+see_lookup(void)
+{
+	static const uint64_t lookup[2] = { 0xababababababababull, 0xababababababababull };
+	uint8_t p[40];
+	uint32_t n = 0;
+	p[n++] = 0x0a;
+	p[n++] = 13;
+	memcpy(p + n, "ambient_light", 13);
+	n += 13;
+	p[n++] = 0x10;
+	p[n++] = 1;                             /* register_updates */
+	p[n++] = 0x18;
+	p[n++] = 1;                             /* default_only */
+	see_send(lookup, SEE_MSG_SUID_REQ, p, n);
+	printf("SWEET SLPI: SEE -> SUID lookup \"ambient_light\"\n");
+}
+
+/* IEEE 754 float bits -> value x 1000, truncated (no FPU in the kernel) */
+static int64_t
+see_float_milli(uint32_t bits)
+{
+	int exp = (int)((bits >> 23) & 0xff) - 127;
+	uint64_t mant = (bits & 0x7fffff) | 0x800000;
+	int64_t v;
+	if (((bits >> 23) & 0xff) == 0) {
+		return 0;
+	}
+	if (exp >= 23) {
+		v = exp > 40 ? INT32_MAX : (int64_t)(mant << (exp - 23)) * 1000;
+	} else {
+		v = (int64_t)((mant * 1000) >> (23 - exp > 63 ? 63 : 23 - exp));
+	}
+	return (bits >> 31) ? -v : v;
+}
+
+static void
+see_event(const uint8_t *p, uint32_t len)
+{
+	uint32_t at = 0, f, wt, dl;
+	uint64_t v;
+	const uint8_t *d;
+	while (pb_next(p, len, &at, &f, &wt, &v, &d, &dl)) {
+		if (f != 2 || wt != 2) {        /* events */
+			continue;
+		}
+		uint32_t eat = 0, ef, ewt, edl, msg_id = 0;
+		uint64_t ev;
+		const uint8_t *ed, *payload = NULL;
+		uint32_t plen = 0;
+		while (pb_next(d, dl, &eat, &ef, &ewt, &ev, &ed, &edl)) {
+			if (ef == 1) {
+				msg_id = (uint32_t)ev;
+			} else if (ef == 3 && ewt == 2) {
+				payload = ed;
+				plen = edl;
+			}
+		}
+		if (msg_id == SEE_MSG_SUID_EVENT && see_state == 1 && payload != NULL) {
+			uint32_t sat = 0, sf, swt, sdl;
+			uint64_t sv;
+			const uint8_t *sd;
+			while (pb_next(payload, plen, &sat, &sf, &swt, &sv, &sd, &sdl)) {
+				if (sf == 2 && swt == 2) {
+					uint32_t uat = 0, uf, uwt, udl;
+					uint64_t uv;
+					const uint8_t *ud;
+					while (pb_next(sd, sdl, &uat, &uf, &uwt, &uv, &ud, &udl)) {
+						if (uf == 1 || uf == 2) {
+							see_suid[uf - 1] = uv;
+						}
+					}
+					break;
+				}
+			}
+			printf("SWEET SLPI: SEE <- ambient_light SUID %#llx/%#llx\n", see_suid[0], see_suid[1]);
+			if (see_suid[0] || see_suid[1]) {
+				see_send(see_suid, SEE_MSG_ON_CHANGE, NULL, 0);
+				see_state = 2;
+				printf("SWEET SLPI: SEE -> on-change config (enable the light sensor)\n");
+			}
+		} else if (msg_id == SEE_MSG_SENSOR_EVENT && payload != NULL) {
+			uint32_t sat = 0, sf, swt, sdl, idx = 0;
+			uint64_t sv;
+			const uint8_t *sd;
+			int64_t vals[4] = { 0 };
+			while (pb_next(payload, plen, &sat, &sf, &swt, &sv, &sd, &sdl)) {
+				if (sf == 1 && swt == 5 && idx < 4) {
+					vals[idx++] = see_float_milli((uint32_t)sv);
+				} else if (sf == 1 && swt == 2) {       /* packed floats */
+					for (uint32_t k = 0; k + 4 <= sdl && idx < 4; k += 4) {
+						uint32_t fb;
+						memcpy(&fb, sd + k, 4);
+						vals[idx++] = see_float_milli(fb);
+					}
+				}
+			}
+			if (idx > 0) {
+				int32_t lux = (int32_t)(vals[0] / 1000);
+				if (see_logged++ < 50 || (lux != sweet_als_lux && (see_logged % 10) == 0)) {
+					printf("SWEET SLPI: SEE <- ambient light %lld.%03lld lux (%u values, 2nd %lld.%03lld)\n",
+					    vals[0] / 1000, (vals[0] < 0 ? -vals[0] : vals[0]) % 1000, idx, vals[1] / 1000,
+					    (vals[1] < 0 ? -vals[1] : vals[1]) % 1000);
+				}
+				sweet_als_lux = lux < 0 ? 0 : lux;
+				sweet_als_time = mach_absolute_time();
+			}
+		} else if (see_logged++ < 50) {
+			printf("SWEET SLPI: SEE <- event msg %u (%u bytes)\n", msg_id, plen);
+		}
+	}
+}
+
+static void
+see_rx(const uint8_t *q, uint32_t len)
+{
+	if (len < 7) {
+		return;
+	}
+	uint16_t msg, mlen;
+	memcpy(&msg, q + 3, 2);
+	memcpy(&mlen, q + 5, 2);
+	for (uint32_t at = 7; at + 3 <= len;) {
+		uint8_t t = q[at];
+		uint16_t tl;
+		memcpy(&tl, q + at + 1, 2);
+		if (at + 3 + tl > len) {
+			break;
+		}
+		const uint8_t *v = q + at + 3;
+		if (q[0] == 2 && t == 0x02 && tl >= 4) {
+			uint16_t res, err;
+			memcpy(&res, v, 2);
+			memcpy(&err, v + 2, 2);
+			if (res || err || see_logged < 50) {
+				printf("SWEET SLPI: SEE <- response %#x result %u error %u\n", msg, res, err);
+			}
+		} else if (q[0] == 4 && t == 0x02 && tl >= 2 && (msg == SEE_IND || msg == SEE_JUMBO_IND)) {
+			uint16_t pl;
+			memcpy(&pl, v, 2);
+			if (2u + pl <= tl) {
+				see_event(v + 2, pl);
+			}
+		}
+		at += 3 + tl;
+	}
+}
+
+/* Called from the GLINK pump: start the lookup once the service is up and the PD has settled. */
+static void
+see_poll(void)
+{
+	if (see_state != 0 || see_port == 0) {
+		return;
+	}
+	uint64_t now = mach_absolute_time(), settle;
+	nanoseconds_to_absolutetime(5 * NSEC_PER_SEC, &settle);
+	if (see_start == 0) {
+		see_start = now;
+		return;
+	}
+	if (now - see_start < settle) {
+		return;
+	}
+	see_state = 1;
+	see_lookup();
+}
+
 static void
 qr_rx(const uint8_t *pkt, uint32_t len)
 {
@@ -800,6 +1121,10 @@ qr_rx(const uint8_t *pkt, uint32_t len)
 	case QR_TYPE_DEL_SERVER:
 		printf("SWEET SLPI: QRTR <- %s service %#x (%u) instance %#x at node %u port %#x\n",
 		    type == QR_TYPE_NEW_SERVER ? "NEW_SERVER" : "DEL_SERVER", c[1], c[1], c[2], c[3], c[4]);
+		if (c[1] == SEE_SERVICE && type == QR_TYPE_NEW_SERVER) {
+			see_node = c[3];
+			see_port = c[4];
+		}
 		break;
 	case QR_TYPE_NEW_LOOKUP: {
 		printf("SWEET SLPI: QRTR <- NEW_LOOKUP service %#x instance %#x from node %u port %#x\n", c[1], c[2],
@@ -816,6 +1141,8 @@ qr_rx(const uint8_t *pkt, uint32_t len)
 	case QR_TYPE_DATA:
 		if (dst_port == QR_PORT_PDM) {
 			pdm_request(src_node, src_port, p, size);
+		} else if (dst_port == SEE_PORT) {
+			see_rx(p, size);
 		} else if (qr_logged++ < 20) {
 			printf("SWEET SLPI: QRTR <- DATA %u bytes from %u:%#x to %u:%#x\n", size, src_node, src_port, dst_node,
 			    dst_port);
@@ -1024,6 +1351,7 @@ fr_invoke(uint32_t pid, uint32_t handle, uint32_t sc, struct fr_buf *in, struct
 	for (unsigned t = 0; wait_ms == 0 || t < wait_ms; t++) {   /* 0: until the reply */
 		while (gl_rx_one()) {
 		}
+		see_poll();
 		if (fr_reply && fr_reply_ctx == ctx) {
 			for (uint32_t i = 0; i < nout; i++) {
 				if (out[i].len) {
