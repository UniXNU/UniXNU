From 9a9392a3d2e57c3a057ebc1c186ad6deb6c9bcf3 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Sun, 1 Nov 2026 20:01:16 +0100
Subject: [PATCH] umi: configure both CS35L41 amps from iOS (Linux driver's
 writes replayed)

bsd/dev/sweet_cs35l41_umi.h holds the register writes the Linux driver
makes on this phone, from regmap traces in the Linux lab: per amp the I2C
probe (errata, OTP trims through the test key, mixer defaults) + the ASoC
component probe, and one stream's start/stop (48 kHz 16-bit, amp DSP
bypassed, PCM source ASP). After the reset pulse the probe replays init
(sweetampinit, default on with sweetamp=1) and reads back key registers;
sweetampplay=1 also runs start for 1 s, reads the IRQ status and stops.

On the phone: 107 / 109 init writes, none failed, read-backs equal the
Linux values; the stream start goes through but the PLL does not lock (no
I2S bit clock: the ADSP's AFE is not driving TERT_MI2S for us yet).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_adsp.c        | 71 +++++++++++++++++++++++++++++++++++++
 bsd/dev/sweet_cs35l41_umi.h | 71 +++++++++++++++++++++++++++++++++++++
 2 files changed, 142 insertions(+)
 create mode 100644 bsd/dev/sweet_cs35l41_umi.h

diff --git a/bsd/dev/sweet_adsp.c b/bsd/dev/sweet_adsp.c
index cf9f7c9..8cd21cd 100644
--- a/bsd/dev/sweet_adsp.c
+++ b/bsd/dev/sweet_adsp.c
@@ -632,6 +632,74 @@ amp_read(uint8_t addr, uint32_t reg, uint32_t *val)
 	return err;
 }
 
+static int
+amp_write(uint8_t addr, uint32_t reg, uint32_t val)
+{
+	uint8_t m[8] = { (uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg,
+		         (uint8_t)(val >> 24), (uint8_t)(val >> 16), (uint8_t)(val >> 8), (uint8_t)val };
+	return amp_msg(addr, m, 8, NULL, 0, false);
+}
+
+#include "sweet_cs35l41_umi.h"
+
+static int
+amp_replay(uint8_t addr, const uint32_t (*seq)[2], unsigned n, const char *what)
+{
+	unsigned bad = 0;
+	for (unsigned i = 0; i < n; i++) {
+		int e = amp_write(addr, seq[i][0], seq[i][1]);
+		if (e != 0 && bad++ < 4) {
+			printf("SWEET AMP: %#x %s: write %#x = %#x -> %d\n", addr, what, seq[i][0], seq[i][1], e);
+		}
+	}
+	printf("SWEET AMP: %#x %s: %u writes, %u failed\n", addr, what, n, bad);
+	return bad ? EIO : 0;
+}
+
+/* Registers whose values the Linux driver leaves behind after probe: read back to check the replay. */
+static const uint32_t amp_check[] = { 0x3808, 0x4220, 0x480c, 0x2018, 0x201c, 0x4c50, 0x4c54, 0x4c58, 0x4c5c, 0x6404 };
+
+static void
+amp_configure(uint8_t addr, bool speaker)
+{
+	uint32_t on = 1, play = 0;
+	PE_parse_boot_argn("sweetampinit", &on, sizeof(on));
+	PE_parse_boot_argn("sweetampplay", &play, sizeof(play));
+	if (!on) {
+		return;
+	}
+	if (speaker) {
+		amp_replay(addr, amp40_init, sizeof(amp40_init) / sizeof(amp40_init[0]), "init");
+	} else {
+		amp_replay(addr, amp42_init, sizeof(amp42_init) / sizeof(amp42_init[0]), "init");
+	}
+	for (unsigned i = 0; i < sizeof(amp_check) / sizeof(amp_check[0]); i++) {
+		uint32_t v = 0;
+		int e = amp_read(addr, amp_check[i], &v);
+		printf("SWEET AMP: %#x read-back %#x = %#x (err %d)\n", addr, amp_check[i], v, e);
+	}
+	if (!play) {
+		return;
+	}
+	/* the stream sequence without an I2S clock from the AFE: the PLL should report that it cannot lock */
+	if (speaker) {
+		amp_replay(addr, amp40_start, sizeof(amp40_start) / sizeof(amp40_start[0]), "stream start");
+	} else {
+		amp_replay(addr, amp42_start, sizeof(amp42_start) / sizeof(amp42_start[0]), "stream start");
+	}
+	IOSleep(1000);
+	uint32_t st[4] = { 0 };
+	for (unsigned i = 0; i < 4; i++) {
+		(void)amp_read(addr, 0x10010 + 4 * i, &st[i]);
+	}
+	printf("SWEET AMP: %#x after 1 s enabled: IRQ1 status %#x %#x %#x %#x\n", addr, st[0], st[1], st[2], st[3]);
+	if (speaker) {
+		amp_replay(addr, amp40_stop, sizeof(amp40_stop) / sizeof(amp40_stop[0]), "stream stop");
+	} else {
+		amp_replay(addr, amp42_stop, sizeof(amp42_stop) / sizeof(amp42_stop[0]), "stream stop");
+	}
+}
+
 static void
 amp_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -666,6 +734,9 @@ amp_thread(__unused void *arg, __unused wait_result_t wr)
 		printf("SWEET AMP: %#x (%s): status4 %#x (err %d) DEVID %#x (err %d) REVID %#x (err %d)%s\n", addrs[i],
 		    i ? "earpiece" : "speaker", st4, e1, devid, e2, revid, e3,
 		    (e2 == 0 && devid == 0x35a40) ? " = CS35L41" : "");
+		if (e2 == 0 && devid == 0x35a40 && revid == 0xb2) {
+			amp_configure(addrs[i], i == 0);        /* tables from rev B2 chips on this phone */
+		}
 	}
 out:
 	thread_terminate(current_thread());
