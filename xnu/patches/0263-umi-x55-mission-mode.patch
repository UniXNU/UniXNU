From ec6af6b871a49b4d7329c294c953814a8747fda5 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Mon, 9 Nov 2026 23:28:58 +0100
Subject: [PATCH] umi: X55 mission mode on the same link - AMSS 290 ms after
 Sahara, SBL MHI session kept, LOOPBACK echoed, IPCR 20/21 started; QRTR v2
 headers (sweetmdm=7) (0263)

Built and booted up to the LOOPBACK echo (0263e); the QRTR v2 parsing (0263f) is built, not booted.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_mdm.c | 473 ++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 432 insertions(+), 41 deletions(-)

diff --git a/bsd/dev/sweet_mdm.c b/bsd/dev/sweet_mdm.c
index 2f7f1af..eecbc0f 100644
--- a/bsd/dev/sweet_mdm.c
+++ b/bsd/dev/sweet_mdm.c
@@ -24,6 +24,10 @@
  *               the 512-byte stubs of the firmware partition). Big images are streamed with sweet_fat_pread.
  *               It ends when the modem says the transfer is complete (it then restarts itself and leaves the
  *               link: mission mode is the next step), on an unknown image, or after sweetmdmsecs (120).
+ *   sweetmdm=7  + mission mode: once MDM2AP status is high, PCIe2 is cycled as Android does (PERST low 15 ms, link
+ *               trained again: the modem's AMSS sets its endpoint up on that reset; facts from the OnePlus 8 Pro port),
+ *               the BAR / MSI / MHI set up again (execution environment 2), LOOPBACK 0/1 pinged, IPCR 20/21 started
+ *               and QRTR spoken (HELLO; every service the modem announces is logged) for sweetmdmqrtr seconds (30).
  * PCIe sequence as sweet_pcie.c (PCIe0, QCA6390) with the PCIe2 registers (Linux gcc-sm8250.c).
  * Built inside sweet_spmi.c (the local build cannot add source files).
  */
@@ -412,6 +416,36 @@ md_iatu(unsigned idx, uint32_t type, uint32_t base, uint32_t size, uint32_t targ
 	(void)md_poll(r, 0x04, 1u << 31, 1u << 31, 5);
 }
 
+static bool
+md_phy_init(void)
+{
+	md_wr(md.gcc, GCC_PCIE2_BCR, 1);
+	md_wr(md.gcc, GCC_PCIE2_PHY_BCR, 1);
+	delay(1000);
+	md_wr(md.gcc, GCC_PCIE2_PHY_BCR, 0);
+	md_wr(md.gcc, GCC_PCIE2_BCR, 0);
+	delay(1000);
+
+	md_wr(md.parf, PARF_DEVICE_TYPE, 4);
+	md_wr(md.parf, PARF_PHY_CTRL, md_rd(md.parf, PARF_PHY_CTRL) & ~1u);
+	md_wr(md.parf, PARF_DBI_BASE_ADDR, 0);
+	md_wr(md.parf, PARF_SYS_CTRL, 0x365e);
+	md_wr(md.parf, PARF_MHI_CLK_RST, md_rd(md.parf, PARF_MHI_CLK_RST) | (1u << 4));
+	md_wr(md.parf, PARF_PM_CTRL, md_rd(md.parf, PARF_PM_CTRL) | (1u << 5));
+	md_wr(md.parf, PARF_AXI_HALT_V2, md_rd(md.parf, PARF_AXI_HALT_V2) | (1u << 31));
+	md_wr(md.parf, PARF_SLV_ADDR_SPACE, 0x4000000);
+
+	for (unsigned i = 0; i < sizeof(mdm_phy_seq) / sizeof(mdm_phy_seq[0]); ++i) {
+		md_wr(md.phy, mdm_phy_seq[i].off, mdm_phy_seq[i].val);
+		if (mdm_phy_seq[i].delay_us) {
+			delay(mdm_phy_seq[i].delay_us);
+		}
+	}
+	bool phy_ok = md_poll(md.phy, PHY_PCS_STATUS, 1u << 6, 0, 100);
+	printf("SWEET MDM: PCIe2 PHY %s, status %#x\n", phy_ok ? "ready" : "NOT ready", md_rd(md.phy, PHY_PCS_STATUS));
+	return phy_ok;
+}
