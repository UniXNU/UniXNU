+
+/* ---- mission mode: the modem's AMSS on PCIe2, QRTR on IPCR ---- */
+
+struct mx_qhdr {
+	uint32_t version, type, src_node, src_port, confirm_rx, size, dst_node, dst_port;
+};
+#define MX_QCTRL        0xfffffffeu
+#define MX_QNODE        1u              /* we are node 1, as Android's APPS */
+
+static struct {
+	unsigned hellos, servers, data, other;
+	uint32_t node;
+	bool v2;                /* the modem speaks QRTR v2 headers (version 3, 16 bytes) on IPCR: answered the same way */
+} mq;
+
+/* QRTR v2 header (Linux qrtr.c struct qrtr_hdr_v2): version 3, type, flags (bit 0 confirm_rx), optlen, le32 size,
+   le16 src node / port, dst node / port; control port 0xfffe */
+struct mx_qhdr2 {
+	uint8_t version, type, flags, optlen;
+	uint32_t size;
+	uint16_t src_node, src_port, dst_node, dst_port;
+};
+
+static void
+mx_qsend(const uint32_t *w, unsigned nwords)
+{
+	volatile uint32_t *p = mx32(MH_TXBUF);
+	for (unsigned i = 0; i < nwords; ++i) {
+		p[i] = w[i];
+	}
+	(void)mx_send(4u * nwords);
+}
+
+/* One QRTR packet: header (v1 or v2, as the modem speaks), then the payload words. */
+static void
+mx_qpkt(uint32_t type, uint32_t src_port, uint32_t dst_node, uint32_t dst_port, bool confirm, const uint32_t *pl,
+    unsigned nwords)
+{
+	uint32_t pkt[8 + 16];
+	unsigned hw;
+	if (mq.v2) {
+		struct mx_qhdr2 h = { 3, (uint8_t)type, confirm ? 1 : 0, 0, 4u * nwords, (uint16_t)MX_QNODE,
+			              (uint16_t)src_port, (uint16_t)dst_node, (uint16_t)dst_port };
+		memcpy(pkt, &h, sizeof(h));
+		hw = 4;
+	} else {
+		uint32_t h[8] = { 1, type, MX_QNODE, src_port, confirm ? 1u : 0u, 4u * nwords, dst_node, dst_port };
+		memcpy(pkt, h, sizeof(h));
+		hw = 8;
+	}
+	for (unsigned i = 0; i < nwords && i < 16; ++i) {
+		pkt[hw + i] = pl[i];
+	}
+	mx_qsend(pkt, hw + nwords);
+}
+
+static void
+mx_qctrl(uint32_t type, uint32_t dst_node, uint32_t a, uint32_t b, uint32_t c, uint32_t d)
+{
+	uint32_t pl[5] = { type, a, b, c, d };
+	mx_qpkt(type, MX_QCTRL, dst_node, MX_QCTRL, false, pl, 5);
+}
+
+static const char *
+mx_qmi_name(uint32_t svc)
+{
+	switch (svc) {
+	case 0x00: return "CTL";
+	case 0x01: return "WDS";
+	case 0x02: return "DMS";
+	case 0x03: return "NAS";
+	case 0x05: return "WMS";
+	case 0x09: return "VOICE";
+	case 0x0b: return "UIM";
+	case 0x0c: return "PBM";
+	case 0x10: return "LOC";
+	case 0x17: return "TS";
+	case 0x18: return "TMD";
+	case 0x1a: return "WDA";
+	case 0x1e: return "SSCTL?";
+	case 0x2b: return "SSCTL";
+	case 0x2f: return "IMSA?";
+	case 0x42: return "SERVREG_NOTIF";
+	case 0x40: return "SERVREG_LOC";
+	case 0x1000: return "TFTP";
+	default: return "";
+	}
+}
+
+static void
+mx_qrx(const uint8_t *p, uint32_t len)
+{
+	struct mx_qhdr h;
+	if (len < sizeof(h)) {
+		printf("SWEET MDM: QRTR: short packet, %u bytes\n", len);
+		return;
+	}
+	size_t hl = sizeof(h);
+	if ((p[0] & 0xff) == 3) {
+		struct mx_qhdr2 h2;
+		memcpy(&h2, p, sizeof(h2));
+		if (!mq.v2) {
+			printf("SWEET MDM: QRTR: the modem speaks v2 headers: answering in v2\n");
+		}
+		mq.v2 = true;
+		h.version = 1;
+		h.type = h2.type;
+		h.confirm_rx = h2.flags & 1u;
+		h.size = h2.size;
+		h.src_node = h2.src_node == 0xffffu ? 0xffffffffu : h2.src_node;
+		h.src_port = h2.src_port >= 0xfffeu ? 0xffff0000u | h2.src_port : h2.src_port;
+		h.dst_node = h2.dst_node == 0xffffu ? 0xffffffffu : h2.dst_node;
+		h.dst_port = h2.dst_port >= 0xfffeu ? 0xffff0000u | h2.dst_port : h2.dst_port;
+		hl = sizeof(h2) + h2.optlen * 4u;
+	} else {
+		memcpy(&h, p, sizeof(h));
+	}
+	if (h.version != 1 || hl > len) {
+		printf("SWEET MDM: QRTR: header %08x (%u bytes)\n", *(const uint32_t *)p, len);
+		mq.other++;
+		return;
+	}
+	uint32_t c[5] = { 0 };
+	memcpy(c, p + hl, MIN((size_t)(len - hl), sizeof(c)));
+	switch (h.type) {
+	case 2:         /* HELLO */
+		mq.hellos++;
+		mq.node = h.src_node;
+		printf("SWEET MDM: QRTR HELLO from node %u: answered\n", h.src_node);
+		mx_qctrl(2, h.src_node, 0, 0, 0, 0);
+		break;
+	case 4:         /* NEW_SERVER: service, instance (version | instance << 8), node, port */
+		mq.servers++;
+		printf("SWEET MDM: QRTR NEW_SERVER service %#x %s version %u instance %u at node %u port %#x\n", c[1],
+		    mx_qmi_name(c[1]), c[2] & 0xff, c[2] >> 8, c[3], c[4]);
+		break;
+	case 5:
+		printf("SWEET MDM: QRTR DEL_SERVER service %#x at node %u port %#x\n", c[1], c[3], c[4]);
+		break;
+	case 10:        /* NEW_LOOKUP: a client looks for a service (the modem's TFTP client wants ours, 0x1000) */
+		printf("SWEET MDM: QRTR NEW_LOOKUP from node %u port %#x: service %#x %s instance %#x\n", h.src_node, h.src_port,
+		    c[1], mx_qmi_name(c[1]), c[2]);
+		break;
+	case 1:         /* DATA */
+		mq.data++;
+		if (mq.data <= 20) {
+			printf("SWEET MDM: QRTR DATA %u bytes from %u:%#x to port %#x%s\n", h.size, h.src_node, h.src_port, h.dst_port,
+			    h.confirm_rx ? " (confirm)" : "");
+		}
+		if (h.confirm_rx) {
+			/* RESUME_TX, 20 bytes of payload (the modem's router drops shorter ones: OnePlus port's finding) */
+			uint32_t r[5] = { 7, MX_QNODE, h.dst_port, 0, 0 };
+			mx_qpkt(7, h.dst_port, h.src_node, h.src_port, false, r, 5);
+		}
+		break;
+	default:
+		printf("SWEET MDM: QRTR type %u from %u:%#x to %u:%#x, %u bytes\n", h.type, h.src_node, h.src_port, h.dst_node,
+		    h.dst_port, h.size);
+		break;
+	}
+}
+
+/*
+ * Android's msm_pcie_disable + enable when the modem has booted: PERST held, the controller's core and PHY reset and
+ * set up again (0263b: PERST and the LTSSM enable alone left LTSSM in 0x5, pre-detect quiet), the link trained again. The link
+ * bits are only trusted once LTSSM has left L0 and come back to it (0263: right after the release they still said
+ * "up" in LTSSM 0x5 and the endpoint read all ones); then the endpoint's ID is read until it answers (the AMSS sets
+ * its endpoint up after the reset). Up to 3 cycles.
+ */
+static bool
+md_soft_cycle(void)
+{
+	for (unsigned attempt = 1; attempt <= 3; ++attempt) {
+		/* as msm_pcie_disable + msm_pcie_enable: PERST low, LTSSM off, core + PHY reset and set up again */
+		md_gpio(PERST2_PIN, 0, 1, 0, true, false);
+		md_wr(md.parf, PARF_LTSSM, md_rd(md.parf, PARF_LTSSM) & ~(1u << 8));
+		uint32_t st = md_rd(md.dbi, ELBI_SYS_STTS);
+		printf("SWEET MDM: soft cycle %u: PERST low, LTSSM %#x stts %#x\n", attempt, (st >> 12) & 0x3f, st);
+		if (!md_phy_init()) {
+			continue;
+		}
+		md_wr(md.dbi, DBI_BUSNUM, 0x00010100);
+		md_wr(md.dbi, DBI_CMD, md_rd(md.dbi, DBI_CMD) | 0x6u);
+		md_wait(100);
+		md_gpio(PERST2_PIN, 0, 1, 0, true, true);
+		md_wait(1);
+		md_wr(md.parf, PARF_LTSSM, md_rd(md.parf, PARF_LTSSM) | (1u << 8));
+		uint32_t last = ~0u;
+		bool left = false, up = false;
+		for (unsigned i = 0; i < 30000 && !up; ++i) {           /* 3 s */
+			st = md_rd(md.dbi, ELBI_SYS_STTS);
+			uint32_t l = (st >> 12) & 0x3f;
+			if (l != last) {
+				last = l;
+				printf("SWEET MDM: soft cycle %u: LTSSM %#x at %u00 us\n", attempt, l, i);
+			}
+			left = left || l != 0x11;
+			up = left && l == 0x11 && (st & (1u << 10)) && (md_rd(md.dbi, DBI_LINKCTL) & (1u << 29));
+			delay(100);
+		}
+		uint32_t ls = md_rd(md.dbi, DBI_LINKCTL);
+		printf("SWEET MDM: soft cycle %u: link %s (gen %u x%u)\n", attempt, up ? "UP" : "down", (ls >> 16) & 0xf,
+		    (ls >> 20) & 0x3f);
+		if (!up) {
+			continue;
+		}
+		for (unsigned i = 0; i < 256; ++i) {
+			md_wr(md.parf, 0x2000u + 4u * i, 0);
+		}
+		md_wr(md.parf, 0x2000u + 4u * 0x15u, 0x0100u << 16 | 1u << 8);
+		md_wr(md.dbi, DBI_BUSNUM, 0x00010100);
+		md_wr(md.dbi, DBI_CMD, md_rd(md.dbi, DBI_CMD) | 0x6u);
+		for (unsigned t = 0; t < 40; ++t) {                     /* 2 s for the endpoint to answer */
+			md_iatu(0, 4, MDM_CONF_PA, 0x1000, 1u << 24);
+			uint32_t id = md_rd(md.conf, 0x00);
+			if ((id & 0xffffu) == 0x17cbu) {
+				printf("SWEET MDM: soft cycle %u: endpoint %#x after %u ms\n", attempt, id, t * 50);
+				return true;
+			}
+			md_wait(50);
+		}
+		printf("SWEET MDM: soft cycle %u: the endpoint does not answer (%#x)\n", attempt, md_rd(md.conf, 0x00));
+	}
+	return false;
+}
+
+static int
+md_mission(void)
+{
+	/*
+	 * First on the same link: right after Sahara the modem's AMSS may show itself there (execution environment 2,
+	 * MHI READY) for a short while before it resets its PCIe side and asks for a new link (WAKE). 0263b / c: the
+	 * link was already down 2 s later, and after a full PCIe re-init the modem was back in its boot ROM.
+	 */
+	vm_offset_t bhi = md.bar0 + md_rd(md.bar0, 0x28);
+	uint32_t ee = 0, ms = 0, last_ee = ~0u, last_ms = ~0u, last_lt = ~0u, last_pins = ~0u;
+	bool same_link = false;
+	for (unsigned t = 0; t < 500; ++t) {                    /* 5 s, every 10 ms */
+		uint32_t lt = (md_rd(md.dbi, ELBI_SYS_STTS) >> 12) & 0x3f;
+		ee = md_rd(bhi, BHI_EXECENV);
+		ms = md_rd(md.bar0, MHI_STATUS);
