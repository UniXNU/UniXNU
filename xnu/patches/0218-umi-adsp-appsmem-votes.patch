-		uint32_t pd[3] = { AFE_MODULE_CLOCK_SET, AFE_PARAM_ID_CLOCK_SET, 20 };      /* param_size u16 + reserved */
-		uint32_t clk[5] = { 1, AFE_CLK_ID_TER_MI2S_IBIT, AFE_RATE * AFE_BITS * 2, 1 /* couple no, root 0 */, 1 };
-		memcpy(m, hdr, 16);
-		memcpy(m + 16, pd, 12);
-		memcpy(m + 28, clk, 20);        /* version, id, freq, attri|root, enable */
-		afe_state = 1;
-		printf("SWEET ADSP: AFE -> clock set TER_MI2S_IBIT %u Hz\n", AFE_RATE * AFE_BITS * 2);
-		afe_send(AFE_SVC_CMD_SET_PARAM, m, 16 + 12 + 20);
-		return;
-	}
-	case 1: {
+	case 0:
+		/*
+		 * First the LPASS core hardware votes Linux sends (q6afe-clocks LPASS_HW_MACRO_VOTE 3, LPASS_HW_DCODEC_VOTE 4:
+		 * AFE_CMD_REMOTE_LPASS_CORE_HW_VOTE_REQUEST {block, client_name[8]} -> 0x100f5 {status, handle}); the clock
+		 * set alone was never answered (0216-0218c), perhaps blocked on an unpowered LPASS block.
+		 */
+		if (afe_votes == 2 && !afe_probe_sent) {
+			uint16_t stop[2] = { AFE_PORT_TERT_MI2S_RX, 0 };
+			afe_probe_sent = true;
+			afe_vote_waiting = true;        /* the same wait: on its answer or after 3 s, go on */
+			printf("SWEET ADSP: AFE -> TERT_MI2S_RX stop (24-byte probe: are small port commands answered?)\n");
+			afe_send(0x000100e6, stop, 4);
+			return;
+		}
+		if (afe_votes < 2) {
+			struct __attribute__((packed)) {
+				uint32_t block;
+				char name[8];
+			} v = { afe_votes == 0 ? 3u : 4u, "SWEET" };
+			afe_votes++;
+			afe_vote_waiting = true;
+			printf("SWEET ADSP: AFE -> LPASS core hw vote, block %u\n", v.block);
+			afe_send(0x000100f4, &v, sizeof(v));
+			return;
+		}
+		{                               /* after the votes, the port's I2S config (a plain store) */
 		/* the pins first, so the clocks reach the amps once the port runs */
 		tlmm_set(TLMM_WEST, 133, 1, 0, 3, false, false);
 		tlmm_set(TLMM_WEST, 134, 1, 0, 3, false, false);
@@ -272,12 +304,39 @@ afe_next(void)
 		memcpy(m + 28, &ver, 4);
 		memcpy(m + 32, w, 8);
 		memcpy(m + 40, &rate, 4);
-		afe_state = 2;
+		afe_state = 1;
 		printf("SWEET ADSP: AFE -> TERT_MI2S_RX i2s config %u Hz, %u bit stereo on SD0, internal WS\n", AFE_RATE,
 		    AFE_BITS);
 		afe_send(AFE_PORT_CMD_SET_PARAM_V2, m, 16 + 12 + 20);
 		return;
 	}
+	case 1: {
+		/*
+		 * The bit clock. AFE_SVC_CMD_SET_PARAM (0x100f3, param data v2) went unanswered with this AFE (0x260000), so
+		 * the retries alternate with AFE_SVC_CMD_SET_PARAM_V2 (0x100fc: {payload_size, lsw, msw, handle} + param
+		 * header v3 {module, u16 instance, u16 reserved, param, u32 size}), as downstream sends on newer AFEs.
+		 */
+		uint32_t clk[5] = { 1, AFE_CLK_ID_TER_MI2S_IBIT, AFE_RATE * AFE_BITS * 2, 1 /* couple no, root 0 */, 1 };
+		bool v2 = (afe_tries & 1) == 0;
+		if (v2) {
+			uint32_t hdr[4] = { 16 + 20, 0, 0, 0 };
+			uint32_t ph[4] = { AFE_MODULE_CLOCK_SET, 0, AFE_PARAM_ID_CLOCK_SET, 20 };
+			memcpy(m, hdr, 16);
+			memcpy(m + 16, ph, 16);
+			memcpy(m + 32, clk, 20);
+		} else {
+			uint32_t hdr[4] = { 12 + 20, 0, 0, 0 };
+			uint32_t pd[3] = { AFE_MODULE_CLOCK_SET, AFE_PARAM_ID_CLOCK_SET, 20 };      /* param_size u16 + reserved */
+			memcpy(m, hdr, 16);
+			memcpy(m + 16, pd, 12);
+			memcpy(m + 28, clk, 20);        /* version, id, freq, attri|root, enable */
+		}
+		afe_state = 2;
+		printf("SWEET ADSP: AFE -> clock set TER_MI2S_IBIT %u Hz (%s)\n", AFE_RATE * AFE_BITS * 2,
+		    v2 ? "SVC_SET_PARAM_V2" : "SVC_SET_PARAM");
+		afe_send(v2 ? AFE_SVC_CMD_SET_PARAM_V2 : AFE_SVC_CMD_SET_PARAM, m, v2 ? 16 + 16 + 20 : 16 + 12 + 20);
+		return;
+	}
 	case 2: {
 		uint16_t start[2] = { AFE_PORT_TERT_MI2S_RX, 0 };
 		afe_state = 3;
@@ -295,10 +354,28 @@ afe_next(void)
 }
 
 /* An unanswered step goes out again every 3 s (8 tries), from the state before it. */
+static void
+afe_vote_answer(uint32_t opcode, uint32_t status, uint32_t handle)
+{
+	(void)opcode;
+	(void)status;
+	(void)handle;
+	if (afe_state == 0 && afe_vote_waiting) {
+		afe_vote_waiting = false;
+		afe_next();
+	}
+}
+
 static void
 afe_poll(uint32_t ms)
 {
 	afe_now_ms = ms;
+	if (afe_state == 0 && afe_vote_waiting && ms - afe_sent_ms > 3000) {
+		printf("SWEET ADSP: AFE: LPASS core hw vote %u not answered in 3 s; going on\n", afe_votes);
+		afe_vote_waiting = false;
+		afe_next();
+		return;
+	}
 	if (afe_state == 0 && apr_core_state == 2 && adsp_fr_on() && !fr_listening && apr_ready_ms != 0 &&
 	    ms - apr_ready_ms > 20000) {
 		printf("SWEET ADSP: FastRPC listener not up 20 s after core ready; AFE anyway\n");
@@ -323,10 +400,12 @@ afe_poll(uint32_t ms)
 static void
 afe_result(uint32_t opcode, uint32_t status)
 {
-	static const uint32_t want[4] = { 0, AFE_SVC_CMD_SET_PARAM, AFE_PORT_CMD_SET_PARAM_V2, AFE_PORT_CMD_DEVICE_START };
-	if (afe_state < 1 || afe_state > 3 || opcode != want[afe_state]) {
+	static const uint32_t want[4] = { 0, AFE_PORT_CMD_SET_PARAM_V2, AFE_SVC_CMD_SET_PARAM, AFE_PORT_CMD_DEVICE_START };
+	if (afe_state < 1 || afe_state > 3 ||
+	    (opcode != want[afe_state] && !(afe_state == 2 && opcode == AFE_SVC_CMD_SET_PARAM_V2))) {
 		return;
 	}
+	afe_tries = 0;
 	if (status != 0) {
 		printf("SWEET ADSP: AFE step %d (opcode %#x) FAILED, ADSP status %#x; stopping\n", afe_state, opcode, status);
 		afe_state = -1;
@@ -794,6 +873,32 @@ adsp_phys_zero(uint64_t pa, uint32_t size)
 #define PERM_RWX                7
 #define FR_SCM_OFF              0xf0000u        /* hyp-assign tables in the pool's last 64 KiB */
 
+/* qcom_scm_assign_mem HLOS -> LPASS + ADSP_HEAP (RWX): tables at the pool's last 64 KiB, 64-aligned. */
+static int
+adsp_assign(uint64_t pa, uint64_t size, const char *what)
+{
+	uint32_t base = FR_SCM_OFF;
+	for (uint32_t i = 0; i < 0x200; i += 4) {
+		fr_put32(base + i, 0);
+	}
+	fr_put32(base + 0x00, VMID_HLOS);       /* src vmids */
+	fr_put64(base + 0x40, pa);              /* mem_to_map {addr, size} */
+	fr_put64(base + 0x48, size);
+	fr_put32(base + 0x80, VMID_LPASS);      /* dest {vmid, perm, ctx, ctx_size}, 24-byte entries */
+	fr_put32(base + 0x84, PERM_RWX);
+	fr_put32(base + 0x98, VMID_ADSP_HEAP);
+	fr_put32(base + 0x9c, PERM_RWX);
+	fr_put64(base + 0x100, 4);              /* extra arguments 3..6: src_sz, dest phys, dest_sz, 0 */
+	fr_put64(base + 0x108, (uint64_t)FR_POOL_PA + base + 0x80);
+	fr_put64(base + 0x110, 2 * 24);
+	fr_put64(base + 0x118, 0);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	int a = adsp_scm("mp_assign", SCM_MP_ASSIGN, SCM_ARGS_MP_ASSIGN, (uint64_t)FR_POOL_PA + base + 0x40, 16,
+	    (uint64_t)FR_POOL_PA + base, (uint64_t)FR_POOL_PA + base + 0x100);
+	printf("SWEET ADSP: %s %#llx + %#llx hyp-assign -> LPASS, ADSP_HEAP: %d\n", what, pa, size, a);
+	return a;
+}
+
 static int
 fr_create_audio_pd(void)
 {
@@ -807,26 +912,7 @@ fr_create_audio_pd(void)
 			printf("SWEET ADSP: audio PD heap: zeroing failed\n");
 			return -1;
 		}
-		/* qcom_scm_assign_mem: src vmids, mem_to_map {addr, size}, dest {vmid, perm, ctx, ctx_size}, 64-aligned */
-		uint32_t base = FR_SCM_OFF;
-		for (uint32_t i = 0; i < 0x200; i += 4) {
-			fr_put32(base + i, 0);
-		}
-		fr_put32(base + 0x00, VMID_HLOS);
-		fr_put64(base + 0x40, FR_HEAP_PA);
-		fr_put64(base + 0x48, FR_HEAP_SIZE);
-		fr_put32(base + 0x80, VMID_LPASS);
-		fr_put32(base + 0x84, PERM_RWX);
-		fr_put32(base + 0x98, VMID_ADSP_HEAP);  /* 24-byte entries */
-		fr_put32(base + 0x9c, PERM_RWX);
-		/* extra arguments 3..6: src_sz, dest phys, dest_sz, 0 */
-		fr_put64(base + 0x100, 4);
-		fr_put64(base + 0x108, (uint64_t)FR_POOL_PA + base + 0x80);
-		fr_put64(base + 0x110, 2 * 24);
-		fr_put64(base + 0x118, 0);
-		__asm__ volatile ("dsb sy" ::: "memory");
-		int a = adsp_scm("mp_assign(audio PD heap -> LPASS, ADSP_HEAP)", SCM_MP_ASSIGN, SCM_ARGS_MP_ASSIGN,
-		    (uint64_t)FR_POOL_PA + base + 0x40, 16, (uint64_t)FR_POOL_PA + base, (uint64_t)FR_POOL_PA + base + 0x100);
+		int a = adsp_assign(FR_HEAP_PA, FR_HEAP_SIZE, "audio PD heap");
 		printf("SWEET ADSP: audio PD heap %#x + %#x hyp-assign -> %d\n", FR_HEAP_PA, FR_HEAP_SIZE, a);
 		if (a != 0) {
 			return -1;
@@ -834,11 +920,71 @@ fr_create_audio_pd(void)
 	}
 	/* createstaticpd: in {pgid, namelen, pageslen}, name, phy_page {addr, size}; method 8 on handle 1, pid 0 */
 	static const char name[] = "audiopd";
-	uint32_t inbuf[3] = { FR_TGID, sizeof(name), 0 };
+	/* pageslen 1 with a heap, as the downstream umi adsprpc.c (upstream sends 0; the heap then seemed unused, 0218b) */
+	uint32_t inbuf[3] = { FR_TGID, sizeof(name), heap ? 1u : 0u };
 	uint64_t page[2] = { FR_HEAP_PA, heap ? FR_HEAP_SIZE : 0 };
 	struct fr_buf in[3] = { { inbuf, 12 }, { (void *)(uintptr_t)name, sizeof(name) }, { page, 16 } };
 	int r = fr_invoke(0, FR_HANDLE_INIT, FR_SC(8, 3, 0), in, NULL, 5000);
 	printf("SWEET ADSP: FastRPC createstaticpd \"audiopd\" -> %d\n", r);
 	return r;
 }
+
+/*
+ * apps_mem for the audio PD (libadsprpc apps_mem_imp.c behaviour; Linux fastrpc_req_mmap): request_map64
+ * {heapid, lflags, rflags, pad, u64 vin, u64 len} -> {u64 vapps, u64 vadsp}. The memory comes from low RAM after
+ * the remote heap (0xd4c00000, 1 MiB, 16 KiB steps), is mapped into the ADSP with mmap (handle 1, method 2 as the
+ * downstream umi adsprpc.c for 64-bit callers; method 4 is its 32-bit compat call and the ADSP answered -1:
+ * {s32 pgid, u32 flags, u64 vaddr, s32 num} + {pa, size} -> {u64 vaddr}) and, for ADSP_MMAP_REMOTE_HEAP_ADDR (8),
+ * hyp-assigned like the heap. 0217f: the PD asks once for 4 KiB with rflags 8.
+ */
+#define APPS_MEM_PA             0xd4c00000u
+#define APPS_MEM_SIZE           0x100000u
+#define ADSP_MMAP_REMOTE_HEAP   8
+static uint32_t apps_mem_used;
+
+static int
+adsp_apps_mem(uint32_t method, const uint32_t *w, uint8_t *prim, struct fr_buf *out, uint32_t nout)
+{
+	if (method == 3) {                      /* request_unmap64(vadsp, len): kept mapped */
+		return 0;
+	}
+	if (method != 2 || nout < 1) {
+		printf("SWEET ADSP: apps_mem method %u not implemented\n", method);
+		return AEE_EUNSUPPORTED;
+	}
+	uint32_t rflags = w[2];
+	uint64_t len = (uint64_t)w[6] | (uint64_t)w[7] << 32;
+	uint32_t size = (uint32_t)((len + 0x3fff) & ~0x3fffull);
+	if (len == 0 || size > APPS_MEM_SIZE - apps_mem_used) {
+		printf("SWEET ADSP: apps_mem: %#llx bytes do not fit (%#x used)\n", len, apps_mem_used);
+		return AEE_EFAILED;
+	}
+	uint64_t pa = (uint64_t)APPS_MEM_PA + apps_mem_used;
+	if (!adsp_phys_zero(pa, size)) {
+		return AEE_EFAILED;
+	}
+	struct {
+		int32_t pgid;
+		uint32_t flags;
+		uint64_t vaddr;
+		int32_t num;
+		uint32_t pad;
+	} req = { FR_TGID, rflags, 0, 1, 0 };
+	uint64_t page[2] = { pa, size }, vaddr = 0;
+	struct fr_buf in[2] = { { &req, sizeof(req) }, { page, 16 } }, rsp[1] = { { &vaddr, 8 } };
+	int r = fr_invoke(0, FR_HANDLE_INIT, FR_SC(2, 2, 1), in, rsp, 5000);       /* 64-bit mmap (4 = compat: -1, 0218) */
+	printf("SWEET ADSP: apps_mem: mmap %#llx + %#x flags %#x -> %d, ADSP vaddr %#llx\n", pa, size, rflags, r, vaddr);
+	if (r != 0) {
+		return AEE_EFAILED;
+	}
+	if (rflags == ADSP_MMAP_REMOTE_HEAP && adsp_assign(pa, size, "apps_mem page") != 0) {
+		return AEE_EFAILED;
+	}
+	apps_mem_used += size;
+	uint64_t res[2] = { 0, vaddr };         /* vapps: no APPS mapping is used */
+	memcpy(prim, res, 16);
+	out[0].p = prim;
+	out[0].len = 16;
+	return 0;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
