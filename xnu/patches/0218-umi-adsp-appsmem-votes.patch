 	apr_send(APR_SVC_AFE, opcode, payload, len);
 }
@@ -241,20 +261,32 @@ afe_next(void)
 	uint8_t m[64];
 	memset(m, 0, sizeof(m));
 	switch (afe_state) {
-	case 0: {
-		/* struct afe_svc_cmd_set_param { payload_size, addr lsw, msw, mem_map_handle } + param data + afe_clk_set */
