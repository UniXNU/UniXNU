From 35bbe418c01c4db945dafc8e9cf96984d77b5a38 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Fri, 6 Nov 2026 21:00:07 +0100
Subject: [PATCH] umi: charger control - FV 4.40 V, FCC 2.0 A (0.9 A soft
 cool/warm), ICL from APSD / Type-C, QC 2.0/3.0 at 9 V (0252)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 iokit/Kernel/arm/SweetBattery.cpp | 152 ++++++++++++++++++++++++++++++
 1 file changed, 152 insertions(+)

diff --git a/iokit/Kernel/arm/SweetBattery.cpp b/iokit/Kernel/arm/SweetBattery.cpp
index 49ead8e..7cd9cff 100644
--- a/iokit/Kernel/arm/SweetBattery.cpp
+++ b/iokit/Kernel/arm/SweetBattery.cpp
@@ -17,9 +17,13 @@
 #include <IOKit/pwr_mgt/IOPMPowerSource.h>
 #include <libkern/c++/OSCollectionIterator.h>
 #include <pexpert/pexpert.h>
+#include <sys/errno.h>
 /* bsd/dev/sweet_spmi.c */
 extern "C" int sweet_spmi_init(void);
 extern "C" int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+/* bsd/dev/sweet_keys.c: PMIC access by PPID through the arbiter's EE 0 channel (apps-owned peripherals only) */
+extern "C" int sweet_pmic_read(uint16_t ppid, uint8_t reg, uint8_t *val);
+extern "C" int sweet_pmic_write(uint16_t ppid, uint8_t reg, uint8_t val);
 
 class SweetBattery : public IOPMPowerSource {
 	OSDeclareDefaultStructors(SweetBattery);
@@ -32,6 +36,10 @@ private:
 	IOWorkLoop *fLoop;
 	IOTimerEventSource *fTimer;
 	bool fTimerAdded, fRunning, fReal, fUmi, fUmiLogged;
+	/* (0252) charger control */
+	bool fChg, fChgChecked, fQc, fQc9;
+	unsigned fChgIcl, fChgFcc, fChgApsd, fChgTypec, fChgWriteFail, fChgPolls;
+	void chargerControl(bool external);
 	int fLastMode;
 	unsigned fLastState;
 	void putNumber(const char *key, UInt32 value);
@@ -59,6 +67,8 @@ SweetBattery::init(OSDictionary *dictionary)
 	fLoop = NULL;
 	fTimer = NULL;
 	fTimerAdded = fRunning = fReal = fUmi = fUmiLogged = false;
+	fChg = fChgChecked = fQc = fQc9 = false;
+	fChgIcl = fChgFcc = fChgApsd = fChgTypec = fChgWriteFail = fChgPolls = 0;
 	if (dictionary) {
 		OSCollectionIterator *it = OSCollectionIterator::withCollection(dictionary);
 		if (!it) {
@@ -217,6 +227,142 @@ SweetBattery::estimatePercent(unsigned mv)
 	return 100;
 }
 
+/*
+ * (0252) umi charger control, PM8150B SMB5 (SID 2). Under iOS nothing programmed the charger: it ran on the limits
+ * ABL left (USB 500 mA) and the phone drained while plugged in. Every poll (10 s), with USB present:
+ *  - FV  0x1070 = 4.40 V (3.6 V + 10 mV steps): Xiaomi's NON_FFC_VFLOAT, the voltage Android charges this battery to
+ *    without the charge pump; never above it.
+ *  - FCC 0x1061 = 2.0 A (50 mA steps): Android's BATT_VERIFY_VOTER for a battery it cannot authenticate (ours: no
+ *    battery-auth driver), below Xiaomi's JEITA table for 10-58 C (2808 / 6000 / 3276 mA); 0.9 A when the PMIC
+ *    reports a soft cool / warm battery (CHGR status 7 0x100d bits 4/5). The PMIC's hard hot/cold cut-off
+ *    (JEITA_EN_CFG 0x1090 bit 4, left by ABL) is not touched.
+ *  - ICL 0x1370 (50 mA steps, HC mode in 0x1366) from the hardware's charger detection (APSD 0x1308) and the
+ *    Type-C source current (0x1506): SDP 500 mA, CDP / DCP 1500, float 1000, Type-C Rp 1.5 A / 3.0 A at least 1500 /
+ *    3000, QC 2.0 / 3.0 2000 at 9 V. AICL (0x1380, on) lowers it when the source sags.
+ *  - QC: HVDCP detection on (USBIN_OPTIONS_1 0x1362 bits 2/3, as Android has them); a QC 2.0 / 3.0 charger is asked
+ *    for 9 V once per plug-in (CMD_HVDCP_2 0x1343 FORCE_9V, which QC 3.0 chargers accept too).
+ * Register map checked against Android in TWRP (2026-11-06: 0x1061 0x28 = 2.0 A, 0x1070 0x50 = 4.40 V, 0x1370 0x0a =
+ * 500 mA, 0x1308 0x01 = SDP, 0x1506 0x08 = default Rp). Refused (logged once) if FV / FCC read back implausibly.
+ * Boot-args: sweetcharger=0 leaves the charger alone, sweetqc=0 stays at 5 V.
+ */
+static int
+chg_rd(unsigned addr, uint8_t *v)
+{
+	return sweet_pmic_read((uint16_t)(0x200u | (addr >> 8)), (uint8_t)addr, v);
+}
+
+static int
+chg_wr(unsigned addr, uint8_t v)
+{
+	int r = sweet_pmic_write((uint16_t)(0x200u | (addr >> 8)), (uint8_t)addr, v);
+	uint8_t back = 0;
+	if (r == 0 && (chg_rd(addr, &back) != 0 || back != v)) {
+		r = EIO;
+	}
+	return r;
+}
+
+void
+SweetBattery::chargerControl(bool external)
+{
+	if (!fChg) {
+		if (fUmi && ++fChgPolls % 6 == 1) {
+			IOLog("SWEET CHARGER: off (sweetcharger=0 or registers did not check out)\n");
+		}
+		return;
+	}
+	uint8_t fv = 0, fcc = 0, icl = 0, opt1 = 0, iclopt = 0, allow = 0, apsd = 0, typec = 0, st7 = 0, jeita = 0, en = 0;
+	if (!fChgChecked) {
+		fChgChecked = true;
+		bool ok = !chg_rd(0x1070, &fv) && !chg_rd(0x1061, &fcc) && !chg_rd(0x1370, &icl) && !chg_rd(0x1362, &opt1) &&
+		    !chg_rd(0x1366, &iclopt) && !chg_rd(0x1360, &allow) && !chg_rd(0x1090, &jeita) && !chg_rd(0x1042, &en);
+		IOLog("SWEET CHARGER: as left by ABL: FV %#x (%u mV) FCC %#x (%u mA) ICL %#x (%u mA) usbin_opt1 %#x "
+		    "icl_opt %#x adapter_allow %#x jeita_en %#x chg_en %#x, read ok %d\n", fv, 3600 + 10u * fv, fcc, 50u * fcc,
+		    icl, 50u * icl, opt1, iclopt, allow, jeita, en, ok);
+		/* FV reads 0..119 (3.6..4.79 V) and FCC 0..160 on this PMIC; anything else: not the map we checked */
+		if (!ok || fv > 119 || fcc > 160) {
+			IOLog("SWEET CHARGER: registers do not look like PM8150B SMB5, charger left alone\n");
+			fChg = false;
+			return;
+		}
+		if ((opt1 & 0x0cu) != 0x0cu && chg_wr(0x1362, (uint8_t)(opt1 | 0x0cu)) != 0) {
+			fChgWriteFail++;
+		}
+	}
+	if (!external) {
+		if (fQc9 || fChgApsd) {
+			IOLog("SWEET CHARGER: unplugged\n");
+		}
+		fQc9 = false;
+		fChgApsd = fChgTypec = fChgIcl = 0;
+		return;
+	}
+	if (chg_rd(0x1308, &apsd) || chg_rd(0x1506, &typec) || chg_rd(0x100d, &st7) || chg_rd(0x1070, &fv) ||
+	    chg_rd(0x1061, &fcc) || chg_rd(0x1370, &icl) || chg_rd(0x1366, &iclopt)) {
+		return;
+	}
+	apsd &= 0x7fu;
+	const char *type = (apsd & 0x40u) ? "QC 3.0" : (apsd & 0x20u) ? "QC 2.0" : (apsd & 0x08u) ? "wall (DCP)" :
+	    (apsd & 0x04u) ? "computer, charging port (CDP)" : (apsd & 0x10u) ? "float" : (apsd & 0x01u) ? "computer (SDP)" :
+	    "unknown";
+	bool qc = (apsd & 0x60u) != 0;
+	unsigned wantIcl = qc ? 2000 : (apsd & 0x0cu) ? 1500 : (apsd & 0x10u) ? 1000 : 500;
+	if ((typec & 0x02u) && wantIcl < 3000) {
+		wantIcl = 3000;                 /* Type-C source advertises 3.0 A */
+	} else if ((typec & 0x04u) && wantIcl < 1500) {
+		wantIcl = 1500;                 /* 1.5 A */
+	}
+	unsigned wantFcc = (st7 & 0x3cu) ? 900 : 2000;
+	if (fv != 80 && chg_wr(0x1070, 80) != 0) {
+		fChgWriteFail++;
+	}
+	if (fcc != wantFcc / 50 && chg_wr(0x1061, (uint8_t)(wantFcc / 50)) != 0) {
+		fChgWriteFail++;
+	}
+	if ((iclopt & 0x03u) != 0x03u && chg_wr(0x1366, (uint8_t)(iclopt | 0x03u)) != 0) {
+		fChgWriteFail++;
+	}
+	if (icl != wantIcl / 50 && chg_wr(0x1370, (uint8_t)(wantIcl / 50)) != 0) {
+		fChgWriteFail++;
+	}
+	bool asked9 = false;
+	if (qc && fQc && !fQc9) {
+		fQc9 = true;
+		/* ABL leaves USBIN_ADAPTER_ALLOW 0x0c; Android runs QC with 0x07 (read in TWRP): use Android's */
+		uint8_t allow = 0;
+		if (chg_rd(0x1360, &allow) == 0 && allow != 0x07 && chg_wr(0x1360, 0x07) != 0) {
+			fChgWriteFail++;
+		}
+		asked9 = sweet_pmic_write(0x213, 0x43, 0x10) == 0;   /* CMD_HVDCP_2: FORCE_9V (a command, reads back 0) */
+	}
+	/* every minute: what the PMIC holds now (the first report comes before the USB log link is up) */
+	if (++fChgPolls % 6 == 1) {
+		uint8_t fv2 = 0, fcc2 = 0, icl2 = 0, st1 = 0, fccSt = 0;
+		uint16_t rawI = 0;
+		int ma = 0;
+		if (readWord(0x41a2, &rawI, 2)) {
+			int si = (rawI & 0x8000u) ? (int)rawI - 65536 : (int)rawI;
+			ma = (int)(-((int64_t)si * 152588) / 1000000);
+		}
+		(void)chg_rd(0x1070, &fv2);
+		(void)chg_rd(0x1061, &fcc2);
+		(void)chg_rd(0x1370, &icl2);
+		(void)chg_rd(0x1006, &st1);
+		(void)chg_rd(0x100a, &fccSt);
+		IOLog("SWEET CHARGER: status: %s, battery %+d mA, regs FV %u mV FCC %u mA (in effect %u) ICL %u mA, "
+		    "charge state %u, temp status %#x, typec %#x, %u failed writes%s\n", type, ma, 3600 + 10u * fv2, 50u * fcc2,
+		    50u * fccSt, 50u * icl2, st1 & 7u, st7, typec, fChgWriteFail, fQc9 ? ", 9 V asked" : "");
+	}
+	if (apsd != fChgApsd || typec != fChgTypec || wantIcl != fChgIcl || wantFcc != fChgFcc || asked9) {
+		IOLog("SWEET CHARGER: %s (apsd %#x, typec %#x, temp status %#x): ICL %u mA, FCC %u mA, FV 4.40 V%s, "
+		    "%u failed writes\n", type, apsd, typec, st7, wantIcl, wantFcc, asked9 ? ", 9 V asked" : "", fChgWriteFail);
+		fChgApsd = apsd;
+		fChgTypec = typec;
+		fChgIcl = wantIcl;
+		fChgFcc = wantFcc;
+	}
+}
+
 /* umi: PM8150B (SID 2). Returns false when the data is not usable (caller publishes the fallback). */
 bool
 SweetBattery::pollUmi(void)
@@ -255,6 +401,7 @@ SweetBattery::pollUmi(void)
 		iOk = false;
 	}
 	bool external = (usb & 0x10u) != 0;
+	chargerControl(external);           /* (0252) */
 	bool capable = external && (path & 0x10u) && (path & 1u) && !(path & 0x40u);
 	unsigned state = charger & 7u;
 	bool charging = capable && state >= 1 && state <= 4 && !(error & 2u) && !(temperature & 0x0cu);
@@ -331,6 +478,11 @@ SweetBattery::start(IOService *provider)
 	int real = 0;
 	(void)PE_parse_boot_argn("sweetbattery", &real, sizeof(real));
 	fUmi = real == 2;
+	uint32_t chg = 1, qc = 1;           /* (0252) */
+	(void)PE_parse_boot_argn("sweetcharger", &chg, sizeof(chg));
+	(void)PE_parse_boot_argn("sweetqc", &qc, sizeof(qc));
+	fChg = fUmi && chg != 0;
+	fQc = qc != 0;
 	fReal = (real == 1 || real == 2) && sweet_spmi_init() == 0;
 	/* Publish a complete source BEFORE registerService wakes powerd. */
 	poll();
