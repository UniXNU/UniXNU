From 2ac2b8a9377c42c1f8f101cca4a3550bef49030b Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Mon, 2 Nov 2026 22:22:32 +0100
Subject: [PATCH] umi: /dev/sweet-audio queues 480 ms, 8 ASM buffers in flight,
 pads only at the end

The audio server hands over up to 1.4 s at once: the node now queues 24
periods (480 ms) but keeps at most 8 at the ASM (with 24 it refused writes,
0x12 ENEEDMORE, which jammed the queue; a refused write now counts as done),
waits for 3 periods before an idle stream starts again, and pads a half
period only after 200 ms without data (40 ms made audible gaps). Once a
second while playing it logs frames in, periods queued and in flight.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_adsp.c | 34 ++++++++++++++++++++++++++--------
 1 file changed, 26 insertions(+), 8 deletions(-)

diff --git a/bsd/dev/sweet_adsp.c b/bsd/dev/sweet_adsp.c
index 9996b00..f5fd5b7 100644
--- a/bsd/dev/sweet_adsp.c
+++ b/bsd/dev/sweet_adsp.c
@@ -687,6 +687,9 @@ tone_rx(uint8_t svc, uint32_t opcode, const uint32_t *p)
 		if (tone_state != 9 || (p[1] != 0 && wr_logged++ < 20)) {
 			printf("SWEET ADSP: TONE <- write result %#x\n", p[1]);
 		}
+		if (tone_state == 9 && p[1] != 0) {
+			au_write_done(0);               /* refused (0x12 ENEEDMORE): no WRITE_DONE will come for it */
+		}
 		return true;
 	}
 	if (opcode != APR_BASIC_RSP_RESULT) {
@@ -722,10 +725,11 @@ tone_poll(uint32_t ms)
  *
  * The stream of the test tone (ASM session 1 -> ADM NULL COPP -> TERT_MI2S_RX), opened once the port runs and then
  * fed from userland: write() takes whole frames (S16LE stereo 48 kHz, 4 bytes) into 20 ms periods of the shared
- * buffer and never blocks; it takes at most AU_MAX_QUEUED periods ahead (160 ms) and returns what it took (EAGAIN
+ * buffer and never blocks; it takes at most AU_MAX_QUEUED periods ahead (480 ms) and returns what it took (EAGAIN
  * when nothing fit, ENXIO before the stream runs). The GLINK loop sends each full period as ASM_DATA_CMD_WRITE_V2 and
- * frees it on WRITE_DONE (in order); a period left half full for 40 ms goes out padded with silence. Without data
- * the ASM underruns: silence. ioctl SWEET_AUDIO_SET_GAIN (Q16, 0..1.0) scales the samples; SWEET_AUDIO_GET_STATS.
+ * frees it on WRITE_DONE (in order), at most AU_INFLIGHT at a time (the ASM refuses more: 0x12); with nothing in flight it waits for AU_PREFILL periods, so a sound does not start
+ * on an underrun; a period left half full for AU_PAD_MS goes out padded with silence. Without data the ASM
+ * underruns: silence. (0229 padded after 40 ms and kept 160 ms: audible gaps when the writer was late.) ioctl SWEET_AUDIO_SET_GAIN (Q16, 0..1.0) scales the samples; SWEET_AUDIO_GET_STATS.
  * The HAL plug-in (userland) opens it, as AudioServerPlugIn devices write to a driver.
  */
 #include <sys/conf.h>
@@ -735,7 +739,10 @@ tone_poll(uint32_t ms)
 
 #define AU_PERIOD_FRAMES        960u            /* 20 ms */
 #define AU_PERIODS              64u             /* 64 x 3840 bytes in TONE_SIZE */
-#define AU_MAX_QUEUED           8u
+#define AU_PAD_MS               200u            /* a half period goes out padded only at the end of a sound */
+#define AU_PREFILL              3u              /* periods ready before an idle stream starts again */
+#define AU_INFLIGHT             8u              /* ASM buffers outstanding: with 24 the ASM refused writes (0x12) */
+#define AU_MAX_QUEUED           24u             /* 480 ms: the audio server hands over up to 341 ms at once */
 struct sweet_audio_stats {
 	uint32_t ready, queued;
 	uint64_t frames_in, periods_done;
@@ -927,7 +934,8 @@ au_poll(uint32_t ms)
 	static bool playing;
 	static uint64_t frames_at_start;
 	lck_mtx_lock(&au_lock);
-	if (au_fill_pos != 0 && ms - au_last_write_ms > 40) {
+	bool stale = ms - au_last_write_ms > AU_PAD_MS;
+	if (au_fill_pos != 0 && stale) {
 		volatile uint32_t *dst = au_pcm + (au_fill % AU_PERIODS) * AU_PERIOD_FRAMES;
 		for (uint32_t i = au_fill_pos; i < AU_PERIOD_FRAMES; i++) {
 			dst[i] = 0;
@@ -935,7 +943,8 @@ au_poll(uint32_t ms)
 		au_fill++;
 		au_fill_pos = 0;
 	}
-	while (au_sent != au_fill) {
+	bool hold = au_sent == au_done && au_fill - au_sent < AU_PREFILL && !stale;
+	while (!hold && au_sent != au_fill && au_sent - au_done < AU_INFLIGHT) {
 		uint32_t idx = au_sent % AU_PERIODS;
 		uint32_t w[8] = { TONE_PA + idx * AU_PERIOD_FRAMES * 4, TONE_SID_BITS, tone_handle, AU_PERIOD_FRAMES * 4,
 			          au_sent, 0, 0, 0 };
@@ -944,12 +953,21 @@ au_poll(uint32_t ms)
 	}
 	bool now = ms - au_last_write_ms < 500 && au_frames_in != 0;
 	uint64_t in = au_frames_in;
+	uint32_t queued = au_fill - au_done, inflight = au_sent - au_done;
 	lck_mtx_unlock(&au_lock);
+	static uint32_t last_stat_ms;
+	static uint64_t last_in;
+	if (now && ms - last_stat_ms >= 1000) {
+		printf("SWEET AUDIO: t=%u ms: %llu frames in the last %u ms, %u periods queued, %u at the ADSP\n", ms,
+		    in - last_in, ms - last_stat_ms, queued, inflight);
+		last_stat_ms = ms;
+		last_in = in;
+	}
 	if (now && !playing) {
 		frames_at_start = in;
-		printf("SWEET AUDIO: playing\n");
+		printf("SWEET AUDIO: t=%u ms: playing\n", ms);
 	} else if (!now && playing) {
-		printf("SWEET AUDIO: stopped after %llu frames\n", in - frames_at_start);
+		printf("SWEET AUDIO: t=%u ms: stopped after %llu frames\n", ms, in - frames_at_start);
 	}
 	playing = now;
 }
-- 
