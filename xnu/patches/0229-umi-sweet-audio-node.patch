+/*
+ * ---- /dev/sweet-audio: iOS's sound into the ASM stream (boot-arg sweetaudio=1) ----
+ *
+ * The stream of the test tone (ASM session 1 -> ADM NULL COPP -> TERT_MI2S_RX), opened once the port runs and then
+ * fed from userland: write() takes whole frames (S16LE stereo 48 kHz, 4 bytes) into 20 ms periods of the shared
+ * buffer and never blocks; it takes at most AU_MAX_QUEUED periods ahead (160 ms) and returns what it took (EAGAIN
+ * when nothing fit, ENXIO before the stream runs). The GLINK loop sends each full period as ASM_DATA_CMD_WRITE_V2 and
+ * frees it on WRITE_DONE (in order); a period left half full for 40 ms goes out padded with silence. Without data
+ * the ASM underruns: silence. ioctl SWEET_AUDIO_SET_GAIN (Q16, 0..1.0) scales the samples; SWEET_AUDIO_GET_STATS.
+ * The HAL plug-in (userland) opens it, as AudioServerPlugIn devices write to a driver.
+ */
+#include <sys/conf.h>
+#include <sys/ioccom.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+
+#define AU_PERIOD_FRAMES        960u            /* 20 ms */
+#define AU_PERIODS              64u             /* 64 x 3840 bytes in TONE_SIZE */
+#define AU_MAX_QUEUED           8u
+struct sweet_audio_stats {
+	uint32_t ready, queued;
+	uint64_t frames_in, periods_done;
+};
+#define SWEET_AUDIO_SET_GAIN    _IOW('A', 1, int32_t)
+#define SWEET_AUDIO_GET_STATS   _IOR('A', 2, struct sweet_audio_stats)
+#define SWEET_AUDIO_LOG         _IOW('A', 3, char[120])     /* the HAL plug-in's bring-up trace into this log */
+
+static LCK_GRP_DECLARE(au_grp, "sweet_audio");
+static LCK_MTX_DECLARE(au_lock, &au_grp);
+static LCK_MTX_DECLARE(au_wlock, &au_grp);     /* one writer at a time (the bounce buffer) */
+static volatile uint32_t *au_pcm;
+static volatile bool au_ready;
+static uint32_t au_fill, au_fill_pos, au_sent, au_done; /* period counters: done <= sent <= fill */
+static uint32_t au_last_write_ms;
+static int32_t au_gain = 0x10000;
+static uint64_t au_frames_in, au_periods_done;
+static bool au_node_made;
+
+static bool
+au_service_on(void)
+{
+	uint32_t on = 0;
+	PE_parse_boot_argn("sweetaudio", &on, sizeof(on));
+	return on != 0;
+}
+
+static uint32_t
+au_scale(uint32_t w)
+{
+	int32_t l = (int16_t)(w & 0xffff), r = (int16_t)(w >> 16);
+	if (au_gain != 0x10000) {
+		l = (int32_t)(((int64_t)l * au_gain) >> 16);
+		r = (int32_t)(((int64_t)r * au_gain) >> 16);
+	}
+	return (uint32_t)(uint16_t)(int16_t)l | ((uint32_t)(uint16_t)(int16_t)r << 16);
+}
+
+static int
+au_open(__unused dev_t dev, int flags, __unused int devtype, proc_t p)
+{
+	static unsigned logged;
+	char name[32] = "?";
+	if (p != NULL) {
+		proc_name(proc_pid(p), name, sizeof(name));
+	}
+	if (logged++ < 40) {
+		printf("SWEET AUDIO: opened by %s[%d] (flags %#x)\n", name, p ? proc_pid(p) : -1, flags);
+	}
+	return 0;
+}
+
+static int
+au_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused proc_t p)
+{
+	return 0;
+}
+
+static int
+au_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	static uint32_t bounce[AU_PERIOD_FRAMES];
+	if (!au_ready) {
+		return ENXIO;
+	}
+	static bool first;
+	if (!first) {
+		first = true;
+		printf("SWEET AUDIO: first write, %lld bytes\n", (long long)uio_resid(uio));
+	}
+	user_ssize_t start = uio_resid(uio);
+	int err = 0;
+	lck_mtx_lock(&au_wlock);
+	while (uio_resid(uio) >= 4) {
+		lck_mtx_lock(&au_lock);
+		uint32_t room = au_fill - au_done >= AU_MAX_QUEUED ? 0 : AU_PERIOD_FRAMES - au_fill_pos;
+		lck_mtx_unlock(&au_lock);
+		if (room == 0) {
+			break;
+		}
+		uint32_t n = MIN(room, (uint32_t)(uio_resid(uio) / 4));
+		err = uiomove((caddr_t)bounce, (int)(n * 4), uio);
+		if (err) {
+			break;
+		}
+		lck_mtx_lock(&au_lock);
+		volatile uint32_t *dst = au_pcm + (au_fill % AU_PERIODS) * AU_PERIOD_FRAMES + au_fill_pos;
+		for (uint32_t i = 0; i < n; i++) {
+			dst[i] = au_scale(bounce[i]);           /* 32-bit stores: the buffer is device memory */
+		}
+		au_fill_pos += n;
+		au_frames_in += n;
+		au_last_write_ms = afe_now_ms;
+		if (au_fill_pos == AU_PERIOD_FRAMES) {
+			au_fill++;
+			au_fill_pos = 0;
+		}
+		lck_mtx_unlock(&au_lock);
+	}
+	lck_mtx_unlock(&au_wlock);
+	if (err == 0 && uio_resid(uio) == start && start >= 4) {
+		err = EAGAIN;
+	}
+	return err;
+}
+
+static int
+au_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused proc_t p)
+{
+	switch (cmd) {
+	case SWEET_AUDIO_SET_GAIN: {
+		int32_t g = *(int32_t *)data;
+		au_gain = g < 0 ? 0 : g > 0x10000 ? 0x10000 : g;
+		return 0;
+	}
+	case SWEET_AUDIO_GET_STATS: {
+		struct sweet_audio_stats *st = (struct sweet_audio_stats *)data;
+		lck_mtx_lock(&au_lock);
+		st->ready = au_ready;
+		st->queued = au_fill - au_done;
+		st->frames_in = au_frames_in;
+		st->periods_done = au_periods_done;
+		lck_mtx_unlock(&au_lock);
+		return 0;
+	}
+	case SWEET_AUDIO_LOG: {
+		static unsigned lines;
+		if (lines++ < 3000) {
+			printf("SWEET AUDIO HAL: %.119s\n", (const char *)data);
+		}
+		return 0;
+	}
+	default:
+		return ENOTTY;
+	}
+}
+
+static const struct cdevsw au_cdevsw = {
+	.d_open       = au_open,
+	.d_close      = au_close,
+	.d_read       = eno_rdwrt,
+	.d_write      = au_write,
+	.d_ioctl      = au_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+/* the stream runs: make the node (0666: mediaserverd runs as mobile) and take writes */
+static void
+au_begin(volatile uint32_t *pcm)
+{
+	au_pcm = pcm;
+	if (!au_node_made) {
+		int major = cdevsw_add(-1, &au_cdevsw);
+		if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666,
+		    "sweet-audio") == NULL) {
+			printf("SWEET AUDIO: /dev/sweet-audio not created (major %d)\n", major);
+			return;
+		}
+		au_node_made = true;
+	}
+	au_ready = true;
+	printf("SWEET AUDIO: /dev/sweet-audio ready: S16LE stereo 48 kHz, %u-frame periods, %u ahead\n",
+	    AU_PERIOD_FRAMES, AU_MAX_QUEUED);
+}
+
+static void
+au_write_done(__unused uint32_t addr)
+{
+	lck_mtx_lock(&au_lock);
+	if (au_done != au_sent) {
+		au_done++;
+		au_periods_done++;
+	}
+	lck_mtx_unlock(&au_lock);
+}
+
+/* GLINK loop, every 10 ms: send the full periods, pad a stale half period */
+static void
+au_poll(uint32_t ms)
+{
+	static bool playing;
+	static uint64_t frames_at_start;
+	lck_mtx_lock(&au_lock);
+	if (au_fill_pos != 0 && ms - au_last_write_ms > 40) {
+		volatile uint32_t *dst = au_pcm + (au_fill % AU_PERIODS) * AU_PERIOD_FRAMES;
+		for (uint32_t i = au_fill_pos; i < AU_PERIOD_FRAMES; i++) {
+			dst[i] = 0;
+		}
+		au_fill++;
+		au_fill_pos = 0;
+	}
+	while (au_sent != au_fill) {
+		uint32_t idx = au_sent % AU_PERIODS;
+		uint32_t w[8] = { TONE_PA + idx * AU_PERIOD_FRAMES * 4, TONE_SID_BITS, tone_handle, AU_PERIOD_FRAMES * 4,
+			          au_sent, 0, 0, 0 };
+		apr_send_port(APR_SVC_ASM, TONE_SESSION_PORT, 0x00010dab, w, 32);
+		au_sent++;
+	}
+	bool now = ms - au_last_write_ms < 500 && au_frames_in != 0;
+	uint64_t in = au_frames_in;
+	lck_mtx_unlock(&au_lock);
+	if (now && !playing) {
+		frames_at_start = in;
+		printf("SWEET AUDIO: playing\n");
+	} else if (!now && playing) {
+		printf("SWEET AUDIO: stopped after %llu frames\n", in - frames_at_start);
+	}
+	playing = now;
+}
+
 /* ---- the speaker amps: two Cirrus CS35L41 on QUP0 SE3 I2C (umi dtbo: 0x40 speaker, 0x42 earpiece) ---- */
 
 /*
@@ -960,7 +1217,7 @@ amp_configure(uint8_t addr, bool speaker)
 		int e = amp_read(addr, amp_check[i], &v);
 		printf("SWEET AMP: %#x read-back %#x = %#x (err %d)\n", addr, amp_check[i], v, e);
 	}
-	if (!play) {
+	if (!play && !au_service_on()) {
 		return;
 	}
 	/* the stream sequence; 0228: after TERT_MI2S_RX runs (its SCLK is the PLL reference), up to 20 s */
@@ -980,6 +1237,10 @@ amp_configure(uint8_t addr, bool speaker)
 		IOSleep(20);
 		amp_live = true;
 	}
+	if (au_service_on()) {
+		printf("SWEET AMP: %#x enabled for /dev/sweet-audio\n", addr);
+		return;                         /* stays on: the stream decides what plays */
+	}
 	IOSleep(1000);
 	uint32_t st[4] = { 0 };
 	for (int t = 0; t < 100 && tone_state > 0 && tone_state < 8; t++) {
-- 
