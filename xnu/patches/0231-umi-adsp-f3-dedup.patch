From f7fb7abde200fd4acc2cfb4d472aee402b4b5555 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:40:07 +0100
Subject: [PATCH] umi: ADSP F3 log keeps its last messages: repeats printed 20
 times, then every 1000th

An idle stream logs the same QShrink message every 5 ms, which used up the
old 3000-line budget long before the ADSP crash of 2026-11-03 ("SFR Init:
wdog or kernel error suspected"), so its last messages were lost. Each
hash now prints 20 times and then every 1000th with its count; the budget
is 20000 printed lines.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_adsp.c | 27 +++++++++++++++++++++++----
 1 file changed, 23 insertions(+), 4 deletions(-)

diff --git a/bsd/dev/sweet_adsp.c b/bsd/dev/sweet_adsp.c
index f5fd5b7..3fff5a4 100644
--- a/bsd/dev/sweet_adsp.c
+++ b/bsd/dev/sweet_adsp.c
@@ -1799,11 +1799,10 @@ static void
 diag_frame(const uint8_t *f, uint32_t n)
 {
 	static unsigned shown;
-	if (n < 3 || shown >= 3000) {
+	if (n < 3 || shown >= 20000) {
 		return;
 	}
 	n -= 2;                                 /* CRC */
-	shown++;
 	/*
 	 * QShrink4 terse message (0x92): {cmd, ts_type, nargs, drop, u64 ts, u16 line, u16 ssid, u32 ss_mask,
 	 * u32 hash, u32 args[nargs]}; the format string is only in the build's hash database, so hash + args.
@@ -1820,8 +1819,27 @@ diag_frame(const uint8_t *f, uint32_t n)
 		}
 		uint64_t ts;
 		memcpy(&ts, f + 4, 8);
-		printf("SWEET ADSP: F3Q %llx [%u/%#x] L%u %08x (%u): %#x %#x %#x %#x %#x %#x\n", ts >> 16, ssid, mask, line,
-		    hash, nargs, a[0], a[1], a[2], a[3], a[4], a[5]);
+		/*
+		 * The same message 20 times, then every 1000th with its count: an idle stream logs one every 5 ms, which
+		 * used up the old 3000-line budget long before the 2026-11-03 crash.
+		 */
+		static struct { uint32_t hash, count; } seen[128];
+		static unsigned nseen;
+		unsigned k;
+		for (k = 0; k < nseen && seen[k].hash != hash; k++) {
+		}
+		if (k == nseen && nseen < 128) {
+			seen[nseen].hash = hash;
+			seen[nseen].count = 0;
+			nseen++;
+		}
+		uint32_t count = k < 128 ? ++seen[k].count : 1;
+		if (count > 20 && count % 1000 != 0) {
+			return;
+		}
+		shown++;
+		printf("SWEET ADSP: F3Q x%u %llx [%u/%#x] L%u %08x (%u): %#x %#x %#x %#x %#x %#x\n", count, ts >> 16, ssid,
+		    mask, line, hash, nargs, a[0], a[1], a[2], a[3], a[4], a[5]);
 		return;
 	}
 	if (f[0] == 0x79 && n >= 20) {
@@ -1844,6 +1862,7 @@ diag_frame(const uint8_t *f, uint32_t n)
 			while (at + fl + 1 + fil < n && file[fil]) {
 				fil++;
 			}
+			shown++;
 			printf("SWEET ADSP: F3 [%u] %.*s:%u \"%.*s\" %#x %#x %#x %#x\n", ssid, (int)MIN(fil, 40u), file, line,
 			    (int)MIN(fl, 120u), fmt, a[0], a[1], a[2], a[3]);
 			return;
