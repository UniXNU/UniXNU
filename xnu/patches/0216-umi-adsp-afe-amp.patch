From 1521b3266d57636205060e41dd69bd2f25ef4338 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Sun, 1 Nov 2026 13:14:10 +0100
Subject: [PATCH] umi: ADSP AFE speaker port attempt, servreg audio PD state,
 amp probe (opt-in)

After the Q6 core is ready: AFE clock set for TER_MI2S_IBIT (1.536 MHz), the
tertiary MI2S pins, I2S config and start of TERT_MI2S_RX (0x1004), each step
waiting for the ADSP's result and resent every 3 s. A servreg notifier
listener reports msm/adsp/audio_pd (UP on the phone). The ADSP takes every
AFE packet (RX_DONE) but never answers, not even with an error.

CS35L41 probe on QUP0 SE3 (FIFO I2C, reset gpio 114, DEVID/REVID) behind
boot-arg sweetamp=1: it froze the phone in its first steps, so each hardware
step now logs and pauses (sweetampstepms) to find which access hangs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_adsp.c | 539 ++++++++++++++++++++++++++++++++++++++++++-
 bsd/dev/sweet_slpi.c |  18 ++
 2 files changed, 556 insertions(+), 1 deletion(-)

diff --git a/bsd/dev/sweet_adsp.c b/bsd/dev/sweet_adsp.c
index 7cc82e8..14e5479 100644
--- a/bsd/dev/sweet_adsp.c
+++ b/bsd/dev/sweet_adsp.c
@@ -44,6 +44,7 @@
 #define APR_DOMAIN_ADSP         4
 #define APR_DOMAIN_APPS         5
 #define APR_SVC_CORE            3
+#define APR_SVC_AFE             4
 #define APR_BASIC_RSP_RESULT    0x000110e8
 #define AVCS_GET_VERSIONS       0x00012905
 #define AVCS_GET_VERSIONS_RSP   0x00012906
@@ -51,6 +52,10 @@
 #define AVCS_GET_STATE_RSP      0x0001290d
 
 static int apr_core_state;                      /* 0 asking, 1 ready (versions asked), 2 done */
+static void afe_next(void);
+static void afe_result(uint32_t opcode, uint32_t status);
+static void afe_poll(uint32_t ms);
+static void amp_start(void);
 static uint32_t apr_asked_ms, apr_token = 1;
 static unsigned apr_logged;
 
@@ -113,12 +118,17 @@ apr_rx(const uint8_t *m, uint32_t len)
 			printf("SWEET ADSP: APR    service %#x version %#x\n", sv[0], sv[1]);
 		}
 		apr_core_state = 2;
+		afe_next();
+		amp_start();                    /* independent of the AFE (whose answers did not come, 0216b) */
 		return;
 	}
 	case APR_BASIC_RSP_RESULT:
 		printf("SWEET ADSP: APR <- result for opcode %#x: %#x (svc %u token %u)\n", p[0], p[1], m[4], token);
-		if (p[0] == AVCS_GET_VERSIONS && apr_core_state == 1) {
+		if (m[4] == APR_SVC_AFE) {
+			afe_result(p[0], p[1]);
+		} else if (p[0] == AVCS_GET_VERSIONS && apr_core_state == 1) {
 			apr_core_state = 2;
+			afe_next();
 		}
 		return;
 	default:
@@ -141,6 +151,7 @@ apr_poll(uint32_t ms)
 		printf("SWEET ADSP: GLINK: the ADSP has not opened \"apr_audio_svc\" in 5 s; opening it\n");
 		gl_open(GL_LCID_RPC);
 	}
+	afe_poll(ms);
 	if (apr_core_state != 0 || !gl_ch[GL_LCID_RPC - 1].acked || ms - apr_asked_ms < 1000) {
 		return;
 	}
@@ -153,4 +164,530 @@ apr_poll(uint32_t ms)
 		apr_send(APR_SVC_CORE, AVCS_GET_STATE, NULL, 0);
 	}
 }
+
+/* ---- AFE: the speaker's audio port (Linux q6afe.c; downstream kona: TERT_MI2S_RX feeds the amps) ---- */
+
+#define AFE_PORT_CMD_DEVICE_START       0x000100e5
+#define AFE_PORT_CMD_SET_PARAM_V2       0x000100ef
+#define AFE_SVC_CMD_SET_PARAM           0x000100f3
+#define AFE_MODULE_AUDIO_DEV_INTERFACE  0x0001020c
+#define AFE_PARAM_ID_I2S_CONFIG         0x0001020d
+#define AFE_MODULE_CLOCK_SET            0x0001028f
+#define AFE_PARAM_ID_CLOCK_SET          0x00010290
+#define AFE_PORT_TERT_MI2S_RX           0x1004
+#define AFE_CLK_ID_TER_MI2S_IBIT        0x104
+#define AFE_RATE                        48000u
+#define AFE_BITS                        16u     /* 2 x 16-bit slots: SCLK 1.536 MHz, a CS35L41 PLL reference */
+
+static int afe_state;                           /* 0 idle, 1 clock, 2 i2s config, 3 start, 4 running, -1 failed */
+static uint32_t afe_now_ms, afe_sent_ms;        /* GLINK loop time; when the pending step went out */
+static unsigned afe_tries;
+static bool audio_pd_up;                        /* servreg: msm/adsp/audio_pd is up */
+
+/* MI2S2 = tertiary: gpio 133 sck, 134 data0, 135 ws (pinctrl-sm8250.c function 1; dt tert_mi2s_*: 8 mA) */
+#define TLMM_WEST                       0x0f100000ull
+#define TLMM_NORTH                      0x0f900000ull
+
+static volatile uint32_t *
+tlmm_pin(uint64_t tile, unsigned pin)
+{
+	uint64_t pa = tile + 0x1000ull * pin;
+	vm_offset_t va = sweet_dsp_io_map((vm_offset_t)(pa & ~0x3fffull), 0x4000);
+	return va == 0 ? NULL : (volatile uint32_t *)(va + (pa & 0x3fff));
+}
+
+/* cfg: pull [1:0] (3 up), function [5:2], drive [8:6] (mA / 2 - 1), output enable bit 9; io bit 1 = out level */
+static void
+tlmm_set(uint64_t tile, unsigned pin, unsigned func, unsigned pull, unsigned drive, bool out, bool high)
+{
+	volatile uint32_t *r = tlmm_pin(tile, pin);
+	if (r == NULL) {
+		return;
+	}
+	if (out) {
+		r[1] = (r[1] & ~2u) | (high ? 2u : 0u);
+	}
+	r[0] = (r[0] & ~0x3ffu) | (func << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+afe_send(uint32_t opcode, const void *payload, uint16_t len)
+{
+	afe_sent_ms = afe_now_ms;
+	apr_send(APR_SVC_AFE, opcode, payload, len);
+}
+
+static void
+afe_next(void)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn(SL_ARG "afe", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	uint8_t m[64];
+	memset(m, 0, sizeof(m));
+	switch (afe_state) {
+	case 0: {
+		/* struct afe_svc_cmd_set_param { payload_size, addr lsw, msw, mem_map_handle } + param data + afe_clk_set */
+		uint32_t hdr[4] = { 12 + 20, 0, 0, 0 };
+		uint32_t pd[3] = { AFE_MODULE_CLOCK_SET, AFE_PARAM_ID_CLOCK_SET, 20 };      /* param_size u16 + reserved */
+		uint32_t clk[5] = { 1, AFE_CLK_ID_TER_MI2S_IBIT, AFE_RATE * AFE_BITS * 2, 1 /* couple no, root 0 */, 1 };
+		memcpy(m, hdr, 16);
+		memcpy(m + 16, pd, 12);
+		memcpy(m + 28, clk, 20);        /* version, id, freq, attri|root, enable */
+		afe_state = 1;
+		printf("SWEET ADSP: AFE -> clock set TER_MI2S_IBIT %u Hz\n", AFE_RATE * AFE_BITS * 2);
+		afe_send(AFE_SVC_CMD_SET_PARAM, m, 16 + 12 + 20);
+		return;
+	}
+	case 1: {
+		/* the pins first, so the clocks reach the amps once the port runs */
+		tlmm_set(TLMM_WEST, 133, 1, 0, 3, false, false);
+		tlmm_set(TLMM_WEST, 134, 1, 0, 3, false, false);
+		tlmm_set(TLMM_WEST, 135, 1, 0, 3, false, false);
+		volatile uint32_t *r = tlmm_pin(TLMM_WEST, 133);
+		printf("SWEET ADSP: TLMM gpio 133-135 -> mi2s2 (cfg %#x)\n", r ? r[0] : 0);
+		/* struct afe_port_cmd_set_param_v2 { u16 port, u16 payload_size, lsw, msw, handle } + param data + i2s cfg */
+		uint16_t port[2] = { AFE_PORT_TERT_MI2S_RX, 12 + 20 };
+		uint32_t pd[3] = { AFE_MODULE_AUDIO_DEV_INTERFACE, AFE_PARAM_ID_I2S_CONFIG, 20 };
+		/* afe_param_id_i2s_cfg: version 1, bit_width, channel_mode SD0, mono_stereo STEREO, ws_src INTERNAL, rate, format */
+		uint32_t ver = 1, rate = AFE_RATE;
+		uint16_t w[4] = { AFE_BITS, 1, 1, 1 };
+		memcpy(m, port, 4);
+		memcpy(m + 16, pd, 12);
+		memcpy(m + 28, &ver, 4);
+		memcpy(m + 32, w, 8);
+		memcpy(m + 40, &rate, 4);
+		afe_state = 2;
+		printf("SWEET ADSP: AFE -> TERT_MI2S_RX i2s config %u Hz, %u bit stereo on SD0, internal WS\n", AFE_RATE,
+		    AFE_BITS);
+		afe_send(AFE_PORT_CMD_SET_PARAM_V2, m, 16 + 12 + 20);
+		return;
+	}
+	case 2: {
+		uint16_t start[2] = { AFE_PORT_TERT_MI2S_RX, 0 };
+		afe_state = 3;
+		printf("SWEET ADSP: AFE -> TERT_MI2S_RX start\n");
+		afe_send(AFE_PORT_CMD_DEVICE_START, start, 4);
+		return;
+	}
+	case 3:
+		afe_state = 4;
+		printf("SWEET ADSP: AFE: TERT_MI2S_RX RUNNING (zeros until a stream feeds it)\n");
+		return;
+	default:
+		return;
+	}
+}
+
+/* An unanswered step goes out again every 3 s (8 tries), from the state before it. */
+static void
+afe_poll(uint32_t ms)
+{
+	afe_now_ms = ms;
+	if (afe_state < 1 || afe_state > 3 || ms - afe_sent_ms < 3000) {
+		return;
+	}
+	if (afe_tries++ >= 8) {
+		printf("SWEET ADSP: AFE step %d: no answer after %u tries (audio PD %s); giving up\n", afe_state, afe_tries,
+		    audio_pd_up ? "up" : "not up");
+		afe_state = -1;
+		return;
+	}
+	printf("SWEET ADSP: AFE step %d: no answer in 3 s (audio PD %s); sending it again\n", afe_state,
+	    audio_pd_up ? "up" : "not up");
+	afe_state--;
+	afe_next();
+}
+
+static void
+afe_result(uint32_t opcode, uint32_t status)
+{
+	static const uint32_t want[4] = { 0, AFE_SVC_CMD_SET_PARAM, AFE_PORT_CMD_SET_PARAM_V2, AFE_PORT_CMD_DEVICE_START };
+	if (afe_state < 1 || afe_state > 3 || opcode != want[afe_state]) {
+		return;
+	}
+	if (status != 0) {
+		printf("SWEET ADSP: AFE step %d (opcode %#x) FAILED, ADSP status %#x; stopping\n", afe_state, opcode, status);
+		afe_state = -1;
+		return;
+	}
+	afe_next();
+}
+
+/* ---- the speaker amps: two Cirrus CS35L41 on QUP0 SE3 I2C (umi dtbo: 0x40 speaker, 0x42 earpiece) ---- */
+
+/*
+ * Read-only probe: SE3 clocks (gcc-sm8250.c wrap0: m/s-ahb, core, core2x, s3 = vote bits 6-9, 13), pins 119/120
+ * function qup3, FIFO-mode GENI I2C as sweet_touch.c (needs the SE's I2C firmware with its FIFO interface on;
+ * GSI-only would need the GPI of QUP0, 0x900000), shared reset gpio 114 pulsed, then each amp's OTP boot done,
+ * DEVID (0x35a40) and REVID (Linux cs35l41_probe). The amps are not configured: no sound.
+ */
+#define GCC_PA                  0x00100000ull
+#define AMP_SE_PA               0x0098c000ull
+#define AMP_RCG                 0x173a0u        /* gcc_qupv3_wrap0_s3_clk_src */
+#define AMP_PIN_RESET           114
+#define SE_FW                   0x068u
+#define SE_IFDIS                0x064u
+#define SE_STATUS               0x040u
+#define SE_CMD                  0x600u
+#define SE_IRQ                  0x610u
+#define SE_IRQ_EN               0x614u
+#define SE_IRQ_CLR              0x618u
+#define SE_TX                   0x700u
+#define SE_RX                   0x780u
+#define SE_TX_COUNT             0x800u
+#define SE_RX_COUNT             0x804u
+#define SE_TX_WM                0x80cu
+#define SE_HW_TX                0xe24u
+#define SE_HW_RX                0xe28u
+#define SE_TX_LEN               0x26cu
+#define SE_RX_LEN               0x270u
+#define SE_DONE                 (1u << 0)
+#define SE_NACK                 (1u << 10)
+#define SE_ERRORS               (0x3eu | (1u << 9) | (1u << 10) | (1u << 12))
+#define SE_TX_WM_IRQ            (1u << 30)
+
+static volatile uint8_t *amp_se;
+
+/* One line per hardware step, then a pause: a bus hang loses the last ~2 s of log (0216c froze here unseen). */
+static void
+amp_step(const char *what)
+{
+	uint32_t ms = 1000;
+	PE_parse_boot_argn("sweetampstepms", &ms, sizeof(ms));
+	printf("SWEET AMP: step: %s\n", what);
+	IOSleep(ms);
+}
+
+static uint32_t
+se_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(amp_se + off);
+}
+
+static void
+se_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(amp_se + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static volatile uint32_t *
+gcc_reg(uint32_t off)
+{
+	uint64_t pa = GCC_PA + off;
+	vm_offset_t va = sweet_dsp_io_map((vm_offset_t)(pa & ~0x3fffull), 0x4000);
+	return va == 0 ? NULL : (volatile uint32_t *)(va + (pa & 0x3fff));
+}
+
+static bool
+amp_clocks(uint32_t *level)
+{
+	amp_step("map GCC");
+	volatile uint32_t *vote = gcc_reg(0x52008), *rcg = gcc_reg(AMP_RCG);
+	if (vote == NULL || rcg == NULL) {
+		return false;
+	}
+	printf("SWEET AMP: GCC vote reg %#x\n", *vote);
+	amp_step("GCC vote wrap0 + s3");
+	*vote |= (0xfu << 6) | (1u << 13);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	IOSleep(1);
+	amp_step("GCC branch check");
+	static const uint32_t branches[] = { 0x17004, 0x17008, 0x23000, 0x23008, 0x1739c };
+	for (unsigned i = 0; i < 5; i++) {
+		volatile uint32_t *b = gcc_reg(branches[i]);
+		if (b != NULL && !(*b & 2u) && (*b & (1u << 31))) {
+			printf("SWEET AMP: GCC branch %#x still off (%#x)\n", branches[i], *b);
+			return false;
+		}
+	}
+	uint32_t dfs = rcg[0x14 / 4];
+	*level = 0;
+	if (dfs & 1u) {                         /* DFS: the first XO/1 level (19.2 MHz, the SCL timing below) */
+		*level = 8;
+		for (uint32_t l = 0; l < 8; l++) {
+			if ((rcg[(0x1c + 4 * l) / 4] & 0x371fu) == 1u) {
+				*level = l;
+				break;
+			}
+		}
+		if (*level == 8) {
+			printf("SWEET AMP: no XO/1 DFS level\n");
+			return false;
+		}
+	} else {
+		rcg[1] = (rcg[1] & ~(0x371fu | (1u << 20))) | 1u;
+		rcg[0] |= 1u;
+		for (int i = 0; i < 1000 && (rcg[0] & 1u); i++) {
+			delay(1);
+		}
+	}
+	printf("SWEET AMP: GCC vote %#x, s3 rcg dfs %#x, level %u\n", *vote, dfs, *level);
+	return true;
+}
+
+static bool
+amp_se_init(uint32_t level)
+{
+	amp_step("map SE3");
+	amp_se = (volatile uint8_t *)sweet_dsp_io_map((vm_offset_t)AMP_SE_PA, 0x4000);
+	if (amp_se == NULL) {
+		return false;
+	}
+	amp_step("first SE3 register read");
+	uint32_t fw = se_rd(SE_FW), tx = se_rd(SE_HW_TX), rx = se_rd(SE_HW_RX);
+	printf("SWEET AMP: SE3 fw %#x proto %u if-disable %#x status %#x tx %#x rx %#x\n", fw, (fw >> 8) & 0xff,
+	    se_rd(SE_IFDIS), se_rd(SE_STATUS), tx, rx);
+	if (((fw >> 8) & 0xffu) != 3u || (se_rd(SE_IFDIS) & 1u) || ((tx >> 24) & 0x3fu) != 32u ||
+	    ((rx >> 24) & 0x3fu) != 32u || ((tx >> 16) & 0x3fu) < 2u) {
+		printf("SWEET AMP: SE3 has no FIFO-mode I2C (GSI only?); probe skipped\n");
+		return false;
+	}
+	se_wr(0xe18, 0);
+	se_wr(0xe1c, 0);
+	se_wr(0x644, 0);
+	se_wr(SE_IRQ_CLR, 0xffffffffu);
+	se_wr(0x648, 0xffffffffu);
+	se_wr(0x258, 0);                        /* FIFO mode, no SE DMA */
+	se_wr(0x28, se_rd(0x28) | 0x7fu);
+	se_wr(0xe30, se_rd(0xe30) | 0x0fu);
+	se_wr(0x24, 0x7f);
+	se_wr(0x20, 1);
+	se_wr(0x07c, level);
+	se_wr(0x048, (7u << 4) | 1u);
+	se_wr(0x278, (10u << 20) | (11u << 10) | 26u); /* 100 kHz */
+	se_wr(0x254, 0);
+	se_wr(0x260, 0x0007f8feu);              /* 8-bit packing, MSB first on the wire */
+	se_wr(0x264, 0x000ffefeu);
+	se_wr(0x284, 0x0007f8feu);
+	se_wr(0x288, 0x000ffefeu);
+	se_wr(SE_TX_WM, 0);
+	se_wr(0x810, 0);
+	se_wr(0x814, ((rx >> 16) & 0x3fu) - 1u);
+	se_wr(SE_IRQ_EN, SE_DONE | SE_ERRORS | SE_TX_WM_IRQ | (3u << 26));
+	return true;
+}
+
+/* One message: a write of up to 8 bytes (stretch: keep the bus for a repeated start) or a read of up to 8. */
+static int
+amp_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	if (nt > 8 || nr > 8 || (nt && nr) || (se_rd(SE_STATUS) & 1u)) {
+		return EIO;
+	}
+	se_wr(SE_IRQ_CLR, 0xffffffffu);
+	se_wr(SE_TX_WM, nt ? 1u : 0u);
+	se_wr(nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	se_wr(SE_CMD, ((nr ? 2u : 1u) << 27) | ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	unsigned sent = 0, got = 0;
+	for (int i = 0; i < 2000; i++) {
+		uint32_t irq = se_rd(SE_IRQ);
+		if (nt && !sent && (irq & SE_TX_WM_IRQ)) {
+			for (unsigned w = 0; w < nt; w += 4) {
+				uint32_t word = 0;
+				for (unsigned j = 0; j < 4 && w + j < nt; j++) {
+					word |= (uint32_t)tx[w + j] << (8 * j);
+				}
+				se_wr(SE_TX, word);
+			}
+			sent = nt;
+			se_wr(SE_TX_WM, 0);
+		}
+		for (uint32_t c = se_rd(SE_RX_COUNT) & 0x1ffffffu; c > 0 && c <= 4; c--) {
+			uint32_t word = se_rd(SE_RX);
+			for (unsigned j = 0; j < 4 && got < nr; j++) {
+				rx[got++] = (uint8_t)(word >> (8 * j));
+			}
+		}
+		if (irq & (SE_DONE | SE_ERRORS)) {
+			se_wr(SE_IRQ_CLR, irq);
+			if (irq & SE_ERRORS) {
+				return (irq & SE_NACK) ? ENXIO : EIO;
+			}
+			return (sent == nt && got == nr) ? 0 : EIO;
+		}
+		delay(10);
+	}
+	se_wr(0x604, 2);                        /* abort the command, release the bus */
+	IOSleep(5);
+	se_wr(SE_IRQ_CLR, 0xffffffffu);
+	return ETIMEDOUT;
+}
+
+/* CS35L41 register read: 32-bit address and value, big-endian (regmap reg_bits 32, val_bits 32). */
+static int
+amp_read(uint8_t addr, uint32_t reg, uint32_t *val)
+{
+	uint8_t a[4] = { (uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg }, v[4];
+	int err = amp_msg(addr, a, 4, NULL, 0, true);
+	if (!err) {
+		err = amp_msg(addr, NULL, 0, v, 4, false);
+	}
+	if (!err) {
+		*val = (uint32_t)v[0] << 24 | (uint32_t)v[1] << 16 | (uint32_t)v[2] << 8 | v[3];
+	}
+	return err;
+}
+
+static void
+amp_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t level = 0;
+	amp_step("map + read TLMM gpio 114");
+	volatile uint32_t *rst = tlmm_pin(TLMM_NORTH, AMP_PIN_RESET);
+	printf("SWEET AMP: reset gpio %u cfg %#x io %#x\n", AMP_PIN_RESET, rst ? rst[0] : 0, rst ? rst[1] : 0);
+	if (rst == NULL || !amp_clocks(&level) || !amp_se_init(level)) {
+		goto out;
+	}
+	amp_step("pins 119/120 qup3, reset pulse");
+	tlmm_set(TLMM_NORTH, 119, 1, 3, 0, false, false);       /* qup3 SDA / SCL, pull-up, 2 mA */
+	tlmm_set(TLMM_NORTH, 120, 1, 3, 0, false, false);
+	tlmm_set(TLMM_NORTH, AMP_PIN_RESET, 0, 0, 0, true, false);      /* reset: low >= 2 ms, then high */
+	IOSleep(3);
+	tlmm_set(TLMM_NORTH, AMP_PIN_RESET, 0, 0, 0, true, true);
+	IOSleep(3);
+	amp_step("I2C reads");
+	static const uint8_t addrs[2] = { 0x40, 0x42 };
+	for (unsigned i = 0; i < 2; i++) {
+		uint32_t st4 = 0, devid = 0, revid = 0;
+		int e1 = ETIMEDOUT;
+		for (int t = 0; t < 100; t++) {         /* OTP_BOOT_DONE (IRQ1_STATUS4 bit 1), up to 100 ms */
+			e1 = amp_read(addrs[i], 0x1001c, &st4);
+			if (e1 == 0 && (st4 & 2u)) {
+				break;
+			}
+			IOSleep(1);
+		}
+		int e2 = amp_read(addrs[i], 0x0, &devid);
+		int e3 = amp_read(addrs[i], 0x4, &revid);
+		printf("SWEET AMP: %#x (%s): status4 %#x (err %d) DEVID %#x (err %d) REVID %#x (err %d)%s\n", addrs[i],
+		    i ? "earpiece" : "speaker", st4, e1, devid, e2, revid, e3,
+		    (e2 == 0 && devid == 0x35a40) ? " = CS35L41" : "");
+	}
+out:
+	thread_terminate(current_thread());
+}
+
+static void
+amp_start(void)
+{
+	uint32_t on = 0;                        /* opt-in: the probe froze the phone in 0216c (step unknown) */
+	PE_parse_boot_argn("sweetamp", &on, sizeof(on));
+	thread_t thread;
+	if (on && kernel_thread_start(amp_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* ---- servreg notifier: is the audio PD up? (Linux qcom_pdr_msg.c / pdr_interface.c) ---- */
+
+/*
+ * The AFE, ASM and ADM services live in the ADSP's audio protection domain
+ * (msm/adsp/audio_pd, instance 74), not in its root PD where the core answered.
+ * Linux registers a listener at the ADSP's servreg notifier (QMI 0x42) and waits
+ * for SERVREG_SERVICE_STATE_UP before using them. Request 0x20 {0x01 enable u8,
+ * 0x02 service path string}, response 0x20 {0x02 result, 0x10 current state};
+ * indication 0x22 {0x01 state, 0x02 path, 0x03 transaction id}, acked with 0x23
+ * {0x01 path, 0x02 transaction id}. States: 0x1fffffff up, 0x0fffffff down,
+ * 0x2fffffff early down, 0x7fffffff uninit.
+ */
+#define SERVREG_NOTIFIER        0x42
+#define SERVREG_REGISTER        0x20
+#define SERVREG_STATE_IND       0x22
+#define SERVREG_SET_ACK         0x23
+#define SERVREG_UP              0x1fffffffu
+static const char audio_pd[] = "msm/adsp/audio_pd";
+static uint16_t servreg_txn = 1;
+
+static const char *
+servreg_state_name(uint32_t st)
+{
+	return st == SERVREG_UP ? "UP" : st == 0x0fffffffu ? "down" : st == 0x2fffffffu ? "early down" :
+	       st == 0x7fffffffu ? "uninit" : "?";
+}
+
+static void
+servreg_send(uint32_t node, uint32_t port, uint16_t msg, const uint8_t *tlvs, uint16_t tlen)
+{
+	uint8_t q[160];
+	if (tlen + 7 > sizeof(q)) {
+		return;
+	}
+	uint16_t txn = servreg_txn++;
+	q[0] = 0;                               /* request */
+	memcpy(q + 1, &txn, 2);
+	memcpy(q + 3, &msg, 2);
+	memcpy(q + 5, &tlen, 2);
+	memcpy(q + 7, tlvs, tlen);
+	qr_send(QR_TYPE_DATA, SERVREG_PORT, node, port, q, 7u + tlen);
+}
+
+static void
+servreg_found(uint32_t service, uint32_t instance, uint32_t node, uint32_t port)
+{
+	if (service != SERVREG_NOTIFIER || (instance >> 8) != 74) {
+		return;
+	}
+	uint8_t t[96];
+	uint8_t on = 1;
+	uint32_t at = qmi_tlv(t, 0, 0x01, &on, 1);
+	at = qmi_tlv(t, at, 0x02, audio_pd, (uint16_t)strlen(audio_pd));       /* top-level string: no length byte */
+	printf("SWEET ADSP: servreg -> register listener \"%s\" at node %u port %#x\n", audio_pd, node, port);
+	servreg_send(node, port, SERVREG_REGISTER, t, (uint16_t)at);
+}
+
+static void
+servreg_rx(uint32_t node, uint32_t port, const uint8_t *q, uint32_t len)
+{
+	if (len < 7) {
+		return;
+	}
+	uint16_t msg, mlen;
+	memcpy(&msg, q + 3, 2);
+	memcpy(&mlen, q + 5, 2);
+	uint32_t state = 0, have_state = 0;
+	uint16_t res[2] = { 0, 0 }, txid = 0;
+	char path[66] = { 0 };
+	for (uint32_t at = 7; at + 3 <= len && at + 3 <= 7u + mlen;) {
+		uint16_t tl;
+		memcpy(&tl, q + at + 1, 2);
+		const uint8_t *v = q + at + 3;
+		if (at + 3 + tl > len) {
+			break;
+		}
+		if (msg == SERVREG_REGISTER && q[at] == 0x02 && tl >= 4) {
+			memcpy(res, v, 4);
+		} else if ((msg == SERVREG_REGISTER && q[at] == 0x10 && tl >= 4) ||
+		    (msg == SERVREG_STATE_IND && q[at] == 0x01 && tl >= 4)) {
+			memcpy(&state, v, 4);
+			have_state = 1;
+		} else if (msg == SERVREG_STATE_IND && q[at] == 0x02) {
+			memcpy(path, v, MIN(64u, (uint32_t)tl));
+		} else if (msg == SERVREG_STATE_IND && q[at] == 0x03 && tl >= 2) {
+			memcpy(&txid, v, 2);
+		}
+		at += 3 + tl;
+	}
+	if (msg == SERVREG_REGISTER) {
+		printf("SWEET ADSP: servreg <- register: result %u error %u, %s is %s (%#x)\n", res[0], res[1], audio_pd,
+		    have_state ? servreg_state_name(state) : "(no state)", state);
+	} else if (msg == SERVREG_STATE_IND) {
+		printf("SWEET ADSP: servreg <- \"%s\" is now %s (%#x), transaction %u; ack\n", path,
+		    servreg_state_name(state), state, txid);
+		uint8_t t[96];
+		uint32_t at = qmi_tlv(t, 0, 0x01, path, (uint16_t)strlen(path));
+		at = qmi_tlv(t, at, 0x02, &txid, 2);
+		servreg_send(node, port, SERVREG_SET_ACK, t, (uint16_t)at);
+	} else {
+		printf("SWEET ADSP: servreg <- msg %#x, %u bytes\n", msg, len);
+		return;
+	}
+	if (have_state) {
+		audio_pd_up = state == SERVREG_UP;
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
