+
+/* QMI message to the WLFW service, from our client port. */
+int
+sweet_ipcr_send(const void *qmi, uint32_t len)
+{
+	static uint8_t pkt[TX_LEN];
+	if (!ip.wlfw_node || len + 32 > TX_LEN) {
+		return EINVAL;
+	}
+	uint32_t h[8] = { 1, 1, 1, WLFW_PORT, 1, len, ip.wlfw_node, ip.wlfw_port };
+	memcpy(pkt, h, sizeof(h));
+	memcpy(pkt + sizeof(h), qmi, len);
+	return ip_send(pkt, (uint32_t)((sizeof(h) + len + 3) & ~3u));
+}
+
+/* Poll for ms milliseconds, handling every packet that arrives. */
+void
+sweet_ipcr_service(unsigned ms)
+{
+	for (unsigned t = 0; t <= ms; ++t) {
+		er1_poll();
+		while (ip.rxq_head != ip.rxq_tail) {
+			unsigned q = ip.rxq_head % RXQ_N;
+			ip.rxq_head++;
+			q_rx(rxq[q], rxq_len[q]);
+		}
+		if (t < ms) {
+			delay(1000);
+		}
+	}
+}
