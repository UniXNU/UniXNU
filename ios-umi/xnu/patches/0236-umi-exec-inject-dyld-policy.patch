From e277964ee911f94f52c5d9c0b4d822985a35a735 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:13:09 +0100
Subject: [PATCH] umi: kern.exec_inject (boot-arg sweetinject) and dyld's AMFI
 policy question for those programs

kern.exec_inject "LIBRARY NAME..." (from the parked research/exec-inject-wip.diff): a named program
starts with DYLD_INSERT_LIBRARIES=LIBRARY, which launchd would drop from a job. The "AMFI" interface
policy answers dyld's op 0x5a (amfi_check_dyld_policy_self) "everything allowed" only for programs
kern.exec_inject names; every other program keeps ENOPOLICY, as before. For libsweet-bt.dylib in
bluetoothd and BlueTool: boot 0236-btinject, bluetoothd's stack STACK_READY, manager state 5.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/kern/kern_exec.c  | 133 ++++++++++++++++++++++++++++++++++++++++++
 bsd/kern/sweet_amfi.c |  25 ++++++++
 2 files changed, 158 insertions(+)

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index c49f15e..e8529d4 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5595,6 +5595,122 @@ bad:
  * Note:	The argument and environment vectors are user space pointers
  *		to arrays of user space pointers.
  */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET (after topaz 0919 / darwin-redwood kern.exec_inject): the sysctl kern.exec_inject
+ * holds "LIBRARY NAME NAME ..." (groups separated by ";"); a program whose file name is one
+ * of the NAMEs starts with DYLD_INSERT_LIBRARIES=LIBRARY (several joined with ":"). The NAME
+ * "*" matches every program except launchd (pid 1), which is how a jailbreak's tweak loader
+ * reaches apps and daemons. launchd drops DYLD_ variables from job descriptions, so the
+ * kernel adds this one. Starts from the boot-arg sweetinject (commas instead of spaces).
+ */
+static char exec_inject_conf[512];
+static int exec_inject_loaded;
+SYSCTL_STRING(_kern, OID_AUTO, exec_inject, CTLFLAG_RW | CTLFLAG_LOCKED, exec_inject_conf, sizeof(exec_inject_conf),
+    "LIBRARY NAME... [; LIBRARY NAME...]: programs started with the library inserted");
+
+static bool
+exec_inject_env(struct image_params *imgp, char *env, size_t size)
+{
+	const char *name, *p;
+	size_t namelen, used;
+	bool any = false, init;
+
+	if (!exec_inject_loaded) {
+		char arg[sizeof(exec_inject_conf)];
+		if (exec_inject_conf[0] == 0 && PE_parse_boot_argn("sweetinject", arg, sizeof(arg))) {
+			for (char *c = arg; *c != 0; c++) {
+				if (*c == ',') {
+					*c = ' ';
+				}
+			}
+			strlcpy(exec_inject_conf, arg, sizeof(exec_inject_conf));
+		}
+		exec_inject_loaded = 1;
+	}
+	p = exec_inject_conf;
+	if (*p == 0 || imgp->ip_ndp == NULL) {
+		return false;
+	}
+	init = proc_pid(vfs_context_proc(imgp->ip_vfs_context)) == 1;
+	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	namelen = imgp->ip_ndp->ni_cnd.cn_namelen;
+	used = strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+	while (*p != 0) {
+		const char *library;
+		size_t liblen;
+		bool matched = false;
+
+		while (*p == ' ' || *p == ';') {
+			p++;
+		}
+		library = p;
+		while (*p != 0 && *p != ' ' && *p != ';') {
+			p++;
+		}
+		liblen = (size_t)(p - library);
+		while (*p == ' ') {
+			const char *word = ++p;
+			while (*p != 0 && *p != ' ' && *p != ';') {
+				p++;
+			}
+			if (!matched && p - word == 1 && *word == '*' && !init) {
+				matched = true;
+			}
+			if (!matched && (size_t)(p - word) == namelen && namelen != 0 && liblen != 0 &&
+			    strncmp(word, name, namelen) == 0) {
+				matched = true;
+			}
+		}
+		if (matched && liblen != 0 && used + 1 + liblen < size) {
+			if (any) {
+				env[used++] = ':';
+			}
+			memcpy(env + used, library, liblen);
+			used += liblen;
+			env[used] = 0;
+			any = true;
+		}
+	}
+	return any;
+}
+
+/*
+ * Whether kern.exec_inject names the program `name` (sweet_amfi.c: dyld's policy question is
+ * answered "allow" only for those, so every other program keeps dyld's restricted defaults).
+ */
+bool sweet_exec_inject_names(const char *name);
+
+bool
+sweet_exec_inject_names(const char *name)
+{
+	const char *p = exec_inject_conf;
+	size_t namelen = strlen(name);
+
+	if (!exec_inject_loaded || namelen == 0) {
+		return false;
+	}
+	while (*p != 0) {
+		while (*p == ' ' || *p == ';') {
+			p++;
+		}
+		while (*p != 0 && *p != ' ' && *p != ';') {
+			p++;                    /* the library */
+		}
+		while (*p == ' ') {
+			const char *word = ++p;
+			while (*p != 0 && *p != ' ' && *p != ';') {
+				p++;
+			}
+			if ((size_t)(p - word) == namelen && strncmp(word, name, namelen) == 0) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 __attribute__((noinline))
 static int
 exec_extract_strings(struct image_params *imgp)
@@ -5768,6 +5884,23 @@ exec_extract_strings(struct image_params *imgp)
 		imgp->ip_envc++;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* SWEET: one more variable for the programs that get a library (see exec_inject_env) */
+	char inject_env[512];
+	if (exec_inject_env(imgp, inject_env, sizeof(inject_env))) {
+		error = exec_add_user_string(imgp, CAST_USER_ADDR_T(inject_env), UIO_SYSSPACE, TRUE);
+		if (error) {
+			goto bad;
+		}
+		if (imgp->ip_argspace < new_ptr_size) {
+			error = E2BIG;
+			goto bad;
+		}
+		imgp->ip_argspace -= new_ptr_size;
+		imgp->ip_envc++;
+	}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 	/* Save space for envv[] NULL terminator */
 	if (imgp->ip_argspace < new_ptr_size) {
 		error = E2BIG;
diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 30d4bf1..d243b75 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -371,6 +371,15 @@ static mac_policy_handle_t sweet_sandbox_mac_handle;
  * keeps ENOPOLICY. The first use of each op is logged. Boot-arg sweetamfistate=0 removes the answer.
  */
 #define SWEET_AMFI_OP_BOOTARG_STATE 0x60
+/*
+ * Op 0x5a, amfi_check_dyld_policy_self: dyld asks what it may do for the process it starts
+ * ({ u64 flags in, user pointer to u64 flags out }). Without an answer it runs restricted and
+ * ignores DYLD_INSERT_LIBRARIES. Answered "everything allowed" (0xff) only for the programs
+ * kern.exec_inject names (kern_exec.c, boot-arg sweetinject), so a library reaches those alone.
+ */
+#define SWEET_AMFI_OP_DYLD_POLICY   0x5a
+#define SWEET_AMFI_DYLD_ALLOW_ALL   0xffULL
+extern bool sweet_exec_inject_names(const char *name);
 static uint64_t sweet_amfi_state = 0x86;
 static uint64_t sweet_amfi_ops_seen[4];
 
@@ -387,6 +396,22 @@ sweet_amfi_syscall(struct proc *p, int call, user_addr_t arg)
 	if (call == SWEET_AMFI_OP_BOOTARG_STATE && sweet_amfi_state != 0) {
 		return copyout(&sweet_amfi_state, arg, sizeof(sweet_amfi_state));
 	}
+	if (call == SWEET_AMFI_OP_DYLD_POLICY) {
+		char name[32];
+		uint64_t in_out[2] = { 0, 0 }, allow = SWEET_AMFI_DYLD_ALLOW_ALL;
+		int error;
+
+		proc_name(proc_pid(p), name, sizeof(name));
+		if (!sweet_exec_inject_names(name)) {
+			return ENOPOLICY;
+		}
+		error = copyin(arg, in_out, sizeof(in_out));
+		if (error == 0) {
+			error = copyout(&allow, (user_addr_t)in_out[1], sizeof(allow));
+		}
+		printf("SWEET AMFI: dyld policy for %s: everything allowed (kern.exec_inject) -> %d\n", name, error);
+		return error;
+	}
 	return ENOPOLICY;
 }
 
-- 
2.54.0 (Apple Git-157)

