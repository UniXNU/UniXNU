+	{ 0x0050, 0x07, 0 },
+	{ 0x0010, 0x01, 0 },
+	{ 0x001c, 0x31, 0 },
+	{ 0x0020, 0x01, 0 },
+	{ 0x0024, 0xde, 0 },
