+/*
+ * umi (Mi 10, SM8250) PCIe0 root complex and the QCA6390 Wi-Fi chip behind it.
+ * Stage 1 (sweetwlan=1): power the chip (WLAN_EN, GPIO 20), bring PCIe0 up the
+ * way msm-4.19 pci-msm does (GDSC, GCC clocks, PARF, the DT qcom,phy-sequence,
+ * PERST, LTSSM) and read the endpoint's ID through an iATU config window.
+ * Nothing here runs unless the boot-arg asks for it.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern bool sweet_board_is_umi(void);
+void sweet_pcie_init(void);
+
+#define PCIE_GCC_PA      0x00100000u
+#define PCIE_GCC_SIZE    0x000a0000u
+#define PCIE_NORTH_PA    0x0f900000u     /* TLMM north tile: GPIO 20, 79-81, 124 */
+#define PCIE_NORTH_SIZE  0x0007d000u
+#define PCIE_PARF_PA     0x01c00000u
+#define PCIE_PHY_PA      0x01c06000u
+#define PCIE_DBI_PA      0x60000000u
+#define PCIE_ELBI_PA     0x60000f20u
+#define PCIE_IATU_PA     0x60001000u
+#define PCIE_CONF_PA     0x60100000u
+
+/* gcc-kona / gcc-sm8250 */
+#define GCC_PCIE0_BCR        0x6b000u
+#define GCC_PCIE0_GDSCR      0x6b004u
+#define GCC_PCIE0_AUX_RCG    0x6b038u
+#define GCC_PCIE0_PHY_BCR    0x6c01cu
+#define GCC_REFGEN_RCG       0x6f014u
+#define GCC_REFGEN_CBCR      0x6f02cu
+#define GCC_WIFI_CLKREF      0x8c004u
+#define GCC_PCIE_VOTE        0x52008u    /* slv-axi 0, mstr-axi 1, cfg-ahb 2, aux 3, pipe 4, slv-q2a 5 */
+#define GCC_PCIE_VOTE_MASK   0x3fu
+#define GCC_AGGRE_TBU_CBCR   0x9000cu
+#define GCC_DDRSS_TBU_CBCR   0x8d058u
+
+#define PARF_SYS_CTRL        0x000u
+#define PARF_PM_CTRL         0x020u
+#define PARF_PHY_CTRL        0x040u
+#define PARF_DBI_BASE_ADDR   0x168u
+#define PARF_MHI_CLK_RST     0x174u
+#define PARF_AXI_HALT_V2     0x1a8u
+#define PARF_LTSSM           0x1b0u
+#define PARF_SLV_ADDR_SPACE  0x358u
+#define PARF_DEVICE_TYPE     0x1000u
+
+#define PHY_PCS_STATUS       0x814u      /* DT qcom,phy-status-offset, bit 6 = PHY not ready */
+
+#define DBI_CMD              0x004u
+#define DBI_BUSNUM           0x018u
+#define DBI_LINKCTL          0x080u      /* PCIe cap link control/status: bit 29 DLL active */
+#define DBI_RO_WR_EN         0x8bcu
+
+#define WLAN_EN_PIN          20u
+#define PERST_PIN            79u
+#define CLKREQ_PIN           80u
+#define WAKE_PIN             81u
+#define SW_CTRL_PIN          124u
+
+struct pcie_phy_step {
+	uint16_t off;
+	uint8_t val;
+	uint8_t delay_us;
+};
+
+/* umi DT pcie0 qcom,phy-sequence (offset, value, delay) */
+static const struct pcie_phy_step pcie_phy_seq[] = {
+	{ 0x0840, 0x03, 0 },
+	{ 0x0094, 0x08, 0 },
+	{ 0x0154, 0x34, 0 },
