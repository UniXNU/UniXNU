+	{ 0x0030, 0x4c, 0 },
+	{ 0x0034, 0x06, 0 },
+	{ 0x029c, 0x12, 0 },
+	{ 0x0284, 0x35, 0 },
+	{ 0x023c, 0x11, 0 },
+	{ 0x051c, 0x03, 0 },
+	{ 0x0518, 0x1c, 0 },
+	{ 0x0524, 0x1e, 0 },
+	{ 0x04e8, 0x00, 0 },
+	{ 0x04ec, 0x0e, 0 },
+	{ 0x04f0, 0x4a, 0 },
+	{ 0x04f4, 0x0f, 0 },
+	{ 0x05b4, 0x04, 0 },
+	{ 0x0434, 0x7f, 0 },
