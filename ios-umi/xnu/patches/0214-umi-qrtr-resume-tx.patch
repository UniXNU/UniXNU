From ae83c901fc1889a51431d24d6427bef4615b315d Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Sat, 31 Oct 2026 22:45:58 +0100
Subject: [PATCH 2/2] umi: QRTR RESUME_TX that the SLPI accepts

The SLPI's IPC router stops sending after 10 unacknowledged packets and sets
confirm_rx on the 5th. RESUME_TX must come from the receiving port and be a
full 20-byte control packet (struct qrtr_ctrl_pkt), as af_qrtr.c sends it;
the 12-byte one from the control port was ignored, so the light sensor went
quiet after its first 6 readings.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_slpi.c | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/sweet_slpi.c b/bsd/dev/sweet_slpi.c
index 06b92b9..70f71a9 100644
--- a/bsd/dev/sweet_slpi.c
+++ b/bsd/dev/sweet_slpi.c
@@ -1160,9 +1160,18 @@ qr_rx(const uint8_t *pkt, uint32_t len)
 		break;
 	}
 	if (confirm && type == QR_TYPE_DATA) {
-		uint32_t a[2] = { dst_node, dst_port };         /* af_qrtr.c qrtr_send_resume_tx */
-		uint32_t pk[3] = { QR_TYPE_RESUME_TX, a[0], a[1] };
-		qr_send(QR_TYPE_RESUME_TX, QR_PORT_CTRL, src_node, src_port, pk, 12);
+		/*
+		 * af_qrtr.c qrtr_send_resume_tx: sent from the receiving port (not the control
+		 * port) to the sender's port, as a full 20-byte control packet (struct
+		 * qrtr_ctrl_pkt; a 12-byte one is ignored); without it the sender stops after its
+		 * flow-control window (10 packets).
+		 */
+		static uint32_t confirms;
+		uint32_t pk[5] = { QR_TYPE_RESUME_TX, dst_node, dst_port, 0, 0 };
+		if (confirms++ < 5) {
+			printf("SWEET SLPI: QRTR <- confirm_rx from %u:%#x to port %#x; RESUME_TX\n", src_node, src_port, dst_port);
+		}
+		qr_send(QR_TYPE_RESUME_TX, dst_port, src_node, src_port, pk, 20);
 	}
 }
 
