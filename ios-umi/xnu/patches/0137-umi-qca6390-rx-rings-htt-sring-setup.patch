+		return 13 + r;          /* 14 no HTC READY ... 21 WMI READY, 22-25 hw mode / chan list / vdev / scan send, 26 no scan start, 27 no scan end, 28 HTT version, 29 country, 30 RX rings */
 	}
 	sweet_ipcr_service(500);        /* log whatever QMI says after that */
 	return 0;
