From 2c71453a1499fabc1d1136d01641799487aaf85a Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Tue, 10 Nov 2026 18:10:17 +0100
Subject: [PATCH] umi: X55 /readwrite RAM store for its TFTP writes, modem
 restart when DMS stays shutting down (at most 2) (0266)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_mdm.c | 135 ++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 123 insertions(+), 12 deletions(-)

diff --git a/bsd/dev/sweet_mdm.c b/bsd/dev/sweet_mdm.c
index 127bdf4..8b4ed11 100644
--- a/bsd/dev/sweet_mdm.c
+++ b/bsd/dev/sweet_mdm.c
@@ -33,7 +33,9 @@
  *               (again every 10 s). sweetmdmonline=1 also asks DMS for operating mode online (the radio transmits
  *               and registers with the SIM's network); default off. sweetmdmqrtr defaults to 90 s here.
  *               Also a TFTP server for the modem (QRTR service 0x1000, port 0x4002): reads from the FAT modem
- *               partition, writes acknowledged and discarded; DMS's offline reason is logged.
+ *               partition; /readwrite files kept in RAM for this phone boot (never written to the phone); DMS's
+ *               offline reason is logged. When DMS stays "shutting down" (two polls, ~10 s) the modem is restarted
+ *               (PMX55 warm reset, PCIe2 re-init, BHI, Sahara, mission), at most twice per phone boot.
  * PCIe sequence as sweet_pcie.c (PCIe0, QCA6390) with the PCIe2 registers (Linux gcc-sm8250.c).
  * Built inside sweet_spmi.c (the local build cannot add source files).
  */
@@ -542,9 +544,11 @@ md_sbl1(void)
 	if (!a || !b) {
 		return 11;
 	}
-	md.pool_pa = MDM_POOL_PA;
-	(void)PE_parse_boot_argn("sweetmdmpool", &md.pool_pa, sizeof(md.pool_pa));
-	md.pool = ml_io_map_unmappable(md.pool_pa, MDM_POOL_SIZE, 0x6u);    /* VM_WIMG_WCOMB */
+	if (md.pool == 0) {                     /* once per phone boot (the modem may be restarted) */
+		md.pool_pa = MDM_POOL_PA;
+		(void)PE_parse_boot_argn("sweetmdmpool", &md.pool_pa, sizeof(md.pool_pa));
+		md.pool = ml_io_map_unmappable(md.pool_pa, MDM_POOL_SIZE, 0x6u);    /* VM_WIMG_WCOMB */
+	}
 	if (md.pool == 0) {
 		return 12;
 	}
@@ -1059,8 +1063,8 @@ static struct {
 	uint32_t node;
 	uint32_t svc_node[0x60], svc_port[0x60];   /* where each QMI service (< 0x60) is */
 	uint16_t txn;
-	bool asked, online_asked;
-	unsigned answers;
+	bool asked, online_asked, restart_wanted;
+	unsigned answers, opmode, opmode5;
 	bool v2;                /* the modem speaks QRTR v2 headers (version 3, 16 bytes) on IPCR: answered the same way */
 } mq;
 
@@ -1151,10 +1155,48 @@ static void mx_qmi_rx(uint32_t node, uint32_t port, const uint8_t *m, uint32_t l
 
 static struct {
 	bool used, writing;
+	int store;                      /* RAM store slot (/readwrite), -1: the FAT */
 	uint32_t node, port;
 	uint32_t block, blksize, base, size, written;
 	char dir[96], name[64];
 } mt[8];
+/*
+ * The modem's /readwrite files, kept in RAM for this phone boot (across modem restarts), never written to the phone.
+ * 0265: with its writes thrown away, the modem wrote /readwrite/mcfg.tmp and then waited in "shutting down".
+ */
+#define MT_STORE_N      32u
+#define MT_STORE_MAX    0x80000u        /* 512 KiB a file */
+static struct {
+	char path[96];
+	uint8_t *data;
+	uint32_t len;
+} mts[MT_STORE_N];
+
+static int
+mts_find(const char *path, bool create)
+{
+	for (unsigned i = 0; i < MT_STORE_N; ++i) {
+		if (mts[i].data != NULL && strcmp(mts[i].path, path) == 0) {
+			return (int)i;
+		}
+	}
+	if (!create) {
+		return -1;
+	}
+	for (unsigned i = 0; i < MT_STORE_N; ++i) {
+		if (mts[i].data == NULL) {
+			mts[i].data = kalloc_data(MT_STORE_MAX, Z_WAITOK | Z_ZERO);
+			if (mts[i].data == NULL) {
+				return -1;
+			}
+			strlcpy(mts[i].path, path, sizeof(mts[i].path));
+			mts[i].len = 0;
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
 static unsigned mt_logged;
 
 static void
@@ -1198,7 +1240,9 @@ mt_data(unsigned s)
 	if (off < mt[s].size) {
 		n = MIN(mt[s].size - off, mt[s].blksize);
 		uint32_t fsz = 0;
-		if (sweet_fat_pread("modem", mt[s].dir, mt[s].name, mt[s].base + off, blk + 4, n, &fsz) != 0) {
+		if (mt[s].store >= 0) {
+			memcpy(blk + 4, mts[mt[s].store].data + mt[s].base + off, n);
+		} else if (sweet_fat_pread("modem", mt[s].dir, mt[s].name, mt[s].base + off, blk + 4, n, &fsz) != 0) {
 			mt_error(mt[s].node, mt[s].port, 2, "read failed");
 			mt[s].used = false;
 			return;
@@ -1282,8 +1326,30 @@ mt_rx(uint32_t node, uint32_t port, const uint8_t *p, uint32_t len)
 		mt[s].port = port;
 		mt[s].blksize = blksize;
 		mt[s].writing = op == 2;
+		mt[s].store = -1;
 		uint32_t fsz = 0;
-		if (op == 1) {
+		bool rw = strncmp(path, "/readwrite/", 11) == 0;
+		if (op == 2) {
+			mt[s].store = rw ? mts_find(path, true) : -1;
+			if (mt[s].store >= 0) {
+				mts[mt[s].store].len = 0;
+			}
+		} else if (rw) {
+			mt[s].store = mts_find(path, false);
+			if (mt[s].store < 0) {
+				if (mt_logged < 80) {
+					printf("SWEET MDM: TFTP \"%s\": not found\n", path);
+				}
+				mt_error(node, port, 1, "File not found");
+				return;
+			}
+			fsz = mts[mt[s].store].len;
+			seek = MIN(seek, fsz);
+			mt[s].base = seek;
+			mt[s].size = MIN(fsz - seek, rsize);
+			printf("SWEET MDM: TFTP \"%s\": %u bytes from RAM\n", path, mt[s].size);
+		}
+		if (op == 1 && !rw) {
 			const char *rest = NULL;
 			if (strncmp(path, "/readonly/firmware/", 19) == 0) {
 				rest = path + 19;
@@ -1350,11 +1416,24 @@ mt_rx(uint32_t node, uint32_t port, const uint8_t *p, uint32_t len)
 		mt_data(s);
 	} else if (op == 3 && mt[s].writing && len >= 4) {
 		uint8_t a[4] = { 0, 4, p[2], p[3] };
-		mt[s].written += len - 4;
+		uint32_t blk = (uint32_t)(p[2] << 8 | p[3]), n = len - 4;
+		int st = mt[s].store;
+		if (st >= 0 && blk >= 1) {
+			uint32_t at = (blk - 1) * mt[s].blksize;
+			if (at + n <= MT_STORE_MAX) {
+				memcpy(mts[st].data + at, p + 4, n);
+				mts[st].len = MAX(mts[st].len, at + n);
+			}
+		}
+		mt[s].written += n;
 		mt_reply(node, port, a, 4);
-		if (len - 4 < mt[s].blksize) {
+		if (n < mt[s].blksize) {
 			if (mt_logged++ < 80) {
-				printf("SWEET MDM: TFTP write done: %u bytes (discarded)\n", mt[s].written);
+				if (st >= 0) {
+					printf("SWEET MDM: TFTP write done: \"%s\" %u bytes (kept in RAM)\n", mts[st].path, mts[st].len);
+				} else {
+					printf("SWEET MDM: TFTP write done: %u bytes (discarded)\n", mt[s].written);
+				}
 			}
 			mt[s].used = false;
 		}
@@ -1568,6 +1647,11 @@ mx_qmi_rx(uint32_t node, uint32_t port, const uint8_t *m, uint32_t len)
 		printf("SWEET MDM: DMS revision: %.*s\n", (int)MIN(tl, (uint16_t)120), (const char *)v);
 	} else if (svc == 0x02 && msg == 0x2d && (v = mx_tlv(m, len, 0x01, &tl)) != NULL && tl >= 1) {
 		printf("SWEET MDM: DMS operating mode: %u (%s)\n", v[0], mx_opmode(v[0]));
+		mq.opmode = v[0];
+		mq.opmode5 = v[0] == 5 ? mq.opmode5 + 1 : 0;
+		if (mq.opmode5 >= 2) {
+			mq.restart_wanted = true;
+		}
 		const uint8_t *w;
 		if ((w = mx_tlv(m, len, 0x10, &tl)) != NULL && tl >= 2) {
 			unsigned rsn = w[0] | w[1] << 8;
@@ -1820,10 +1904,11 @@ md_mission(void)
 	}
 	printf("SWEET MDM: IPCR channels %u/%u running: QRTR HELLO sent\n", MX_IPCR_OUT, MX_IPCR_IN);
 	bzero(&mq, sizeof(mq));
+	bzero(mt, sizeof(mt));                  /* TFTP sessions of a previous modem run */
 	mx_qctrl(2, 0xffffffffu, 0, 0, 0, 0);
 	unsigned secs = md.stage >= 8 ? 90 : 30;
 	(void)PE_parse_boot_argn("sweetmdmqrtr", &secs, sizeof(secs));
-	for (unsigned t = 0; t < secs * 1000u && !mx.gone; ++t) {
+	for (unsigned t = 0; t < secs * 1000u && !mx.gone && !mq.restart_wanted; ++t) {
 		mx_er0();
 		mx_er1();
 		while (mx_rxq_head != mx_rxq_tail) {
@@ -1846,12 +1931,38 @@ md_mission(void)
 	}
 	printf("SWEET MDM: mission: %u hellos, %u services announced, %u data packets, %u QMI answers%s\n", mq.hellos,
 	    mq.servers, mq.data, mq.answers, mx.gone ? " (the modem went away)" : "");
+	static unsigned restarts;
+	if (mq.restart_wanted && restarts < 2) {
+		restarts++;
+		unsigned files = 0;
+		for (unsigned i = 0; i < MT_STORE_N; ++i) {
+			if (mts[i].data != NULL) {
+				printf("SWEET MDM: RAM store: \"%s\" %u bytes\n", mts[i].path, mts[i].len);
+				files++;
+			}
+		}
+		printf("SWEET MDM: the modem stays in \"shutting down\": RESTART %u (PMX55 warm reset, PCIe2, BHI, Sahara, mission; "
+		    "%u /readwrite file(s) kept)\n", restarts, files);
+		md_gpio(AP2MDM_STATUS, 0, 0, 7, true, false);
+		(void)md_warm_reset();
+		md_wait(150);
+		md_gpio(AP2MDM_STATUS, 0, 0, 7, true, true);
+		if (!md_soft_cycle()) {
+			return 36;
+		}
+		if (md_bar0() != 0) {
+			return 37;
+		}
+		return md_sbl1();
+	}
 	return mq.servers ? 0 : 35;
 }
 
 static int
 md_sahara(void)
 {
+	mx.gone = false;                        /* (again after a modem restart) */
+	mx_rxq_head = mx_rxq_tail = 0;
 	int r = mhi_init(false);
 	if (r) {
 		return r;
-- 
2.54.0 (Apple Git-157)

