 	/* direct frames cost one cache clean: every vsync; copied frames every fFlushTicks */
-	bool flush = fb->fDirty && ((fb->fDirect && fb->fLastDirect) || (count % fb->fFlushTicks) == 0);
+	bool flush = !gpuHold && fb->fDirty && ((fb->fDirect && fb->fLastDirect) || (count % fb->fFlushTicks) == 0);
 	uint8_t *rec = NULL;
 	SweetSurface *taken[SWEET_FB_LAYERS] = {}, *retire[SWEET_FB_LAYERS];
 	if (flush) {
@@ -741,6 +753,77 @@ AppleCLCD::scanBoot()
