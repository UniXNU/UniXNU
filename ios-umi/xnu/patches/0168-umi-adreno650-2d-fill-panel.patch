 }
 
+/* Clean and invalidate the data cache to the point of coherency (memory the GPU writes). */
+static void
+sweet_dcache_flush(uintptr_t va, uint64_t len)
+{
+	uint64_t ctr;
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r"(ctr));
+	uint64_t line = 4ull << ((ctr >> 16) & 0xf);
+	for (uintptr_t p = va & ~(line - 1); p < va + len; p += line) {
+		__asm__ volatile ("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * For the GPU bring-up (bsd/dev/sweet_adreno.c step 22): the boot framebuffer's place and
+ * size, cleaned out of the CPU's caches (so no dirty line lands on what the GPU writes), and
+ * from the next vsync on shown alone on the panel for hold_ms at most: no frames presented,
+ * direct scanout pointed back at it. sweet_fb_gpu_show() sets how long it stays once drawn.
+ * Afterwards the latest frame is shown again.
+ */
+extern "C" bool
+sweet_fb_gpu_begin(uint64_t *phys, uint32_t *width, uint32_t *height, uint32_t *row_bytes, uint32_t hold_ms)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	uint64_t hold;
+
+	if (fb == NULL || fb->fPowerOff) {
+		return false;
+	}
+	*phys = fb->fPhys;
+	*width = fb->fWidth;
+	*height = fb->fHeight;
+	*row_bytes = fb->fRowBytes;
+	sweet_dcache_flush(fb->fPixels, (uint64_t)fb->fRowBytes * fb->fHeight);
+	nanoseconds_to_absolutetime((uint64_t)hold_ms * NSEC_PER_MSEC, &hold);
+	IOLockLock(fb->fLock);
+	fb->fGpuHoldUntil = mach_absolute_time() + hold;
+	IOLockUnlock(fb->fLock);
+	return true;
+}
+
+/* The GPU's picture is in place: shown alone for hold_ms more. */
+extern "C" void
+sweet_fb_gpu_show(uint32_t hold_ms)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	uint64_t hold;
+
+	if (fb == NULL) {
+		return;
+	}
+	nanoseconds_to_absolutetime((uint64_t)hold_ms * NSEC_PER_MSEC, &hold);
+	IOLockLock(fb->fLock);
+	fb->fGpuHoldUntil = mach_absolute_time() + hold;
+	IOLockUnlock(fb->fLock);
+}
+
+/* A pixel of the boot framebuffer as memory holds it (after the GPU wrote it). */
+extern "C" uint32_t
+sweet_fb_gpu_pixel(uint32_t x, uint32_t y)
+{
+	AppleCLCD *fb = sweet_fb_main;
+
+	if (fb == NULL || x >= fb->fWidth || y >= fb->fHeight) {
+		return 0;
+	}
+	uintptr_t va = fb->fPixels + (uint64_t)y * fb->fRowBytes + (uint64_t)x * 4;
+	sweet_dcache_flush(va, 4);
+	return *(volatile uint32_t *)va;
+}
+
