From b1e5cadb4f55cd17987cd121c0d075f31911ff95 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Tue, 3 Nov 2026 21:37:23 +0100
Subject: [PATCH] umi: sweettop=N, a CPU top in the kernel log (the phone has
 no top)

Every N seconds the 12 processes that used the most CPU since the last
round (TASK_ABSOLUTETIME_INFO user + system, as % of one core) and the sum
over all processes. First run on the Mi 10 at idle: 140-180 % of one core,
backboardd ~64 % (CPU rendering) and ReportCrash ~60 % (crash loops:
AegirPoster, CommCenter, bluetoothd, a Siri voice).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_sample.c | 94 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 94 insertions(+)

diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index b40eccd..e1139bf 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -11,6 +11,11 @@
  * syscall stub in pc and its caller in lr/bt.
  *
  * First sample 90 s after start, then every 120 s, 40 samples at most.
+ *
+ * Boot-arg sweettop=N (seconds, default off): a "top" for the phone, which has none. Every N seconds the
+ * processes that used the most CPU since the last round (user + system time of live and exited threads, from
+ * TASK_ABSOLUTETIME_INFO) as "TOP name[pid] 123%" (% of one core) and the sum over all processes, 360 rounds at
+ * most. Respawn loops show as a new pid each round (and as exec lines in the log).
  */
 #include <sys/param.h>
 #include <sys/systm.h>
@@ -20,6 +25,9 @@
 #include <kern/thread.h>
 #include <pexpert/pexpert.h>
 
+#include <mach/task_info.h>
+#include <kern/clock.h>
+
 extern task_t proc_task(proc_t);
 extern int hz;
 extern void sweet_sample_start(void);
@@ -78,6 +86,87 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 	}
 }
 
+#define TOP_MAX 640
+struct top_ent {
+	int pid;
+	uint64_t total, delta;          /* mach absolute time units */
+	char name[17];
+};
+static struct top_ent top_prev[TOP_MAX], top_cur[TOP_MAX];
+static unsigned top_nprev, top_ncur;
+
+static int
+sweet_top_proc(proc_t p, __unused void *arg)
+{
+	if (top_ncur >= TOP_MAX) {
+		return PROC_RETURNED;
+	}
+	task_t task = proc_task(p);
+	if (task == TASK_NULL) {
+		return PROC_RETURNED;
+	}
+	struct task_absolutetime_info info;
+	mach_msg_type_number_t count = TASK_ABSOLUTETIME_INFO_COUNT;
+	if (task_info(task, TASK_ABSOLUTETIME_INFO, (task_info_t)&info, &count) != KERN_SUCCESS) {
+		return PROC_RETURNED;
+	}
+	struct top_ent *e = &top_cur[top_ncur++];
+	e->pid = proc_pid(p);
+	e->total = info.total_user + info.total_system;
+	e->delta = e->total;            /* a new pid: everything since it started */
+	proc_name(e->pid, e->name, sizeof(e->name));
+	for (unsigned i = 0; i < top_nprev; i++) {
+		if (top_prev[i].pid == e->pid) {
+			e->delta = e->total >= top_prev[i].total ? e->total - top_prev[i].total : 0;
+			break;
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static void
+sweet_top_thread(void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	uint32_t secs = (uint32_t)(uintptr_t)arg;
+	uint64_t window_ns = (uint64_t)secs * NSEC_PER_SEC;
+	top_ncur = 0;
+	proc_iterate(PROC_ALLPROCLIST, sweet_top_proc, NULL, NULL, NULL);       /* baseline */
+	for (int round = 0; round < 360; round++) {
+		memcpy(top_prev, top_cur, sizeof(top_cur[0]) * top_ncur);
+		top_nprev = top_ncur;
+		(void)tsleep(&chan, PZERO, "sweettop", (int)secs * hz);
+		top_ncur = 0;
+		proc_iterate(PROC_ALLPROCLIST, sweet_top_proc, NULL, NULL, NULL);
+		uint64_t sum = 0;
+		for (unsigned i = 0; i < top_ncur; i++) {
+			sum += top_cur[i].delta;
+		}
+		uint64_t sum_ns;
+		absolutetime_to_nanoseconds(sum, &sum_ns);
+		printf("TOP --- round %d: all processes %llu%% of one core over %u s (8 cores = 800%%)\n", round,
+		    sum_ns * 100 / window_ns, secs);
+		for (int k = 0; k < 12; k++) {          /* the 12 busiest, by selection */
+			unsigned best = TOP_MAX;
+			for (unsigned i = 0; i < top_ncur; i++) {
+				if (top_cur[i].delta != 0 && (best == TOP_MAX || top_cur[i].delta > top_cur[best].delta)) {
+					best = i;
+				}
+			}
+			if (best == TOP_MAX) {
+				break;
+			}
+			uint64_t ns;
+			absolutetime_to_nanoseconds(top_cur[best].delta, &ns);
+			if (ns * 100 / window_ns == 0) {
+				break;
+			}
+			printf("TOP %s[%d] %llu%%\n", top_cur[best].name, top_cur[best].pid, ns * 100 / window_ns);
+			top_cur[best].delta = 0;        /* printed (the total stays for the next round) */
+		}
+	}
+}
+
 void
 sweet_sample_start(void)
 {
@@ -85,4 +174,9 @@ sweet_sample_start(void)
 	if (kernel_thread_start(sweet_sample_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
+	uint32_t secs = 0;
+	PE_parse_boot_argn("sweettop", &secs, sizeof(secs));
+	if (secs != 0 && kernel_thread_start(sweet_top_thread, (void *)(uintptr_t)secs, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 }
-- 
