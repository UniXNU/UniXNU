+/* ---- DIAG on MHI 4 (to the modem) / 5 (from it): F3 messages, HDLC framed (CRC-16/CCITT, 0x7e, 0x7d escapes) ---- */
+
+
+static struct {
+	uint32_t in_wp, out_wp;
+	uint8_t frame[4096];
+	uint32_t flen;
+	bool esc, on;
+	unsigned msgs, printed, other, bad;
+} dg;
+
+static uint16_t
+dg_crc(const uint8_t *p, uint32_t n)
+{
+	uint16_t crc = 0xffff;
+	for (uint32_t i = 0; i < n; ++i) {
+		crc ^= p[i];
+		for (int b = 0; b < 8; ++b) {
+			crc = (crc & 1) ? (uint16_t)((crc >> 1) ^ 0x8408) : (uint16_t)(crc >> 1);
+		}
+	}
+	return (uint16_t)~crc;
+}
+
+static void
+dg_rx_queue(unsigned buf)
+{
+	mx_tre(MH_TRE_DG_IN + dg.in_wp * MH_EL, mx.pa + MH_DGBUF + buf * MH_RX_LEN, MH_RX_LEN, 0x2u << 16 | 1u << 9);
+	dg.in_wp = (dg.in_wp + 1) % MH_TRE_N;
+	mx_ring(MX_DIAG_IN, MH_TRE_DG_IN, dg.in_wp);
+}
+
+/* One DIAG request, HDLC framed. */
+static void
+dg_send(const uint8_t *pl, uint32_t n)
+{
+	uint8_t *o = (uint8_t *)(mx.mem + MH_DGTX);
+	uint8_t raw[64];
+	uint32_t k = 0;
+	if (n > sizeof(raw) - 2) {
+		return;
+	}
+	memcpy(raw, pl, n);
+	uint16_t c = dg_crc(pl, n);
+	raw[n] = (uint8_t)c;
+	raw[n + 1] = (uint8_t)(c >> 8);
+	for (uint32_t i = 0; i < n + 2; ++i) {
+		if (raw[i] == 0x7e || raw[i] == 0x7d) {
+			o[k++] = 0x7d;
+			o[k++] = raw[i] ^ 0x20;
+		} else {
+			o[k++] = raw[i];
+		}
+	}
+	o[k++] = 0x7e;
+	mx_tre(MH_TRE_DG_OUT + dg.out_wp * MH_EL, mx.pa + MH_DGTX, k, 0x2u << 16 | 1u << 9);
+	dg.out_wp = (dg.out_wp + 1) % MH_TRE_N;
+	mx_ring(MX_DIAG_OUT, MH_TRE_DG_OUT, dg.out_wp);
+	for (unsigned i = 0; i < 200; ++i) {        /* its completion comes on event ring 1: let it pass */
+		mx_er1();
+		delay(100);
+	}
+}
+
+/* A whole DIAG packet (HDLC removed, CRC checked). */
+static void
+dg_packet(const uint8_t *p, uint32_t n)
+{
+	if (n >= 21 && p[0] == 0x79) {          /* DIAG_EXT_MSG_F: an F3 message */
+		dg.msgs++;
+		unsigned nargs = p[2];
+		uint16_t line = (uint16_t)(p[12] | p[13] << 8), ssid = (uint16_t)(p[14] | p[15] << 8);
+		uint32_t mask = (uint32_t)p[16] | (uint32_t)p[17] << 8 | (uint32_t)p[18] << 16 | (uint32_t)p[19] << 24;
+		uint32_t o = 20 + 4u * nargs;
+		if (o >= n || dg.printed >= 1500) {
+			return;
+		}
+		const char *fmt = (const char *)p + o;
+		size_t fl = strnlen(fmt, n - o);
+		const char *file = fl + 1 < n - o ? fmt + fl + 1 : "";
+		size_t fil = fl + 1 < n - o ? strnlen(file, n - o - fl - 1) : 0;
+		const char *base = file;
+		for (size_t i = 0; i < fil; ++i) {
+			if (file[i] == '/' || file[i] == '\\') {
+				base = file + i + 1;
+			}
+		}
+		uint32_t a[6] = { 0 };
+		for (unsigned i = 0; i < nargs && i < 6; ++i) {
+			memcpy(&a[i], p + 20 + 4 * i, 4);
+		}
+		dg.printed++;
+		/* the modem's format string is printed as text, never used as a format */
+		printf("SWEET MDM: F3 %u/%#x %.*s:%u: %.*s | %x %x %x %x %x %x\n", ssid, mask,
+		    (int)MIN(fil - (size_t)(base - file), (size_t)40), base, line, (int)MIN(fl, (size_t)160), fmt,
+		    a[0], a[1], a[2], a[3], a[4], a[5]);
+		return;
+	}
+	if (dg.other++ < 20) {
+		printf("SWEET MDM: DIAG packet %u bytes: %02x %02x %02x %02x %02x %02x %02x %02x\n", n, p[0], n > 1 ? p[1] : 0,
+		    n > 2 ? p[2] : 0, n > 3 ? p[3] : 0, n > 4 ? p[4] : 0, n > 5 ? p[5] : 0, n > 6 ? p[6] : 0, n > 7 ? p[7] : 0);
+	}
+}
+
+/* Bytes from channel 5: HDLC frames ending in 0x7e. */
+static void
+dg_feed(const uint8_t *b, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; ++i) {
+		uint8_t c = b[i];
+		if (c == 0x7e) {
+			if (dg.flen >= 3) {
+				uint16_t want = (uint16_t)(dg.frame[dg.flen - 2] | dg.frame[dg.flen - 1] << 8);
+				if (dg_crc(dg.frame, dg.flen - 2) == want) {
+					dg_packet(dg.frame, dg.flen - 2);
+				} else if (dg.bad++ < 10) {
+					printf("SWEET MDM: DIAG frame of %u bytes with a bad CRC\n", dg.flen);
+				}
+			}
+			dg.flen = 0;
+			dg.esc = false;
+		} else if (c == 0x7d) {
+			dg.esc = true;
+		} else if (dg.flen < sizeof(dg.frame)) {
+			dg.frame[dg.flen++] = dg.esc ? c ^ 0x20 : c;
+			dg.esc = false;
+		}
+	}
+}
+
+/* The modem's failure reason buffer, if it wrote one. */
+static void
+mx_sfr_print(const char *when)
+{
+	const char *t = (const char *)(mx.mem + MH_SFR);
+	size_t l = strnlen(t, MX_SFR_LEN);
+	if (l) {
+		printf("SWEET MDM: SFR (%s): %.*s\n", when, (int)MIN(l, (size_t)300), t);
+	} else {
+		printf("SWEET MDM: SFR (%s): empty\n", when);
+	}
+}
+
+/* SFR_CFG (MHI command 73): where the modem writes its failure reason. */
+static void
+mx_sfr_cfg(void)
+{
+	bzero((void *)(mx.mem + MH_SFR), MX_SFR_LEN);
+	mx_tre(MH_CMD + mx.cmd_wp * MH_EL, mx.pa + MH_SFR, MX_SFR_LEN, 73u << 16);
+	mx.cmd_wp = (mx.cmd_wp + 1) % MH_CMD_N;
+	uint64_t a = mx.pa + MH_CMD + mx.cmd_wp * MH_EL;
+	mx64(MH_CMDCTX + 36, a);
+	mx.cmd_code = -1;
+	mx_db(MHI_CRDB, a);
+	for (unsigned i = 0; i < 2000 && mx.cmd_code < 0; ++i) {
+		mx_er0();
+		delay(1000);
+	}
+	printf("SWEET MDM: SFR buffer (%u bytes at %#x) handed to the modem: completion %d\n", MX_SFR_LEN, mx.pa + MH_SFR,
+	    mx.cmd_code);
+}
+
+/* DIAG up: channels, receive buffers, every subsystem's real-time message mask set (high / error / fatal). */
+static void
+dg_start(void)
+{
+	bzero(&dg, sizeof(dg));
+	if (mx_chan_start(MX_DIAG_OUT, false, MH_TRE_DG_OUT) || mx_chan_start(MX_DIAG_IN, true, MH_TRE_DG_IN)) {
+		return;
+	}
+	for (unsigned b = 0; b < MH_RX_N; ++b) {
+		dg_rx_queue(b);
+	}
+	dg.on = true;
+	uint32_t m = 0x1c;                      /* MSG_LEGACY high 0x4, error 0x8, fatal 0x10 */
+	(void)PE_parse_boot_argn("sweetmdmdiag", &m, sizeof(m));
+	const uint8_t verno[1] = { 0x00 };      /* DIAG_VERNO_F: a first answer */
+	dg_send(verno, 1);
+	uint8_t all[8] = { 0x7d, 0x05, 0x00, 0x00, (uint8_t)m, (uint8_t)(m >> 8), (uint8_t)(m >> 16), (uint8_t)(m >> 24) };
+	dg_send(all, 8);                        /* DIAG_EXT_MSG_CONFIG_F: set all real-time masks */
+	printf("SWEET MDM: DIAG channels %u/%u running, message mask %#x for every subsystem\n", MX_DIAG_OUT, MX_DIAG_IN, m);
+}
+
