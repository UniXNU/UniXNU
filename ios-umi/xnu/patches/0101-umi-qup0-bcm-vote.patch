+/*
+ * One ACTIVE bandwidth/clock vote (BCM_TCS_CMD: commit, valid, vote_x = average,
+ * vote_y = peak). umi: Linux keeps QUP0 voted (msm-bus client qupv3_1_geni_se,
+ * master 152 -> slave 512) whenever a QUP1 serial engine is used; without it the
+ * QUP core clock domain may be left off by AOP.
+ */
+int
+sweet_rpmh_bcm_vote(const char *res, uint32_t vote_x, uint32_t vote_y)
+{
+	if (!sweet_board_is_umi() || !res || strcmp(res, "QUP0")) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (!rh_poisoned) {
+		error = rh_map();
+		if (!error) {
+			error = rh_lookup_type(res, &address, RH_BCM);
+		}
+		if (!error) {
+			uint32_t data = (1u << 30) | (1u << 29) | ((vote_x & 0x3fffu) << 14) | (vote_y & 0x3fffu);
+			error = rh_send_cmds(address, &address, &data, 1, "BCM QUP0");
+		}
+	}
+	if (error) {
+		printf("SWEET RPMH: BCM %s vote failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
