diff --git a/bsd/dev/sweet_wlsec.c b/bsd/dev/sweet_wlsec.c
new file mode 100644
index 0000000..a688744
--- /dev/null
+++ b/bsd/dev/sweet_wlsec.c
@@ -0,0 +1,385 @@
+/*
+ * umi Wi-Fi 0203: WPA2-PSK for the station (bsd/dev/sweet_wlsta.c), the supplicant's half of
+ * IEEE 802.11-2016 12.7 for AKM 00-0f-ac:2 (PSK) with CCMP pairwise and group ciphers:
+ *   - PMK: given by wifid (Apple80211 ASSOCIATE, key kind 6), or PBKDF2-SHA1(passphrase, SSID,
+ *     4096, 32) for a passphrase (12.7.1.3);
+ *   - PTK = PRF-384(PMK, "Pairwise key expansion", min/max(AA, SPA) || min/max(ANonce, SNonce)):
+ *     KCK 0-15, KEK 16-31, TK 32-47 (12.7.1.2-3);
+ *   - EAPOL-Key frames, key descriptor version 2: MIC = HMAC-SHA1-128(KCK), key data wrapped
+ *     with AES key wrap (RFC 3394) under the KEK (12.7.2);
+ *   - 4-way handshake message 1 -> 2 (SNonce, our RSN element), 3 -> 4 (GTK KDE from the key
+ *     data, 12.7.6), and the group key handshake 1 -> 2 for a new GTK (12.7.7).
+ * Frames arrive from the data path (sweet_wlsta.c's receive hook, wlce lock held) and the
+ * answers go straight back out through sweet_wldp_tx (unencrypted: the keys come after). The
+ * keys are installed by the caller from its own thread (sweet_wlce.c), never from here.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/random.h>
+#include <libkern/crypto/sha1.h>
+#include <libkern/crypto/aes.h>
+
+extern int sweet_wldp_tx(const void *frame, uint32_t len);
+
+void sweet_wlsec_pmk(const uint8_t *pass, unsigned pass_len, const uint8_t *ssid, unsigned ssid_len, uint8_t pmk[32]);
+void sweet_wlsec_begin(const uint8_t pmk[32], const uint8_t aa[6], const uint8_t spa[6], const uint8_t *ie, unsigned ie_len);
+void sweet_wlsec_end(void);
+bool sweet_wlsec_rx(const uint8_t *frame, uint32_t len);
+int sweet_wlsec_state(void);
+void sweet_wlsec_keys(uint8_t tk[16], uint8_t gtk[32], unsigned *gtk_len, unsigned *gtk_idx, uint8_t rsc[8]);
+bool sweet_wlsec_new_gtk(uint8_t gtk[32], unsigned *gtk_len, unsigned *gtk_idx, uint8_t rsc[8]);
+
+#define KI_VER_MASK     0x0007u
+#define KI_PAIRWISE     0x0008u
+#define KI_INSTALL      0x0040u
+#define KI_ACK          0x0080u
+#define KI_MIC          0x0100u
+#define KI_SECURE       0x0200u
+#define KI_ENCDATA      0x1000u
+
+/* EAPOL-Key frame offsets from the EAPOL header (version, type 3, body length) */
+#define EK_DESC         4
+#define EK_INFO         5
+#define EK_KEYLEN       7
+#define EK_REPLAY       9
+#define EK_NONCE        17
+#define EK_RSC          65
+#define EK_MIC          81
+#define EK_DATALEN      97
+#define EK_DATA         99
+
+static struct {
+	bool on;
+	int state;                      /* 0 waiting, 1 keys ready (message 4 sent) */
+	uint8_t pmk[32], aa[6], spa[6];
+	uint8_t ie[64];
+	unsigned ie_len;
+	uint8_t anonce[32], snonce[32];
+	bool have_anonce;
+	uint8_t ptk[48];
+	uint8_t replay[8];
+	bool replay_seen;
+	uint8_t gtk[32], rsc[8];
+	unsigned gtk_len, gtk_idx;
+	bool gtk_new;
+	unsigned m1, m3, mic_bad;
+} ws;
+
+/* ---- HMAC-SHA1 (RFC 2104) over up to three pieces ---- */
+static void
+hmac_sha1(const uint8_t *key, size_t key_len, const void *a, size_t al, const void *b, size_t bl, const void *c, size_t cl,
+    uint8_t out[20])
+{
+	uint8_t k[64], pad[64], inner[20];
+	SHA1_CTX ctx;
+	bzero(k, sizeof(k));
+	if (key_len > 64) {
+		SHA1Init(&ctx);
+		SHA1Update(&ctx, key, key_len);
+		SHA1Final(k, &ctx);
+	} else {
+		memcpy(k, key, key_len);
+	}
+	for (int i = 0; i < 64; i++) {
+		pad[i] = k[i] ^ 0x36;
+	}
+	SHA1Init(&ctx);
+	SHA1Update(&ctx, pad, 64);
+	if (al) {
+		SHA1Update(&ctx, a, al);
+	}
+	if (bl) {
+		SHA1Update(&ctx, b, bl);
+	}
+	if (cl) {
+		SHA1Update(&ctx, c, cl);
+	}
+	SHA1Final(inner, &ctx);
+	for (int i = 0; i < 64; i++) {
+		pad[i] = k[i] ^ 0x5c;
+	}
+	SHA1Init(&ctx);
+	SHA1Update(&ctx, pad, 64);
+	SHA1Update(&ctx, inner, 20);
+	SHA1Final(out, &ctx);
+}
+
+/* PBKDF2-HMAC-SHA1(passphrase, SSID, 4096 iterations, 32 bytes): the PSK of a passphrase */
+void
+sweet_wlsec_pmk(const uint8_t *pass, unsigned pass_len, const uint8_t *ssid, unsigned ssid_len, uint8_t pmk[32])
+{
+	for (uint32_t block = 1; block <= 2; block++) {
+		uint8_t be[4] = { 0, 0, 0, (uint8_t)block }, u[20], t[20];
+		hmac_sha1(pass, pass_len, ssid, ssid_len, be, 4, NULL, 0, u);
+		memcpy(t, u, 20);
+		for (int i = 1; i < 4096; i++) {
+			hmac_sha1(pass, pass_len, u, 20, NULL, 0, NULL, 0, u);
+			for (int j = 0; j < 20; j++) {
+				t[j] ^= u[j];
+			}
+		}
+		memcpy(pmk + 20 * (block - 1), t, block == 1 ? 20 : 12);
+	}
+}
+
+/* PRF-384 (12.7.1.2): HMAC-SHA1(PMK, label || 0 || data || counter) for counters 0-2 */
+static void
+derive_ptk(void)
+{
+	static const char label[] = "Pairwise key expansion";      /* (the trailing NUL is the 0 byte) */
+	uint8_t data[76], out[60];
+	bool aa_first = memcmp(ws.aa, ws.spa, 6) < 0, an_first = memcmp(ws.anonce, ws.snonce, 32) < 0;
+	memcpy(data, aa_first ? ws.aa : ws.spa, 6);
+	memcpy(data + 6, aa_first ? ws.spa : ws.aa, 6);
+	memcpy(data + 12, an_first ? ws.anonce : ws.snonce, 32);
+	memcpy(data + 44, an_first ? ws.snonce : ws.anonce, 32);
+	for (uint8_t i = 0; i < 3; i++) {
+		hmac_sha1(ws.pmk, 32, label, sizeof(label), data, sizeof(data), &i, 1, out + 20 * i);
+	}
+	memcpy(ws.ptk, out, 48);
+}
+
+/* RFC 3394 key unwrap under the KEK; 0 or -1 (integrity check failed) */
+static int
+aes_unwrap(const uint8_t kek[16], const uint8_t *in, unsigned len, uint8_t *out)
+{
+	aes_decrypt_ctx ctx;
+	uint8_t a[8], b[16];
+	unsigned n = len / 8 - 1;
+	if (len < 24 || len % 8 || aes_decrypt_key128(kek, &ctx) != aes_good) {
+		return -1;
+	}
+	memcpy(a, in, 8);
+	memcpy(out, in + 8, 8 * n);
+	for (int j = 5; j >= 0; j--) {
+		for (unsigned i = n; i >= 1; i--) {
+			uint64_t t = (uint64_t)n * (unsigned)j + i;
+			memcpy(b, a, 8);
+			for (int k = 0; k < 8; k++) {
+				b[7 - k] ^= (uint8_t)(t >> (8 * k));
+			}
+			memcpy(b + 8, out + 8 * (i - 1), 8);
+			aes_decrypt(b, b, &ctx);
+			memcpy(a, b, 8);
+			memcpy(out + 8 * (i - 1), b + 8, 8);
+		}
+	}
+	for (int k = 0; k < 8; k++) {
+		if (a[k] != 0xa6) {
+			return -1;
+		}
+	}
+	return 0;
+}
+
+static bool
+mic_ok(const uint8_t *e, unsigned len)
+{
+	static uint8_t copy[1600];
+	uint8_t mic[20];
+	if (len > sizeof(copy)) {
+		return false;
+	}
+	memcpy(copy, e, len);
+	bzero(copy + EK_MIC, 16);
+	hmac_sha1(ws.ptk, 16, copy, len, NULL, 0, NULL, 0, mic);
+	return memcmp(mic, e + EK_MIC, 16) == 0;
+}
+
+/* An EAPOL-Key frame of ours: info, replay counter, nonce, key data; MIC'd unless the KCK is unknown */
+static int
+send_key(uint16_t info, const uint8_t replay[8], const uint8_t *nonce, const uint8_t *data, unsigned data_len)
+{
+	static uint8_t f[14 + EK_DATA + 64];
+	uint8_t *e = f + 14, mic[20];
+	unsigned elen = EK_DATA + data_len;
+	if (data_len > 64) {
+		return EINVAL;
+	}
+	bzero(f, sizeof(f));
+	memcpy(f, ws.aa, 6);
+	memcpy(f + 6, ws.spa, 6);
+	f[12] = 0x88;
+	f[13] = 0x8e;
+	e[0] = 1;                       /* 802.1X-2001 */
+	e[1] = 3;                       /* EAPOL-Key */
+	e[2] = (uint8_t)((elen - 4) >> 8);
+	e[3] = (uint8_t)(elen - 4);
+	e[EK_DESC] = 2;                 /* RSN key descriptor */
+	e[EK_INFO] = (uint8_t)(info >> 8);
+	e[EK_INFO + 1] = (uint8_t)info;
+	memcpy(e + EK_REPLAY, replay, 8);
+	if (nonce != NULL) {
+		memcpy(e + EK_NONCE, nonce, 32);
+	}
+	e[EK_DATALEN] = (uint8_t)(data_len >> 8);
+	e[EK_DATALEN + 1] = (uint8_t)data_len;
+	if (data_len) {
+		memcpy(e + EK_DATA, data, data_len);
+	}
+	if (info & KI_MIC) {
+		hmac_sha1(ws.ptk, 16, e, elen, NULL, 0, NULL, 0, mic);
+		memcpy(e + EK_MIC, mic, 16);
+	}
+	return sweet_wldp_tx(f, 14 + elen);
+}
+
+/* The GTK KDE (00-0f-ac:1) in decrypted key data: key id, the key */
+static bool
+find_gtk(const uint8_t *d, unsigned len)
+{
+	for (unsigned o = 0; o + 2 <= len;) {
+		unsigned type = d[o], l = d[o + 1];
+		if (type == 0xdd && l == 0 && o + 2 <= len) {
+			break;                  /* padding */
+		}
+		if (o + 2 + l > len) {
+			break;
+		}
+		if (type == 0xdd && l >= 6 + 5 && d[o + 2] == 0x00 && d[o + 3] == 0x0f && d[o + 4] == 0xac && d[o + 5] == 1 &&
+		    l - 6 <= sizeof(ws.gtk)) {
+			ws.gtk_idx = d[o + 6] & 3u;
+			ws.gtk_len = l - 6;
+			memcpy(ws.gtk, d + o + 8, ws.gtk_len);
+			return true;
+		}
+		o += 2 + l;
+	}
+	return false;
+}
+
+void
+sweet_wlsec_begin(const uint8_t pmk[32], const uint8_t aa[6], const uint8_t spa[6], const uint8_t *ie, unsigned ie_len)
+{
+	bzero(&ws, sizeof(ws));
+	memcpy(ws.pmk, pmk, 32);
+	memcpy(ws.aa, aa, 6);
+	memcpy(ws.spa, spa, 6);
+	ws.ie_len = MIN(ie_len, (unsigned)sizeof(ws.ie));
+	memcpy(ws.ie, ie, ws.ie_len);
+	ws.on = true;
+}
+
+void
+sweet_wlsec_end(void)
+{
+	bzero(&ws, sizeof(ws));         /* (the keys too) */
+}
+
+/* 1 keys ready, 2 message 1 came but no good message 3 (yet), 0 nothing yet */
+int
+sweet_wlsec_state(void)
+{
+	return ws.state != 0 ? ws.state : ws.m1 != 0 ? 2 : 0;
+}
+
+void
+sweet_wlsec_keys(uint8_t tk[16], uint8_t gtk[32], unsigned *gtk_len, unsigned *gtk_idx, uint8_t rsc[8])
+{
+	memcpy(tk, ws.ptk + 32, 16);
+	memcpy(gtk, ws.gtk, sizeof(ws.gtk));
+	*gtk_len = ws.gtk_len;
+	*gtk_idx = ws.gtk_idx;
+	memcpy(rsc, ws.rsc, 8);
+}
+
+/* A GTK from a group key handshake since the last call */
+bool
+sweet_wlsec_new_gtk(uint8_t gtk[32], unsigned *gtk_len, unsigned *gtk_idx, uint8_t rsc[8])
+{
+	if (!ws.gtk_new) {
+		return false;
+	}
+	ws.gtk_new = false;
+	memcpy(gtk, ws.gtk, sizeof(ws.gtk));
+	*gtk_len = ws.gtk_len;
+	*gtk_idx = ws.gtk_idx;
+	memcpy(rsc, ws.rsc, 8);
+	return true;
+}
+
+/* A received Ethernet frame: true if it was EAPOL (handled here, not for the stack). */
+bool
+sweet_wlsec_rx(const uint8_t *frame, uint32_t len)
+{
+	static uint8_t plain[256];
+	if (len < 14 || frame[12] != 0x88 || frame[13] != 0x8e) {
+		return false;
+	}
+	const uint8_t *e = frame + 14;
+	unsigned elen = len - 14;
+	if (!ws.on || elen < EK_DATA || e[1] != 3 || e[EK_DESC] != 2) {
+		return true;
+	}
+	unsigned body = (unsigned)(e[2] << 8 | e[3]) + 4, dlen = (unsigned)(e[EK_DATALEN] << 8 | e[EK_DATALEN + 1]);
+	if (body > elen || EK_DATA + dlen > body) {
+		return true;
+	}
+	elen = body;
+	uint16_t info = (uint16_t)(e[EK_INFO] << 8 | e[EK_INFO + 1]);
+	if ((info & KI_VER_MASK) != 2 || !(info & KI_ACK)) {
+		printf("SWEET WLSEC: EAPOL-Key info %#x ignored (descriptor version %u)\n", info, info & KI_VER_MASK);
+		return true;
+	}
+	if (ws.replay_seen && memcmp(e + EK_REPLAY, ws.replay, 8) <= 0) {
+		return true;                    /* replayed */
+	}
+	if ((info & KI_PAIRWISE) && !(info & KI_MIC)) {
+		/* message 1: ANonce; a new SNonce for a new ANonce */
+		if (!ws.have_anonce || memcmp(ws.anonce, e + EK_NONCE, 32) != 0) {
+			memcpy(ws.anonce, e + EK_NONCE, 32);
+			read_random(ws.snonce, 32);
+			ws.have_anonce = true;
+			derive_ptk();
+		}
+		ws.m1++;
+		memcpy(ws.replay, e + EK_REPLAY, 8);
+		ws.replay_seen = true;
+		int r = send_key(2 | KI_PAIRWISE | KI_MIC, ws.replay, ws.snonce, ws.ie, ws.ie_len);
+		printf("SWEET WLSEC: 4-way message 1 (%u), message 2 sent: %d\n", ws.m1, r);
+		return true;
+	}
+	if (!(info & KI_MIC) || !ws.have_anonce) {
+		return true;
+	}
+	if (!mic_ok(e, elen)) {
+		ws.mic_bad++;
+		printf("SWEET WLSEC: EAPOL-Key MIC wrong (info %#x, %u times): wrong password?\n", info, ws.mic_bad);
+		return true;
+	}
+	memcpy(ws.replay, e + EK_REPLAY, 8);
+	ws.replay_seen = true;
+	if ((info & KI_ENCDATA) && (dlen > sizeof(plain) + 8 || aes_unwrap(ws.ptk + 16, e + EK_DATA, dlen, plain) != 0)) {
+		printf("SWEET WLSEC: key data (%u bytes) does not unwrap\n", dlen);
+		return true;
+	}
+	unsigned plen = (info & KI_ENCDATA) ? dlen - 8 : 0;
+	if (info & KI_PAIRWISE) {
+		/* message 3: the same ANonce, the GTK; message 4 answers it, then the keys go in */
+		if (memcmp(ws.anonce, e + EK_NONCE, 32) != 0 || !(info & KI_INSTALL)) {
+			printf("SWEET WLSEC: message 3 with another ANonce / no install bit, ignored\n");
+			return true;
+		}
+		bool gtk = find_gtk(plain, plen);
+		memcpy(ws.rsc, e + EK_RSC, 8);
+		int r = send_key(2 | KI_PAIRWISE | KI_MIC | KI_SECURE, ws.replay, NULL, NULL, 0);
+		ws.m3++;
+		printf("SWEET WLSEC: 4-way message 3 (GTK %s, id %u, %u bytes), message 4 sent: %d\n", gtk ? "found" : "MISSING",
+		    ws.gtk_idx, ws.gtk_len, r);
+		if (r == 0 && gtk) {
+			ws.state = 1;
+		}
+	} else {
+		/* group key handshake message 1: a new GTK */
+		if (find_gtk(plain, plen)) {
+			memcpy(ws.rsc, e + EK_RSC, 8);
+			ws.gtk_new = ws.state == 1;
+			int r = send_key(2 | KI_MIC | KI_SECURE, ws.replay, NULL, NULL, 0);
+			printf("SWEET WLSEC: group key message 1 (id %u), message 2 sent: %d\n", ws.gtk_idx, r);
+		}
+	}
+	return true;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
