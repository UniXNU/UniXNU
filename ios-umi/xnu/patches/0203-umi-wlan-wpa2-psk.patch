 	return r ? EIO : htc.scan_done ? 0 : ETIMEDOUT;
 }
 
+/*
+ * 0203: WMI_VDEV_INSTALL_KEY 0x5009 (tag 0x60, after VDEV_SET_PARAM 0x5f) as ath11k_install_key:
+ * wmi_vdev_install_key_cmd {vdev_id, peer mac, key_idx, key_flags (PAIRWISE 0 / GROUP 1),
+ * key_cipher (AES_CCM 4), rsc, global rsc, tsc (2 words each), wpi rsc / tsc (16 bytes each),
+ * key_len, tx mic len, rx mic len, group key id valid, group key id}, then the key as a byte
+ * array (0x11); the peer is the AP for both keys of a station. Waits for
+ * VDEV_INSTALL_KEY_COMPLETE 0x5003. 0 or EIO.
+ */
+static int
+wlce_install_key(bool group, unsigned idx, const uint8_t *key, unsigned len, const uint8_t rsc[8])
+{
+	static uint32_t b[27 + 8];
+	if (len > 32) {
+		return EINVAL;
+	}
+	bzero(b, sizeof(b));
+	b[0] = WMI_TLV(0x60, 25 * 4);
+	memcpy(&b[2], htc.join_bssid, 6);
+	b[4] = idx;
+	b[5] = group ? 1 : 0;
+	b[6] = 4;                       /* WMI_CIPHER_AES_CCM */
+	if (rsc != NULL) {
+		memcpy(&b[7], rsc, 8);
+	}
+	b[21] = len;
+	b[26] = WMI_TLV(0x11, (len + 3) & ~3u);
+	memcpy(&b[27], key, len);
+	htc.key_done = false;
+	int r = wmi_cmd(0x5009u, b, (27 + (len + 3) / 4) * 4, group ? "INSTALL_KEY group" : "INSTALL_KEY pairwise");
+	bzero(&b[27], 32);
+	if (r != 0 || !wlce_wait(&htc.key_done, 1000) || htc.key_status != 0) {
+		printf("SWEET WMI: %s key %u not installed (send %d, %s, status %u)\n", group ? "group" : "pairwise", idx, r,
+		    htc.key_done ? "answered" : "no answer", htc.key_status);
+		return EIO;
+	}
+	return 0;
+}
+
+/* 0203: after a WPA2 association: the 4-way handshake (sweet_wlsec.c), the keys, authorization */
+static int
+wlce_secure(void)
+{
+	static uint32_t b[8];
+	uint8_t tk[16], gtk[32], rsc[8];
+	unsigned gtk_len, gtk_idx, t;
+	int st = 0, r;
+	bool m1 = false;
+	/* (an AP that does not like message 2 deauthenticates, reason 15: the leave that follows forgets the handshake) */
+	for (t = 0; t < 8000 && htc.joined && !htc.lost && (st = sweet_wlsec_state()) != 1; ++t) {
+		m1 |= st == 2;
+		wlce_tick();
+	}
+	if (st != 1) {
+		printf("SWEET WMI: 4-way handshake not done (%s, %s)\n", htc.joined && !htc.lost ? "8 s" : "the AP sent us away",
+		    m1 ? "message 1 came: wrong password?" : "no message 1 from the AP");
+		return m1 ? EAUTH : ETIMEDOUT;
+	}
+	for (t = 0; t < 50; ++t) {      /* (message 4 on the air before the key goes in) */
+		wlce_tick();
+	}
+	sweet_wlsec_keys(tk, gtk, &gtk_len, &gtk_idx, rsc);
+	r = wlce_install_key(false, 0, tk, 16, NULL);
+	if (r == 0) {
+		sweet_wldp_set_encrypt(6);      /* HAL_ENCRYPT_TYPE_CCMP_128 */
+		r = wlce_install_key(true, gtk_idx, gtk, gtk_len, rsc);
+	}
+	bzero(tk, sizeof(tk));
+	bzero(gtk, sizeof(gtk));
+	if (r != 0) {
+		return EIO;
+	}
+	bzero(b, sizeof(b));
+	b[0] = WMI_TLV(0x64, 5 * 4);
+	memcpy(&b[2], htc.join_bssid, 6);
+	b[4] = 3;                       /* WMI_PEER_AUTHORIZE */
+	b[5] = 1;
+	if (wmi_cmd(0x6004u, b, 6 * 4, "PEER_SET_PARAM authorize") != 0) {
+		return EIO;
+	}
+	printf("SWEET WMI: WPA2 keys installed, peer authorized\n");
+	return 0;
+}
