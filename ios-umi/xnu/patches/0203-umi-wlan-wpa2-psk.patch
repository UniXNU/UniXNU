+/*
+ * 0203: the AP's RSN element (in its beacon's elements) and ours: WPA2-PSK only, i.e. group
+ * cipher CCMP (00-0f-ac:4), CCMP among the pairwise ciphers, PSK (00-0f-ac:2) among the AKMs,
+ * management frame protection not required (capability bit 6). Ours names exactly those
+ * (12.2.2, 9.4.2.25); the same bytes go into 4-way message 2. 0, or -1 not for us.
+ */
+static const uint8_t wlce_rsn_ie[22] = { 0x30, 20, 1, 0, 0x00, 0x0f, 0xac, 4, 1, 0, 0x00, 0x0f, 0xac, 4, 1, 0, 0x00, 0x0f, 0xac, 2,
+	                                 0, 0 };
+
+static int
+wlce_rsn_check(const uint8_t *ies, unsigned len)
+{
+	static const uint8_t ccmp[4] = { 0x00, 0x0f, 0xac, 4 }, psk[4] = { 0x00, 0x0f, 0xac, 2 };
+	for (unsigned o = 0; o + 2 <= len && o + 2 + ies[o + 1] <= len; o += 2 + ies[o + 1]) {
+		const uint8_t *e = ies + o + 2;
+		unsigned l = ies[o + 1], n, p = 8;
+		bool pw = false, akm = false;
+		if (ies[o] != 0x30) {
+			continue;
+		}
+		if (l < 8 + 2 || memcmp(e + 2, ccmp, 4) != 0) {
+			printf("SWEET WMI: the AP's group cipher is not CCMP\n");
+			return -1;
+		}
+		n = e[6] | e[7] << 8;
+		for (unsigned i = 0; i < n && p + 4 <= l; i++, p += 4) {
+			pw |= memcmp(e + p, ccmp, 4) == 0;
+		}
+		if (p + 2 > l) {
+			return -1;
+		}
+		n = e[p] | e[p + 1] << 8;
+		p += 2;
+		for (unsigned i = 0; i < n && p + 4 <= l; i++, p += 4) {
+			akm |= memcmp(e + p, psk, 4) == 0;
+		}
+		unsigned caps = p + 2 <= l ? (unsigned)(e[p] | e[p + 1] << 8) : 0;
+		printf("SWEET WMI: AP RSN: pairwise CCMP %d, PSK %d, capabilities %#x\n", pw, akm, caps);
+		/* 0203: the AP's whole RSN element and the kinds of its other elements (ids; 255 with the extension id,
+		 * 221 with OUI + type), for APs that refuse us - never the SSID's bytes */
+		printf("SWEET WMI: AP RSN element:");
+		for (unsigned k = 0; k < l + 2 && k < 48; k++) {
+			printf(" %02x", ies[o + k]);
+		}
+		printf("\nSWEET WMI: AP elements:");
+		for (unsigned q = 0; q + 2 <= len && q + 2 + ies[q + 1] <= len; q += 2 + ies[q + 1]) {
+			if (ies[q] == 255 && ies[q + 1] >= 1) {
+				printf(" 255/%u", ies[q + 2]);
+			} else if (ies[q] == 221 && ies[q + 1] >= 4) {
+				printf(" 221/%02x%02x%02x-%u", ies[q + 2], ies[q + 3], ies[q + 4], ies[q + 5]);
+			} else {
+				printf(" %u", ies[q]);
+			}
+		}
+		printf("\n");
+		return pw && akm && !(caps & 0x40) ? 0 : -1;
+	}
+	printf("SWEET WMI: the AP has no RSN element (WPA1 / WEP / open)\n");
+	return -1;
+}
