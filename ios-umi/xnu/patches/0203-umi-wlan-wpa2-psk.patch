 /* The net thread (lock held): copy engines and data rings once; frames go to the rx handler. */
+static int wlce_install_key(bool group, unsigned idx, const uint8_t *key, unsigned len, const uint8_t rsc[8]);
+
 unsigned
 sweet_wlce_poll(void)
 {
+	uint8_t gtk[32], rsc[8];
+	unsigned gtk_len, gtk_idx;
 	wlce_shared = true;
 	htc_poll();
+	/* 0203: a new GTK from a group key handshake (received just now, answered already) */
+	if (htc.joined && htc.rsn && sweet_wlsec_new_gtk(gtk, &gtk_len, &gtk_idx, rsc)) {
+		(void)wlce_install_key(true, gtk_idx, gtk, gtk_len, rsc);
+		bzero(gtk, sizeof(gtk));
