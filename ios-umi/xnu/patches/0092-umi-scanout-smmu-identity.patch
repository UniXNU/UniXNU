+/*
+ * Translation of one IOVA by an SMMU context bank's stage-1 tables (AArch64
+ * format, 4K granule, as ABL sets up the display context). *size is the size
+ * of the mapping that covers it. False when unmapped or not walkable.
+ */
+static bool
+sweet_smmu_walk(uint64_t ttbr, uint32_t tcr, uint64_t iova, uint64_t *pa, uint64_t *size)
+{
+	uint32_t t0sz = tcr & 0x3f, ia = 64 - t0sz;
+	if (((tcr >> 14) & 3) != 0 || ia < 25 || ia > 48) {
+		return false;                   /* only the 4K granule */
+	}
+	int level = ia > 39 ? 0 : ia > 30 ? 1 : 2;
+	uint64_t table = ttbr & 0x0000fffffffff000ull;
+	for (; level <= 3; level++) {
+		uint32_t shift = 12 + 9 * (3 - level);
+		uint32_t bits = level == (ia > 39 ? 0 : ia > 30 ? 1 : 2) ? ia - shift : 9;
+		uint64_t idx = (iova >> shift) & ((1ull << bits) - 1);
+		vm_offset_t va = ml_io_map(table, 0x1000);
+		if (va == 0) {
+			return false;
+		}
+		uint64_t desc = ((volatile uint64_t *)va)[idx];
+		ml_io_unmap(va, 0x1000);
+		if ((desc & 1) == 0) {
+			return false;
+		}
+		bool leaf = level == 3 || (desc & 2) == 0;     /* page (L3) or block */
+		if (level == 3 && (desc & 2) == 0) {
+			return false;
+		}
+		if (leaf) {
+			uint64_t span = 1ull << shift;
+			*pa = (desc & 0x0000fffffffff000ull & ~(span - 1)) | (iova & (span - 1));
+			*size = span - (iova & (span - 1));
+			return true;
+		}
+		table = desc & 0x0000fffffffff000ull;
+	}
+	return false;
+}
