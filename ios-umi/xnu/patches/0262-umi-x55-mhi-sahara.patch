From 5c9dee55876726ab6e6a9339f736fb31c0ad765d Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Mon, 9 Nov 2026 22:25:43 +0100
Subject: [PATCH] umi: X55 MHI host + Sahara server - 12 images (94 MB) in 6.7
 s, transfer complete, MDM2AP_STATUS high (sweetmdm=6) (0262)

sweet_fat_pread: ranged, cursor-cached FAT reads; UFS partition cache 16 slots.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_mdm.c  | 499 ++++++++++++++++++++++++++++++++++++++++++-
 bsd/dev/sweet_ufs.c  |   2 +-
 bsd/dev/sweet_wlan.c | 120 +++++++++++
 3 files changed, 618 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/sweet_mdm.c b/bsd/dev/sweet_mdm.c
index f3d5132..2f7f1af 100644
--- a/bsd/dev/sweet_mdm.c
+++ b/bsd/dev/sweet_mdm.c
@@ -17,6 +17,13 @@
  *               RAM (sweetmdmpool, default 0xd8000000, 8 MiB, outside XNU's highmem RAM), SMMU streams
  *               0x1d00 / 0x1d01 routed to bypass, MSI into the pool (polled); then watch the execution
  *               environment (Linux pci_generic mhi_qcom_sdx55_info: fw sbl1.mbn by BHI, no fbc download)
+ *   sweetmdm=6  + MHI host (contexts, M0; as sweet_mhi.c, own copy in the X55's pool) and a Sahara server on the
+ *               SBL's channels 2 (to the modem) / 3 (from it): the images of image/sdx55m by Sahara image id
+ *               (ids as on the OnePlus 8 Pro's X55, dekefake/hackios-op8pro; facts only), the EFS images
+ *               (16 / 17 / 20) from the X55's own mdm1m9kefs1 / 2 / 3 partitions (read only; sweetmdmefs=0:
+ *               the 512-byte stubs of the firmware partition). Big images are streamed with sweet_fat_pread.
+ *               It ends when the modem says the transfer is complete (it then restarts itself and leaves the
+ *               link: mission mode is the next step), on an unknown image, or after sweetmdmsecs (120).
  * PCIe sequence as sweet_pcie.c (PCIe0, QCA6390) with the PCIe2 registers (Linux gcc-sm8250.c).
  * Built inside sweet_spmi.c (the local build cannot add source files).
  */
@@ -38,6 +45,9 @@ extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, unsigned int);
 extern bool sweet_smmu_route_sid(uint32_t sid);
 extern int sweet_fat_read_file(const char *part, const char *dir, const char *name, void *dst, uint32_t max,
     uint32_t *size);
+extern int sweet_fat_pread(const char *part, const char *dir, const char *name, uint64_t off, void *dst, uint32_t len,
+    uint32_t *size);
+extern int sweet_ufs_read_part(const char *want, uint64_t off, void *dst, uint64_t len);
 void sweet_mdm_start(void);
 
 #define MDM_GCC_PA        0x00100000u
@@ -254,6 +264,8 @@ static const struct mdm_phy_step mdm_phy_seq[] = {
 	{ 0x0a44, 0x03, 0 },
 };
 
+static int md_sahara(void);
+
 static struct {
 	vm_offset_t gcc, tlmm, parf, phy, dbi, iatu, conf, bar0, pool;
 	uint32_t pool_pa;
@@ -528,9 +540,9 @@ md_sbl1(void)
 		printf("SWEET MDM: BHI %s (status %#x)\n", (st >> 30) == 3 ? "ERROR" : "timeout", st);
 		return 15;
 	}
-	/* watch the modem leave the PBL: execenv / MHI state / MDM2AP_STATUS, 10 s */
+	/* watch the modem leave the PBL: execenv / MHI state / MDM2AP_STATUS, 10 s (stage 6: until the SBL is up) */
 	uint32_t ee = 0, last_ee = ~0u, last_ms = ~0u;
-	for (unsigned t = 0; t < 100; ++t) {
+	for (unsigned t = 0; t < 100 && !(md.stage >= 6 && ee == 1 && (last_ms & 1u)); ++t) {
 		ee = md_rd(bhi, BHI_EXECENV);
 		uint32_t ms = md_rd(md.bar0, MHI_STATUS);
 		if (ee != last_ee || ms != last_ms) {
@@ -542,9 +554,492 @@ md_sbl1(void)
 		md_wait(100);
 	}
 	md_state(bhi, "10 s after BHI");
+	return ee == 1 && md.stage >= 6 ? md_sahara() : 0;
+}
+
+
+/* ---- MHI host on the X55 (as sweet_mhi.c / sweet_ipcr.c, polled; its own rings in the X55's pool) ---- */
+
+#define MH_OFF          0x200000u       /* in the pool: after sbl1 */
+#define MH_CHCTX        0x0000u         /* 128 x 44 */
+#define MH_ERCTX        0x2000u         /* 2 x 44 */
+#define MH_CMDCTX       0x2100u
+#define MH_ER0          0x3000u         /* 32 x 16: control */
+#define MH_ER1          0x4000u         /* 256 x 16: data */
+#define MH_CMD          0x5000u         /* 64 x 16 */
+#define MH_TRE_OUT      0x6000u         /* channel 2: 16 x 16 */
+#define MH_TRE_IN       0x6100u         /* channel 3: 16 x 16 */
+#define MH_RXBUF        0x8000u         /* 8 x 4 KiB */
+#define MH_TXBUF        0x10000u        /* 64 KiB */
+#define MH_ER0_N        32u
+#define MH_ER1_N        256u
+#define MH_CMD_N        64u
+#define MH_TRE_N        16u
+#define MH_RX_N         8u
+#define MH_RX_LEN       0x1000u
+#define MH_TX_LEN       0x8000u         /* bytes per transfer element of image data */
+#define MH_EL           16u
+#define SAH_OUT         2u
+#define SAH_IN          3u
+#define MHI_CFG         0x10u
+#define MHI_CHDBOFF     0x18u
+#define MHI_ERDBOFF     0x20u
+#define MHI_CCABAP      0x58u
+#define MHI_ECABAP      0x60u
+#define MHI_CRCBAP      0x68u
+#define MHI_CRDB        0x70u
+#define MHI_CTRLBASE    0x80u
+#define MHI_CTRLLIMIT   0x88u
+#define MHI_DATABASE    0x98u
+#define MHI_DATALIMIT   0xa0u
+
+static struct {
+	vm_offset_t mem;
+	uint32_t pa, chdb, erdb;
+	uint32_t er0_rp, er0_wp, er1_rp, er1_wp, cmd_wp, out_wp, in_wp;
+	unsigned ee, mstate;
+	bool tx_done, gone;
+	int cmd_code;
+} mx;
+
+static volatile uint32_t *
+mx32(uint32_t off)
+{
+	return (volatile uint32_t *)(mx.mem + off);
+}
+
+static void
+mx64(uint32_t off, uint64_t v)
+{
+	mx32(off)[0] = (uint32_t)v;
+	mx32(off)[1] = (uint32_t)(v >> 32);
+}
+
+static uint64_t
+mx_rd64(uint32_t off)
+{
+	return (uint64_t)mx32(off)[0] | (uint64_t)mx32(off)[1] << 32;
+}
+
+static void
+mx_db(uint32_t off, uint64_t v)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	md_wr(md.bar0, off + 4, (uint32_t)(v >> 32));
+	md_wr(md.bar0, off, (uint32_t)v);
+}
+
+static void
+mx_ctx(uint32_t off, uint32_t w0, uint32_t w1, uint32_t w2, uint32_t ring, uint32_t len, uint32_t wp)
+{
+	mx32(off)[0] = w0;
+	mx32(off)[1] = w1;
+	mx32(off)[2] = w2;
+	mx64(off + 12, ring ? mx.pa + ring : 0);
+	mx64(off + 20, len);
+	mx64(off + 28, ring ? mx.pa + ring : 0);
+	mx64(off + 36, ring ? mx.pa + wp : 0);
+}
+
+static void
+mx_tre(uint32_t off, uint64_t ptr, uint32_t d0, uint32_t d1)
+{
+	mx64(off, ptr);
+	mx32(off)[2] = d0;
+	mx32(off)[3] = d1;
+}
+
+/* Control events: execution environment, state changes, command completions. */
+static void
+mx_er0(void)
+{
+	uint64_t devrp = mx_rd64(MH_ERCTX + 28);
+	uint32_t idx = (uint32_t)((devrp - (mx.pa + MH_ER0)) / MH_EL);
+	while (idx < MH_ER0_N && mx.er0_rp != idx) {
+		uint32_t e = MH_ER0 + mx.er0_rp * MH_EL;
+		uint32_t d0 = mx32(e)[2], d1 = mx32(e)[3];
+		unsigned type = (d1 >> 16) & 0xff, code = d0 >> 24;
+		if (type == 0x40) {
+			mx.ee = code;
+			printf("SWEET MDM: MHI event: execution environment %u\n", code);
+		} else if (type == 0x20) {
+			mx.mstate = code;
+			printf("SWEET MDM: MHI event: state %u\n", code);
+		} else if (type == 0x21) {
+			mx.cmd_code = (int)code;
+		} else {
+			printf("SWEET MDM: MHI control event %#x code %u (d0 %#x d1 %#x)\n", type, code, d0, d1);
+		}
+		mx.er0_rp = (mx.er0_rp + 1) % MH_ER0_N;
+		mx.er0_wp = (mx.er0_wp + 1) % MH_ER0_N;
+		uint64_t wp = mx.pa + MH_ER0 + mx.er0_wp * MH_EL;
+		mx64(MH_ERCTX + 36, wp);
+		mx_db(mx.erdb, wp);
+	}
+}
+
+static int
+mhi_init(void)
+{
+	mx.mem = md.pool + MH_OFF;
+	mx.pa = md.pool_pa + MH_OFF;
+	bzero((void *)mx.mem, MH_TXBUF + MH_TX_LEN);
+	bool rst = md_poll(md.bar0, MHI_CTRL, 1u << 1, 0, 2000);
+	bool rdy = md_poll(md.bar0, MHI_STATUS, 1u, 1u, 2000);
+	printf("SWEET MDM: MHI reset %s, ready %s (ctrl %#x status %#x)\n", rst ? "clear" : "STUCK", rdy ? "yes" : "NO",
+	    md_rd(md.bar0, MHI_CTRL), md_rd(md.bar0, MHI_STATUS));
+	if (!rst || !rdy) {
+		return 20;
+	}
+	/* channels 2 (out) / 3 (in) on event ring 1, disabled until START_CHAN (Linux mhi_init_dev_ctxt) */
+	mx_ctx(MH_CHCTX + SAH_OUT * 44u, 2u << 8, 1, 1, 0, 0, 0);
+	mx_ctx(MH_CHCTX + SAH_IN * 44u, 2u << 8, 2, 1, 0, 0, 0);
+	mx_ctx(MH_ERCTX, 0, 1, 1, MH_ER0, MH_ER0_N * MH_EL, MH_ER0 + (MH_ER0_N - 1) * MH_EL);
+	mx_ctx(MH_ERCTX + 44, 1u << 16, 1, 2, MH_ER1, MH_ER1_N * MH_EL, MH_ER1 + (MH_ER1_N - 1) * MH_EL);
+	mx_ctx(MH_CMDCTX, 0, 0, 0, MH_CMD, MH_CMD_N * MH_EL, MH_CMD);
+	__asm__ volatile("dsb sy" ::: "memory");
+	mx.er0_rp = mx.er1_rp = mx.cmd_wp = mx.out_wp = mx.in_wp = 0;
+	mx.er0_wp = MH_ER0_N - 1;
+	mx.er1_wp = MH_ER1_N - 1;
+	mx.chdb = md_rd(md.bar0, MHI_CHDBOFF);
+	mx.erdb = md_rd(md.bar0, MHI_ERDBOFF);
+	mx_db(MHI_CCABAP, mx.pa + MH_CHCTX);
+	mx_db(MHI_ECABAP, mx.pa + MH_ERCTX);
+	mx_db(MHI_CRCBAP, mx.pa + MH_CMDCTX);
+	mx_db(MHI_CTRLBASE, 0);
+	mx_db(MHI_DATABASE, 0);
+	mx_db(MHI_CTRLLIMIT, 0xffffffffu);
+	mx_db(MHI_DATALIMIT, 0xffffffffu);
+	md_wr(md.bar0, MHI_CFG, (md_rd(md.bar0, MHI_CFG) & ~0xffff0000u) | (2u << 16));
+	mx_db(mx.erdb, mx.pa + MH_ER0 + (MH_ER0_N - 1) * MH_EL);
+	mx_db(mx.erdb + 8, mx.pa + MH_ER1 + (MH_ER1_N - 1) * MH_EL);
+	md_wr(md.bar0, MHI_CTRL, (md_rd(md.bar0, MHI_CTRL) & ~0xff00u) | (2u << 8));      /* M0 */
+	printf("SWEET MDM: MHI contexts at %#x, M0 requested (chdb %#x erdb %#x cfg %#x)\n", mx.pa, mx.chdb, mx.erdb,
+	    md_rd(md.bar0, MHI_CFG));
+	for (unsigned t = 0; t < 5000; ++t) {
+		mx_er0();
+		if (((md_rd(md.bar0, MHI_STATUS) >> 8) & 0xff) == 2) {
+			printf("SWEET MDM: MHI in M0 after %u ms (status %#x, ee %u)\n", t, md_rd(md.bar0, MHI_STATUS), mx.ee);
+			return 0;
+		}
+		if (md_rd(md.bar0, MHI_STATUS) & (1u << 2)) {
+			printf("SWEET MDM: MHI SYSERR (status %#x)\n", md_rd(md.bar0, MHI_STATUS));
+			return 21;
+		}
+		delay(1000);
+	}
+	printf("SWEET MDM: no M0 (status %#x)\n", md_rd(md.bar0, MHI_STATUS));
+	return 22;
+}
+
+static int
+mx_chan_start(unsigned ch, bool in, uint32_t ring)
+{
+	mx_ctx(MH_CHCTX + ch * 44u, 1u | (2u << 8), in ? 2u : 1u, 1, ring, MH_TRE_N * MH_EL, ring);
+	mx_tre(MH_CMD + mx.cmd_wp * MH_EL, 0, 0, ch << 24 | 0x12u << 16);
+	mx.cmd_wp = (mx.cmd_wp + 1) % MH_CMD_N;
+	uint64_t a = mx.pa + MH_CMD + mx.cmd_wp * MH_EL;
+	mx64(MH_CMDCTX + 36, a);
+	mx.cmd_code = -1;
+	mx_db(MHI_CRDB, a);
+	for (unsigned i = 0; i < 2000 && mx.cmd_code < 0; ++i) {
+		mx_er0();
+		delay(1000);
+	}
+	printf("SWEET MDM: channel %u start -> %d (ctx state %#x)\n", ch, mx.cmd_code, mx32(MH_CHCTX + ch * 44u)[0]);
+	return mx.cmd_code == 1 ? 0 : 23;
+}
+
+static void
+mx_ring(unsigned ch, uint32_t ring, uint32_t wp)
+{
+	uint64_t a = mx.pa + ring + wp * MH_EL;
+	mx64(MH_CHCTX + ch * 44u + 36, a);
+	mx_db(mx.chdb + 8u * ch, a);
+}
+
+static void
+mx_rx_queue(unsigned buf)
+{
+	mx_tre(MH_TRE_IN + mx.in_wp * MH_EL, mx.pa + MH_RXBUF + buf * MH_RX_LEN, MH_RX_LEN, 0x2u << 16 | 1u << 9);
+	mx.in_wp = (mx.in_wp + 1) % MH_TRE_N;
+	mx_ring(SAH_IN, MH_TRE_IN, mx.in_wp);
+}
+
+/* Received Sahara packets wait here. */
+static uint8_t mx_rxq[8][MH_RX_LEN];
+static uint32_t mx_rxq_len[8];
+static unsigned mx_rxq_head, mx_rxq_tail;
+
+static void
+mx_er1(void)
+{
+	uint32_t ctx = MH_ERCTX + 44;
+	for (;;) {
+		uint32_t idx = (uint32_t)((mx_rd64(ctx + 28) - (mx.pa + MH_ER1)) / MH_EL);
+		if (idx >= MH_ER1_N || mx.er1_rp == idx) {
+			break;
+		}
+		uint32_t e = MH_ER1 + mx.er1_rp * MH_EL;
+		uint64_t ptr = mx_rd64(e);
+		uint32_t d0 = mx32(e)[2], d1 = mx32(e)[3];
+		unsigned type = (d1 >> 16) & 0xff, ch = d1 >> 24, code = d0 >> 24, n = d0 & 0xffff;
+		if (type == 0x22 && ch == SAH_IN) {
+			unsigned slot = (unsigned)((ptr - (mx.pa + MH_TRE_IN)) / MH_EL);
+			uint64_t buf = mx_rd64(MH_TRE_IN + slot * MH_EL);
+			unsigned b = (unsigned)((buf - (mx.pa + MH_RXBUF)) / MH_RX_LEN);
+			if (b < MH_RX_N) {
+				if (mx_rxq_tail - mx_rxq_head < 8 && n <= MH_RX_LEN) {
+					unsigned q = mx_rxq_tail % 8;
+					memcpy(mx_rxq[q], (const void *)(mx.mem + MH_RXBUF + b * MH_RX_LEN), n);
+					mx_rxq_len[q] = n;
+					mx_rxq_tail++;
+				} else {
+					printf("SWEET MDM: sahara receive queue full, %u bytes dropped\n", n);
+				}
+				mx_rx_queue(b);
+			}
+		} else if (type == 0x22 && ch == SAH_OUT) {
+			mx.tx_done = true;
+		} else {
+			printf("SWEET MDM: data event %#x ch %u code %u len %u\n", type, ch, code, n);
+		}
+		mx.er1_rp = (mx.er1_rp + 1) % MH_ER1_N;
+		mx.er1_wp = (mx.er1_wp + 1) % MH_ER1_N;
+		uint64_t wp = mx.pa + MH_ER1 + mx.er1_wp * MH_EL;
+		mx64(ctx + 36, wp);
+		mx_db(mx.erdb + 8, wp);
+	}
+}
+
+/* One transfer to the modem on channel 2 (from the TX buffer), waiting for its completion. */
+static int
+mx_send(uint32_t len)
+{
+	mx.tx_done = false;
+	mx_tre(MH_TRE_OUT + mx.out_wp * MH_EL, mx.pa + MH_TXBUF, len, 0x2u << 16 | 1u << 9);
+	mx.out_wp = (mx.out_wp + 1) % MH_TRE_N;
+	mx_ring(SAH_OUT, MH_TRE_OUT, mx.out_wp);
+	for (unsigned i = 0; i < 20000 && !mx.tx_done; ++i) {
+		mx_er1();
+		if (!mx.tx_done) {
+			delay(100);
+		}
+	}
+	if (!mx.tx_done) {
+		uint32_t st = md_rd(md.bar0, MHI_STATUS);
+		printf("SWEET MDM: send of %u bytes not completed (mhistatus %#x)\n", len, st);
+		if (st == 0xffffffffu) {
+			mx.gone = true;
+		}
+		return ETIMEDOUT;
+	}
 	return 0;
 }
 
+/* ---- Sahara (Qualcomm's image transfer protocol over channels 2 / 3) ---- */
+
+enum { SAH_HELLO = 1, SAH_HELLO_RESP, SAH_READ_DATA, SAH_END_IMAGE_TX, SAH_DONE, SAH_DONE_RESP, SAH_RESET, SAH_RESET_RESP,
+	   SAH_MEM_DEBUG, SAH_MEM_READ, SAH_CMD_READY, SAH_CMD_SWITCH_MODE, SAH_CMD_EXEC, SAH_CMD_EXEC_RESP, SAH_CMD_EXEC_DATA,
+	   SAH_MEM_DEBUG64, SAH_MEM_READ64, SAH_READ_DATA64 };
+
+static const struct { uint32_t id; const char *file; } sah_files[] = {
+	{ 21, "sbl1.mbn" }, { 25, "tz.mbn" }, { 23, "aop.mbn" }, { 8, "qdsp6sw.mbn" }, { 34, "mdmddr.mbn" },
+	{ 36, "multi_image_qti.mbn" }, { 37, "multi_image.mbn" }, { 38, "xbl_cfg.elf" }, { 41, "devcfg.mbn" },
+	{ 33, "hyp.mbn" }, { 16, "efs1.bin" }, { 17, "efs2.bin" }, { 20, "efs3.bin" }, { 40, "apdp.mbn" },
+	{ 42, "sec.elf" }, { 29, "acdb.mbn" }, { 6, "apps.mbn" },
+};
+
+static struct {
+	unsigned images, unknown_id;
+	uint64_t bytes;
+	bool complete, stop;
+	uint32_t last_id;
+	uint64_t id_bytes;
+} sah;
+
+static void
+sah_words(uint32_t cmd, const uint32_t *w, unsigned n)
+{
+	volatile uint32_t *p = mx32(MH_TXBUF);
+	p[0] = cmd;
+	p[1] = 8u + 4u * n;
+	for (unsigned i = 0; i < n; ++i) {
+		p[2 + i] = w[i];
+	}
+	(void)mx_send(8u + 4u * n);
+}
+
+static void
+sah_read(uint32_t id, uint64_t off, uint64_t len)
+{
+	const char *file = NULL;
+	for (unsigned i = 0; i < sizeof(sah_files) / sizeof(sah_files[0]); ++i) {
+		if (sah_files[i].id == id) {
+			file = sah_files[i].file;
+		}
+	}
+	if (file == NULL) {
+		printf("SWEET MDM: sahara: image %u (offset %llu, %llu bytes) is NOT KNOWN: stopping\n", id, off, len);
+		sah.unknown_id = id;
+		sah.stop = true;
+		return;
+	}
+	unsigned efs = 1;
+	(void)PE_parse_boot_argn("sweetmdmefs", &efs, sizeof(efs));
+	const char *part = NULL;
+	if (efs && (id == 16 || id == 17 || id == 20)) {
+		part = id == 16 ? "mdm1m9kefs1" : id == 17 ? "mdm1m9kefs2" : "mdm1m9kefs3";
+	}
+	if (id != sah.last_id) {
+		if (sah.last_id) {
+			printf("SWEET MDM: sahara: image %u: %llu bytes sent\n", sah.last_id, sah.id_bytes);
+		}
+		printf("SWEET MDM: sahara: image %u = %s%s%s: first read %llu bytes at %llu\n", id, part ? "partition " : "",
+		    part ? part : file, part ? "" : "", len, off);
+		sah.last_id = id;
+		sah.id_bytes = 0;
+	}
+	while (len > 0 && !sah.stop) {
+		uint32_t take = (uint32_t)MIN(len, (uint64_t)MH_TX_LEN);
+		void *buf = (void *)(mx.mem + MH_TXBUF);
+		int err;
+		if (part != NULL) {
+			bzero(buf, take);
+			err = sweet_ufs_read_part(part, off, buf, take);
+		} else {
+			uint32_t fsz = 0;
+			err = sweet_fat_pread("modem", "image/sdx55m", file, off, buf, take, &fsz);
+		}
+		if (err) {
+			printf("SWEET MDM: sahara: image %u read at %llu failed: %d\n", id, off, err);
+			sah.stop = true;
+			return;
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+		if (mx_send(take) != 0) {
+			sah.stop = true;
+			return;
+		}
+		off += take;
+		len -= take;
+		sah.bytes += take;
+		sah.id_bytes += take;
+	}
+}
+
+static void
+sah_packet(const uint8_t *p, uint32_t n)
+{
+	uint32_t w[12] = { 0 };
+	memcpy(w, p, MIN(n, (uint32_t)sizeof(w)));
+	if (n < 8) {
+		return;
+	}
+	switch (w[0]) {
+	case SAH_HELLO: {
+		printf("SWEET MDM: sahara HELLO: version %u (compatible %u), max command %u bytes, mode %u\n", w[2], w[3], w[4], w[5]);
+		uint32_t r[10] = { 2, 1, 0, w[5], 0, 0, 0, 0, 0, 0 };
+		sah_words(SAH_HELLO_RESP, r, 10);
+		break;
+	}
+	case SAH_READ_DATA:
+		sah_read(w[2], w[3], w[4]);
+		break;
+	case SAH_READ_DATA64:
+		sah_read(w[2], (uint64_t)w[5] << 32 | w[4], (uint64_t)w[7] << 32 | w[6]);
+		break;
+	case SAH_END_IMAGE_TX:
+		printf("SWEET MDM: sahara: image %u done, status %u (%llu bytes)\n", w[2], w[3], sah.id_bytes);
+		sah.last_id = 0;
+		if (w[3] == 0) {
+			sah.images++;
+			sah_words(SAH_DONE, NULL, 0);
+		} else {
+			sah.stop = true;
+		}
+		break;
+	case SAH_DONE_RESP:
+		printf("SWEET MDM: sahara DONE_RESP: %s (%u images, %llu bytes)\n", w[2] ? "TRANSFER COMPLETE" : "more images",
+		    sah.images, sah.bytes);
+		if (w[2]) {
+			sah.complete = true;
+		}
+		break;
+	case SAH_CMD_READY: {
+		uint32_t mode = 0;
+		printf("SWEET MDM: sahara command mode: switching to image transfer\n");
+		sah_words(SAH_CMD_SWITCH_MODE, &mode, 1);
+		break;
+	}
+	case SAH_MEM_DEBUG:
+	case SAH_MEM_DEBUG64:
+		printf("SWEET MDM: sahara: the modem offers a memory dump (it crashed): resetting it\n");
+		sah_words(SAH_RESET, NULL, 0);
+		sah.stop = true;
+		break;
+	default:
+		printf("SWEET MDM: sahara: command %u, %u bytes: %08x %08x %08x %08x\n", w[0], n, w[2], w[3], w[4], w[5]);
+		break;
+	}
+}
+
+static int
+md_sahara(void)
+{
+	int r = mhi_init();
+	if (r) {
+		return r;
+	}
+	if (mx_chan_start(SAH_OUT, false, MH_TRE_OUT) || mx_chan_start(SAH_IN, true, MH_TRE_IN)) {
+		return 24;
+	}
+	for (unsigned b = 0; b < MH_RX_N; ++b) {
+		mx_rx_queue(b);
+	}
+	printf("SWEET MDM: sahara channels %u/%u running\n", SAH_OUT, SAH_IN);
+	unsigned secs = 120;
+	(void)PE_parse_boot_argn("sweetmdmsecs", &secs, sizeof(secs));
+	bzero(&sah, sizeof(sah));
+	uint64_t start = mach_absolute_time(), now = start, limit;
+	nanoseconds_to_absolutetime((uint64_t)secs * NSEC_PER_SEC, &limit);
+	unsigned idle = 0;
+	while (!sah.complete && !sah.stop && !mx.gone && now - start < limit) {
+		mx_er0();
+		mx_er1();
+		if (mx_rxq_head != mx_rxq_tail) {
+			unsigned q = mx_rxq_head % 8;
+			mx_rxq_head++;
+			sah_packet(mx_rxq[q], mx_rxq_len[q]);
+			idle = 0;
+		} else {
+			delay(200);
+			if (++idle % 25000 == 0) {          /* ~5 s quiet */
+				printf("SWEET MDM: sahara: quiet; mhistatus %#x ee %u execenv %u mdm2ap status %u\n",
+				    md_rd(md.bar0, MHI_STATUS), mx.ee, md_rd(md.bar0, md_rd(md.bar0, 0x28) + BHI_EXECENV),
+				    md_gpio_in(MDM2AP_STATUS));
+				if (md_rd(md.bar0, MHI_STATUS) == 0xffffffffu) {
+					mx.gone = true;
+				}
+			}
+		}
+		now = mach_absolute_time();
+	}
+	uint64_t ns;
+	absolutetime_to_nanoseconds(now - start, &ns);
+	printf("SWEET MDM: sahara ends after %llu ms: %s; %u images, %llu bytes%s\n", ns / 1000000,
+	    sah.complete ? "COMPLETE" : sah.stop ? "stopped" : mx.gone ? "modem gone" : "timeout", sah.images, sah.bytes,
+	    sah.unknown_id ? " (an unknown image id)" : "");
+	/* what the modem does next: it restarts into the images; watch the link and its pins for 10 s */
+	for (unsigned t = 0; t < 20; ++t) {
+		md_wait(500);
+		uint32_t st = md_rd(md.dbi, ELBI_SYS_STTS);
+		printf("SWEET MDM: after sahara +%u ms: link stts %#x (ltssm %#x) mdm2ap status %u errfatal %u\n", (t + 1) * 500,
+		    st, (st >> 12) & 0x3f, md_gpio_in(MDM2AP_STATUS), md_gpio_in(MDM2AP_ERRFATAL));
+	}
+	return sah.complete ? 0 : 25;
+}
