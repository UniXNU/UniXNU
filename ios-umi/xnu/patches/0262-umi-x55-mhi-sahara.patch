+/*
+ * Part of a file of a FAT partition (read-only): bytes [off, off + len) into dst; past the end reads as zeros.
+ * For the X55's Sahara server (sweet_mdm.c), which streams big images (qdsp6sw.mbn, 84 MB) in pieces: the
+ * volume stays mounted and each file keeps a cursor (cluster at a cluster-aligned offset), so sequential
+ * reads do not walk the cluster chain from the start. One caller at a time.
+ */
+static struct {
+	char key[96];
+	uint32_t first, size, cur_clus;
+	uint64_t cur_off;
+} fp_files[24];
+static unsigned fp_nfiles;
+static struct fatvol fp_vol;
+static char fp_part[24];
+
+int
+sweet_fat_pread(const char *part, const char *dir, const char *name, uint64_t off, void *dst, uint32_t len,
+    uint32_t *size)
+{
+	char key[96];
+	snprintf(key, sizeof(key), "%s:%s/%s", part, dir ? dir : "", name);
+	if (fp_vol.buf == NULL || strcmp(fp_part, part) != 0) {
+		if (fp_vol.buf == NULL) {
+			fp_vol.buf = kalloc_data(FAT_BUF_SIZE, Z_WAITOK | Z_ZERO);
+			if (fp_vol.buf == NULL) {
+				return ENOMEM;
+			}
+		}
+		strlcpy(fp_part, part, sizeof(fp_part));
+		fp_vol.part = fp_part;
+		fp_nfiles = 0;
+		int err = fat_mount(&fp_vol);
+		if (err) {
+			fp_part[0] = '\0';
+			return err;
+		}
+	}
+	struct fatvol *v = &fp_vol;
+	unsigned k;
+	for (k = 0; k < fp_nfiles && strcmp(fp_files[k].key, key) != 0; ++k) {
+	}
+	if (k == fp_nfiles) {
+		uint32_t c = 0, sz = 0, f = 0;
+		int err = 0;
+		for (const char *d = dir; !err && d != NULL && *d != '\0';) {
+			char comp[32];
+			size_t n = 0;
+			while (d[n] != '\0' && d[n] != '/' && n < sizeof(comp) - 1) {
+				comp[n] = d[n];
+				n++;
+			}
+			comp[n] = '\0';
+			err = fat_find(v, c, comp, &c, &sz);
+			d += n;
+			while (*d == '/') {
+				d++;
+			}
+		}
+		if (!err) {
+			err = fat_find(v, c, name, &f, &sz);
+		}
+		if (err) {
+			return err;
+		}
+		k = fp_nfiles < 24 ? fp_nfiles++ : 23;
+		strlcpy(fp_files[k].key, key, sizeof(fp_files[k].key));
+		fp_files[k].first = f;
+		fp_files[k].size = sz;
+		fp_files[k].cur_clus = f;
+		fp_files[k].cur_off = 0;
+	}
+	if (size != NULL) {
+		*size = fp_files[k].size;
+	}
+	uint32_t csize = v->bps * v->spc, fsize = fp_files[k].size;
+	uint8_t *out = dst;
+	bzero(out, len);
+	if (off >= fsize) {
+		return 0;
+	}
+	uint32_t want = (uint32_t)MIN((uint64_t)len, fsize - off);
+	/* cursor to the cluster holding off */
+	uint64_t base = off - off % csize;
+	if (base < fp_files[k].cur_off) {
+		fp_files[k].cur_off = 0;
+		fp_files[k].cur_clus = fp_files[k].first;
+	}
+	while (fp_files[k].cur_off < base) {
+		uint32_t n = fat_next(v, fp_files[k].cur_clus);
+		if (n < 2 || n >= 0x0ffffff7) {
+			return EIO;
+		}
+		fp_files[k].cur_clus = n;
+		fp_files[k].cur_off += csize;
+	}
+	uint32_t done = 0, clus = fp_files[k].cur_clus;
+	uint64_t coff = fp_files[k].cur_off;
+	while (done < want) {
+		if (clus < 2 || clus >= 0x0ffffff7) {
+			return EIO;
+		}
+		uint32_t skip = (uint32_t)(off + done - coff);
+		uint32_t n = MIN(csize - skip, want - done);
+		int err = sweet_ufs_read_part(v->part, clus_off(v, clus) + skip, out + done, n);
+		if (err) {
+			return err;
+		}
+		done += n;
+		if (skip + n == csize && done < want) {
+			clus = fat_next(v, clus);
+			coff += csize;
+			fp_files[k].cur_clus = clus;
+			fp_files[k].cur_off = coff;
+		}
+	}
+	return 0;
+}
