index 4fc73c3..79a1f48 100644
--- a/bsd/dev/sweet_adreno.c
+++ b/bsd/dev/sweet_adreno.c
@@ -2900,6 +2900,178 @@ sweet_adreno_fence_wait(uint32_t fence, uint32_t ms)
 	return sa_fence_wait(fence, ms);
 }
 
+/*
+ * ---- v2: the NativeAdreno ABI's needs (iokit/Kernel/arm/SweetAdreno.cpp, for Turnip) ----
+ *
+ * The client picks GPU addresses inside a window of its own (a 4 GB span in context 0), and maps
+ * the pages of its buffer objects at them 4K at a time; submits run several indirect buffers in
+ * one command stream and signal one fence; fences can be waited for in nanoseconds; the always-on
+ * counter is the timestamp. The kernel keeps allocating the step-23/0173 objects below the first
+ * window, so the two allocation schemes never meet.
+ */
+#define SA_WINDOW_BASE   0x200000000ull     /* first client window (8 GB in the 39-bit space) */
+#define SA_WINDOW_SIZE   0x100000000ull     /* one window: 4 GB */
+#define SA_WINDOW_MAX    4
+
+static uint64_t sa_window_next = SA_WINDOW_BASE;
+static uint32_t sa_window_count;
+static uint64_t sa_faults;                     /* SMMU or CP faults seen by the service */
+
+int
+sweet_adreno_window_alloc(uint64_t *base, uint64_t *size)
+{
+	if (!sweet_adreno_service_ready() || sa_window_count >= SA_WINDOW_MAX) {
+		return ENOMEM;
+	}
+	*base = sa_window_next;
+	*size = SA_WINDOW_SIZE;
+	sa_window_next += SA_WINDOW_SIZE;
+	sa_window_count++;
+	return 0;
+}
+
+void
+sweet_adreno_window_free(uint64_t base)
+{
+	/* the pages mapped in it are unmapped by the client (BoFree); nothing to leak but the slot */
+	(void)base;
+}
+
+/* Map n physical pages (4K each) at iova, 4K at a time, as context 0's step-23 objects. */
+int
+sweet_adreno_map_at(uint64_t iova, const uint64_t *pages, uint32_t n)
+{
+	if (!sweet_adreno_service_ready() || (iova & 4095) || n == 0) {
+		return EINVAL;
+	}
+	sa_service_take_lock();
+	int err = 0;
+	for (uint32_t i = 0; i < n; i++) {
+		if (!sa_space_map(&sa_core_space, iova + 4096ull * i, pages[i], PTE_CORE)) {
+			err = ENOMEM;
+			break;
+		}
+	}
+	if (err != 0) {
+		for (uint32_t i = 0; i < n; i++) {
+			uint64_t *pte = sa_space_pte(&sa_core_space, iova + 4096ull * i);
+			if (pte != NULL) {
+				*pte = 0;
+			}
+		}
+	}
+	if (!sa_core_tlb_flush()) {
+		err = err ? err : EIO;
+	}
+	sa_service_drop_lock();
+	return err;
+}
+
+/* Drop [iova, iova+len) out of context 0 and forget its translations. */
+void
+sweet_adreno_unmap_at(uint64_t iova, uint64_t len)
+{
+	if (!sweet_adreno_service_ready() || (iova & 4095)) {
+		return;
+	}
+	sa_service_take_lock();
+	for (uint64_t at = 0; at < len; at += 4096) {
+		uint64_t *pte = sa_space_pte(&sa_core_space, iova + at);
+		if (pte != NULL) {
+			*pte = 0;
+		}
+	}
+	(void)sa_core_tlb_flush();
+	sa_service_drop_lock();
+}
+
+/* One command stream of up to n indirect buffers, one fence when it all ran (0: not submitted). */
+uint32_t
+sweet_adreno_submit_v2(const uint64_t *iova, const uint32_t *dwords, uint32_t n, bool *busy)
+{
+	if (!sweet_adreno_service_ready() || n == 0 || n > 16) {
+		*busy = false;
+		return 0;
+	}
+	sa_service_take_lock();
+	uint32_t need = 6 + 4 * n;
+	*busy = false;
+	for (int i = 0; i < 5000; i++) {
+		if (sa_ring_room(need)) {
+			break;
+		}
+		if (i == 4999) {
+			*busy = true;
+			sa_service_drop_lock();
+			return 0;
+		}
+		delay_for_interval(100, NSEC_PER_USEC);
+	}
+	uint32_t seqno = ++sa_fence_seqno;
+	sa_ring_event(EVENT_CCU_INVALIDATE_DEPTH, false);
+	sa_ring_event(EVENT_CCU_INVALIDATE_COLOR, false);
+	for (uint32_t i = 0; i < n; i++) {
+		sa_ring_packet(CP_INDIRECT_BUFFER, 3);
+		sa_ring((uint32_t)iova[i]);
+		sa_ring((uint32_t)(iova[i] >> 32));
+		sa_ring(dwords[i]);
+	}
+	sa_ring_packet(CP_EVENT_WRITE, 4);
+	sa_ring(EVENT_CACHE_FLUSH_TS);
+	sa_ring(CORE_FENCE_ADDRESS);
+	sa_ring(0);
+	sa_ring(seqno);
+	sa_ring_send();
+	if (sa_space_faulted(&sa_smmu_cb0, "the 3D core") || sa_rd(sa_gpu.base + CP_HW_FAULT) != 0) {
+		sa_faults++;
+	}
+	sa_service_drop_lock();
+	return seqno;
+}
+
+bool
+sweet_adreno_wait_fence_ns(uint32_t fence, uint64_t timeout_ns)
+{
+	uint64_t deadline;
+
+	nanoseconds_to_absolutetime(timeout_ns, &deadline);
+	deadline += mach_absolute_time();
+	do {
+		if ((int32_t)(sa_fence_read() - fence) >= 0) {
+			return true;
+		}
+		delay_for_interval(100, NSEC_PER_USEC);
+	} while (mach_absolute_time() < deadline);
+	return (int32_t)(sa_fence_read() - fence) >= 0;
+}
+
+/* The always-on counter (a6xx.xml CP 0x0980/0x0981, as flame's a6_timestamp reads it). */
+uint64_t
+sweet_adreno_timestamp(void)
+{
+	uint32_t hi = sa_rd(sa_gpu.base + GPU_WORD(0x0981)), lo = sa_rd(sa_gpu.base + GPU_WORD(0x0980)),
+	    hi2 = sa_rd(sa_gpu.base + GPU_WORD(0x0981));
+
+	if (hi2 != hi) {
+		lo = sa_rd(sa_gpu.base + GPU_WORD(0x0980));
+		hi = hi2;
+	}
+	return (uint64_t)hi << 32 | lo;
+}
+
+uint64_t
+sweet_adreno_faults(void)
+{
+	return sa_faults;
+}
+
+/* Push a kernel virtual range out to memory (SweetAdreno.cpp cleans its objects' pages on submit). */
+void
+sweet_adreno_clean(vm_offset_t kva, uint64_t len)
+{
+	sa_to_memory(kva, len);
+}
+
 static bool (*const sa_step_fn[])(void) = {
 	NULL, sa_step_outside, sa_step_fuses, sa_step_gpucc, sa_step_cx_power, sa_step_clocks, sa_step_gmu_read,
 	sa_step_rscc, sa_step_smmu, sa_step_smmu_context, sa_step_gmu_memory, sa_step_trustzone, sa_step_zap_signature,
