 OSDefineMetaClassAndStructors(SweetAdrenoUserClient, IOUserClient);
 
+/* v2 open types: Turnip's darwin backend opens with 0x4147 ('AG'), tests may use 2 */
+#define SWEET_ADRENO_V2_OPEN_AG   0x4147
+#define SWEET_ADRENO_V2_OPEN_2    2
+#define SWEET_ADRENO_V2_TUNNEL    0x4e544e4cu     /* 'NTNL': {magic, method, payload...} */
+#define SWEET_ADRENO_V2_PAGEBUF   1024            /* 4K pages per map_at call */
+#define SWEET_ADRENO_V2_MAX_BOS   65536
+
 bool
 SweetAdrenoUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
 {
@@ -182,9 +225,52 @@ SweetAdrenoUserClient::initWithTask(task_t owningTask, void *securityID, UInt32
 		return false;
 	}
 	fTask = owningTask;
+	if (type == SWEET_ADRENO_V2_OPEN_AG || type == SWEET_ADRENO_V2_OPEN_2) {
+		if (!sweet_adreno_service_ready()) {
+			return false;
+		}
+		fBOCap = 256;
+		fBO = IONewZero(BO, fBOCap);
+		fPageBuf = IONew(uint64_t, SWEET_ADRENO_V2_PAGEBUF);
+		if (fBO == NULL || fPageBuf == NULL ||
+		    sweet_adreno_window_alloc(&fWinBase, &fWinSize) != 0) {
+			IOLog("SWEET ADRENO: v2 client: no window or no memory\n");
+			return false;
+		}
+		fFaultsSeen = sweet_adreno_faults();
+		fV2 = true;
+		IOLog("SWEET ADRENO: v2 client (Turnip ABI): window %#llx..%#llx\n", fWinBase,
+		    fWinBase + fWinSize - 1);
+	}
 	return true;
 }
 
+void
+SweetAdrenoUserClient::free(void)
+{
+	if (fV2) {
+		if (fLastFence != 0 && !sweet_adreno_wait_fence_ns(fLastFence, 2000000000ULL)) {
+			IOLog("SWEET ADRENO: v2 client freed with fence %u still pending\n", fLastFence);
+		}
+		if (fBO != NULL) {
+			for (uint32_t i = 0; i < fBOCap; i++) {
+				v2Release(&fBO[i]);
+			}
+			IODelete(fBO, BO, fBOCap);
+			fBO = NULL;
+		}
+		if (fPageBuf != NULL) {
+			IODelete(fPageBuf, uint64_t, SWEET_ADRENO_V2_PAGEBUF);
+			fPageBuf = NULL;
+		}
+		if (fWinSize != 0) {
+			sweet_adreno_window_free(fWinBase);
+			fWinSize = 0;
+		}
+	}
+	IOUserClient::free();
+}
