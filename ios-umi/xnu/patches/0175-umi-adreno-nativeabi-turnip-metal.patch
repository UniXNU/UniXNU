+/* ---- v2: the NativeAdreno ABI (SweetGPUABI.h), what Turnip's darwin backend speaks ---- */
+
+SweetAdrenoUserClient::BO *
+SweetAdrenoUserClient::v2Find(uint64_t handle)
+{
+	return handle >= 1 && handle <= fBOCap && fBO[handle - 1].md != NULL ? &fBO[handle - 1] : NULL;
+}
+
+IOReturn
+SweetAdrenoUserClient::v2NewSlot(IOMemoryDescriptor *md, IOMemoryMap *kmap, uint64_t bytes,
+    bool imported, uint64_t *handle)
+{
+	uint32_t i = 0;
+	while (i < fBOCap && fBO[i].md != NULL) {
+		i++;
+	}
+	if (i == fBOCap) {
+		if (fBOCap >= SWEET_ADRENO_V2_MAX_BOS) {
+			return kIOReturnNoResources;
+		}
+		BO *n = IONewZero(BO, fBOCap * 2);
+		if (n == NULL) {
+			return kIOReturnNoMemory;
+		}
+		memcpy(n, fBO, sizeof(*n) * fBOCap);
+		IODelete(fBO, BO, fBOCap);
+		fBO = n;
+		fBOCap *= 2;
+	}
+	fBO[i].md = md;
+	fBO[i].kmap = kmap;
+	fBO[i].bytes = bytes;
+	fBO[i].iova = 0;
+	fBO[i].imported = imported;
+	*handle = i + 1;
+	return kIOReturnSuccess;
+}
+
+/* Unmap from the GPU and drop (imports give back the client's pinned pages) */
+void
+SweetAdrenoUserClient::v2Release(SweetAdrenoUserClient::BO *bo)
+{
+	if (bo->md == NULL) {
+		return;
+	}
+	if (bo->iova != 0) {
+		sweet_adreno_unmap_at(bo->iova, bo->bytes);
+	}
+	if (bo->imported) {
+		bo->md->complete();
+	}
+	bo->md->release();
+	if (bo->kmap != NULL) {
+		bo->kmap->release();
+	}
+	bzero(bo, sizeof(*bo));
+}
+
+IOReturn
+SweetAdrenoUserClient::v2Method(uint32_t method, const void *in, uint32_t inSize, void *out,
+    uint32_t *outSize)
+{
+#define V2_IN(T)        if (in == NULL || inSize != sizeof(T)) return kIOReturnBadArgument; const T *rq = (const T *)in
+#define V2_OUT(T)       if (out == NULL || *outSize < sizeof(T)) return kIOReturnBadArgument; \
+	                T *rp = (T *)out; bzero(rp, sizeof(T)); *outSize = sizeof(T)
+	switch (method) {
+	case NativeAdrenoMethodQuery: {
+		V2_OUT(NativeAdrenoAbiParams);
+		rp->abi_version = NativeAdrenoAbiVersion;
+		rp->input_bits = 39;                  /* context 0's page tables (step 18) */
+		rp->output_bits = 36;                 /* SM8250 DRAM */
+		rp->flags = NativeAdrenoParamsHostImport;
+		rp->max_bo_bytes = 1ULL << NativeAdrenoAbiMaxBoBytesShift;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodGetDeviceInfo: {
+		V2_OUT(NativeAdrenoAbiDeviceInfo);
+		/* what the kernel brings up (a6xx_catalog.c / a6xx_set_ubwc_config for the A650) */
+		rp->chip_id = 0x06050002;
+		rp->gmem_bytes = 0x120000;
+		rp->gmem_base = 0x100000;
+		rp->uche_trap_base = 0x0001fffffffff000ULL;        /* step 20's UCHE_TRAP_BASE */
+		rp->va_start = fWinBase;
+		rp->va_size = fWinSize;
+		rp->highest_bank_bit = 16;
+		rp->ubwc_swizzle = 0x6;
+		rp->macrotile_mode = 0;
+		rp->ubwc_version = 4;
+		rp->flags = NativeAdrenoDeviceClientIova;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodBoAlloc: {
+		V2_IN(NativeAdrenoAbiBoAlloc);
+		V2_OUT(NativeAdrenoAbiBoAllocReply);
+		if (rq->bytes == 0 || (rq->bytes & 4095) || rq->bytes > (1ULL << NativeAdrenoAbiMaxBoBytesShift) ||
+		    rq->align_log2 < 12 || rq->align_log2 > 24 || rq->contiguous > 1) {
+			return kIOReturnBadArgument;
+		}
+		IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIODirectionInOut | kIOMemoryKernelUserShared, rq->bytes, 1u << rq->align_log2);
+		IOMemoryMap *kmap = md != NULL ? md->map() : NULL;
+		if (md == NULL || kmap == NULL || md->prepare() != kIOReturnSuccess) {
+			IOLog("SWEET ADRENO: v2 BoAlloc of %llu bytes failed\n", rq->bytes);
+			OSSafeReleaseNULL(kmap);
+			OSSafeReleaseNULL(md);
+			return kIOReturnNoMemory;
+		}
+		bzero((void *)kmap->getVirtualAddress(), rq->bytes);
+		uint64_t h = 0;
+		IOReturn r = v2NewSlot(md, kmap, rq->bytes, false, &h);
+		if (r != kIOReturnSuccess) {
+			kmap->release();
+			md->release();
+			return r;
+		}
+		rp->handle = h;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodBoImport: {
+		V2_IN(NativeAdrenoAbiBoImport);
+		V2_OUT(NativeAdrenoAbiBoAllocReply);
+		if (rq->address == 0 || ((rq->address | rq->bytes) & 4095) || rq->bytes == 0 ||
+		    rq->bytes > (1ULL << NativeAdrenoAbiMaxBoBytesShift)) {
+			return kIOReturnBadArgument;
+		}
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(rq->address, rq->bytes,
+		    kIODirectionInOut, fTask);
+		if (md != NULL && md->prepare() != kIOReturnSuccess) {
+			md->release();
+			md = NULL;                    /* read-only pages: nothing imports yet anyway */
+		}
+		if (md == NULL) {
+			return kIOReturnBadArgument;
+		}
+		uint64_t h = 0;
+		IOReturn r = v2NewSlot(md, NULL, rq->bytes, true, &h);
+		if (r != kIOReturnSuccess) {
+			md->complete();
+			md->release();
+			return r;
+		}
+		rp->handle = h;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodBoMap: {
+		V2_IN(NativeAdrenoAbiBoMap);
+		V2_OUT(NativeAdrenoAbiBoMapReply);
+		if (!(rq->permissions & 1) || (rq->permissions & ~3u) || (rq->iova & 4095) || rq->reserved) {
+			return kIOReturnBadArgument;
+		}
+		BO *bo = v2Find(rq->handle);
+		IOReturn r = kIOReturnSuccess;
+		if (bo == NULL) {
+			r = kIOReturnBadArgument;
+		} else if (bo->iova != 0) {
+			r = kIOReturnBusy;
+		} else if (rq->iova < fWinBase || rq->iova + bo->bytes > fWinBase + fWinSize ||
+		    rq->iova + bo->bytes < rq->iova) {
+			r = kIOReturnBadArgument;
+		}
+		/* the pages in 4K steps, mapped in pieces of SWEET_ADRENO_V2_PAGEBUF */
+		for (uint64_t off = 0; r == kIOReturnSuccess && off < bo->bytes;) {
+			uint32_t n = 0;
+			uint64_t start = off;
+			for (; n < SWEET_ADRENO_V2_PAGEBUF && off < bo->bytes; n++, off += 4096) {
+				IOByteCount seg = 0;
+				addr64_t pa = bo->md->getPhysicalSegment(off, &seg, kIOMemoryMapperNone);
+				if (pa == 0 || (pa & 4095)) {
+					r = kIOReturnVMError;
+					break;
+				}
+				fPageBuf[n] = pa;
+			}
+			if (r == kIOReturnSuccess && sweet_adreno_map_at(rq->iova + start, fPageBuf, n) != 0) {
+				r = kIOReturnNoResources;
+			}
+		}
+		if (r == kIOReturnSuccess) {
+			bo->iova = rq->iova;
+			rp->iova = rq->iova;
+		} else if (bo != NULL && bo->iova == 0 && r != kIOReturnBadArgument && r != kIOReturnBusy) {
+			sweet_adreno_unmap_at(rq->iova, bo->bytes);
+		}
+		return r;
+	}
+	case NativeAdrenoMethodBoFree: {
+		V2_IN(NativeAdrenoAbiBoFree);
+		BO *bo = v2Find(rq->handle);
+		if (bo == NULL) {
+			return kIOReturnBadArgument;
+		}
+		v2Release(bo);
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodBoCpuMap: {
+		V2_IN(NativeAdrenoAbiBoCpuMap);
+		V2_OUT(NativeAdrenoAbiBoCpuMapReply);
+		BO *bo = v2Find(rq->handle);
+		if (bo == NULL || bo->imported) {
+			return kIOReturnBadArgument;
+		}
+		rp->token = (uint32_t)rq->handle;       /* clientMemoryForType type */
+		rp->bytes = bo->bytes;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodBoCpuUnmap:
+		return kIOReturnSuccess;                /* the mapping is the client's (IOConnectUnmapMemory64) */
+	case NativeAdrenoMethodSubmit: {
+		V2_IN(NativeAdrenoAbiSubmit);
+		V2_OUT(NativeAdrenoAbiSubmitReply);
+		if (rq->buffer_count == 0 || rq->buffer_count > NativeAdrenoAbiMaxBuffers || rq->reserved) {
+			return kIOReturnBadArgument;
+		}
+		uint64_t iova[NativeAdrenoAbiMaxBuffers];
+		uint32_t dw[NativeAdrenoAbiMaxBuffers];
+		for (uint32_t i = 0; i < rq->buffer_count; i++) {
+			const NativeAdrenoAbiSubmitBuffer *b = &rq->buffers[i];
+			if ((b->bytes & 3) || b->bytes == 0 || b->bytes / 4 > 0xfffff || b->iova < fWinBase ||
+			    b->iova + b->bytes > fWinBase + fWinSize) {
+				return kIOReturnBadArgument;
+			}
+			iova[i] = b->iova;
+			dw[i] = (uint32_t)(b->bytes / 4);
+		}
+		if (rq->wait_fence != 0 && sweet_adreno_wait_fence_ns((uint32_t)rq->wait_fence, rq->wait_timeout_ns)) {
+			return kIOReturnTimeout;
+		}
+		/* what the CPU wrote is out to memory before the GPU reads it: clean every mapped BO
+		 * that overlaps the submitted buffers (a WC user mapping has no dirty lines anyway;
+		 * a cached one would be cleaned here through the kernel's own view of the pages) */
+		for (uint32_t i = 0; i < fBOCap; i++) {
+			BO *bo = &fBO[i];
+			if (bo->md == NULL || bo->iova == 0 || bo->kmap == NULL) {
+				continue;
+			}
+			for (uint32_t b = 0; b < rq->buffer_count; b++) {
+				uint64_t s = rq->buffers[b].iova, e = s + rq->buffers[b].bytes;
+				if (s < bo->iova + bo->bytes && e > bo->iova) {
+					sweet_adreno_clean((vm_offset_t)bo->kmap->getVirtualAddress(), bo->bytes);
+					break;
+				}
+			}
+		}
+		bool busy = false;
+		uint32_t fence = sweet_adreno_submit_v2(iova, dw, rq->buffer_count, &busy);
+		if (fence == 0) {
+			return busy ? kIOReturnBusy : kIOReturnNotReady;
+		}
+		fLastFence = fence;
+		rp->fence = fence;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodWaitFence: {
+		V2_IN(NativeAdrenoAbiWaitFence);
+		return sweet_adreno_wait_fence_ns((uint32_t)rq->fence, rq->timeout_ns) ?
+		    kIOReturnSuccess : kIOReturnTimeout;
+	}
+	case NativeAdrenoMethodGetTimestamp: {
+		V2_OUT(NativeAdrenoAbiTimestamp);
+		rp->ticks = sweet_adreno_timestamp();
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodGetStatus: {
+		V2_OUT(NativeAdrenoAbiStatus);
+		uint64_t faults = sweet_adreno_faults();
+		if (faults != fFaultsSeen) {
+			fFaultsSeen = faults;
+			rp->faults = 1;                 /* any change means this client's work may be lost */
+		}
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodSetMetadata:
+		return kIOReturnSuccess;                /* only for dma-buf exports, which Darwin has not */
+	case NativeAdrenoMethodGetMetadata: {
+		V2_OUT(NativeAdrenoAbiMetadata);
+		return kIOReturnSuccess;                /* bytes 0 */
+	}
+	case NativeAdrenoMethodCreateQueue: {
+		V2_OUT(NativeAdrenoAbiQueueReply);
+		rp->queue = 1;                          /* one ring: every queue is queue 0 */
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodCloseQueue:
+		return kIOReturnSuccess;
+	default:
+		return kIOReturnUnsupported;
+	}
+#undef V2_IN
+#undef V2_OUT
+}
