 void pe_init_fiq(void);
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 extern uint32_t sweet_vtimer_intid;
+extern uint32_t sweet_gic_masked;
+extern void sweet_gic_mask(uint32_t intid);
