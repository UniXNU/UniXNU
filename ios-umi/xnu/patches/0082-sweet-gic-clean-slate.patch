+++ b/osfmk/arm64/sleh.c
@@ -1887,6 +1887,8 @@ sleh_irq(arm_saved_state_t *state)
 			    cdp->interrupt_refCon,
 			    cdp->interrupt_nub,
 			    intid);
+		} else {
+			sweet_gic_mask(intid);
 		}
 		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
