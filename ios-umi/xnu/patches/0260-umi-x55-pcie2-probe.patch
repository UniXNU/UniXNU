+/*
+ * SWEET umi: the external modem, a Snapdragon X55 (SDX55M) on PCIe2. Modem work step 2a
+ * (boot-arg sweetmdm=N, after sweetmdmdelay seconds, default 120 = after the Wi-Fi's PCIe0).
+ *
+ * umi live FDT: qcom,mdm0 "qcom,ext-sdx55m" (esoc), TLMM (south tile) AP2MDM status 56 /
+ * errfatal 57, MDM2AP errfatal 1 / status 3; PCIe2 (qcom,pcie@1c10000): PERST 85, CLKREQ 86
+ * (pci_e2), WAKE 87, PHY rails pm8150 L5A / L9A (the PCIe0 ones), smmu-sid-base 0x1d00. The
+ * X55's PMIC (PMX55, "pmxprairie") is SPMI SID 8, its modem-reset PON at 0x800.
+ * Power on as msm-4.19 esoc-mdm-pon.c mdm4x_do_first_power_on + sdx55m_toggle_soft_reset:
+ * PMX55 PON warm reset (SW_RST_S2_CTL2 0, S2_CTL 1, S2_CTL2 0x80, GO 0xa5), 150 ms,
+ * AP2MDM_STATUS high; then the image request (MHI BHI, a later step).
+ *   sweetmdm=1  read only: MDM2AP pins, PMX55 PON registers
+ *   sweetmdm=2  + AP2MDM pins, PCIe2 GDSC / clocks / PHY
+ *   sweetmdm=3  + warm reset (unless sweetmdmreset=0), AP2MDM_STATUS, PERST, link, endpoint ID
+ *   sweetmdm=4  + BAR0 and the MHI / BHI registers
+ * PCIe sequence as sweet_pcie.c (PCIe0, QCA6390) with the PCIe2 registers (Linux gcc-sm8250.c).
+ * Built inside sweet_spmi.c (the local build cannot add source files).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
