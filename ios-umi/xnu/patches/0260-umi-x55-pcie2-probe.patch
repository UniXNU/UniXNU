+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern bool sweet_board_is_umi(void);
+extern int sweet_pmic_read(uint16_t ppid, uint8_t reg, uint8_t *val);
+extern int sweet_pmic_write(uint16_t ppid, uint8_t reg, uint8_t val);
+void sweet_mdm_start(void);
+
