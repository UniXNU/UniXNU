+
+static struct {
+	vm_offset_t gcc, tlmm, parf, phy, dbi, iatu, conf, bar0;
+	unsigned stage;
+	int chan;
+} md;
+
+static uint32_t
+md_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+md_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+md_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&md.chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+md_poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, unsigned ms)
+{
+	for (unsigned i = 0; i < ms * 10u; ++i) {
+		if ((md_rd(base, off) & mask) == want) {
+			return true;
+		}
+		delay(100);
+	}
+	return false;
+}
+
+/* TLMM pin: offset pin * 0x1000 inside its tile (all of ours are south). */
+static void
+md_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	uint32_t off = pin * 0x1000u;
+	if (out) {
+		md_wr(md.tlmm, off + 4u, (md_rd(md.tlmm, off + 4u) & ~2u) | (high ? 2u : 0u));
+	}
+	uint32_t cfg = md_rd(md.tlmm, off) & ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	md_wr(md.tlmm, off, cfg);
+}
+
+static unsigned
+md_gpio_in(unsigned pin)
+{
+	return md_rd(md.tlmm, pin * 0x1000u + 4u) & 1u;
+}
+
+static void
+md_pins(const char *when)
+{
+	printf("SWEET MDM: %s: mdm2ap status %u errfatal %u | ap2mdm status %#x/%u errfatal %#x/%u | perst %#x/%u clkreq %#x wake %u\n",
+	    when, md_gpio_in(MDM2AP_STATUS), md_gpio_in(MDM2AP_ERRFATAL),
+	    md_rd(md.tlmm, AP2MDM_STATUS * 0x1000u), md_gpio_in(AP2MDM_STATUS),
+	    md_rd(md.tlmm, AP2MDM_ERRFATAL * 0x1000u), md_gpio_in(AP2MDM_ERRFATAL),
+	    md_rd(md.tlmm, PERST2_PIN * 0x1000u), md_gpio_in(PERST2_PIN),
+	    md_rd(md.tlmm, CLKREQ2_PIN * 0x1000u), md_gpio_in(WAKE2_PIN));
+}
+
+static void
+md_pmx55(const char *when)
+{
+	/* PON: revision 0x00-0x05, reason / warm-reset / poff / on registers 0x08-0x0f, S2 reset 0x62-0x64 */
+	uint8_t r[24];
+	static const uint8_t regs[24] = { 0x04, 0x05, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
+		0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x46, 0x62, 0x63, 0x64, 0x80, 0x88, 0x8a, 0xc0 };
+	int bad = 0;
+	for (unsigned i = 0; i < 24; ++i) {
+		r[i] = 0xee;
+		if (sweet_pmic_read(PMX55_PON, regs[i], &r[i]) != 0) {
+			bad++;
+		}
+	}
+	printf("SWEET MDM: %s: PMX55 PON (%d read errors) type/sub %02x %02x | 08-0f %02x %02x %02x %02x %02x %02x %02x %02x"
+	    " | 10-15 %02x %02x %02x %02x %02x %02x | 46 %02x | s2 %02x %02x %02x | 80 %02x 88 %02x 8a %02x c0 %02x\n",
+	    when, bad, r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9], r[10], r[11], r[12], r[13], r[14],
+	    r[15], r[16], r[17], r[18], r[19], r[20], r[21], r[22], r[23]);
+}
+
+/* msm-4.19 qpnp_pon_modem_pwr_off(PON_POWER_OFF_WARM_RESET = 1) on the modem-reset PON. */
+static int
+md_warm_reset(void)
+{
+	int e = sweet_pmic_write(PMX55_PON, 0x63, 0);
+	delay(500);
+	if (!e) {
+		e = sweet_pmic_write(PMX55_PON, 0x62, 1);
+	}
+	if (!e) {
+		e = sweet_pmic_write(PMX55_PON, 0x63, 0x80);
+	}
+	delay(500);
+	if (!e) {
+		e = sweet_pmic_write(PMX55_PON, 0x64, 0xa5);
+	}
+	printf("SWEET MDM: PMX55 warm reset -> %d\n", e);
+	return e;
+}
+
+static bool
+md_rcg_xo(uint32_t rcg)
+{
+	md_wr(md.gcc, rcg + 4u, 0);
+	md_wr(md.gcc, rcg, md_rd(md.gcc, rcg) | 1u);
+	return md_poll(md.gcc, rcg, 1u, 0, 10);
+}
+
+static void
+md_clocks_dump(const char *when)
+{
+	printf("SWEET MDM: %s: gdsc %#x vote %#x aux %#x cfg %#x mstr %#x slv %#x pipe %#x q2a %#x refgen %#x mdm_clkref %#x\n",
+	    when, md_rd(md.gcc, GCC_PCIE2_GDSCR), md_rd(md.gcc, GCC_PCIE2_VOTE),
+	    md_rd(md.gcc, 0x6028), md_rd(md.gcc, 0x6024), md_rd(md.gcc, 0x601c), md_rd(md.gcc, 0x6014),
+	    md_rd(md.gcc, 0x602c), md_rd(md.gcc, 0x6010), md_rd(md.gcc, GCC_REFGEN_CBCR), md_rd(md.gcc, GCC_MDM_CLKREF));
+}
+
+static void
+md_iatu(unsigned idx, uint32_t type, uint32_t base, uint32_t size, uint32_t target)
+{
+	vm_offset_t r = md.iatu + 0x200u * idx;
+	md_wr(r, 0x04, 0);
+	md_wr(r, 0x08, base);
+	md_wr(r, 0x0c, 0);
+	md_wr(r, 0x10, base + size - 1);
+	md_wr(r, 0x14, target);
+	md_wr(r, 0x18, 0);
+	md_wr(r, 0x00, type);
+	md_wr(r, 0x04, 1u << 31);
+	(void)md_poll(r, 0x04, 1u << 31, 1u << 31, 5);
+}
+
+static int
+md_bar0(void)
+{
+	md_wr(md.conf, 0x10, 0xffffffffu);
+	uint32_t mask = md_rd(md.conf, 0x10);
+	uint32_t size = ~(mask & ~0xfu) + 1;
+	printf("SWEET MDM: BAR0 mask %#x -> %u KiB, BAR1 %#x, BAR2 %#x\n", mask, size >> 10,
+	    md_rd(md.conf, 0x14), md_rd(md.conf, 0x18));
+	if (size == 0 || size > MDM_MEM_SIZE - (MDM_BAR0_PA - MDM_MEM_PA)) {
+		return 5;
+	}
+	md_wr(md.conf, 0x10, MDM_BAR0_PA);
+	if (mask & 4u) {
+		md_wr(md.conf, 0x14, 0);
+	}
+	md_wr(md.dbi, 0x20, ((MDM_MEM_PA + MDM_MEM_SIZE - 1) & 0xfff00000u) | (MDM_MEM_PA >> 16));
+	md_iatu(1, 0, MDM_MEM_PA, MDM_MEM_SIZE, MDM_MEM_PA);
+	md_wr(md.conf, 0x04, md_rd(md.conf, 0x04) | 0x6u);
+	if (md.bar0 == 0) {
+		md.bar0 = ml_io_map(MDM_BAR0_PA, size < 0x100000u ? size : 0x100000u);
+	}
+	if (md.bar0 == 0) {
+		return 6;
+	}
+	printf("SWEET MDM: MHI regs: len %#x ver %#x cfg %#x chdboff %#x erdboff %#x bhioff %#x bhieoff %#x ctrl %#x status %#x\n",
+	    md_rd(md.bar0, 0x00), md_rd(md.bar0, 0x08), md_rd(md.bar0, 0x10), md_rd(md.bar0, 0x18),
+	    md_rd(md.bar0, 0x20), md_rd(md.bar0, 0x28), md_rd(md.bar0, 0x2c), md_rd(md.bar0, 0x38),
+	    md_rd(md.bar0, 0x68));
+	uint32_t bhi = md_rd(md.bar0, 0x28);
+	if (bhi && bhi < 0x100000u) {
+		printf("SWEET MDM: BHI at %#x: execenv %#x status %#x errcode %#x serial %#x oem %#x\n", bhi,
+		    md_rd(md.bar0, bhi + 0x28), md_rd(md.bar0, bhi + 0x2c), md_rd(md.bar0, bhi + 0x34),
+		    md_rd(md.bar0, bhi + 0x40), md_rd(md.bar0, bhi + 0x6c));
+	}
+	return 0;
+}
+
+static int
+md_run(void)
+{
+	md_pins("before");
+	md_pmx55("before");
+	if (md.stage < 2) {
+		return 0;
+	}
+	/* esoc pinctrl mdm_active: AP2MDM 56 / 57 GPIO outputs, low (status 0, no errfatal) until the modem is reset */
+	md_gpio(AP2MDM_ERRFATAL, 0, 0, 7, true, false);
+	md_gpio(AP2MDM_STATUS, 0, 0, 7, true, false);
+	md_gpio(MDM2AP_STATUS, 0, 0, 3, false, false);
+	md_gpio(MDM2AP_ERRFATAL, 0, 0, 3, false, false);
+	/* PERST low, CLKREQ to pci_e2 (mux 1, pull-up), WAKE input pull-up */
+	md_gpio(PERST2_PIN, 0, 1, 0, true, false);
+	md_gpio(CLKREQ2_PIN, 1, 3, 0, false, false);
+	md_gpio(WAKE2_PIN, 0, 3, 0, false, false);
+
+	md_wr(md.gcc, GCC_PCIE2_GDSCR, md_rd(md.gcc, GCC_PCIE2_GDSCR) & ~1u);
+	if (!md_poll(md.gcc, GCC_PCIE2_GDSCR, 1u << 31, 1u << 31, 50)) {
+		printf("SWEET MDM: PCIe2 GDSC did not power on: %#x\n", md_rd(md.gcc, GCC_PCIE2_GDSCR));
+		return 1;
+	}
+	bool aux = md_rcg_xo(GCC_PCIE2_AUX_RCG);
+	bool ref = md_rcg_xo(GCC_REFGEN_RCG);
+	md_wr(md.gcc, GCC_REFGEN_CBCR, md_rd(md.gcc, GCC_REFGEN_CBCR) | 1u);
+	md_wr(md.gcc, GCC_MDM_CLKREF, md_rd(md.gcc, GCC_MDM_CLKREF) | 1u);
+	md_wr(md.gcc, GCC_PCIE2_VOTE, md_rd(md.gcc, GCC_PCIE2_VOTE) | GCC_PCIE2_VOTE_MASK);
+	md_wr(md.gcc, GCC_AGGRE_TBU_CBCR, md_rd(md.gcc, GCC_AGGRE_TBU_CBCR) | 1u);
+	md_wr(md.gcc, GCC_DDRSS_TBU_CBCR, md_rd(md.gcc, GCC_DDRSS_TBU_CBCR) | 1u);
+	delay(100);
+	printf("SWEET MDM: rcg aux %d refgen %d\n", aux, ref);
+	md_clocks_dump("clocks on");
+
+	md_wr(md.gcc, GCC_PCIE2_BCR, 1);
+	md_wr(md.gcc, GCC_PCIE2_PHY_BCR, 1);
+	delay(1000);
+	md_wr(md.gcc, GCC_PCIE2_PHY_BCR, 0);
+	md_wr(md.gcc, GCC_PCIE2_BCR, 0);
+	delay(1000);
+
+	md_wr(md.parf, PARF_DEVICE_TYPE, 4);
+	md_wr(md.parf, PARF_PHY_CTRL, md_rd(md.parf, PARF_PHY_CTRL) & ~1u);
+	md_wr(md.parf, PARF_DBI_BASE_ADDR, 0);
+	md_wr(md.parf, PARF_SYS_CTRL, 0x365e);
+	md_wr(md.parf, PARF_MHI_CLK_RST, md_rd(md.parf, PARF_MHI_CLK_RST) | (1u << 4));
+	md_wr(md.parf, PARF_PM_CTRL, md_rd(md.parf, PARF_PM_CTRL) | (1u << 5));
+	md_wr(md.parf, PARF_AXI_HALT_V2, md_rd(md.parf, PARF_AXI_HALT_V2) | (1u << 31));
+	md_wr(md.parf, PARF_SLV_ADDR_SPACE, 0x4000000);
+
+	for (unsigned i = 0; i < sizeof(mdm_phy_seq) / sizeof(mdm_phy_seq[0]); ++i) {
+		md_wr(md.phy, mdm_phy_seq[i].off, mdm_phy_seq[i].val);
+		if (mdm_phy_seq[i].delay_us) {
+			delay(mdm_phy_seq[i].delay_us);
+		}
+	}
+	bool phy_ok = md_poll(md.phy, PHY_PCS_STATUS, 1u << 6, 0, 100);
+	printf("SWEET MDM: PCIe2 PHY %s, status %#x\n", phy_ok ? "ready" : "NOT ready", md_rd(md.phy, PHY_PCS_STATUS));
+	md_clocks_dump("phy");
+	if (!phy_ok || md.stage == 2) {
+		return phy_ok ? 0 : 2;
+	}
+
+	/* the modem: warm reset through its PMIC, 150 ms, AP2MDM_STATUS high (esoc first power on) */
+	unsigned reset = 1;
+	(void)PE_parse_boot_argn("sweetmdmreset", &reset, sizeof(reset));
+	if (reset) {
+		(void)md_warm_reset();
+		md_wait(150);
+	}
+	md_gpio(AP2MDM_STATUS, 0, 0, 7, true, true);
+	md_pins("ap2mdm status high");
+	for (unsigned i = 0; i < 20 && !md_gpio_in(MDM2AP_STATUS); ++i) {
+		md_wait(100);
+	}
+	md_pins("after 2 s");
+	md_pmx55("after reset");
+
+	md_wr(md.dbi, DBI_BUSNUM, 0x00010100);
+	md_wr(md.dbi, DBI_CMD, md_rd(md.dbi, DBI_CMD) | 0x6u);
+	md_wait(100);
+	md_gpio(PERST2_PIN, 0, 1, 0, true, true);
+	md_wait(1);
+	md_wr(md.parf, PARF_LTSSM, md_rd(md.parf, PARF_LTSSM) | (1u << 8));
+	bool up = false;
+	uint32_t last = ~0u, st = 0;
+	for (unsigned i = 0; i < 30000 && !up; ++i) {           /* up to 3 s: the X55 PBL may be slow */
+		st = md_rd(md.dbi, ELBI_SYS_STTS);
+		if (((st >> 12) & 0x3f) != last) {
+			last = (st >> 12) & 0x3f;
+			printf("SWEET MDM: LTSSM %#x at %u00 us (stts %#x)\n", last, i, st);
+		}
+		up = (st & (1u << 10)) && (md_rd(md.dbi, DBI_LINKCTL) & (1u << 29));
+		delay(100);
+	}
+	uint32_t ls = md_rd(md.dbi, DBI_LINKCTL);
+	printf("SWEET MDM: PCIe2 link %s: linkctl %#x (gen %u x%u) stts %#x\n", up ? "UP" : "down",
+	    ls, (ls >> 16) & 0xf, (ls >> 20) & 0x3f, st);
+	md_pins("link");
+	if (!up) {
+		return 3;
+	}
+	/* BDF -> SMMU stream table (as sweet_pcie.c): BDF 0x100 -> sid-base 0x1d00 + 1 */
+	for (unsigned i = 0; i < 256; ++i) {
+		md_wr(md.parf, 0x2000u + 4u * i, 0);
+	}
+	md_wr(md.parf, 0x2000u + 4u * 0x15u, 0x0100u << 16 | 1u << 8);
+	md_iatu(0, 4, MDM_CONF_PA, 0x1000, 1u << 24);
+	uint32_t id = md_rd(md.conf, 0x00);
+	printf("SWEET MDM: bus 1 dev 0: id %#x class/rev %#x%s\n", id, md_rd(md.conf, 0x08),
+	    (id & 0xffffu) == 0x17cbu ? " (Qualcomm)" : "");
+	if ((id & 0xffffu) != 0x17cbu) {
+		return 4;
+	}
+	return md.stage >= 4 ? md_bar0() : 0;
+}
+
+static void
+md_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	unsigned delay_s = 120;
+	(void)PE_parse_boot_argn("sweetmdmdelay", &delay_s, sizeof(delay_s));
+	md_wait(delay_s * 1000u);
+	md.gcc = ml_io_map(MDM_GCC_PA, MDM_GCC_SIZE);
+	md.tlmm = ml_io_map(MDM_SOUTH_PA, MDM_SOUTH_SIZE);
+	md.parf = ml_io_map(MDM_PARF_PA, 0x3000);
+	md.phy = ml_io_map(MDM_PHY_PA, 0x2000);
+	md.dbi = ml_io_map(MDM_DBI_PA, 0x1000);
+	md.iatu = ml_io_map(MDM_IATU_PA, 0x1000);
+	md.conf = ml_io_map(MDM_CONF_PA, 0x1000);
+	int r = -2;
+	if (md.gcc && md.tlmm && md.parf && md.phy && md.dbi && md.iatu && md.conf) {
+		r = md_run();
+	} else {
+		printf("SWEET MDM: mapping failed\n");
+	}
+	printf("SWEET MDM: stage %u done, result %d\n", md.stage, r);
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_mdm_start(void)
+{
+	unsigned stage = 0;
+	(void)PE_parse_boot_argn("sweetmdm", &stage, sizeof(stage));
+	if (!stage || !sweet_board_is_umi()) {
+		return;
+	}
+	md.stage = stage;
+	thread_t thread;
+	if (kernel_thread_start(md_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
