From 67de4bd0e2765214f1acc0539caffaa45b1e7448 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Mon, 9 Nov 2026 20:33:21 +0100
Subject: [PATCH] umi: AppleIPAppender stub - CommCenter's ApplePDPHelper got
 NULL without it and crashed in reportLinkThroughput (0258)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 iokit/Kernel/arm/SweetWatchdog.cpp | 87 ++++++++++++++++++++++++++++++
 iokit/KernelConfigTables.cpp       |  5 ++
 2 files changed, 92 insertions(+)

diff --git a/iokit/Kernel/arm/SweetWatchdog.cpp b/iokit/Kernel/arm/SweetWatchdog.cpp
index 8f53742..7eed579 100644
--- a/iokit/Kernel/arm/SweetWatchdog.cpp
+++ b/iokit/Kernel/arm/SweetWatchdog.cpp
@@ -104,4 +104,91 @@ IOWatchdogUserClient::externalMethod(uint32_t selector, IOExternalMethodArgument
 	}
 	return kIOReturnSuccess;
 }
+
+/*
+ * Built-in AppleIPAppender stub for SWEET (umi 0258).
+ *
+ * CommCenter's ApplePDPHelperInterface (ApplePDPHelper.framework) opens
+ * IOServiceMatching("AppleIPAppender") with type 0, the cellular data path
+ * of Apple's baseband. When the service is missing, getInstance() returns
+ * NULL and CommCenter still calls through it: a link-throughput timer calls
+ * reportLinkThroughput() -> callStructMethod() on NULL (mutex lock at 0,
+ * SIGSEGV), so CommCenter crash-looped every ~10-20 s on umi and kept
+ * ReportCrash busy (~20 % of one core at idle).
+ *
+ * umi has no baseband for iOS: this service accepts every call, returns
+ * zeroed outputs and does nothing; each selector is logged the first time.
+ */
+class AppleIPAppender : public IOService {
+	OSDeclareDefaultStructors(AppleIPAppender);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleIPAppender, IOService);
+
+bool
+AppleIPAppender::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleIPAppenderUserClient");
+	registerService();
+	IOLog("SWEET IPAPP: AppleIPAppender registered (no baseband, accepts every call)\n");
+	return true;
+}
+
+class AppleIPAppenderUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleIPAppenderUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleIPAppenderUserClient, IOUserClient);
+
+IOReturn
+AppleIPAppenderUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static uint64_t sweet_ipapp_logged;     /* selectors already logged (< 64) */
+
+IOReturn
+AppleIPAppenderUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutputDescriptor != NULL) {
+		IOByteCount len = args->structureOutputDescriptor->getLength();
+		for (IOByteCount off = 0; off < len; off += 8) {
+			static const uint64_t zero = 0;
+			args->structureOutputDescriptor->writeBytes(off, &zero, len - off < 8 ? len - off : 8);
+		}
+	} else if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+
+	if (selector >= 64 || !(sweet_ipapp_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			sweet_ipapp_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET IPAPP: %s sel %u in %u/%u out %u/%u -> ok\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
 #endif /* SWEET */
diff --git a/iokit/KernelConfigTables.cpp b/iokit/KernelConfigTables.cpp
index e0925e7..dff1aa1 100644
--- a/iokit/KernelConfigTables.cpp
+++ b/iokit/KernelConfigTables.cpp
@@ -58,6 +58,11 @@ const char * gIOKernelConfigTables =
     "     'IOMatchCategory' = IOWatchdog;"
     "   },"
     "   {"
+    "     'IOClass'         = AppleIPAppender;"
+    "     'IOProviderClass' = IOResources;"
+    "     'IOMatchCategory' = AppleIPAppender;"
+    "   },"
+    "   {"
     "     'IOClass'         = IOCoreSurfaceRoot;"
     "     'IOProviderClass' = IOResources;"
     "     'IOMatchCategory' = IOCoreSurfaceRoot;"
