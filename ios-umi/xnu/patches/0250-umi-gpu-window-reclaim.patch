From 81079a4e4bfd2676d37c1f097387bc821cc63d69 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Thu, 5 Nov 2026 20:10:20 +0100
Subject: [PATCH] umi: GPU windows per process, reclaimed once the process has
 exited and its clients are gone; 64 windows (0250)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_adreno.c | 92 +++++++++++++++++++++++++++++++++---------
 1 file changed, 73 insertions(+), 19 deletions(-)

diff --git a/bsd/dev/sweet_adreno.c b/bsd/dev/sweet_adreno.c
index bc5d8c5..96c6491 100644
--- a/bsd/dev/sweet_adreno.c
+++ b/bsd/dev/sweet_adreno.c
@@ -3105,15 +3105,32 @@ sweet_adreno_fence_wait(uint32_t fence, uint32_t ms)
  */
 #define SA_WINDOW_BASE   0x200000000ull     /* first client window (8 GB in the 39-bit space) */
 #define SA_WINDOW_SIZE   0x100000000ull     /* one window: 4 GB */
-#define SA_WINDOW_MAX    32
+#define SA_WINDOW_MAX    64                 /* (0250) was 32: 8 GB + 64 x 4 GB stays in the 39-bit space */
 
 static uint64_t sa_window_next = SA_WINDOW_BASE;
 static uint32_t sa_window_count;
-static struct { task_t task; uint64_t base; } sa_window_task[SA_WINDOW_MAX];
+/* (0250) keyed by the process's unique id, not its task pointer (a dead task's pointer can come back as another's);
+ * users = open clients in it. A window whose process has exited and that no client still uses is handed to the next
+ * process: every BO of a client is unmapped in its free(), before window_free. */
+static struct { uint64_t uniqueid; int pid; uint32_t users; uint64_t base; } sa_window_task[SA_WINDOW_MAX];
+static uint32_t sa_window_reused;
+extern void *get_bsdtask_info(task_t);
 static uint64_t sa_faults;                     /* SMMU or CP faults seen by the service */
 
+static bool
+sa_window_process_gone(int pid, uint64_t uniqueid)
+{
+	proc_t p = proc_find(pid);
+	if (p == NULL) {
+		return true;
+	}
+	bool gone = proc_uniqueid(p) != uniqueid;
+	proc_rele(p);
+	return gone;
+}
+
 /*
- * A window belongs to the TASK, not the connection: a client (Turnip) learns its GPU address
+ * A window belongs to the PROCESS, not the connection: a client (Turnip) learns its GPU address
  * range once and keeps using it after closing and reopening the connection, so a later
  * connection of the same process must get the same window back.
  */
@@ -3123,30 +3140,67 @@ sweet_adreno_window_alloc(task_t task, uint64_t *base, uint64_t *size)
 	if (!sweet_adreno_service_ready()) {
 		return ENXIO;
 	}
-	for (uint32_t i = 0; i < sa_window_count; i++) {
-		if (sa_window_task[i].task == task) {
-			*base = sa_window_task[i].base;
-			*size = SA_WINDOW_SIZE;
-			return 0;
+	proc_t me = (proc_t)get_bsdtask_info(task);
+	if (me == NULL) {
+		return ESRCH;
+	}
+	uint64_t uid = proc_uniqueid(me);
+	int pid = proc_pid(me);
+	int err = 0;
+	sa_service_take_lock();
+	uint32_t i;
+	for (i = 0; i < sa_window_count; i++) {
+		if (sa_window_task[i].uniqueid == uid) {
+			break;
+		}
+	}
+	if (i == sa_window_count) {
+		if (sa_window_count < SA_WINDOW_MAX) {
+			sa_window_task[i].base = sa_window_next;
+			sa_window_next += SA_WINDOW_SIZE;
+			sa_window_count++;
+		} else {
+			for (i = 0; i < sa_window_count; i++) {
+				if (sa_window_task[i].users == 0 &&
+				    sa_window_process_gone(sa_window_task[i].pid, sa_window_task[i].uniqueid)) {
+					sa_window_reused++;
+					printf("SWEET ADRENO: GPU window %#llx of exited pid %d goes to pid %d (%u reused)\n",
+					    sa_window_task[i].base, sa_window_task[i].pid, pid, sa_window_reused);
+					break;
+				}
+			}
+			if (i == sa_window_count) {
+				printf("SWEET ADRENO: no GPU window for pid %d: all %u in use\n", pid, (unsigned)SA_WINDOW_MAX);
+				err = ENOMEM;
+			}
+		}
+		if (err == 0) {
+			sa_window_task[i].uniqueid = uid;
+			sa_window_task[i].pid = pid;
+			sa_window_task[i].users = 0;
 		}
 	}
-	if (sa_window_count >= SA_WINDOW_MAX) {
-		return ENOMEM;
+	if (err == 0) {
+		sa_window_task[i].users++;
+		*base = sa_window_task[i].base;
+		*size = SA_WINDOW_SIZE;
 	}
-	*base = sa_window_next;
-	*size = SA_WINDOW_SIZE;
-	sa_window_task[sa_window_count].task = task;
-	sa_window_task[sa_window_count].base = sa_window_next;
-	sa_window_next += SA_WINDOW_SIZE;
-	sa_window_count++;
-	return 0;
+	sa_service_drop_lock();
+	return err;
 }
 
+/* A client of this window is gone (its BOs already unmapped). */
 void
 sweet_adreno_window_free(uint64_t base)
 {
-	/* the pages mapped in it are unmapped by the client (BoFree); nothing to leak but the slot */
-	(void)base;
+	sa_service_take_lock();
+	for (uint32_t i = 0; i < sa_window_count; i++) {
+		if (sa_window_task[i].base == base && sa_window_task[i].users > 0) {
+			sa_window_task[i].users--;
+			break;
+		}
+	}
+	sa_service_drop_lock();
 }
 
 extern void IOLog(const char *, ...);
-- 
