From 15ca229f8dbbcc0fb6878fcb12bf679bb6728b27 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Tue, 10 Nov 2026 17:36:58 +0100
Subject: [PATCH] umi: X55 QMI clients over QRTR - DMS revision / mode / ids
 (not logged), UIM card status, NAS serving system + signal (sweetmdm=8, read
 only; sweetmdmonline=1 opt-in) (0264)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_mdm.c | 206 +++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 203 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/sweet_mdm.c b/bsd/dev/sweet_mdm.c
index eecbc0f..28e74b1 100644
--- a/bsd/dev/sweet_mdm.c
+++ b/bsd/dev/sweet_mdm.c
@@ -28,6 +28,10 @@
  *               trained again: the modem's AMSS sets its endpoint up on that reset; facts from the OnePlus 8 Pro port),
  *               the BAR / MSI / MHI set up again (execution environment 2), LOOPBACK 0/1 pinged, IPCR 20/21 started
  *               and QRTR spoken (HELLO; every service the modem announces is logged) for sweetmdmqrtr seconds (30).
+ *   sweetmdm=8  + QMI clients over QRTR (our port 0x4001 on node 1), read only: DMS revision / operating mode / IDs
+ *               (the IMEI is not logged, only its length), UIM card status, NAS serving system + signal strength
+ *               (again every 10 s). sweetmdmonline=1 also asks DMS for operating mode online (the radio transmits
+ *               and registers with the SIM's network); default off. sweetmdmqrtr defaults to 90 s here.
  * PCIe sequence as sweet_pcie.c (PCIe0, QCA6390) with the PCIe2 registers (Linux gcc-sm8250.c).
  * Built inside sweet_spmi.c (the local build cannot add source files).
  */
@@ -1051,6 +1055,10 @@ struct mx_qhdr {
 static struct {
 	unsigned hellos, servers, data, other;
 	uint32_t node;
+	uint32_t svc_node[0x60], svc_port[0x60];   /* where each QMI service (< 0x60) is */
+	uint16_t txn;
+	bool asked, online_asked;
+	unsigned answers;
 	bool v2;                /* the modem speaks QRTR v2 headers (version 3, 16 bytes) on IPCR: answered the same way */
 } mq;
 
@@ -1128,6 +1136,9 @@ mx_qmi_name(uint32_t svc)
 	}
 }
 
+static void mx_qmi_rx(uint32_t node, uint32_t port, const uint8_t *m, uint32_t len);
+#define MX_QMI_PORT     0x4001u
+
 static void
 mx_qrx(const uint8_t *p, uint32_t len)
 {
@@ -1174,6 +1185,10 @@ mx_qrx(const uint8_t *p, uint32_t len)
 		mq.servers++;
 		printf("SWEET MDM: QRTR NEW_SERVER service %#x %s version %u instance %u at node %u port %#x\n", c[1],
 		    mx_qmi_name(c[1]), c[2] & 0xff, c[2] >> 8, c[3], c[4]);
+		if (c[1] < 0x60 && mq.svc_port[c[1]] == 0) {
+			mq.svc_node[c[1]] = c[3];
+			mq.svc_port[c[1]] = c[4];
+		}
 		break;
 	case 5:
 		printf("SWEET MDM: QRTR DEL_SERVER service %#x at node %u port %#x\n", c[1], c[3], c[4]);
@@ -1193,6 +1208,9 @@ mx_qrx(const uint8_t *p, uint32_t len)
 			uint32_t r[5] = { 7, MX_QNODE, h.dst_port, 0, 0 };
 			mx_qpkt(7, h.dst_port, h.src_node, h.src_port, false, r, 5);
 		}
+		if (h.dst_port == MX_QMI_PORT && h.size <= len - hl) {
+			mx_qmi_rx(h.src_node, h.src_port, p + hl, h.size);
+		}
 		break;
 	default:
 		printf("SWEET MDM: QRTR type %u from %u:%#x to %u:%#x, %u bytes\n", h.type, h.src_node, h.src_port, h.dst_node,
@@ -1201,6 +1219,185 @@ mx_qrx(const uint8_t *p, uint32_t len)
 	}
 }
 
+/* ---- QMI over QRTR (no CTL: each service is a QRTR port of the modem) ---- */
+
+/* One QRTR DATA packet from our QMI port, payload bytes as given. */
+static void
+mx_qdata(uint32_t dst_node, uint32_t dst_port, const uint8_t *pl, uint32_t n)
+{
+	uint8_t *p = (uint8_t *)(mx.mem + MH_TXBUF);
+	uint32_t hl;
+	if (mq.v2) {
+		struct mx_qhdr2 h = { 3, 1, 1, 0, n, (uint16_t)MX_QNODE, (uint16_t)MX_QMI_PORT, (uint16_t)dst_node,
+			              (uint16_t)dst_port };
+		memcpy(p, &h, sizeof(h));
+		hl = sizeof(h);
+	} else {
+		uint32_t h[8] = { 1, 1, MX_QNODE, MX_QMI_PORT, 1, n, dst_node, dst_port };
+		memcpy(p, h, sizeof(h));
+		hl = sizeof(h);
+	}
+	memcpy(p + hl, pl, n);
+	(void)mx_send((hl + n + 3) & ~3u);
+}
+
+/* A QMI request: header (type 0 request, txn, message id, length), then TLVs. */
+static void
+mx_qmi_req(uint32_t svc, uint16_t msg, const uint8_t *tlv, uint16_t tlvlen)
+{
+	if (svc >= 0x60 || mq.svc_port[svc] == 0) {
+		printf("SWEET MDM: QMI: service %#x not announced\n", svc);
+		return;
+	}
+	uint8_t m[64];
+	uint16_t txn = ++mq.txn;
+	m[0] = 0;
+	m[1] = (uint8_t)txn;
+	m[2] = (uint8_t)(txn >> 8);
+	m[3] = (uint8_t)msg;
+	m[4] = (uint8_t)(msg >> 8);
+	m[5] = (uint8_t)tlvlen;
+	m[6] = (uint8_t)(tlvlen >> 8);
+	if (tlv != NULL && tlvlen) {
+		memcpy(m + 7, tlv, MIN((size_t)tlvlen, sizeof(m) - 7));
+	}
+	mx_qdata(mq.svc_node[svc], mq.svc_port[svc], m, 7u + tlvlen);
+}
+
+static const uint8_t *
+mx_tlv(const uint8_t *m, uint32_t len, uint8_t type, uint16_t *tlen)
+{
+	for (uint32_t o = 7; o + 3 <= len;) {
+		uint16_t l = (uint16_t)(m[o + 1] | m[o + 2] << 8);
+		if (o + 3 + l > len) {
+			break;
+		}
+		if (m[o] == type) {
+			*tlen = l;
+			return m + o + 3;
+		}
+		o += 3u + l;
+	}
+	return NULL;
+}
+
+static const char *
+mx_opmode(unsigned m)
+{
+	static const char *const n[] = { "online", "low power", "factory test", "offline", "resetting", "shutting down",
+		                         "persistent low power", "mode-only low power", "network test" };
+	return m < 9 ? n[m] : "?";
+}
+
+static void
+mx_qmi_rx(uint32_t node, uint32_t port, const uint8_t *m, uint32_t len)
+{
+	if (len < 7) {
+		return;
+	}
+	unsigned type = m[0], txn = m[1] | m[2] << 8, msg = m[3] | m[4] << 8;
+	uint32_t svc = 0xff;
+	for (uint32_t i = 0; i < 0x60; ++i) {
+		if (mq.svc_port[i] == port && mq.svc_node[i] == node) {
+			svc = i;
+		}
+	}
+	uint16_t tl = 0;
+	const uint8_t *r = mx_tlv(m, len, 0x02, &tl);
+	unsigned res = r && tl >= 4 ? (unsigned)(r[0] | r[1] << 8) : 0xffff;
+	unsigned err = r && tl >= 4 ? (unsigned)(r[2] | r[3] << 8) : 0;
+	if (type != 2) {
+		static unsigned inds;
+		if (inds++ < 30) {
+			printf("SWEET MDM: QMI %s indication %#x from service %#x, %u bytes\n", mx_qmi_name(svc), msg, svc, len);
+		}
+		return;
+	}
+	mq.answers++;
+	printf("SWEET MDM: QMI %s response %#x (txn %u): result %u error %#x\n", mx_qmi_name(svc), msg, txn, res, err);
+	const uint8_t *v;
+	if (svc == 0x02 && msg == 0x23 && (v = mx_tlv(m, len, 0x01, &tl)) != NULL) {
+		printf("SWEET MDM: DMS revision: %.*s\n", (int)MIN(tl, (uint16_t)120), (const char *)v);
+	} else if (svc == 0x02 && msg == 0x2d && (v = mx_tlv(m, len, 0x01, &tl)) != NULL && tl >= 1) {
+		printf("SWEET MDM: DMS operating mode: %u (%s)\n", v[0], mx_opmode(v[0]));
+	} else if (svc == 0x02 && msg == 0x25) {
+		for (uint8_t t = 0x10; t <= 0x13; ++t) {
+			if ((v = mx_tlv(m, len, t, &tl)) != NULL) {
+				printf("SWEET MDM: DMS id TLV %#x: %u characters (not logged)\n", t, tl);
+			}
+		}
+	} else if (svc == 0x0b && msg == 0x2f && (v = mx_tlv(m, len, 0x10, &tl)) != NULL && tl >= 9) {
+		/* card status: 4 x u16 indexes, number of slots, then per slot card / UPIN state, apps */
+		unsigned nslots = v[8], o = 9;
+		printf("SWEET MDM: UIM card status: %u slot(s)\n", nslots);
+		for (unsigned sl = 0; sl < nslots && o + 6 <= tl; ++sl) {
+			unsigned card = v[o], napps = v[o + 5];
+			static const char *const cs[] = { "absent", "PRESENT", "error" };
+			printf("SWEET MDM: UIM slot %u: card %u (%s) upin state %u error %u, %u application(s)\n", sl + 1, card,
+			    card < 3 ? cs[card] : "?", v[o + 1], v[o + 4], napps);
+			o += 6;
+			for (unsigned a = 0; a < napps && o + 7 <= tl; ++a) {
+				unsigned at = v[o], as = v[o + 1], aidlen = v[o + 6];
+				if (o + 7 + aidlen + 8 > tl) {
+					break;
+				}
+				const uint8_t *pin = v + o + 7 + aidlen;
+				static const char *const ats[] = { "unknown", "SIM", "USIM", "RUIM", "CSIM", "ISIM" };
+				static const char *const ass[] = { "unknown", "detected", "PIN1 required", "PUK1 required",
+					                           "perso", "PIN1 blocked", "illegal", "READY" };
+				printf("SWEET MDM: UIM slot %u app %u: %s, state %u (%s), pin1 state %u retries %u\n", sl + 1, a + 1,
+				    at < 6 ? ats[at] : "?", as, as < 8 ? ass[as] : "?", pin[1], pin[2]);
+				o += 7 + aidlen + 8;
+			}
+		}
+	} else if (svc == 0x03 && msg == 0x24 && (v = mx_tlv(m, len, 0x01, &tl)) != NULL && tl >= 5) {
+		static const char *const rs[] = { "not registered", "REGISTERED", "searching", "denied", "unknown" };
+		printf("SWEET MDM: NAS serving system: %s, cs attach %u ps attach %u, network %u, %u radio(s)\n",
+		    v[0] < 5 ? rs[v[0]] : "?", v[1], v[2], v[3], v[4]);
+		if (v[4] && tl >= 6) {
+			static const char *const ri[] = { "none", "cdma1x", "evdo", "amps", "gsm", "umts", "", "", "lte", "tdscdma",
+				                          "", "", "nr5g" };
+			printf("SWEET MDM: NAS radio interface %u (%s)\n", v[5], v[5] < 13 ? ri[v[5]] : "?");
+		}
+		if ((v = mx_tlv(m, len, 0x12, &tl)) != NULL && tl >= 5) {
+			printf("SWEET MDM: NAS network: MCC %u MNC %u \"%.*s\"\n", v[0] | v[1] << 8, v[2] | v[3] << 8,
+			    (int)MIN((unsigned)v[4], (unsigned)tl - 5u), (const char *)(v + 5));
+		}
+	} else if (svc == 0x03 && msg == 0x20 && (v = mx_tlv(m, len, 0x01, &tl)) != NULL && tl >= 2) {
+		printf("SWEET MDM: NAS signal strength: %d dBm on radio %u\n", (int8_t)v[0], v[1]);
+	} else if (svc == 0x02 && msg == 0x2e) {
+		printf("SWEET MDM: DMS set operating mode: %s\n", res == 0 ? "accepted" : "refused");
+	}
+}
+
+/* The read-only survey; again NAS / DMS mode every 10 s. */
+static void
+mx_qmi_survey(unsigned t_ms)
+{
+	if (!mq.asked && mq.svc_port[0x02] && mq.svc_port[0x0b] && mq.svc_port[0x03]) {
+		mq.asked = true;
+		printf("SWEET MDM: QMI: DMS, UIM and NAS announced: asking\n");
+		mx_qmi_req(0x02, 0x23, NULL, 0);        /* DMS get revision */
+		mx_qmi_req(0x02, 0x2d, NULL, 0);        /* DMS get operating mode */
+		mx_qmi_req(0x02, 0x25, NULL, 0);        /* DMS get device serial numbers (not logged) */
+		mx_qmi_req(0x0b, 0x2f, NULL, 0);        /* UIM get card status */
+		mx_qmi_req(0x03, 0x24, NULL, 0);        /* NAS get serving system */
+		mx_qmi_req(0x03, 0x20, NULL, 0);        /* NAS get signal strength */
+		unsigned online = 0;
+		(void)PE_parse_boot_argn("sweetmdmonline", &online, sizeof(online));
+		if (online && !mq.online_asked) {
+			static const uint8_t on[4] = { 0x01, 0x01, 0x00, 0x00 };     /* TLV 1: mode 0 = online */
+			mq.online_asked = true;
+			printf("SWEET MDM: QMI: asking DMS for operating mode ONLINE (sweetmdmonline=1)\n");
+			mx_qmi_req(0x02, 0x2e, on, 4);
+		}
+	} else if (mq.asked && t_ms % 10000 == 0) {
+		mx_qmi_req(0x03, 0x24, NULL, 0);
+		mx_qmi_req(0x03, 0x20, NULL, 0);
+		mx_qmi_req(0x02, 0x2d, NULL, 0);
+	}
+}
+
 /*
  * Android's msm_pcie_disable + enable when the modem has booted: PERST held, the controller's core and PHY reset and
  * set up again (0263b: PERST and the LTSSM enable alone left LTSSM in 0x5, pre-detect quiet), the link trained again. The link
@@ -1365,7 +1562,7 @@ md_mission(void)
 	printf("SWEET MDM: IPCR channels %u/%u running: QRTR HELLO sent\n", MX_IPCR_OUT, MX_IPCR_IN);
 	bzero(&mq, sizeof(mq));
 	mx_qctrl(2, 0xffffffffu, 0, 0, 0, 0);
-	unsigned secs = 30;
+	unsigned secs = md.stage >= 8 ? 90 : 30;
 	(void)PE_parse_boot_argn("sweetmdmqrtr", &secs, sizeof(secs));
 	for (unsigned t = 0; t < secs * 1000u && !mx.gone; ++t) {
 		mx_er0();
@@ -1375,6 +1572,9 @@ md_mission(void)
 			mx_rxq_head++;
 			mx_qrx(mx_rxq[q], mx_rxq_len[q]);
 		}
+		if (md.stage >= 8) {
+			mx_qmi_survey(t);
+		}
 		if (t % 10000 == 9999) {
 			printf("SWEET MDM: QRTR %u s: %u hellos, %u services, %u data; mhistatus %#x mdm2ap status %u errfatal %u\n",
 			    (t + 1) / 1000, mq.hellos, mq.servers, mq.data, md_rd(md.bar0, MHI_STATUS), md_gpio_in(MDM2AP_STATUS),
@@ -1385,8 +1585,8 @@ md_mission(void)
 		}
 		delay(1000);
 	}
-	printf("SWEET MDM: mission: %u hellos, %u services announced, %u data packets%s\n", mq.hellos, mq.servers, mq.data,
-	    mx.gone ? " (the modem went away)" : "");
+	printf("SWEET MDM: mission: %u hellos, %u services announced, %u data packets, %u QMI answers%s\n", mq.hellos,
+	    mq.servers, mq.data, mq.answers, mx.gone ? " (the modem went away)" : "");
 	return mq.servers ? 0 : 35;
 }
 
