+/* ---- the audio PD over FastRPC (Android: adsprpcd audiopd; Linux fastrpc_init_create_static_process) ---- */
+
+static bool
+adsp_fr_on(void)
+{
+	uint32_t secs = 180;
+	PE_parse_boot_argn(SL_ARG "rpc", &secs, sizeof(secs));
+	return secs != 0;
+}
+
+static bool
+adsp_fr_wanted(void)
+{
+	return apr_core_state >= 2;             /* after the core is ready, as adsprpcd starts with the HAL */
+}
+
+static void
+adsp_fr_ready(void)
+{
+	fr_listening = true;
+	printf("SWEET ADSP: audio PD listener registered; AFE next\n");
+	if (afe_state == 0) {
+		afe_next();
+	}
+}
+
+/* sl_scm with a fourth register argument (x5: the extra-argument buffer when there are more than 4). */
+static int
+adsp_scm(const char *what, uint64_t function, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t d)
+{
+	uint64_t session = 0;
+	for (int i = 0; i < 1000; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 ? (SCM_64 | SCM_SIP | function) : SCM_INTERRUPTED;
+		register uint64_t x1 __asm__("x1") = arginfo;
+		register uint64_t x2 __asm__("x2") = a;
+		register uint64_t x3 __asm__("x3") = b;
+		register uint64_t x4 __asm__("x4") = c;
+		register uint64_t x5 __asm__("x5") = d;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+		    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != SCM_INTERRUPTED) {
+			printf("SWEET ADSP: TrustZone %s -> %d, answer %#llx\n", what, (int32_t)x0, x1);
+			return (int32_t)x0 != 0 ? (int32_t)x0 : (int32_t)x1;
+		}
+	}
+	printf("SWEET ADSP: TrustZone %s: still interrupted\n", what);
+	return -1;
+}
+
+/* Zero low RAM that XNU does not manage, through the loader's 2 MiB window. */
+static bool
+adsp_phys_zero(uint64_t pa, uint32_t size)
+{
+	if (sl_window == 0) {
+		return false;
+	}
+	for (uint32_t b = 0; b < size; b += SL_WINDOW) {
+		uint32_t n = MIN(SL_WINDOW, size - b);
+		for (uint32_t o = 0; o < n; o += PAGE_SIZE) {
+			if (pmap_enter(kernel_pmap, sl_window + o, (ppnum_t)atop_64(pa + b + o), VM_PROT_READ | VM_PROT_WRITE,
+			    VM_PROT_NONE, VM_WIMG_WCOMB_SL, TRUE) != KERN_SUCCESS) {
+				pmap_remove(kernel_pmap, sl_window, sl_window + o);
+				return false;
+			}
+		}
+		for (uint32_t o = 0; o < n; o += 8) {
+			*(volatile uint64_t *)(sl_window + o) = 0;
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		pmap_remove(kernel_pmap, sl_window, sl_window + n);
+	}
+	return true;
+}
+
+#define SCM_MP_ASSIGN           SCM_CALL(0x0c, 0x16)
+#define SCM_ARGS_MP_ASSIGN      0x1117u         /* 7 args: RO, VAL, RO, VAL, RO, VAL, VAL */
+#define VMID_HLOS               3
+#define VMID_LPASS              22
+#define VMID_ADSP_HEAP          37
+#define PERM_RWX                7
+#define FR_SCM_OFF              0xf0000u        /* hyp-assign tables in the pool's last 64 KiB */
+
+static int
+fr_create_audio_pd(void)
+{
+	uint32_t heap = 1;
+	PE_parse_boot_argn(SL_ARG "heap", &heap, sizeof(heap));
+	if (!fr_map_pool()) {
+		return -1;
+	}
+	if (heap) {
+		if (!adsp_phys_zero(FR_HEAP_PA, FR_HEAP_SIZE)) {
+			printf("SWEET ADSP: audio PD heap: zeroing failed\n");
+			return -1;
+		}
+		/* qcom_scm_assign_mem: src vmids, mem_to_map {addr, size}, dest {vmid, perm, ctx, ctx_size}, 64-aligned */
+		uint32_t base = FR_SCM_OFF;
+		for (uint32_t i = 0; i < 0x200; i += 4) {
+			fr_put32(base + i, 0);
+		}
+		fr_put32(base + 0x00, VMID_HLOS);
+		fr_put64(base + 0x40, FR_HEAP_PA);
+		fr_put64(base + 0x48, FR_HEAP_SIZE);
+		fr_put32(base + 0x80, VMID_LPASS);
+		fr_put32(base + 0x84, PERM_RWX);
+		fr_put32(base + 0x98, VMID_ADSP_HEAP);  /* 24-byte entries */
+		fr_put32(base + 0x9c, PERM_RWX);
+		/* extra arguments 3..6: src_sz, dest phys, dest_sz, 0 */
+		fr_put64(base + 0x100, 4);
+		fr_put64(base + 0x108, (uint64_t)FR_POOL_PA + base + 0x80);
+		fr_put64(base + 0x110, 2 * 24);
+		fr_put64(base + 0x118, 0);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		int a = adsp_scm("mp_assign(audio PD heap -> LPASS, ADSP_HEAP)", SCM_MP_ASSIGN, SCM_ARGS_MP_ASSIGN,
+		    (uint64_t)FR_POOL_PA + base + 0x40, 16, (uint64_t)FR_POOL_PA + base, (uint64_t)FR_POOL_PA + base + 0x100);
+		printf("SWEET ADSP: audio PD heap %#x + %#x hyp-assign -> %d\n", FR_HEAP_PA, FR_HEAP_SIZE, a);
+		if (a != 0) {
+			return -1;
+		}
+	}
+	/* createstaticpd: in {pgid, namelen, pageslen}, name, phy_page {addr, size}; method 8 on handle 1, pid 0 */
+	static const char name[] = "audiopd";
+	uint32_t inbuf[3] = { FR_TGID, sizeof(name), 0 };
+	uint64_t page[2] = { FR_HEAP_PA, heap ? FR_HEAP_SIZE : 0 };
+	struct fr_buf in[3] = { { inbuf, 12 }, { (void *)(uintptr_t)name, sizeof(name) }, { page, 16 } };
+	int r = fr_invoke(0, FR_HANDLE_INIT, FR_SC(8, 3, 0), in, NULL, 5000);
+	printf("SWEET ADSP: FastRPC createstaticpd \"audiopd\" -> %d\n", r);
+	return r;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
