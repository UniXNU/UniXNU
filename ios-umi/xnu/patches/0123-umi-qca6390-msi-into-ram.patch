+extern int sweet_pcie_msi(uint32_t addr, uint32_t data);
 
 #define WLAN_POOL_PA            0xd0000000u
 #define WLAN_POOL_SIZE          0x00490000u
@@ -31,6 +32,7 @@ extern int sweet_mhi_wait_ee(unsigned want, unsigned ms);
 #define WLAN_FW_MAX             0x480000u        /* amss20.bin is 4352144 bytes */
 #define WLAN_VEC_OFF            0x480000u       /* BHIe vector table */
 #define WLAN_MHI_OFF            0x484000u       /* MHI contexts and rings (sweet_mhi.c), 24 KiB */
+#define WLAN_MSI_OFF            0x48c000u       /* MSI writes land here (polled) */
 #define WLAN_SBL_SIZE           0x80000u        /* ath11k sbl_size = seg_len = 512 KiB */
 #define WLAN_SEG_LEN            0x80000u
 
@@ -323,6 +325,7 @@ wlan_bhi(vm_offset_t bar0, vm_offset_t bhi)
 		delay(100);
 	}
 	wlan_state(bar0, bhi, "after BHI");
+	printf("SWEET WLAN: MSI word after BHI: %#x\n", *(volatile uint32_t *)(sw.pool + WLAN_MSI_OFF));
 	if ((st >> 30) != 2) {
 		printf("SWEET WLAN: BHI %s (status %#x)\n", (st >> 30) == 3 ? "ERROR" : "timeout", st);
 		return EIO;
@@ -462,6 +465,8 @@ sweet_wlan_fw_boot(vm_offset_t bar0, unsigned stage)
 	if (prep) {
 		wlan_prep(bar0);
 	}
+	*(volatile uint32_t *)(sw.pool + WLAN_MSI_OFF) = 0xffffffffu;
+	(void)sweet_pcie_msi(sw.pool_pa + WLAN_MSI_OFF, 0);
 	wlan_state(bar0, bhi, "before BHI");
 	if (wl_rd(bhi, BHI_EXECENV) == 0 && wlan_bhi(bar0, bhi) != 0) {
 		return 14;
