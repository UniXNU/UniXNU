diff --git a/bsd/dev/sweet_pcie.c b/bsd/dev/sweet_pcie.c
index 1c5df50..01e8917 100644
--- a/bsd/dev/sweet_pcie.c
+++ b/bsd/dev/sweet_pcie.c
@@ -20,6 +20,7 @@ extern bool sweet_board_is_umi(void);
 extern int sweet_rpmh_smps_enable(const char *res, unsigned mv);
 void sweet_pcie_init(void);
 int sweet_pcie_run(unsigned stage);
+int sweet_pcie_msi(uint32_t addr, uint32_t data);
 extern int sweet_wlan_fw_boot(vm_offset_t bar0, unsigned stage);
 
 #define PCIE_GCC_PA      0x00100000u
@@ -487,6 +488,44 @@ pcie_bringup(void)
 	return r == 0 && sp.stage >= 5 ? sweet_wlan_fw_boot(sp.bar0, sp.stage) : r;
 }
 
+/*
+ * Point the endpoint's MSI at addr (Linux enables MSI before MHI; the QCA6390
+ * PBL raises a BHI interrupt and errors out without one). The write lands in
+ * RAM through the SMMU bypass: no interrupt controller involved, the caller
+ * can poll it. All vectors the function asks for.
+ */
+int
+sweet_pcie_msi(uint32_t addr, uint32_t data)
+{
+	if (sp.conf == 0) {
+		return -1;
+	}
+	uint32_t ptr = pcie_rd(sp.conf, 0x34) & 0xfcu;
+	for (unsigned guard = 0; ptr >= 0x40u && guard < 48; ++guard) {
+		uint32_t hdr = pcie_rd(sp.conf, ptr);
+		if ((hdr & 0xffu) == 0x05u) {
+			uint32_t ctl = hdr >> 16;
+			bool is64 = (ctl & (1u << 7)) != 0;
+			unsigned mmc = (ctl >> 1) & 7u;
+			pcie_wr(sp.conf, ptr + 4, addr);
+			if (is64) {
+				pcie_wr(sp.conf, ptr + 8, 0);
+				pcie_wr(sp.conf, ptr + 12, data);
+			} else {
+				pcie_wr(sp.conf, ptr + 8, data);
+			}
+			ctl = (ctl & ~(7u << 4)) | (mmc << 4) | 1u;     /* MME = MMC, enable */
+			pcie_wr(sp.conf, ptr, (hdr & 0xffffu) | (ctl << 16));
+			printf("SWEET PCIE: MSI cap at %#x: %u vectors, %s, address %#x data %#x, ctl %#x\n",
+			    ptr, 1u << mmc, is64 ? "64-bit" : "32-bit", addr, data, pcie_rd(sp.conf, ptr) >> 16);
+			return 0;
+		}
+		ptr = (hdr >> 8) & 0xfcu;
+	}
+	printf("SWEET PCIE: no MSI capability\n");
+	return -1;
+}
+
 int
 sweet_pcie_run(unsigned stage)
 {
