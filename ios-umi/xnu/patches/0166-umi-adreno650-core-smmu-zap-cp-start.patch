+	sa_put(&sa_gpu, "rbbm_perfctr_gpu_busy_masked", RBBM_PERFCTR_GPU_BUSY_MASKED, 0xffffffff);
+	sa_put64(&sa_gpu, "uche_write_range_max", UCHE_WRITE_RANGE_MAX, 0x0001ffffffffffc0ull);
+	sa_put64(&sa_gpu, "uche_trap_base", UCHE_TRAP_BASE, 0x0001fffffffff000ull);
+	sa_put64(&sa_gpu, "uche_write_thru_base", UCHE_WRITE_THRU_BASE, 0x0001fffffffff000ull);
+	sa_put(&sa_gpu, "uche_filter_cntl", UCHE_FILTER_CNTL, 0x804);
+	sa_put(&sa_gpu, "uche_cache_ways", UCHE_CACHE_WAYS, 0x4);
+	sa_put(&sa_gpu, "cp_roq_thresholds_2", CP_ROQ_THRESHOLDS_2, 0x02000140);
+	sa_put(&sa_gpu, "cp_roq_thresholds_1", CP_ROQ_THRESHOLDS_1, 0x8040362c);
+	sa_put(&sa_gpu, "cp_mem_pool_size", CP_MEM_POOL_SIZE, 128);
+	sa_put(&sa_gpu, "pc_dbg_eco_cntl", PC_DBG_ECO_CNTL, 0x00300200);       /* a6xx_catalog.c A650 prim_fifo_threshold */
+	sa_put(&sa_gpu, "cp_ahb_cntl", CP_AHB_CNTL, 1);
+	sa_put(&sa_gpu, "rbbm_perfctr_cntl", RBBM_PERFCTR_CNTL, 1);
+	/* a6xx_set_ubwc_config, A650: highest bank bit 16, amsbc, rgb565 predicator, uavflagprd_inv 2, macrotile */
+	sa_put(&sa_gpu, "rb_nc_mode_cntl", RB_NC_MODE_CNTL, 0x816);
+	sa_put(&sa_gpu, "tpl1_nc_mode_cntl", TPL1_NC_MODE_CNTL, 0x6);
+	sa_put(&sa_gpu, "sp_nc_mode_cntl", SP_NC_MODE_CNTL, 0x26);
+	sa_put(&sa_gpu, "uche_mode_cntl", UCHE_MODE_CNTL, 0x600000);
+	sa_put(&sa_gpu, "rbbm_nc_mode_cntl", RBBM_NC_MODE_CNTL, 1);
+	sa_put(&sa_gpu, "rbbm_interface_hang_int_cntl", RBBM_INTERFACE_HANG_INT_CNTL, 1u << 30 | 0x1fffff);
+	sa_put(&sa_gpu, "uche_client_pf", UCHE_CLIENT_PF, 1u << 7 | 1);
+	for (unsigned i = 0; i < 5; i++) {
+		sa_put(&sa_gpu, "tpl1_bicubic_weights", TPL1_BICUBIC_WEIGHTS_TABLE_0 + 4 * i, bicubic[i]);
+	}
+	sa_put(&sa_gpu, "cp_apriv_cntl", CP_APRIV_CNTL, 1u << 6 | 1u << 5 | 1u << 3 | 1u << 2 | 1u << 1);  /* HW_APRIV */
+	sa_put64(&sa_gpu, "cp_sqe_instr_base", CP_SQE_INSTR_BASE, CORE_SQE_ADDRESS);
+	sa_put64(&sa_gpu, "cp_rb_base", CP_RB_BASE, CORE_RING_ADDRESS);
+	sa_put(&sa_gpu, "cp_rb_cntl", CP_RB_CNTL, CP_RB_CNTL_A650);
+	sa_get(&sa_gpu, "cp_sqe_instr_base", CP_SQE_INSTR_BASE);
+	sa_get(&sa_gpu, "cp_rb_base", CP_RB_BASE);
+	sa_get(&sa_gpu, "cp_rb_cntl", CP_RB_CNTL);
+	sa_get(&sa_gpu, "cp_rb_rptr", CP_RB_RPTR);
+	sa_get(&sa_gpu, "cp_rb_wptr", CP_RB_WPTR);
+	sa_get(&sa_gpu, "rbbm_status", RBBM_STATUS);
+
+	sa_announce("start the 3D core's command processor (cp_sqe_cntl 1)");
+	sa_core_runs = true;
+	sa_put(&sa_gpu, "cp_sqe_cntl", CP_SQE_CNTL, 1);
+	sa_sleep_ms(20);
+	printf("SWEET GPU: %u: after the start: status %#x, interrupts %#x, command processor: fault %#x, interrupts %#x, "
+	    "protection %#x, ring read up to %u\n", sa_step, sa_rd(sa_gpu.base + RBBM_STATUS),
+	    sa_rd(sa_gpu.base + RBBM_INT_0_STATUS), sa_rd(sa_gpu.base + CP_HW_FAULT),
+	    sa_rd(sa_gpu.base + CP_INTERRUPT_STATUS), sa_rd(sa_gpu.base + CP_PROTECT_STATUS), sa_rd(sa_gpu.base + CP_RB_RPTR));
+	sa_get(&sa_smmu, "sgfsr", SMMU_SGFSR);
+	if (sa_space_faulted(&sa_smmu_cb0, "the 3D core")) {
+		return false;
+	}
+
+	sa_announce("give the 3D core its first command: CP_ME_INIT (Linux a6xx_cp_init)");
+	sa_ring_packet(CP_ME_INIT, 8);
+	sa_ring(0x0000002f);
+	sa_ring(0x00000003);    /* multiple hardware contexts */
+	sa_ring(0x20000000);    /* error detection */
+	sa_ring(0);             /* no header dump */
+	sa_ring(0);
+	sa_ring(0);             /* no workarounds */
+	sa_ring(0);
+	sa_ring(0);
+	if (!sa_ring_run("initialise its command processor")) {
+		return false;
+	}
+	printf("SWEET GPU: %u: THE 3D CORE'S COMMAND PROCESSOR RUNS AND TAKES COMMANDS\n", sa_step);
+	return true;
+}
