+/* ---- step 21: out of secure mode; a word written on command ---- */
+
+#define CORE_KNOWN_WORD         0x600dc0deu
+
+static bool
+sa_step_core_commands(void)
+{
+	volatile uint32_t *scratch = (volatile uint32_t *)sa_core_scratch.memory;
+
+	if (!sa_cx_ready() || !sa_core_runs) {
+		return false;
+	}
+	sa_announce("command the 3D core out of secure mode (CP_SET_SECURE_MODE 0: the zap shader lets it)");
+	sa_ring_packet(CP_SET_SECURE_MODE, 1);
+	sa_ring(0);
+	if (!sa_ring_run("leave secure mode")) {
+		return false;
+	}
+	sa_announce("command the 3D core to write a known word into the scratch page (CP_MEM_WRITE)");
+	sa_ring_packet(CP_MEM_WRITE, 3);
+	sa_ring(CORE_SCRATCH_ADDRESS);
+	sa_ring(0);
+	sa_ring(CORE_KNOWN_WORD);
+	if (!sa_ring_run("write a word to memory")) {
+		return false;
+	}
+	sa_to_memory(sa_core_scratch.memory, PAGE_SIZE);       /* drop our cache's copy of the page before reading it */
+	uint32_t word = scratch[0];
+	printf("SWEET GPU: %u: the scratch page reads %#x: %s\n", sa_step, word, word == CORE_KNOWN_WORD ?
+	    "THE 3D CORE EXECUTES OUR COMMANDS AND WRITES OUR MEMORY" : "not the word it was told to write");
+	return word == CORE_KNOWN_WORD;
+}
