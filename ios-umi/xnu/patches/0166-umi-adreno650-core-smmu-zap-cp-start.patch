+
 static bool
-sa_step_zap_signature(void)
+sa_zap_init(void)
 {
 	unsigned int size = 0;
-	vm_offset_t page = 0;
 	uint32_t segments, hashes;
 
-	sa_announce("find the zap shader's header (a650_zap.mdt) in the ADT");
 	const uint8_t *header = sa_firmware("a650_zap.mdt", &size);
 	if (header == NULL) {
 		return false;
@@ -886,13 +901,13 @@ sa_step_zap_signature(void)
 		printf("SWEET GPU: %u: the file is not the header followed by the hashes alone\n", sa_step);
 		return false;
 	}
-	if (kmem_alloc_contig(kernel_map, &page, PAGE_SIZE, PAGE_MASK, 0, 0, KMA_DATA | KMA_ZERO | KMA_PERMANENT,
-	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+	if (sa_zap_header_page == 0 && kmem_alloc_contig(kernel_map, &sa_zap_header_page, PAGE_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
 		printf("SWEET GPU: %u: no memory\n", sa_step);
 		return false;
 	}
-	memcpy((void *)page, header, size);
-	uint64_t phys = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)page));
+	memcpy((void *)sa_zap_header_page, header, size);
+	uint64_t phys = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)sa_zap_header_page));
 	flush_dcache64((addr64_t)phys, PAGE_SIZE, TRUE);        /* TrustZone reads memory, not our cache */
 
 	sa_announce("hand the header to TrustZone to check its signature (image 13)");
@@ -908,6 +923,13 @@ sa_step_zap_signature(void)
 	return false;
 }
 
+static bool
+sa_step_zap_signature(void)
+{
+	sa_announce("find the zap shader's header (a650_zap.mdt) in the ADT");
+	return sa_zap_init();
+}
+
 /* What TrustZone holds for image 13 is let go at the end of a run (Linux: qcom_scm_pas_shutdown). */
 static void
 sa_zap_release(void)
@@ -1084,8 +1106,26 @@ sa_space_faulted(struct sa_block *cb, const char *who)
 	return true;
 }
 
+/* Stream match register `match` sends `stream` through the space's context (the hypervisor grants the global registers). */
+static bool
+sa_space_stream(struct sa_space *space, uint32_t match, uint32_t stream)
+{
+	uint32_t smr = SMMU_SMR_VALID | SMMU_STREAM_MASK << 16 | stream;
+
+	sa_put(&sa_smmu, "s2cr", SMMU_S2CR(match), space->context);
+	sa_put(&sa_smmu, "smr", SMMU_SMR(match), smr);
+	if (sa_get(&sa_smmu, "smr", SMMU_SMR(match)) != smr ||
+	    (sa_get(&sa_smmu, "s2cr", SMMU_S2CR(match)) & 0x300ff) != space->context) {
+		printf("SWEET GPU: %u: the SMMU did not take what was written: stream %u is not going through context %u\n",
+		    sa_step, stream, space->context);
+		return false;
+	}
+	return true;
+}
+
+/* `sctlr`: bits wanted in the context's SCTLR besides SMMU_SCTLR_ON. */
 static bool
-sa_space_on(struct sa_space *space, struct sa_block *cb, uint32_t match, uint32_t stream)
+sa_space_on(struct sa_space *space, struct sa_block *cb, uint32_t match, uint32_t stream, uint32_t sctlr)
 {
 	uint64_t root = space->table_phys[0] | (uint64_t)space->context << 48;
 
@@ -1110,13 +1150,12 @@ sa_space_on(struct sa_space *space, struct sa_block *cb, uint32_t match, uint32_
 		printf("SWEET GPU: %u: the SMMU does not finish its TLB sync (%#x)\n", sa_step, sa_rd(cb->base + SMMU_CB_TLBSTATUS));
 		return false;
 	}
-	sa_put(cb, "sctlr", SMMU_CB_SCTLR, SMMU_SCTLR_ON);
-	sa_put(&sa_smmu, "s2cr", SMMU_S2CR(match), space->context);
-	sa_put(&sa_smmu, "smr", SMMU_SMR(match), SMMU_SMR_VALID | SMMU_STREAM_MASK << 16 | stream);
+	sa_put(cb, "sctlr", SMMU_CB_SCTLR, SMMU_SCTLR_ON | sctlr);
+	if (!sa_space_stream(space, match, stream)) {
+		return false;
+	}
 	/* the global registers are the hypervisor's to grant: see what it made of them */
-	if (sa_get(&sa_smmu, "smr", SMMU_SMR(match)) != (SMMU_SMR_VALID | SMMU_STREAM_MASK << 16 | stream) ||
-	    (sa_get(&sa_smmu, "s2cr", SMMU_S2CR(match)) & 0x300ff) != space->context ||
-	    (sa_get(&sa_smmu_cbar, "cbar", SMMU_CBAR(space->context)) & 0x30000) != (SMMU_CBAR_STAGE_1 & 0x30000) ||
+	if ((sa_get(&sa_smmu_cbar, "cbar", SMMU_CBAR(space->context)) & 0x30000) != (SMMU_CBAR_STAGE_1 & 0x30000) ||
 	    !(sa_get(cb, "sctlr", SMMU_CB_SCTLR) & 1) ||
 	    sa_get(cb, "ttbr0 low", SMMU_CB_TTBR0) != (uint32_t)root ||
 	    sa_get(cb, "ttbr0 high", SMMU_CB_TTBR0 + 4) != (uint32_t)(root >> 32)) {
@@ -1205,7 +1244,7 @@ sa_step_gmu_space(void)
 	}
 	sa_smmu_gmu_cb.phys = SMMU_PHYS + (sa_smmu_pages + GMU_CONTEXT) * sa_smmu_page;
 	sa_gmu_space_on = true;
-	return sa_space_on(&sa_gmu_space, &sa_smmu_gmu_cb, GMU_MATCH, GMU_STREAM);
+	return sa_space_on(&sa_gmu_space, &sa_smmu_gmu_cb, GMU_MATCH, GMU_STREAM, 0);
 }
 
 /* ---- step 14: the GMU's firmware ---- */
@@ -1741,10 +1780,367 @@ sa_step_core_power(void)
 	return !sa_space_faulted(&sa_smmu_gmu_cb, "the GMU");
 }
 
+/* ---- step 18: the 3D core's memory ---- */
+
+/*
+ * The 3D core reads its orders from a ring of memory, through a processor of its own (SQE) that
+ * runs a650_sqe.fw. It reaches memory through the SMMU like the GMU: dt gfx3d_user iommus <0 0x401>,
+ * streams 0 and 1, both through context 0 here. The addresses are ours to choose.
+ */
+#define PTE_UNPRIVILEGED        (1ull << 6)     /* io-pgtable-arm.c: a mapping without IOMMU_PRIV */
+#define PTE_READ_ONLY           (1ull << 7)     /* without IOMMU_WRITE (Linux: MSM_BO_GPU_READONLY) */
+#define PTE_CORE                (PTE_GMU | PTE_UNPRIVILEGED)
+#define SMMU_SCTLR_HUPCF        (1u << 8)       /* serve the core's other requests after a fault (qcom_adreno_smmu_write_sctlr) */
+#define CORE_CONTEXT            0
+#define CORE_MATCH              0
+#define CORE_MATCH_2            2               /* entry 1 is the GMU's */
+#define CORE_RING_ADDRESS       0x01000000u
+#define CORE_RING_SIZE          0x8000u         /* Linux's MSM_GPU_RINGBUFFER_SZ */
+#define CORE_SQE_ADDRESS        0x01100000u
+#define CORE_SCRATCH_ADDRESS    0x01200000u
+
+static struct sa_space sa_core_space = { .name = "the 3D core", .context = CORE_CONTEXT };
+static struct sa_gpu_block sa_core_ring, sa_core_sqe, sa_core_scratch;
+static bool sa_core_space_on, sa_core_runs;
+
+static bool
+sa_step_core_space(void)
+{
+	unsigned int size = 0;
+
+	if (!sa_cx_ready() || !sa_core_on) {
+		printf("SWEET GPU: %u: the 3D core has no power: step 17\n", sa_step);
+		return false;
+	}
+	sa_announce("make the 3D core's memory: its ring, its processor's firmware (a650_sqe.fw), a scratch page");
+	const uint8_t *sqe = sa_firmware("a650_sqe.fw", &size);
+	if (sqe == NULL || size < 8 || size > 0x40000) {
+		return false;
+	}
+	uint32_t version;
+	memcpy(&version, sqe + 4, sizeof(version));
+	printf("SWEET GPU: %u: a650_sqe.fw version %#x (Linux a6xx_ucode_check_version wants >= 0x095)\n", sa_step,
+	    version & 0xfff);
+	if (!sa_block_new(&sa_core_space, &sa_core_ring, CORE_RING_ADDRESS, CORE_RING_SIZE, PTE_CORE) ||
+	    !sa_block_new(&sa_core_space, &sa_core_sqe, CORE_SQE_ADDRESS, size - 4, PTE_CORE | PTE_READ_ONLY) ||
+	    !sa_block_new(&sa_core_space, &sa_core_scratch, CORE_SCRATCH_ADDRESS, 4096, PTE_CORE)) {
+		return false;
+	}
+	memcpy((void *)sa_core_sqe.memory, sqe + 4, size - 4);         /* the file's first word is not firmware */
+	sa_to_memory(sa_core_sqe.memory, round_page(sa_core_sqe.size));
+
+	sa_announce("give SMMU context 0 these tables and send the 3D core's streams 0 and 1 through it");
+	if (sa_smmu_cb0.phys == 0 && !sa_smmu_layout()) {
+		return false;
+	}
+	sa_core_space_on = true;
+	if (!sa_space_on(&sa_core_space, &sa_smmu_cb0, CORE_MATCH, 0, SMMU_SCTLR_HUPCF) ||
+	    !sa_space_stream(&sa_core_space, CORE_MATCH_2, 1)) {
+		return false;
+	}
+	sa_get(&sa_smmu_cb0, "sctlr", SMMU_CB_SCTLR);
+	sa_get(&sa_gpu, "rbbm_status", RBBM_STATUS);
+	return !sa_space_faulted(&sa_smmu_cb0, "the 3D core");
+}
+
+/* ---- step 19: the zap shader, loaded ---- */
+
+/*
+ * Linux zap_shader_load_mdt / qcom_mdt_pas_init + qcom_mdt_load: the header to TrustZone again
+ * (step 12's init is let go first), the place of the image (dt pil_gpu_region@8681a000, 0x2000;
+ * a650_zap.b02 is the only loadable segment, relocatable, paddr 0x5000 = the lowest, so it goes at
+ * the start, size rounded to 0x1000), the segment copied there, then authenticate and run. The
+ * 3D core leaves secure mode (step 21) only with the zap shader's help.
+ */
+#define SCM_PAS_MEM_SETUP       SCM_CALL(2, 2)
+#define SCM_THREE_VALUES        3
+#define ZAP_MEMORY              0x8681a000ull
+#define ZAP_MEMORY_SIZE         0x2000u
+#define ZAP_IMAGE_SIZE          0x1000u
+
+static bool
+sa_step_zap_load(void)
+{
+	unsigned int size = 0;
+	uint64_t answer = ~0ull;
+
+	if (!sa_cx_ready() || !sa_core_space_on) {
+		return false;
+	}
+	sa_announce("find the zap shader's image (a650_zap.b02) in the ADT");
+	const uint8_t *segment = sa_firmware("a650_zap.b02", &size);
+	if (segment == NULL || size == 0 || size > ZAP_IMAGE_SIZE) {
+		return false;
+	}
+	sa_announce("let TrustZone go of step 12's header, then hand it over again");
+	sa_zap_release();
+	if (!sa_zap_init()) {
+		return false;
+	}
+	sa_announce("tell TrustZone where the image goes (0x8681a000, 0x1000)");
+	if (sa_scm3("where the zap shader's image will be", SCM_64 | SCM_SIP | SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, PAS_GPU,
+	    ZAP_MEMORY, ZAP_IMAGE_SIZE, &answer) != 0 || answer != 0) {
+		printf("SWEET GPU: %u: TrustZone does not take the place (%#llx)\n", sa_step, answer);
+		return false;
+	}
+	volatile uint8_t *memory = (volatile uint8_t *)ml_io_map_wcomb(ZAP_MEMORY, ZAP_MEMORY_SIZE);
+	if (memory == NULL) {
+		return false;
+	}
+	printf("SWEET GPU: %u: about to write %u bytes of zap shader at %#llx (it begins %02x %02x %02x %02x; the memory "
+	    "%02x %02x %02x %02x)\n", sa_step, size, ZAP_MEMORY, segment[0], segment[1], segment[2], segment[3], memory[0],
+	    memory[1], memory[2], memory[3]);
+	if (sa_pause_ms && sa_step == sa_steps) {
+		sa_sleep_ms(sa_pause_ms);
+	}
+	for (unsigned i = 0; i < ZAP_IMAGE_SIZE; i++) {
+		memory[i] = i < size ? segment[i] : 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	sa_announce("ask TrustZone to authenticate the zap shader and run it");
+	if (sa_scm("to authenticate and run the zap shader", SCM_64 | SCM_SIP | SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, PAS_GPU,
+	    &answer) != 0 || answer != 0) {
+		printf("SWEET GPU: %u: TrustZone does not authenticate the zap shader (%#llx)\n", sa_step, answer);
+		return false;
+	}
+	printf("SWEET GPU: %u: TRUSTZONE HAS AUTHENTICATED AND STARTED THE ZAP SHADER\n", sa_step);
+	return true;
+}
+
+/* ---- step 20: the 3D core's registers; its command processor started ---- */
+
+/* a6xx.xml offsets in words. */
+#define RBBM_GBIF_CLIENT_QOS_CNTL GPU_WORD(0x0011)
+#define RBBM_GBIF_HALT          GPU_WORD(0x0016)
+#define RBBM_INTERFACE_HANG_INT_CNTL GPU_WORD(0x001f)
+#define RBBM_STATUS_GPU_BUSY    (1u << 23)      /* GPU_BUSY_IGN_AHB, what Linux's _a6xx_check_idle looks at */
+#define RBBM_PERFCTR_CNTL       GPU_WORD(0x0500)
+#define RBBM_PERFCTR_GPU_BUSY_MASKED GPU_WORD(0x050b)
+#define RBBM_NC_MODE_CNTL       GPU_WORD(0x0534)
+#define CP_RB_CNTL              GPU_WORD(0x0802)
+#define CP_RB_RPTR              GPU_WORD(0x0806)
+#define CP_RB_WPTR              GPU_WORD(0x0807)
+#define CP_SQE_CNTL             GPU_WORD(0x0808)
+#define CP_HW_FAULT             GPU_WORD(0x0821)
+#define CP_INTERRUPT_STATUS     GPU_WORD(0x0823)
+#define CP_PROTECT_STATUS       GPU_WORD(0x0824)
+#define CP_SQE_INSTR_BASE       GPU_WORD(0x0830)
+#define CP_APRIV_CNTL           GPU_WORD(0x0844)
+#define CP_ROQ_THRESHOLDS_1     GPU_WORD(0x08c1)
+#define CP_ROQ_THRESHOLDS_2     GPU_WORD(0x08c2)
+#define CP_MEM_POOL_SIZE        GPU_WORD(0x08c3)
+#define CP_AHB_CNTL             GPU_WORD(0x098d)
+#define UCHE_MODE_CNTL          GPU_WORD(0x0e01)
+#define UCHE_WRITE_RANGE_MAX    GPU_WORD(0x0e05)
+#define UCHE_WRITE_THRU_BASE    GPU_WORD(0x0e07)
+#define UCHE_TRAP_BASE          GPU_WORD(0x0e09)
+#define UCHE_CACHE_WAYS         GPU_WORD(0x0e17)
+#define UCHE_FILTER_CNTL        GPU_WORD(0x0e18)
+#define UCHE_CLIENT_PF          GPU_WORD(0x0e19)
+#define RB_NC_MODE_CNTL         GPU_WORD(0x8e08)
+#define PC_DBG_ECO_CNTL         GPU_WORD(0x9e00)
+#define SP_NC_MODE_CNTL         GPU_WORD(0xae02)
+#define TPL1_NC_MODE_CNTL       GPU_WORD(0xb604)
+#define TPL1_BICUBIC_WEIGHTS_TABLE_0 GPU_WORD(0xb608)
+#define RBBM_SECVID_TSB_TRUSTED_BASE GPU_WORD(0xf800)
+#define RBBM_SECVID_TSB_TRUSTED_SIZE GPU_WORD(0xf802)
+#define RBBM_SECVID_TSB_CNTL    GPU_WORD(0xf803)
+#define GBIF_QSB_SIDE0          (4 * 0x03)      /* in sa_gbif (0x3c03) */
+#define CP_RB_CNTL_A650         (12u | 2u << 8 | 1u << 27)      /* 32K ring, 32-byte blocks; no read-position copy to memory */
+
+/* PM4 packets (Mesa adreno_pm4.xml; Linux adreno_gpu.h OUT_PKT4 / OUT_PKT7) */
+#define CP_MEM_WRITE            0x3d
+#define CP_ME_INIT              0x48
+#define CP_SET_SECURE_MODE      0x66
+#define RING_WORDS              (CORE_RING_SIZE / 4)
+
+static uint32_t sa_ring_at, sa_ring_sent;
+
+static uint32_t
+sa_pm4_parity(uint32_t v)
+{
+	return 0x9669 >> (0xf & (v ^ v >> 4 ^ v >> 8 ^ v >> 12 ^ v >> 16 ^ v >> 20 ^ v >> 24 ^ v >> 28)) & 1;
+}
+
+static void
+sa_ring(uint32_t word)
+{
+	((uint32_t *)sa_core_ring.memory)[sa_ring_at] = word;
+	sa_ring_at = (sa_ring_at + 1) % RING_WORDS;
+}
+
+/* A type 7 packet: a command with `words` words after it. */
+static void
+sa_ring_packet(uint32_t opcode, uint32_t words)
+{
+	sa_ring(7u << 28 | words | sa_pm4_parity(words) << 15 | (opcode & 0x7f) << 16 | sa_pm4_parity(opcode) << 23);
+}
+
+/* What the ring holds since the last time goes out to memory, the core is told how far to read, and we wait for it to be idle. */
+static bool
+sa_ring_run(const char *what)
+{
+	uint32_t taken = ~0u, status = ~0u;
+
+	printf("SWEET GPU: %u: about to have the 3D core %s: the ring up to word %u\n", sa_step, what, sa_ring_at);
+	if (sa_pause_ms && sa_step == sa_steps) {
+		sa_sleep_ms(sa_pause_ms);
+	}
+	sa_to_memory(sa_core_ring.memory, CORE_RING_SIZE);
+	sa_ring_sent = sa_ring_at;
+	sa_wr(sa_gpu.base + CP_RB_WPTR, sa_ring_sent);
+	for (int i = 0; i < 20000 && (taken != sa_ring_sent || (status & RBBM_STATUS_GPU_BUSY)); i++) {
+		delay_for_interval(100, NSEC_PER_USEC);
+		taken = sa_rd(sa_gpu.base + CP_RB_RPTR);
+		status = sa_rd(sa_gpu.base + RBBM_STATUS);
+	}
+	bool faulted = sa_space_faulted(&sa_smmu_cb0, "the 3D core");
+	uint32_t hw_fault = sa_rd(sa_gpu.base + CP_HW_FAULT);
+	if (taken == sa_ring_sent && !(status & RBBM_STATUS_GPU_BUSY) && hw_fault == 0 && !faulted) {
+		printf("SWEET GPU: %u: the 3D core did it (ring read up to %u, status %#x)\n", sa_step, taken, status);
+		return true;
+	}
+	printf("SWEET GPU: %u: the 3D core does not get through: ring read up to %u of %u, status %#x, interrupts %#x, "
+	    "command processor: fault %#x, interrupts %#x, protection %#x\n", sa_step, taken, sa_ring_sent, status,
+	    sa_rd(sa_gpu.base + RBBM_INT_0_STATUS), hw_fault, sa_rd(sa_gpu.base + CP_INTERRUPT_STATUS),
+	    sa_rd(sa_gpu.base + CP_PROTECT_STATUS));
+	return false;
+}
