+static void
+sa_put64(struct sa_block *b, const char *name, uint32_t offset, uint64_t value)
+{
+	sa_put(b, name, offset, (uint32_t)value);
+	sa_put(b, name, offset + 4, (uint32_t)(value >> 32));
+}
