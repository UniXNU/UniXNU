+	sa_put(&sa_gpu, "rbbm_gbif_halt", RBBM_GBIF_HALT, 0);
+	sa_put(&sa_gpu, "rbbm_secvid_tsb_cntl", RBBM_SECVID_TSB_CNTL, 0);
+	sa_put64(&sa_gpu, "rbbm_secvid_tsb_trusted_base", RBBM_SECVID_TSB_TRUSTED_BASE, 0);
+	sa_put(&sa_gpu, "rbbm_secvid_tsb_trusted_size", RBBM_SECVID_TSB_TRUSTED_SIZE, 0);
+	for (unsigned i = 0; i < 12; i++) {
+		sa_put(&sa_gpu, "addr_mode_cntl", GPU_WORD(address_modes[i]), 1);
+	}
+	for (unsigned i = 0; i < 4; i++) {
