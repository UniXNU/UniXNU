+/*
+ * PMIC register access by PPID (SID << 8 | peripheral) for other drivers. Reads go
+ * through the observer like the key reads; writes through the EE 0 channel
+ * (PMIC arbiter v5 EXT_WRITEL: WDATA0, then CMD, poll STATUS), only for APIDs the
+ * arbiter's config says apps (EE 0) owns.
+ */
+static bool
+keys_map(void)
+{
+	if (!keys_core) {
+		keys_core = ml_io_map(KEYS_CORE_PA, 0x2000);
+		keys_cnfg = ml_io_map(KEYS_CNFG_PA, 0x1000);
+		keys_obs = ml_io_map(KEYS_OBS_PA, 0x10000);
+	}
+	if (!keys_chnl) {
+		keys_chnl = ml_io_map(KEYS_CHNL_PA, 0x10000);
+	}
+	return keys_core && keys_cnfg && keys_obs && keys_chnl;
+}
+
+int
+sweet_pmic_read(uint16_t ppid, uint8_t reg, uint8_t *val)
+{
+	if (!keys_map()) {
+		return ENXIO;
+	}
+	uint32_t count = keys_rd(keys_core, 4) & 0x7ffu;
+	uint16_t apid = keys_find_apid(ppid, count);
+	return keys_read(apid, (uint16_t)(((ppid & 0xffu) << 8) | reg), val) ? 0 : EIO;
+}
+
+int
+sweet_pmic_write(uint16_t ppid, uint8_t reg, uint8_t val)
+{
+	if (!keys_map()) {
+		return ENXIO;
+	}
+	uint32_t count = keys_rd(keys_core, 4) & 0x7ffu;
+	uint16_t apid = keys_find_apid(ppid, count);
+	if (apid == KEYS_NO_APID) {
+		return ENODEV;
+	}
+	if ((keys_rd(keys_cnfg, 0x700u + 4u * apid) & 7u) != 0) {
+		printf("SWEET PMIC: ppid %#x apid %u not owned by apps\n", ppid, apid);
+		return EPERM;
+	}
+	uint32_t off = 0x80u * apid;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(keys_chnl + off + 0x10u) = val;                        /* WDATA0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	*(volatile uint32_t *)(keys_chnl + off) = (0u << 27) | ((uint32_t)reg << 4);  /* EXT_WRITEL, 1 byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t st = keys_rd(keys_chnl, off + 0x08u);
+		if (st & 1u) {
+			return (st & 0x0eu) ? EIO : 0;
+		}
+		delay(1);
+	}
+	return ETIMEDOUT;
+}
