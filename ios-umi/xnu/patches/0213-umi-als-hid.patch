From 8401ef8f75bd23c276852e963d9229b6e087ec24 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Sat, 31 Oct 2026 22:45:58 +0100
Subject: [PATCH 1/2] umi: ambient light HID service for CoreBrightness
 auto-brightness

SweetHIDALS publishes the lux value read from the SLPI (sweet_als_lux) as
Apple's vendor-page ALS service (usage page 0xff00, usage 4, Built-In), the
same service MobileGestalt's ambient-light-sensor capability looks for and
CoreBrightness's AABC opens. A 500 ms timer posts an ambient light event when
the value changes, and at least every 2 s. Boot-arg sweetals=0 turns it off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 iokit/Kernel/arm/hid/SweetHID.cpp | 68 +++++++++++++++++++++++++++++++
 iokit/KernelConfigTables.cpp      |  5 +++
 2 files changed, 73 insertions(+)

diff --git a/iokit/Kernel/arm/hid/SweetHID.cpp b/iokit/Kernel/arm/hid/SweetHID.cpp
index 9611ab9..9aa5553 100644
--- a/iokit/Kernel/arm/hid/SweetHID.cpp
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -375,6 +375,74 @@ private:
 };
 OSDefineMetaClassAndStructors(SweetHIDTouch, IOHIDEventService);
 
+/*
+ * Ambient light (umi): the SLPI's ams TCS3701 read through SEE (bsd/dev/sweet_slpi.c,
+ * sweet_als_lux) as Apple's vendor-page ALS service (usage page 0xff00, usage 4, what
+ * AppleSPU publishes for the iPhone's ALS), so CoreBrightness can do auto-brightness.
+ * A timer posts an ambient light event (level and Illuminance = lux) when the value
+ * changes, and at least every 2 s.
+ */
+extern "C" int32_t sweet_als_lux;
+extern "C" bool sweet_board_is_umi(void);
+
+class SweetHIDALS : public IOHIDEventService {
+	OSDeclareDefaultStructors(SweetHIDALS);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return 0xff00; }
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return 4; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 3; }
+private:
+	static void poll(OSObject *owner, IOTimerEventSource *sender);
+	IOTimerEventSource *fTimer;
+	int32_t fLast;
+	UInt32 fQuiet;
+	UInt32 fSent;
+};
+OSDefineMetaClassAndStructors(SweetHIDALS, IOHIDEventService);
+
+bool
+SweetHIDALS::start(IOService *provider)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("sweetals", &on, sizeof(on));
+	if (!on || !sweet_board_is_umi() || !IOHIDEventService::start(provider)) {
+		return false;
+	}
+	fLast = -2;
+	fTimer = IOTimerEventSource::timerEventSource(this, &SweetHIDALS::poll);
+	if (!fTimer || _hidWorkLoop->addEventSource(fTimer) != kIOReturnSuccess) {
+		return false;
+	}
+	fTimer->setTimeoutMS(500);
+	registerService();
+	IOLog("SWEET HID: ambient light service registered\n");
+	return true;
+}
+
+void
+SweetHIDALS::poll(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDALS *self = (SweetHIDALS *)owner;
+	int32_t lux = sweet_als_lux;
+	if (lux >= 0 && (lux != self->fLast || ++self->fQuiet >= 4)) {
+		IOHIDEvent *event = IOHIDEvent::ambientLightSensorEvent(mach_absolute_time(), (UInt32)lux);
+		if (event) {
+			event->setIntegerValue(kIOHIDEventFieldAmbientLightSensorIlluminance, lux);
+			if (self->fSent++ < 20 || lux != self->fLast) {
+				IOLog("SWEET HID: ambient light %d lux (%u clients)\n", lux,
+				    self->_clients ? self->_clients->getCount() : 0);
+			}
+			self->dispatchEvent(event);
+			event->release();
+		}
+		self->fLast = lux;
+		self->fQuiet = 0;
+	}
+	sender->setTimeoutMS(500);
+}
+
 static SweetHIDButtons *gSweetButtons;
 static SweetHIDTouch *gSweetTouch;
 
diff --git a/iokit/KernelConfigTables.cpp b/iokit/KernelConfigTables.cpp
index 92f3e26..e0925e7 100644
--- a/iokit/KernelConfigTables.cpp
+++ b/iokit/KernelConfigTables.cpp
@@ -78,6 +78,11 @@ const char * gIOKernelConfigTables =
     "     'IOMatchCategory' = SweetHIDTouch;"
     "   },"
     "   {"
+    "     'IOClass'         = SweetHIDALS;"
+    "     'IOProviderClass' = IOResources;"
+    "     'IOMatchCategory' = SweetHIDALS;"
+    "   },"
+    "   {"
     "     'IOClass'         = SweetBattery;"
     "     'IOProviderClass' = IOResources;"
     "     'IOMatchCategory' = SweetBattery;"
