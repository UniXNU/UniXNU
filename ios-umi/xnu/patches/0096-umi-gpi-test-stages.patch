+/*
+ * Test mode (sweetgpistage=N): one line a second for sweettestsecs (40) so the persistent log
+ * shows when the phone died, then reboot into recovery (IMEM restart reason, PSCI SYSTEM_RESET)
+ * so the log can be read without anyone at the phone.
+ */
+static void
+touch_test_hold(void)
+{
+	unsigned secs = 40;
+	(void)PE_parse_boot_argn("sweettestsecs", &secs, sizeof(secs));
+	for (unsigned i = 1; i <= secs; i++) {
+		touch_wait(1000);
+		printf("SWEET TEST: stage %u alive %u s\n", st.test_stage, i);
+	}
+	printf("SWEET TEST: stage %u survived %u s; rebooting to recovery\n", st.test_stage, secs);
+	touch_wait(3000);       /* two persistent-log flushes */
+	vm_offset_t imem = ml_io_map(0x146bf000, 0x1000);
+	if (imem != 0) {
+		*(volatile uint32_t *)(imem + 0x65c) = 0x77665502u;    /* RECOVERY_MODE */
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	register uint64_t x0 __asm__("x0") = 0x84000009ull;     /* PSCI SYSTEM_RESET */
+	__asm__ volatile ("smc #0" : "+r"(x0) :: "x1", "x2", "x3", "memory");
+	printf("SWEET TEST: PSCI reset returned %#llx\n", x0);
+}
