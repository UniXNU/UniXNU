diff --git a/bsd/dev/sweet_gpi.c b/bsd/dev/sweet_gpi.c
index 6d29b9b..9bab1cd 100644
--- a/bsd/dev/sweet_gpi.c
+++ b/bsd/dev/sweet_gpi.c
@@ -35,6 +35,7 @@ int sweet_gpi_nop(void);
 #define GPI_EE_OFFSET   0x6000u         /* qcom,gpi-ee-offset: registers are relative to PA - this */
 #define GPI_MAP_SIZE    0x40000u
 #define GPI_SID         0x56u           /* iommus = <&apps_smmu 0x56 0x0> */
+#define QUP_SID         0x43u           /* qcom,qupv3_1_geni_se@ac0000 iommus = <&apps_smmu 0x43 0x0> */
 #define SMMU_PA         0x15000000u
 #define DMA_PA          0x9e200000u     /* free: splash 0x9c000000-0x9e300000, pool ends 0x9e200000 */
 #define DMA_SIZE        0x2000u
@@ -299,7 +300,7 @@ ev_cmd(uint32_t op, unsigned want)
  * BYPASS S2CRs on these SoCs, Linux arm-smmu-qcom uses such a bank too).
  */
 static bool
-gpi_smmu_route(void)
+smmu_route_sid(uint32_t sid)
 {
 	volatile uint32_t *gr0 = (volatile uint32_t *)ml_io_map(SMMU_PA, 0x1000);
 	if (gr0 == NULL) {
@@ -318,9 +319,9 @@ gpi_smmu_route(void)
 			}
 			continue;
 		}
-		if (((GPI_SID ^ id) & ~mask & 0x7fff) == 0) {
+		if (((sid ^ id) & ~mask & 0x7fff) == 0) {
 			printf("SWEET GPI: SMMU SMR%u id %#x mask %#x already routes stream %#x: S2CR %#x\n",
-			    i, id, mask, GPI_SID, s2cr);
+			    i, id, mask, sid, s2cr);
 			return ((s2cr >> 16) & 3) != 2;
 		}
 		if (((0x820 ^ id) & ~mask & 0x7fff) == 0 && ((s2cr >> 16) & 3) == 0) {
@@ -339,12 +340,28 @@ gpi_smmu_route(void)
 	}
 	gr0[(0xc00 + 4 * freeidx) / 4] = (uint32_t)displaycb;          /* S2CR: translate via that bank */
 	__asm__ volatile ("dsb sy" ::: "memory");
-	gr0[(0x800 + 4 * freeidx) / 4] = (1u << 31) | GPI_SID;         /* SMR: valid, exact id */
+	gr0[(0x800 + 4 * freeidx) / 4] = (1u << 31) | sid;         /* SMR: valid, exact id */
 	__asm__ volatile ("dsb sy" ::: "memory");
 	uint32_t smr = gr0[(0x800 + 4 * freeidx) / 4], s2cr = gr0[(0xc00 + 4 * freeidx) / 4];
 	printf("SWEET GPI: SMMU SMR%d = %#x, S2CR = %#x (stream %#x -> cb%d, translation off)\n",
-	    freeidx, smr, s2cr, GPI_SID, displaycb);
-	return smr == ((1u << 31) | GPI_SID) && (s2cr & 0x300ff) == (uint32_t)displaycb;
+	    freeidx, smr, s2cr, sid, displaycb);
+	return smr == ((1u << 31) | sid) && (s2cr & 0x300ff) == (uint32_t)displaycb;
+}
+
+/*
+ * The GPI fetches TREs and writes events as stream 0x56, but the bytes of a transfer
+ * are moved as the QUP1 wrapper's own stream 0x43 (DT qupv3_1_geni_se iommus; Linux maps
+ * the I2C buffers on the wrapper device): both need a route, or the data access faults.
+ */
+static bool
+gpi_smmu_route(void)
+{
+	uint32_t qup = QUP_SID;
+	(void)PE_parse_boot_argn("sweetqupsid", &qup, sizeof(qup));
+	if (!smmu_route_sid(GPI_SID)) {
+		return false;
+	}
+	return qup == 0 || smmu_route_sid(qup);
 }
 
