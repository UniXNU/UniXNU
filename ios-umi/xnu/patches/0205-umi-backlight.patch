  * SWEET process sampler (bsd/dev/sweet_sample.c): user pc/lr/sp and a frame
  * pointer backtrace of every thread of a task, from the saved user state.
  */
+void sweet_user_bt_current(const char *tag);
+
+/* The calling thread's user backtrace, one line ("UBT tag slide ... bt ..."). */
+void
+sweet_user_bt_current(const char *tag)
+{
+	thread_t thread = current_thread();
+	task_t task = current_task();
+	arm_saved_state_t *ss = find_user_regs(thread);
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	uint64_t slide = 0, fp;
+	char line[400];
+	int n;
+
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	if (ss == NULL || !is_saved_state64(ss)) {
+		return;
+	}
+	fp = get_saved_state_fp(ss);
+	n = snprintf(line, sizeof(line), "UBT %s slide 0x%llx mh 0x%llx lr 0x%llx bt", tag, slide,
+	    task->mach_header_vm_address, get_saved_state_lr(ss));
+	for (int i = 0; i < 24 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
+		uint64_t frame[2];
+		if (copyin(fp, frame, sizeof(frame)) != 0) {
+			break;
+		}
+		n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+	printf("%s\n", line);
+}
