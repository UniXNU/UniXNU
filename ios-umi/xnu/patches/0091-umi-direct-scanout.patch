+/* Direct scanout pool (sweet_scanout_configure) */
+#define SWEET_SCANOUT_SLOT      (16u << 20)
+#define SWEET_SCANOUT_MAX_SLOTS 8
+static uint64_t sweet_scanout_pool;             /* physical base, 0: off */
+static uint32_t sweet_scanout_slots;
+static uint32_t sweet_scanout_used;             /* bit per slot, sweet_surface_lock */
+static uint32_t sweet_scanout_w[2], sweet_scanout_h[2];
