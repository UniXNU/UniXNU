+/*
+ * Direct scanout. Qualcomm DPU (SM7150 / SM8250, MDSS at 0xae00000, MDP at
+ * 0xae01000): source pipes (SSPP) VIG0-3 and DMA0-3, SRC0_ADDR at +0x14 and
+ * SRC_YSTRIDE0 at +0x24 of each; CTL paths at +0x1000 + 0x200 n, CTL_FLUSH at
+ * +0x18 (bit 17 = CTL, pipe bits as in Linux dpu_hw_ctl.c). Which pipe and CTL
+ * ABL uses is found at run time: the pipe fetching the boot framebuffer, the
+ * CTL whose layer mixer has blending stages set. umi's panel is a command-mode
+ * DSI panel that ABL leaves in MDP autorefresh, so a flush is latched at the
+ * next refresh without a kick.
+ */
+static const struct { uint32_t off, bit; const char *name; } sweet_sspp[] = {
+	{ 0x04000, 1u << 0, "VIG0" }, { 0x06000, 1u << 1, "VIG1" },
+	{ 0x08000, 1u << 2, "VIG2" }, { 0x0a000, 1u << 18, "VIG3" },
+	{ 0x24000, 1u << 11, "DMA0" }, { 0x26000, 1u << 12, "DMA1" },
+	{ 0x28000, 1u << 24, "DMA2" }, { 0x2a000, 1u << 25, "DMA3" },
+};
+#define SWEET_MDP_SIZE          0x2c000
+#define SWEET_CTL_FLUSH_CTL     (1u << 17)
+
+static AppleCLCD *sweet_fb_direct;
+
+static void
+sweet_fb_panic_display(void)
+{
+	if (sweet_fb_direct != NULL) {
+		sweet_fb_direct->scanBoot();    /* the panic text is drawn into the boot framebuffer */
+	}
+}
+
+/* Clean the data cache to the point of coherency (the MDP does not snoop it). */
+static void
+sweet_dcache_clean(uintptr_t va, uint64_t len)
+{
+	uint64_t ctr;
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r"(ctr));
+	uint64_t line = 4ull << ((ctr >> 16) & 0xf);
+	for (uintptr_t p = va & ~(line - 1); p < va + len; p += line) {
+		__asm__ volatile ("dc cvac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * A surface the MDP may still be fetching counts as in use, so CoreAnimation
+ * does not render into it: IOSurfaceClientIsInUse (iOS 16.7) reads the u64 at
+ * +0x18 of the shared state page (ios-topaz 0099). Held from SwapEnd until one
+ * vsync after the next frame replaced it on the panel.
+ */
+static void
+sweet_hold(SweetSurface *s, bool on)
+{
+	OSAddAtomic64(on ? 1 : -1, (volatile SInt64 *)((uint8_t *)s->state->getBytesNoCopy() + 0x18));
+}
+
+static void
+sweet_hold_drop(SweetSurface **set)
+{
+	for (uint32_t i = 0; i < SWEET_FB_LAYERS; i++) {
+		if (set[i] != NULL) {
+			sweet_hold(set[i], false);
+			set[i]->release();
+			set[i] = NULL;
+		}
+	}
+}
+
+void
+AppleCLCD::setupScanout()
+{
+	uint32_t direct = 0, mdp = 0x0ae01000, smmu = 0x15000000, sid = 0x820;
+	uint32_t pool = 0xc0000000, slots = 6;     /* umi: free low RAM (0xb0400000 is disp_rdump_region) */
+
+	if (!PE_parse_boot_argn("sweetfb_direct", &direct, sizeof(direct)) || direct == 0) {
+		return;
+	}
+	PE_parse_boot_argn("sweetfb_mdp", &mdp, sizeof(mdp));
+	PE_parse_boot_argn("sweetfb_smmu", &smmu, sizeof(smmu));
+	PE_parse_boot_argn("sweetfb_sid", &sid, sizeof(sid));
+	PE_parse_boot_argn("sweetfb_pool", &pool, sizeof(pool));
+	PE_parse_boot_argn("sweetfb_slots", &slots, sizeof(slots));
+	bool umi = sweet_board_is_umi();
+
+	/*
+	 * The pool is used as physical addresses by the display. That only works if
+	 * the apps SMMU passes the display's stream through (bypass): log what ABL
+	 * left for the MDP stream id and refuse a translating context unless forced
+	 * (sweetfb_direct=2).
+	 */
+	if (smmu != 0) {
+		volatile uint32_t *gr0 = (volatile uint32_t *)ml_io_map(smmu, 0x1000);
+		if (gr0 != NULL) {
+			uint32_t n = gr0[0x20 / 4] & 0xff, matched = 0;
+			bool translate = false;
+			IOLog("SWEET FB: SMMU sCR0 %#x (unmatched streams %s), %u SMRs\n", gr0[0],
+			    (gr0[0] & (1u << 10)) ? "fault" : "bypass", n);
+			for (uint32_t i = 0; i < n && i < 128; i++) {
+				uint32_t smr = gr0[(0x800 + 4 * i) / 4];
+				uint32_t id = smr & 0x7fff, mask = (smr >> 16) & 0x7fff;
+				if (!(smr & (1u << 31)) || ((sid ^ id) & ~mask & 0x7fff) != 0) {
+					continue;
+				}
+				uint32_t s2cr = gr0[(0xc00 + 4 * i) / 4], type = (s2cr >> 16) & 3;
+				matched++;
+				translate |= type == 0;
+				IOLog("SWEET FB: SMMU SMR%u id %#x mask %#x -> S2CR %#x (%s, cb %u)\n", i, id, mask,
+				    s2cr, type == 0 ? "translate" : type == 1 ? "bypass" : "fault", s2cr & 0xff);
+			}
+			bool unmatched_fault = matched == 0 && (gr0[0] & (1u << 10));
+			if ((translate || unmatched_fault) && direct != 2) {
+				IOLog("SWEET FB: direct scanout off: the SMMU %s display stream %#x (sweetfb_direct=2 forces)\n",
+				    translate ? "translates" : "faults", sid);
+				return;
+			}
+		}
+	}
+
+	fMdp = (volatile uint32_t *)ml_io_map(mdp, SWEET_MDP_SIZE);
+	if (fMdp == NULL) {
+		return;
+	}
+	/* SM7150 has VIG0-1 and DMA0-2; SM8250 all eight */
+	int found = -1, hits = 0;
+	for (uint32_t i = 0; i < sizeof(sweet_sspp) / sizeof(sweet_sspp[0]); i++) {
+		if (!umi && (i == 2 || i == 3 || i == 7)) {
+			continue;
+		}
+		volatile uint32_t *p = fMdp + sweet_sspp[i].off / 4;
+		uint32_t src = p[0x14 / 4];
+		IOLog("SWEET FB: MDP %s src %#x stride %u size %#x\n", sweet_sspp[i].name, src,
+		    p[0x24 / 4] & 0xffff, p[0x00 / 4]);
+		if (src != 0 && (uint64_t)src >= fPhys && (uint64_t)src < fPhys + (uint64_t)fHeight * fRowBytes) {
+			found = (int)i;
+			hits++;
+		}
+	}
+	int ctl = -1, ctls = 0;
+	for (uint32_t n = 0; n < 6; n++) {
+		volatile uint32_t *c = fMdp + (0x1000 + 0x200 * n) / 4;
+		uint32_t layer0 = c[0x00 / 4], top = c[0x14 / 4];
+		IOLog("SWEET FB: MDP CTL%u layer0 %#x top %#x flush %#x\n", n, layer0, top, c[0x18 / 4]);
+		if (layer0 != 0) {
+			ctl = (int)n;
+			ctls++;
+		}
+	}
+	if (hits != 1 || ctls != 1) {
+		IOLog("SWEET FB: direct scanout off: %d pipes fetch the boot framebuffer, %d CTLs active "
+		    "(need 1 and 1; split panels are not handled)\n", hits, ctls);
+		return;
+	}
+	fPipeOff = sweet_sspp[found].off;
+	fCtlOff = 0x1000 + 0x200 * (uint32_t)ctl;
+	fPipe = fMdp + fPipeOff / 4;
+	fCtl = fMdp + fCtlOff / 4;
+	fFlushBits = sweet_sspp[found].bit | SWEET_CTL_FLUSH_CTL;
+	fBootSrc = fPipe[0x14 / 4];
+	fBootStride = fPipe[0x24 / 4] & 0xffff;
+	fScanPhys = fBootSrc;
+	if (fBootSrc != (uint32_t)fPhys) {
+		/* ABL scans a window of the framebuffer; keep it simple */
+		IOLog("SWEET FB: direct scanout off: %s fetches %#x, not the framebuffer start\n",
+		    sweet_sspp[found].name, fBootSrc);
+		fPipe = NULL;
+		return;
+	}
+	sweet_scanout_configure(pool, slots, fWidth, fHeight, fLogicalW, fLogicalH);
+	fDirect = true;
+	sweet_fb_direct = this;
+	sweet_panic_display_hook = sweet_fb_panic_display;
+	IOLog("SWEET FB: direct scanout on: %s via CTL%d (flush %#x), pool %#x x %u slots%s\n",
+	    sweet_sspp[found].name, ctl, fFlushBits, pool, slots, umi ? "" : " (not umi: untested)");
+}
+
+void
+AppleCLCD::scanFrom(uint64_t pa, uint32_t stride)
+{
+	fPipe[0x14 / 4] = (uint32_t)pa;
+	fPipe[0x24 / 4] = (fPipe[0x24 / 4] & 0xffff0000u) | stride;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fCtl[0x18 / 4] = fFlushBits;    /* latched at the next (auto)refresh */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fScanPhys = pa;
+}
+
+void
+AppleCLCD::scanBoot()
+{
+	if (fPipe != NULL && fScanPhys != fBootSrc) {
+		scanFrom(fBootSrc, fBootStride);
+	}
+}
