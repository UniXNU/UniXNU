+/*
+ * A frame that is exactly one full-screen surface from the scanout pool is
+ * shown by pointing the pipe at its panel window. Returns false for the copy
+ * path.
+ */
+bool
+AppleCLCD::directPresent(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104), layer = SWEET_FB_LAYERS, n = 0;
+	for (uint32_t i = 0; i < SWEET_FB_LAYERS; i++) {
+		if ((mask & (1u << i)) && get32(rec, 0x54 + 4 * i) != 0) {
+			layer = i;
+			n++;
+		}
+	}
+	if (n != 1) {
+		return false;
+	}
+	SweetSurface *s = sweet_surface_copy(get32(rec, 0x54 + 4 * layer));
+	if (s == NULL) {
+		return false;
+	}
+	bool ok = false;
+	if (s->scanoutPhys != 0 && s->bytesPerElement == 4 && s->width >= fWidth && s->height >= fHeight) {
+		uint32_t ox = (s->width - fWidth) / 2, oy = (s->height - fHeight) / 2;
+		if (s->width == fLogicalW && s->height == fLogicalH) {
+			ox = (uint32_t)fOffX;
+			oy = (uint32_t)fOffY;
+		}
+		uint64_t off = s->offset + (uint64_t)oy * s->bytesPerRow + (uint64_t)ox * 4;
+		uint64_t pa = s->scanoutPhys + off;
+		uint64_t len = (uint64_t)(fHeight - 1) * s->bytesPerRow + (uint64_t)fWidth * 4;
+		uintptr_t va = s->kernelAddress();
+		if ((pa & 0xf) == 0 && pa + len <= (1ull << 32) && off + len <= s->allocSize && va != 0 &&
+		    s->bytesPerRow <= 0xffff) {
+			sweet_dcache_clean(va + off, len);
+			scanFrom(pa, s->bytesPerRow);
+			ok = true;
+			IOLockLock(fLock);
+			SweetSurface *old = fLastSurf;
+			s->retain();
+			fLastSurf = s;
+			fLastOff = off;
+			IOLockUnlock(fLock);
+			OSSafeReleaseNULL(old);
+		}
+	}
+	s->release();
+	return ok;
+}
