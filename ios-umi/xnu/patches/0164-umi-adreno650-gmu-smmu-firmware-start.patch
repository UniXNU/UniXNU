+static bool
+sa_step_gmu_start(void)
+{
+	static const uint8_t priority[HFI_QUEUES] = { 10, 10, 40 };
+	uint32_t result = 0;
+
+	if (!sa_cx_ready() || !sa_gmu_space_on) {
+		return false;
+	}
+	sa_hfi = (volatile struct sa_hfi_table *)ml_io_map_wcomb(sa_phys(sa_gmu_hfi.memory), GMU_HFI_SIZE);
+	if (sa_hfi == NULL) {
+		return false;
+	}
+	sa_hfi->words = sizeof(struct sa_hfi_table) / 4;
+	sa_hfi->first_queue = 6;
+	sa_hfi->queue_words = sizeof(struct sa_hfi_queue) / 4;
+	sa_hfi->queues = sa_hfi->active_queues = HFI_QUEUES;
+	for (unsigned i = 0; i < HFI_QUEUES; i++) {
+		sa_hfi->queue[i].start = GMU_HFI_ADDRESS + HFI_QUEUE_AT(i);
+		sa_hfi->queue[i].type = i | (uint32_t)priority[i] << 8;
+		sa_hfi->queue[i].words = HFI_QUEUE_WORDS;
+		sa_hfi->queue[i].status = 1;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	sa_announce("configure the GMU (HFI table, log, chip ID, fence, caches, RPMh), wake its RPMh channel, then let its "
+	    "processor out of reset");
+	if (sa_get(&sa_gmu, "cm3_sysreset", GMU_CM3_SYSRESET) != 1) {
+		printf("SWEET GPU: %u: the GMU's processor is not held in reset\n", sa_step);
+		return false;
+	}
+	sa_put(&sa_gmu, "cx_falnext_intf", GMU_CX_FALNEXT_INTF, 1);
+	sa_put(&sa_gmu, "cx_fal_intf", GMU_CX_FAL_INTF, 1);
+	sa_put(&sa_gmu, "general_7", GMU_GENERAL_7, 1);
+	/* a6xx_rpmh_start */
+	sa_put(&sa_gmu, "rscc_control_req", GMU_RSCC_CONTROL_REQ, 2);
+	if (!sa_wait_for(&sa_gmu, GMU_RSCC_CONTROL_ACK, 2, 2, 10) || !sa_wait_for(&sa_rscc, RSCC_SEQ_BUSY_DRV0, ~0u, 0, 10)) {
+		printf("SWEET GPU: %u: the GMU's RPMh channel does not wake (ack %#x, seq busy %#x)\n", sa_step,
+		    sa_rd(sa_gmu.base + GMU_RSCC_CONTROL_ACK), sa_rd(sa_rscc.base + RSCC_SEQ_BUSY_DRV0));
+	}
+	sa_get(&sa_gmu, "rscc_control_ack", GMU_RSCC_CONTROL_ACK);
+	sa_put(&sa_gmu, "rscc_control_req", GMU_RSCC_CONTROL_REQ, 0);
+	/* a6xx_gmu_fw_start */
+	sa_put(&sa_gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT, 0);
+	sa_put(&sa_gmu, "cm3_boot_config", GMU_CM3_BOOT_CONFIG, 2);
+	sa_put(&sa_gmu, "hfi_qtbl_addr", GMU_HFI_QTBL_ADDR, GMU_HFI_ADDRESS);
+	sa_put(&sa_gmu, "hfi_qtbl_info", GMU_HFI_QTBL_INFO, 1);
+	sa_put(&sa_gmu, "ahb_fence_range_0", GMU_AHB_FENCE_RANGE_0, GMU_FENCE_RANGE_A650);
+	sa_put(&sa_gmu, "cm3_cfg", GMU_CM3_CFG, 0x4052);
+	sa_put(&sa_gmu, "hfi_sfr_addr", GMU_HFI_SFR_ADDR, GMU_CHIP_A650);
+	sa_put(&sa_gmu, "pwr_col_cp_msg", GMU_PWR_COL_CP_MSG, GMU_LOG_ADDRESS | (GMU_LOG_SIZE / 4096 - 1));
+	/* a6xx_gmu_power_config (idle level: none) */
+	sa_put(&sa_gmu, "sys_bus_config", GMU_SYS_BUS_CONFIG, 1);
+	sa_put(&sa_gmu, "icache_config", GMU_ICACHE_CONFIG, 1);
+	sa_put(&sa_gmu, "dcache_config", GMU_DCACHE_CONFIG, 1);
+	sa_put(&sa_gmu, "pwr_col_inter_frame_ctrl", GMU_PWR_COL_INTER_FRAME_CTRL, 0x9c40400);
+	sa_set(&sa_gmu, "rpmh_ctrl", GMU_RPMH_CTRL, GMU_RPMH_CTRL_ALL);
+	sa_put(&sa_gbif, "halt", GBIF_HALT, 0);
+	sa_put(&sa_gmu, "gmu2host_intr_clr", GMU_GMU2HOST_INTR_CLR, 0xffffffff);
+	/* a6xx_gmu_start: firmware newer than 0x20010004 reports 0x100 in bits 8:0 */
+	uint32_t version = sa_rd(sa_gmu.base + GMU_DTCM_VERSIONS);
+	uint32_t mask = version <= 0x20010004 ? 0xffffffffu : 0x1ffu;
+	uint32_t started = version <= 0x20010004 ? 0xbabefaceu : 0x100u;
+	printf("SWEET GPU: %u: firmware version %#x: started means init result & %#x == %#x\n", sa_step, version, mask, started);
+	sa_put(&sa_gmu, "pwr_col_cp_resp", GMU_PWR_COL_CP_RESP, 0);
+	sa_put(&sa_gmu, "cm3_sysreset", GMU_CM3_SYSRESET, 0);
+	for (int i = 0; i < 1000 && (result & mask) != started; i++) {
+		delay_for_interval(100, NSEC_PER_USEC);
+		result = sa_rd(sa_gmu.base + GMU_CM3_FW_INIT_RESULT);
+	}
+	sa_get(&sa_gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT);
+	sa_get(&sa_gmu, "hfi_version_info", GMU_HFI_VERSION_INFO);
+	if (sa_space_faulted(&sa_smmu_gmu_cb, "the GMU") || (result & mask) != started) {
+		printf("SWEET GPU: %u: the GMU's firmware does not come up\n", sa_step);
+		sa_gmu_post_mortem();
+		return false;
+	}
+	printf("SWEET GPU: %u: THE GMU'S FIRMWARE RUNS\n", sa_step);
+	sa_gmu_post_mortem();
+	return true;
+}
