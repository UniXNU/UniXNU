+/*
+ * Monitor-status reap (ath11k_dp_rx_reap_mon_status_ring + hal_rx_parse_mon_status):
+ * the host looks at the slot at its own HP once the hardware's TP has moved past
+ * it; a used buffer starts with TLV STATUS_BUFFER_DONE (0x140). TLV header u32:
+ * tag bits 9:1, length 25:10, user 31:26; 4-byte aligned; PPDU_END (0xce) counts
+ * as 4 bytes so the PHY TLVs after it are read. PPDU_START 0xcd: chan_num at +4;
+ * PHYRX_RSSI_LEGACY 0x4c: rssi_comb bits 15:8 of the word at +140 (signal =
+ * rssi_comb - 95 dBm, ath11k's default noise floor); MPDU_START 0xcf counted;
+ * PPDU_END_STATUS_DONE 0x13f or tag 0 ends a PPDU. The same buffer goes back
+ * into the slot (ath11k allocates a new one), the slot left empty at setup
+ * gets the ring's spare.
+ */
+static struct {
+	uint32_t bufs, ppdus, mpdus, notdone, logged;
+	int rssi_min, rssi_max;
+} mon = { .rssi_min = 127, .rssi_max = -128 };
+
+void sweet_wldp_mon_reap(void);
+void sweet_wldp_mon_report(void);
+
+static void
+mon_parse(const uint8_t *b, unsigned ring)
+{
+	uint32_t o = 0, chan = 0, nmpdu = 0;
+	int rssi = 0;
+	bool have_rssi = false;
+	while (o + 4 <= RXBUF_SZ) {
+		uint32_t tl;
+		memcpy(&tl, b + o, 4);
+		uint32_t tag = (tl >> 1) & 0x1ffu, len = (tl >> 10) & 0xffffu;
+		o += 4;
+		if (tag == 0xce) {
+			len = 4;
+		}
+		if (tag == 0xcd && o + 8 <= RXBUF_SZ) {
+			memcpy(&chan, b + o + 4, 4);
+		} else if (tag == 0x4c && o + 144 <= RXBUF_SZ) {
+			uint32_t info0;
+			memcpy(&info0, b + o + 140, 4);
+			rssi = (int)((info0 >> 8) & 0xffu) - 95;
+			have_rssi = true;
+		} else if (tag == 0xcf) {
+			nmpdu++;
+		}
+		if (tag == 0x13f || tag == 0) {
+			mon.ppdus++;
+			mon.mpdus += nmpdu;
+			if (have_rssi) {
+				mon.rssi_min = MIN(mon.rssi_min, rssi);
+				mon.rssi_max = MAX(mon.rssi_max, rssi);
+			}
+			if (mon.logged++ < 8) {
+				printf("SWEET WLDP: rx ppdu (status ring %u): channel %u, %u mpdu, signal %d dBm%s\n",
+				    ring, chan, nmpdu, rssi, have_rssi ? "" : " (no rssi tlv)");
+			}
+			break;
+		}
+		o = (o + len + 3) & ~3u;
+	}
+}
+
+void
+sweet_wldp_mon_reap(void)
+{
+	if (!rx_ready) {
+		return;
+	}
+	for (unsigned i = 0; i < RX_NRING; ++i) {
+		struct rxring *r = &rx_rings[i];
+		if (!r->bufs || r->htt_id != 1 || dp.mem == 0) {
+			continue;
+		}
+		uint32_t size = r->n * r->esz;
+		bool moved = false;
+		while ((r->hp + r->esz) % size != *mem32(M_RDP + r->id * 4)) {
+			volatile uint32_t *d = mem32(r->off + r->hp * 4);
+			uint32_t paddr = d[0], info1 = d[1];
+			if (paddr != 0) {
+				uint8_t *b = (uint8_t *)(dp.mem + (paddr - dp.pa));
+				uint32_t tl;
+				memcpy(&tl, b, 4);
+				if (((tl >> 1) & 0x1ffu) != 0x140) {
+					mon.notdone++;          /* not written yet: try again later */
+					break;
+				}
+				mon.bufs++;
+				mon_parse(b + 4, i - 5);
+				bzero(b, 4);
+			} else {
+				paddr = r->spare;
+				info1 = 4u << 8;                /* cookie 0, RBM SW1 */
+				r->spare = 0;
+				if (paddr == 0) {
+					break;
+				}
+			}
+			d[0] = paddr;
+			d[1] = info1;
+			r->hp = (r->hp + r->esz) % size;
+			moved = true;
+		}
+		if (moved) {
+			*mem32(M_WRP + (r->id - 128) * 4) = r->hp;
+		}
+	}
+}
+
+void
+sweet_wldp_mon_report(void)
+{
+	printf("SWEET WLDP: monitor status: %u buffers, %u ppdus, %u mpdus, signal %d..%d dBm, %u not done\n",
+	    mon.bufs, mon.ppdus, mon.mpdus, mon.ppdus ? mon.rssi_min : 0, mon.ppdus ? mon.rssi_max : 0, mon.notdone);
+}
+
 /* Entries whose first word (buffer address or status) is non-zero: what the target has written into a ring. */
 static uint32_t
 rx_filled(const struct rxring *r)
