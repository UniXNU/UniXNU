+bool
+sweet_cpu_sample(unsigned int cpu, uint32_t *mpidr, uint64_t *idle_abs)
+{
+	struct recount_usage usage = { 0 };
+	processor_t processor;
+
+	if (cpu >= topology_info.num_cpus || cpu >= MAX_SCHED_CPUS) {
+		return false;
+	}
+	processor = processor_array[cpu];
+	if (processor == PROCESSOR_NULL) {
+		return false;
+	}
+	*mpidr = topology_info.cpus[cpu].phys_id;
+	recount_processor_usage(&processor->pr_recount, &usage, idle_abs);
+	return true;
