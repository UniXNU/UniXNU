+//==============================================================================
+void IOHIDEvent::appendChild(IOHIDEvent *childEvent)
+{
+    if (!_children) {
+        const OSObject *events[] = { childEvent };
+
+        _children = OSArray::withObjects(events, 1);
+        
+        _data->options |= kIOHIDEventOptionIsCollection;
+    } else {
+        _children->setObject(childEvent);
+    }
+}
