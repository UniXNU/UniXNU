+		}
+	}
 	printf("SWEET WMI: BSS %02x:%02x:%02x:%02x:%02x:%02x ch %u %u MHz snr %u %s \"%s\"\n", bssid[0], bssid[1],
 	    bssid[2], bssid[3], bssid[4], bssid[5], ch, mhz, get32(hdr + 4), f[0] == 0x50 ? "probe-resp" : "beacon", ssid);
 }
@@ -719,7 +769,6 @@ wmi_cmd(uint32_t id, const void *body, uint32_t len, const char *name)
  * (single-pdev chip). Events: SCAN 0x3001 (tag 0x24), MGMT_RX 0x7001 (0x2c).
  */
 #define SCAN_NCHAN      13
-static const uint8_t wlce_mac[6] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x10 };  /* locally administered: OTP has none */
 
 static int
 wmi_scan(void)
@@ -915,6 +964,227 @@ wmi_scan(void)
 	return htc.scan_done ? 0 : 14;
 }
 
+/*
+ * Join an open network (0140), as mac80211 + ath11k do for a qca6390 station
+ * (vdev_start_delay: peer first, then vdev start), legacy 11g only:
+ *   PEER_CREATE 0x6001 (tag 0x61) -> HTT PEER_MAP; VDEV_START 0x5003 (tag 0x58 +
+ *   channel 0x50, MODE_11G, LDPC rx flag) -> VDEV_START_RESP 0x5001; auth and
+ *   assoc request through MGMT_TX_SEND 0x7008 (tag 0x1a6: frame in DMA memory,
+ *   first 64 bytes inline) -> MGMT_TX_COMPLETION 0x7006 + replies via MGMT_RX;
+ *   PEER_ASSOC 0x6005 (tag 0x65, 41 words: AUTH flag, 11G, 12 legacy rates) ->
+ *   PEER_ASSOC_CONF 0x6006; VDEV_UP 0x5005 (tag 0x5c); PEER_SET_PARAM 0x6004
+ *   (tag 0x64) AUTHORIZE (3) = 1. The network: boot-arg sweetwlanssid=NAME,
+ *   '_' for spaces (boot arguments cannot hold spaces); matched against the scan.
+ */
+#define M_MGMT_TX       0x7c000u        /* 2 KiB frame buffer in the copy-engine area */
+
+static bool
+wlce_wait(volatile bool *flag, unsigned ms)
+{
+	for (unsigned t = 0; t < ms && !*flag; ++t) {
+		htc_poll();
+		delay(1000);
+	}
+	return *flag;
+}
+
+static int
+wmi_mgmt_tx(const uint8_t *frame, uint32_t len, uint32_t desc)
+{
+	static uint32_t b[10 + 16];
+	uint32_t inl = MIN(len, 64u);
+	memcpy((void *)(ce.mem + M_MGMT_TX), frame, len);
+	bzero(b, sizeof(b));
+	b[0] = WMI_TLV(0x1a6, 8 * 4);
+	b[2] = desc;                    /* vdev 0, chanfreq 0 (on-channel) */
+	b[4] = ce.pa + M_MGMT_TX;
+	b[6] = len;
+	b[7] = inl;
+	b[9] = WMI_TLV(0x11, inl);
+	memcpy(&b[10], frame, inl);
+	htc.tx_done = false;
+	return wmi_cmd(0x7008u, b, (10 + (inl + 3) / 4) * 4, "MGMT_TX_SEND");
+}
+
+/* 802.11 management header: frame control, duration, DA, SA, BSSID, sequence */
+static uint32_t
+mgmt_hdr(uint8_t *f, uint8_t fc, const uint8_t *bssid, uint16_t seq)
+{
+	bzero(f, 24);
+	f[0] = fc;
+	memcpy(f + 4, bssid, 6);
+	memcpy(f + 10, wlce_mac, 6);
+	memcpy(f + 16, bssid, 6);
+	f[22] = (uint8_t)(seq << 4);
+	f[23] = (uint8_t)(seq >> 4);
+	return 24;
+}
+
+static int
+wmi_join(void)
+{
+	static uint32_t b[64];
+	static uint8_t f[128];
+	static const uint8_t rates[12] = { 0x82, 0x84, 0x8b, 0x96, 0x0c, 0x12, 0x18, 0x24, 0x30, 0x48, 0x60, 0x6c };
+	char want[33] = {0};
+	unsigned i;
+	if (!PE_parse_boot_argn("sweetwlanssid", want, sizeof(want)) || want[0] == 0) {
+		return 0;                       /* nothing to join */
+	}
+	for (i = 0; want[i]; ++i) {
+		if (want[i] == '_') {
+			want[i] = ' ';
+		}
+	}
+	size_t wl = strlen(want);
+	for (i = 0; i < MIN(htc.nbss, 32u); ++i) {
+		if (strlen((const char *)htc.bss_ssid[i]) == wl && memcmp(htc.bss_ssid[i], want, wl) == 0) {
+			break;
+		}
+	}
+	if (i >= MIN(htc.nbss, 32u)) {
+		printf("SWEET WMI: \"%s\" not among the %u networks heard\n", want, htc.nbss);
+		return 1;
+	}
+	const uint8_t *bssid = htc.bss[i];
+	uint32_t ch = htc.bss_ch[i], mhz = 2407 + 5 * ch;
+	uint32_t chains = MIN(htc.num_rf_chains ? htc.num_rf_chains : 1, 8u);
+	memcpy(htc.join_bssid, bssid, 6);
+	printf("SWEET WMI: joining \"%s\" %02x:%02x:%02x:%02x:%02x:%02x on channel %u\n", want, bssid[0], bssid[1],
+	    bssid[2], bssid[3], bssid[4], bssid[5], ch);
+
+	/* ath11k_peer_create: vdev 0, AP address, type default */
+	bzero(b, sizeof(b));
+	b[0] = WMI_TLV(0x61, 4 * 4);
+	memcpy(&b[2], bssid, 6);
+	if (wmi_cmd(0x6001u, b, 5 * 4, "PEER_CREATE") != 0) {
+		return 2;
+	}
+	if (!wlce_wait(&htc.peer_mapped, 1000)) {
+		printf("SWEET WMI: no HTT peer map in 1 s (continuing)\n");
+	}
+
+	/* ath11k_mac_vdev_start for the STA (ath11k_start_vdev_delay): channel of the AP, 11g */
+	bzero(b, sizeof(b));
+	b[0] = WMI_TLV(0x58, 26 * 4);
+	b[3] = 100;                     /* beacon interval */
+	b[4] = 1;                       /* dtim */
+	b[5] = 1u << 3;                 /* LDPC_RX_ENABLED */
+	b[19] = chains;                 /* preferred tx streams */
+	b[20] = chains;                 /* preferred rx streams */
+	uint32_t *c = b + 27;
+	c[0] = WMI_TLV(0x50, 24);
+	c[1] = mhz;
+	c[2] = mhz;
+	c[4] = 1;                       /* MODE_11G */
+	c[5] = 40u << 8 | 40u << 16;
+	c[6] = 40u << 8;
+	b[34] = WMI_TLV(0x12, 0);       /* no NoA descriptors */
+	if (wmi_cmd(0x5003u, b, 35 * 4, "VDEV_START") != 0) {
+		return 3;
+	}
+	if (!wlce_wait(&htc.vdev_started, 2000) || htc.vdev_start_status != 0) {
+		printf("SWEET WMI: vdev start %s (status %u)\n", htc.vdev_started ? "failed" : "not answered",
+		    htc.vdev_start_status);
+		return 4;
+	}
+
+	/* open-system authentication, transaction 1 */
+	uint32_t n = mgmt_hdr(f, 0xb0, bssid, 1);
+	bzero(f + n, 6);
+	f[n + 2] = 1;
+	n += 6;
+	if (wmi_mgmt_tx(f, n, 1) != 0) {
+		return 5;
+	}
+	wlce_wait(&htc.tx_done, 1000);
+	if (!wlce_wait(&htc.auth_rx, 2000) || htc.auth_status != 0) {
+		printf("SWEET WMI: auth %s (tx %s status %u, reply status %u)\n", htc.auth_rx ? "refused" : "not answered",
+		    htc.tx_done ? "done" : "pending", htc.tx_status, htc.auth_status);
+		return 6;
+	}
+
+	/* association request: capability ESS + short slot, listen interval 1, SSID, rates, extended rates */
+	n = mgmt_hdr(f, 0x00, bssid, 2);
+	f[n++] = 0x01;
+	f[n++] = 0x04;
+	f[n++] = 1;
+	f[n++] = 0;
+	f[n++] = 0;
+	f[n++] = (uint8_t)wl;
+	memcpy(f + n, want, wl);
+	n += wl;
+	f[n++] = 1;
+	f[n++] = 8;
+	memcpy(f + n, rates, 8);
+	n += 8;
+	f[n++] = 50;
+	f[n++] = 4;
+	memcpy(f + n, rates + 8, 4);
+	n += 4;
+	if (wmi_mgmt_tx(f, n, 2) != 0) {
+		return 7;
+	}
+	wlce_wait(&htc.tx_done, 1000);
+	if (!wlce_wait(&htc.assoc_rx, 2000) || htc.assoc_status != 0) {
+		printf("SWEET WMI: association %s (status %u)\n", htc.assoc_rx ? "refused" : "not answered", htc.assoc_status);
+		return 8;
+	}
+
+	/* ath11k_bss_assoc: peer assoc (legacy), wait for the confirmation */
+	bzero(b, sizeof(b));
+	b[0] = WMI_TLV(0x65, 40 * 4);
+	memcpy(&b[1], bssid, 6);
+	b[3] = 0;                       /* vdev */
+	b[4] = 1;                       /* new assoc */
+	b[5] = htc.aid;
+	b[6] = 0x1;                     /* WMI_PEER_AUTH: open network, no 4-way handshake */
+	b[7] = htc.ap_caps;
+	b[8] = 1;                       /* listen interval */
+	b[13] = 1;                      /* nss */
+	b[15] = 1;                      /* MODE_11G */
+	b[18] = sizeof(rates);          /* legacy rates */
+	uint32_t *p = b + 41;
+	*p++ = WMI_TLV(0x11, sizeof(rates));
+	memcpy(p, rates, sizeof(rates));
+	p += sizeof(rates) / 4;
+	*p++ = WMI_TLV(0x11, 0);        /* no HT rates */
+	*p++ = WMI_TLV(0x66, 5 * 4);    /* VHT rate set: unused */
+	p += 5;
+	*p++ = WMI_TLV(0x12, 0);        /* no HE rate sets */
+	if (wmi_cmd(0x6005u, b, (uint32_t)((uint8_t *)p - (uint8_t *)b), "PEER_ASSOC") != 0) {
+		return 9;
+	}
+	if (!wlce_wait(&htc.assoc_conf, 2000)) {
+		printf("SWEET WMI: no peer assoc confirmation (continuing)\n");
+	}
+
+	/* ath11k_wmi_vdev_up: vdev 0, AID, BSSID */
+	bzero(b, sizeof(b));
+	b[0] = WMI_TLV(0x5c, 8 * 4);
+	b[2] = htc.aid;
+	memcpy(&b[3], bssid, 6);
+	if (wmi_cmd(0x5005u, b, 9 * 4, "VDEV_UP") != 0) {
+		return 10;
+	}
+
+	/* ath11k_mac_op_sta_state -> AUTHORIZED: WMI_PEER_AUTHORIZE = 1 */
+	bzero(b, sizeof(b));
+	b[0] = WMI_TLV(0x64, 5 * 4);
+	memcpy(&b[2], bssid, 6);
+	b[4] = 3;
+	b[5] = 1;
+	if (wmi_cmd(0x6004u, b, 6 * 4, "PEER_SET_PARAM authorize") != 0) {
+		return 11;
+	}
+	for (unsigned t = 0; t < 2000; ++t) {   /* 2 s: a kickout (STA_KICKOUT 0x6001) would show here */
+		htc_poll();
+		delay(1000);
+	}
+	printf("SWEET WMI: associated to \"%s\" as AID %u (peer id %u)\n", want, htc.aid, htc.peer_id);
+	return 0;
+}
+
 /*
  * After WLAN_MODE: HTC READY, connect WMI control, SETUP_COMPLETE_EX, the
  * service-ready events, WMI_INIT, WMI_READY, then the scan. 0 or step 1-17
@@ -987,6 +1257,11 @@ sweet_wlce_htc(void)
 	if (htc.rdy_status != 0) {
 		return 8;
 	}
-	return wmi_scan();
+	r = wmi_scan();
+	if (r != 0) {
+		return r;
+	}
+	r = wmi_join();
+	return r ? 17 + r : 0;          /* 18 network not heard ... 28 authorize failed */
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
