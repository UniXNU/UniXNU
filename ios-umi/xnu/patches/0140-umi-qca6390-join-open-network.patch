 	}
@@ -556,7 +584,27 @@ wmi_mgmt_rx(const uint8_t *hdr, const uint8_t *m, uint32_t len)
 	uint32_t fl;
 	const uint8_t *f = wmi_tlv_find(m, len, 0x11, &fl);
