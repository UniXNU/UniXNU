+		return;
+	}
+	if (fl < 36 || (f[0] != 0x80 && f[0] != 0x50)) {
 		return;
 	}
 	const uint8_t *bssid = f + 16;
@@ -565,25 +613,27 @@ wmi_mgmt_rx(const uint8_t *hdr, const uint8_t *m, uint32_t len)
 			return;
 		}
 	}
