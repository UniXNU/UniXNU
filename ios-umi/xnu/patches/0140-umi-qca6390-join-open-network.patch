@@ -534,6 +547,21 @@ wmi_rx(uint32_t id, const uint8_t *m, uint32_t len)
 		}
 		printf("SWEET WMI: regulatory phy %u: country \"%s\" id %u domain %#x\n",
 		    get32(v + 4), cc, get32(v + 16), get32(v + 20));
+	} else if (id == 0x5001u && (v = wmi_tlv_find(m, len, 0x28, &l)) != NULL && l >= 16) {
