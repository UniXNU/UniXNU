+/*
+ * ST FTM5 (fts_521): drain the event FIFO one 8-byte event at a time.
+ * Point events: id = e[1] >> 4, type = e[1] & 15,
+ * x = (e[3] & 15) << 8 | e[2], y = e[4] << 4 | e[3] >> 4 (no swap on umi).
+ */
+static int
+touch_stfts(void)
+{
+	uint8_t ev[STFTS_EVENT_LEN];
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	uint32_t mask = st.active;
+	memcpy(x, st.x, sizeof(x));
+	memcpy(y, st.y, sizeof(y));
+	for (unsigned i = 0; i < STFTS_FIFO_DEPTH; ++i) {
+		int err = touch_read(STFTS_ADDR, STFTS_FIFO_READ, false, ev, sizeof(ev));
+		if (err) {
+			return err;
+		}
+		unsigned id = ev[1] >> 4;
+		switch (ev[0]) {
+		case STFTS_EVT_NONE:
+			touch_report(mask, x, y);
+			return 0;
+		case STFTS_EVT_ENTER:
+		case STFTS_EVT_MOTION: {
+			if (id >= TOUCH_MAX) {
+				return EIO;
+			}
+			unsigned px = ((unsigned)(ev[3] & 15u) << 8) | ev[2];
+			unsigned py = ((unsigned)ev[4] << 4) | (ev[3] >> 4);
+			if ((ev[1] & 15u) == STFTS_TYPE_HOVER) {
+				mask &= ~(1u << id);
+				break;
+			}
+			mask |= 1u << id;
+			x[id] = (int)(px < UMI_PANEL_W ? px : UMI_PANEL_W - 1);
+			y[id] = (int)(py < UMI_PANEL_H ? py : UMI_PANEL_H - 1);
+			break;
+		}
+		case STFTS_EVT_LEAVE:
+			if (id < TOUCH_MAX) {
+				mask &= ~(1u << id);
+			}
+			break;
+		case STFTS_EVT_ERROR:
+		case STFTS_EVT_READY:
+			printf("SWEET TOUCH: stfts event %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+			break;
+		default:
+			break; /* status updates, gestures, echoes */
+		}
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
