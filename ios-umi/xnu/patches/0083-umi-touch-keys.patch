+/*
+ * The Xiaomi Mi 10 (umi, SM8250) runs this kernel too: tools/mkadt.py
+ * --board umi adds "xiaomi,umi" to the root compatible. The RSC and its
+ * TCS layout match sweet; umi's DT declares cmd-db as fixed reserved RAM.
+ */
+#define RH_UMI_DB_PA    0x80860000u
+#define RH_UMI_DB_SIZE  0x20000u
+
+bool
+sweet_board_is_umi(void)
+{
+	static int umi = -1;
+	if (umi < 0) {
+		DTEntry root;
+		void const *prop;
+		unsigned int size = 0;
+		umi = 0;
+		if (SecureDTLookupEntry(NULL, "/", &root) == kSuccess &&
+		    SecureDTGetProperty(root, "compatible", &prop, &size) == kSuccess) {
+			const char *p = prop;
+			static const char want[] = "xiaomi,umi";
+			for (unsigned int i = 0; i + sizeof(want) <= size; ) {
+				if (memcmp(p + i, want, sizeof(want)) == 0) {
+					umi = 1;
+					break;
+				}
+				while (i < size && p[i]) {
+					++i;
+				}
+				++i;
+			}
+		}
+	}
+	return umi == 1;
+}
 
