+/*
+ * A file of another FAT partition, by its long names (sweet_bt.c: image/htbtfw20.tlv of the
+ * bluetooth partition). Read-only; each call mounts the partition again, with a buffer of its own.
+ */
+int
+sweet_fat_read_file(const char *part, const char *dir, const char *name, void *dst, uint32_t max, uint32_t *size)
+{
+	struct fatvol vol = { .part = part }, *v = &vol;
+	uint32_t c = 0, sz = 0, f = 0;
+	int err;
+
+	v->buf = kalloc_data(FAT_BUF_SIZE, Z_WAITOK | Z_ZERO);
+	if (v->buf == NULL) {
+		return ENOMEM;
+	}
+	err = fat_mount(v);
+	if (!err && dir != NULL) {
+		err = fat_find(v, 0, dir, &c, &sz);
+	}
+	if (!err) {
+		err = fat_find(v, c, name, &f, &sz);
+	}
+	if (!err && (sz == 0 || sz > max)) {
+		err = EFBIG;
+	}
+	if (!err) {
+		err = fat_read(v, f, sz, dst);
+	}
+	kfree_data(v->buf, FAT_BUF_SIZE);
+	if (err) {
+		printf("SWEET WLAN: %s: %s/%s: error %d\n", part, dir ? dir : "", name, err);
+		return err;
+	}
+	*size = sz;
+	return 0;
+}
