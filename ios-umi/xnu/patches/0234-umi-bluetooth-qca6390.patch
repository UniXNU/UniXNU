+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+extern int sweet_fat_read_file(const char *part, const char *dir, const char *name, void *dst, uint32_t max,
+    uint32_t *size);    /* sweet_wlan.c */
+extern bool sweet_board_is_umi(void);
+extern int SweetBluetoothPublish(const uint8_t address[6], const uint8_t commands[64]);  /* SweetBluetooth.cpp */
