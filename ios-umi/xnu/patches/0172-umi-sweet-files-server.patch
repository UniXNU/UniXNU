diff --git a/bsd/dev/sweet_files.c b/bsd/dev/sweet_files.c
new file mode 100644
index 0000000..6b9b6f7
--- /dev/null
+++ b/bsd/dev/sweet_files.c
@@ -0,0 +1,350 @@
+/*
+ * File server for the running iOS root, over USB Ethernet: TCP 192.168.7.2:2223
+ * (on the Mac: tools/umi-files.py, the phone's ue0 address, host side 192.168.7.1
+ * via tools/umi-usbnet.sh). One request per connection, a header line then data:
+ *
+ *   PUT <path> <mode-octal> <size>\n<size bytes>  -> "OK <size>\n"  (root:wheel)
+ *   GET <path>\n                                  -> "OK <size>\n<bytes>"
+ *   MKDIR <path> <mode-octal>\n                   -> "OK\n"
+ *   LINK <target> <path>\n                        -> "OK\n"  (symlink)
+ *   RM <path>\n                                   -> "OK\n"
+ *   CHMOD <path> <mode-octal>\n                   -> "OK\n"
+ *
+ * Errors: "ERR <errno>\n". Paths have no spaces. Started with the USB gadget
+ * (sweet_usb.c) when the interface comes up (boot-arg sweetfiles=0 keeps it off).
+ *
+ * Ported from ios-flame (NWylynko/ios-flame, patch 0091 bsd/dev/sweet_files.c,
+ * xnu-8796 as here): the protocol and the vfs helpers are flame's. umi differs
+ * in one thing: it has no USB command channel to ask for a sync, so every
+ * request that changes the file system is followed by sync(), so what it wrote
+ * survives the reset that ends a fastboot-boot test cycle (HFS+ journal).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/kernel.h>
+#include <sys/kauth.h>
+#include <sys/kpi_socket.h>
+#include <sys/socket.h>
+#include <sys/uio.h>
+#include <netinet/in.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+
+extern int sweet_vfs_mkdir(const char *path, int mode);         /* bsd/vfs/vfs_syscalls.c */
+extern int sweet_vfs_symlink(const char *target, const char *link);
+extern int sweet_vfs_unlink(const char *path);
+struct sync_args;
+extern int sync(proc_t p, struct sync_args *uap, int32_t *retval);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_files_start(void);
+
+#define SF_BUF  (64 * 1024)
+#define SF_PORT 2223
+
+static char *sf_buf;
+
+static void
+sf_sleep_ms(int ms)
+{
+	(void)tsleep(&sf_buf, PZERO, "sweetfiles", MAX(1, ms * hz / 1000));
+}
+
+static unsigned long long
+sf_dec(const char *p)
+{
+	unsigned long long v = 0;
+	while (*p == ' ') {
+		p++;
+	}
+	while (*p >= '0' && *p <= '9') {
+		v = v * 10 + (unsigned)(*p++ - '0');
+	}
+	return v;
+}
+
+static int
+sf_recv(socket_t so, void *buf, size_t len, size_t *got, int flags)
+{
+	struct iovec iov = { .iov_base = buf, .iov_len = len };
+	struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+	return sock_receive(so, &msg, flags, got);
+}
+
+static int
+sf_recv_all(socket_t so, void *buf, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		size_t got = 0;
+		int err = sf_recv(so, (char *)buf + off, len - off, &got, MSG_WAITALL);
+		if (err) {
+			return err;
+		}
+		if (got == 0) {
+			return ECONNRESET;
+		}
+		off += got;
+	}
+	return 0;
+}
+
+static int
+sf_send(socket_t so, const void *buf, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		struct iovec iov = { .iov_base = (char *)buf + off, .iov_len = len - off };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+		size_t sent = 0;
+		int err = sock_send(so, &msg, 0, &sent);
+		if (err) {
+			return err;
+		}
+		off += sent;
+	}
+	return 0;
+}
+
+static void
+sf_reply(socket_t so, int err, uint64_t n, bool with_n)
+{
+	char line[48];
+	int len = err ? snprintf(line, sizeof(line), "ERR %d\n", err) :
+	    with_n ? snprintf(line, sizeof(line), "OK %llu\n", n) : snprintf(line, sizeof(line), "OK\n");
+	(void)sf_send(so, line, (size_t)len);
+}
+
+/* Header line: up to '\n', read byte by byte so data after it stays queued. */
+static int
+sf_line(socket_t so, char *line, size_t max)
+{
+	size_t n = 0;
+	while (n + 1 < max) {
+		size_t got = 0;
+		int err = sf_recv(so, line + n, 1, &got, MSG_WAITALL);
+		if (err || got == 0) {
+			return err ? err : ECONNRESET;
+		}
+		if (line[n] == '\n') {
+			break;
+		}
+		n++;
+	}
+	line[n] = 0;
+	return 0;
+}
+
+/* Push the file system out (HFS+ journal), so a reset does not lose what we wrote. */
+static void
+sf_sync(void)
+{
+	int32_t rv = 0;
+	(void)sync(kernproc, NULL, &rv);
+}
+
+static int
+sf_setattr(const char *path, int mode, bool owner)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_lookup(path, 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & 07777);
+	if (owner) {
+		VATTR_SET(&va, va_uid, 0);
+		VATTR_SET(&va, va_gid, 0);
+	}
+	err = vnode_setattr(vp, &va, ctx);
+	vnode_put(vp);
+	return err;
+}
+
+static int
+sf_put(socket_t so, const char *path, int mode, uint64_t size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, mode & 07777, 0, &vp, ctx);
+	uint64_t off = 0;
+	while (off < size) {
+		size_t chunk = (size_t)MIN((uint64_t)SF_BUF, size - off);
+		int rerr = sf_recv_all(so, sf_buf, chunk);
+		if (rerr) {
+			err = err ? err : rerr;
+			break;
+		}
+		if (!err) {
+			int resid = 0;
+			err = vn_rdwr(UIO_WRITE, vp, sf_buf, (int)chunk, (off_t)off, UIO_SYSSPACE, IO_UNIT,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			if (!err && resid) {
+				err = EIO;
+			}
+		}
+		off += chunk;
+	}
+	if (vp != NULLVP) {
+		vnode_close(vp, FWRITE, ctx);
+	}
+	if (!err) {
+		err = sf_setattr(path, mode, true);
+	}
+	return err;
+}
+
+static int
+sf_get(socket_t so, const char *path)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	int err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (!err) {
+		err = vnode_size(vp, &size, ctx);
+	}
+	if (err) {
+		if (vp != NULLVP) {
+			vnode_close(vp, FREAD, ctx);
+		}
+		sf_reply(so, err, 0, false);
+		return err;
+	}
+	sf_reply(so, 0, (uint64_t)size, true);
+	for (off_t off = 0; off < size && !err;) {
+		int chunk = (int)MIN((off_t)SF_BUF, size - off), resid = 0;
+		err = vn_rdwr(UIO_READ, vp, sf_buf, chunk, off, UIO_SYSSPACE, IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!err) {
+			err = sf_send(so, sf_buf, (size_t)(chunk - resid));
+		}
+		off += chunk;
+	}
+	vnode_close(vp, FREAD, ctx);
+	return err;
+}
+
+static void
+sf_handle(socket_t so)
+{
+	static char line[1100];
+	char a[512], b[512];
+	unsigned long long n = 0;
+	int err = sf_line(so, line, sizeof(line));
+	if (err) {
+		return;
+	}
+	a[0] = b[0] = 0;
+	if (!strncmp(line, "PUT ", 4)) {
+		unsigned mode = 0644;
+		char *p = line + 4, *sp = strchr(p, ' ');
+		if (!sp || (size_t)(sp - p) >= sizeof(a)) {
+			sf_reply(so, EINVAL, 0, false);
+			return;
+		}
+		memcpy(a, p, (size_t)(sp - p));
+		a[sp - p] = 0;
+		mode = (unsigned)strtoul(sp + 1, &p, 8);
+		n = sf_dec(p);
+		err = sf_put(so, a, (int)mode, n);
+		printf("SWEET FILES: PUT %s %o %llu -> %d\n", a, mode, n, err);
+		sf_reply(so, err, n, true);
+		sf_sync();
+		return;
+	}
+	if (!strncmp(line, "GET ", 4)) {
+		err = sf_get(so, line + 4);
+		printf("SWEET FILES: GET %s -> %d\n", line + 4, err);
+		return;
+	}
+	char *sp = strchr(line, ' ');
+	if (!sp) {
+		sf_reply(so, EINVAL, 0, false);
+		return;
+	}
+	*sp = 0;
+	char *arg1 = sp + 1, *arg2 = strchr(arg1, ' ');
+	if (arg2) {
+		*arg2++ = 0;
+	}
+	if (!strcmp(line, "MKDIR")) {
+		err = sweet_vfs_mkdir(arg1, arg2 ? (int)strtoul(arg2, NULL, 8) : 0755);
+		if (err == EEXIST) {
+			err = 0;
+		}
+	} else if (!strcmp(line, "LINK") && arg2) {
+		err = sweet_vfs_symlink(arg1, arg2);
+	} else if (!strcmp(line, "RM")) {
+		err = sweet_vfs_unlink(arg1);
+	} else if (!strcmp(line, "CHMOD") && arg2) {
+		err = sf_setattr(arg1, (int)strtoul(arg2, NULL, 8), false);
+	} else {
+		err = EINVAL;
+	}
+	printf("SWEET FILES: %s %s %s -> %d\n", line, arg1, arg2 ? arg2 : "", err);
+	sf_reply(so, err, 0, false);
+	sf_sync();
+}
+
+static void
+sf_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	socket_t ls = NULL;
+	struct sockaddr_in me;
+	int one = 1;
+
+	sf_buf = kalloc_data(SF_BUF, Z_WAITOK);
+	for (;;) {
+		if (sf_buf != NULL && sock_socket(PF_INET, SOCK_STREAM, IPPROTO_TCP, NULL, NULL, &ls) == 0) {
+			(void)sock_setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+			bzero(&me, sizeof(me));
+			me.sin_len = sizeof(me);
+			me.sin_family = AF_INET;
+			me.sin_port = htons(SF_PORT);
+			me.sin_addr.s_addr = htonl(INADDR_ANY);
+			if (sock_bind(ls, (struct sockaddr *)&me) == 0 && sock_listen(ls, 4) == 0) {
+				break;
+			}
+			sock_close(ls);
+		}
+		ls = NULL;
+		sf_sleep_ms(1000);
+	}
+	printf("SWEET FILES: listening on tcp %u (the file server for the running root)\n", SF_PORT);
+	for (;;) {
+		socket_t c = NULL;
+		if (sock_accept(ls, NULL, 0, 0, NULL, NULL, &c) != 0 || c == NULL) {
+			sf_sleep_ms(100);
+			continue;
+		}
+		sf_handle(c);
+		sock_close(c);
+	}
+}
+
+void
+sweet_files_start(void)
+{
+	thread_t thread;
+	int on = 1;
+
+	(void)PE_parse_boot_argn("sweetfiles", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	if (kernel_thread_start(sf_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 64d8382..65e4556 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -1009,5 +1009,9 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	if (ud.ifp != NULL) {
 		sweet_mon_start();
 	}
+	if (ud.ifp != NULL) {
+		extern void sweet_files_start(void);
+		sweet_files_start();    /* tcp 2223 on ue0: bsd/dev/sweet_files.c */
+	}
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
index 842ea3b..3aa54ee 100644
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -14709,3 +14709,35 @@ fs_snapshot(__unused proc_t p, struct fs_snapshot_args *uap,
 
 	return error;
 }
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * Kernel-path wrappers for the SWEET file server (bsd/dev/sweet_files.c):
+ * installs test binaries and tools into the running root over USB Ethernet.
+ */
+int sweet_vfs_mkdir(const char *path, int mode);
+int sweet_vfs_symlink(const char *target, const char *link);
+int sweet_vfs_unlink(const char *path);
+
+int
+sweet_vfs_mkdir(const char *path, int mode)
+{
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, (mode & ACCESSPERMS) & ~0);
+	return mkdir1at(vfs_context_kernel(), CAST_USER_ADDR_T(path), &va, AT_FDCWD, UIO_SYSSPACE);
+}
+
+int
+sweet_vfs_symlink(const char *target, const char *link)
+{
+	return symlinkat_internal(vfs_context_kernel(), CAST_USER_ADDR_T(target), AT_FDCWD,
+	           CAST_USER_ADDR_T(link), UIO_SYSSPACE);
+}
+
+int
+sweet_vfs_unlink(const char *path)
+{
+	return unlink1(vfs_context_kernel(), NULLVP, CAST_USER_ADDR_T(path), UIO_SYSSPACE, 0);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
