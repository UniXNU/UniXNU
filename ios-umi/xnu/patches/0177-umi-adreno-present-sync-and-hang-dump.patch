 			scanFrom(pa, s->bytesPerRow);
 			ok = true;
 			IOLockLock(fLock);
@@ -977,6 +980,10 @@ AppleCLCD::present(const uint8_t *rec)
 {
 	uint32_t mask = get32(rec, 0x104);
 
