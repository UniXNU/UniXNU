+	sweet_adreno_finish();
+
 	if (fDirect) {
 		fLastDirect = directPresent(rec);
 		if (!fLastDirect) {
@@ -1065,11 +1072,17 @@ AppleCLCD::present(const uint8_t *rec)
 			src = 0;
 		}
 		if (src != 0 && bpe == 4) {
+			/* the GPU wrote the source (Metal on Turnip); its lines may sit stale in the
