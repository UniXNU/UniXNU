diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index 68301fd..8fc765c 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -91,6 +91,19 @@ static IOLock       *sweet_surface_lock;
 static SweetSurface *sweet_surface_table[SWEET_SURFACE_MAX_ID];
 static uint32_t      sweet_surface_users[SWEET_SURFACE_MAX_ID];
 static uint32_t      sweet_surface_next_id = 1;
+/* Clean and invalidate the data cache (memory the CPU wrote that the GPU will use). */
+static void
+sweet_dcache_flush(uintptr_t va, uint64_t len)
+{
+	uint64_t ctr;
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r"(ctr));
+	uint64_t line = 4ull << ((ctr >> 16) & 0xf);
+	for (uintptr_t p = va & ~(line - 1); p < va + len; p += line) {
+		__asm__ volatile ("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
 static uint32_t      sweet_surface_creates_logged;
 static uint64_t      sweet_surface_wired;       /* bytes of buffer surfaces */
 #define SWEET_SURFACE_WIRED_MAX         (1536ull << 20)
@@ -843,6 +856,7 @@ IOSurfaceRootUserClient::create(IOExternalMethodArguments *args)
 					s->scanoutPhys = 0;
 				} else {
 					bzero((void *)va, s->allocSize);
+					sweet_dcache_flush(va, s->allocSize);   /* the GPU renders here: no dirty line may land on it */
 					if (!sweet_surface_publish(s)) {
 						ret = kIOReturnNoResources;
 					}
@@ -864,6 +878,7 @@ IOSurfaceRootUserClient::create(IOExternalMethodArguments *args)
 			ret = kIOReturnNoMemory;
 		} else {
 			bzero(mem->getBytesNoCopy(), s->allocSize);
+			sweet_dcache_flush((uintptr_t)mem->getBytesNoCopy(), s->allocSize);  /* the GPU renders here */
 			s->memory = mem;
 			s->mapCache = kIOMapDefaultCache;
 			if (!sweet_surface_publish(s)) {
