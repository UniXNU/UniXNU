From d41b836551621372edb882155e7f955b8718924b Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Wed, 28 Oct 2026 14:11:55 +0100
Subject: [PATCH] umi-0177-adreno-present-sync-and-hang-dump

Metal on Turnip renders into SweetSurface objects and the frame
swap reads them on the CPU, so the present path waits for the GPU now
(sweet_adreno_finish: the latest fence, before directPresent's scanout
and before present's copies) and drops the CPU's stale lines of
GPU-written memory before reading or scanning it (clean+invalidate in
present's copy path and directPresent; both surface-creation paths
flush after their bzero; BoAlloc cleans its pages after bzero - the
v2 test's words read back 0 before that). Turnip's bigger workloads:
SA_TABLES_MAX 64 -> 1024 (every 2 MB of dense window VA costs an L3
table; SpringBoard's 8 MB BoMaps hit NoResources at 64), and a fence
wait "forever" fails after 120 s instead of hanging.

A fence that will not signal dumps the core's state once after 2 s of
failed waits (IOLog, so it reaches the live log): how far the CP read
the ring, the fence word, RBBM status and interrupts, CP fault /
interrupt / protection / status 1, the SQE's instruction address, the
SMMU's fault registers, the last 8 submissions' IBs (the words the SQE
is stopped on are read through context 0's page tables, from the
kernel's map of the same pages). Submits, BoCpuMaps and wait-fence
failures log with budgets of their own.

First finding on the phone (umi-0177-metal.img): the fence-950 hang is
CP_OPCODE_ERROR (CP_INTERRUPT_STATUS bit 0, a6xx.xml A6XX_CP_INT) with
the core busy in backboardd's indirect buffers - a bad opcode in a
command stream, not a lost fence write: ring fully read (1674 of 1674),
fence word stuck at the previous submission, no SMMU fault, no
protection violation.

Co-Authored-By: Mistral Vibe <vibe@mistral.ai>
---
 bsd/dev/sweet_adreno.c                | 146 +++++++++++++++++++++++++-
 iokit/Kernel/arm/SweetAdreno.cpp      |  22 +++-
 iokit/Kernel/arm/SweetFramebuffer.cpp |  15 ++-
 iokit/Kernel/arm/SweetSurface.cpp     |  15 +++
 4 files changed, 193 insertions(+), 5 deletions(-)

diff --git a/bsd/dev/sweet_adreno.c b/bsd/dev/sweet_adreno.c
index 22aa279..9cfd45b 100644
--- a/bsd/dev/sweet_adreno.c
+++ b/bsd/dev/sweet_adreno.c
@@ -963,7 +963,7 @@ sa_zap_release(void)
 #define PTE_NOT_GLOBAL          (1ull << 11)
 #define PTE_ADDRESS             0x0000fffffffff000ull
 #define PTE_GMU                 (PTE_SHARED | PTE_ACCESSED | PTE_NOT_GLOBAL)    /* privileged, uncached (MAIR 0) */
-#define SA_TABLES_MAX           64
+#define SA_TABLES_MAX           1024
 
 static uint64_t
 sa_phys(vm_offset_t va)
@@ -1945,6 +1945,7 @@ sa_step_zap_load(void)
 #define CP_HW_FAULT             GPU_WORD(0x0821)
 #define CP_INTERRUPT_STATUS     GPU_WORD(0x0823)
 #define CP_PROTECT_STATUS       GPU_WORD(0x0824)
+#define CP_STATUS_1             GPU_WORD(0x0825)
 #define CP_SQE_INSTR_BASE       GPU_WORD(0x0830)
 #define CP_APRIV_CNTL           GPU_WORD(0x0844)
 #define CP_PROTECT_CNTL         GPU_WORD(0x084f)
@@ -2460,6 +2461,17 @@ struct sa_bo {
 static uint64_t sa_bo_next = CORE_BO_ADDRESS;
 static uint32_t sa_fence_seqno;
 
+/* The last few submissions (fence and indirect buffers): what a stuck fence is diagnosed from. */
+#define SA_SUBMIT_HISTORY 8
+struct sa_submit {
+	uint32_t       fence;
+	uint32_t       n;
+	uint64_t       iova[16];
+	uint32_t       dwords[16];
+};
+static struct sa_submit sa_submit_hist[SA_SUBMIT_HISTORY];
+static uint32_t sa_submit_next;
+
 /* Page-table changes of context 0 out to memory, and the SMMU's cached translations dropped. */
 static bool
 sa_core_tlb_flush(void)
@@ -3034,6 +3046,15 @@ sweet_adreno_submit_v2(const uint64_t *iova, const uint32_t *dwords, uint32_t n,
 		sa_ring((uint32_t)(iova[i] >> 32));
 		sa_ring(dwords[i]);
 	}
+	struct sa_submit *h = &sa_submit_hist[sa_submit_next];
+
+	h->fence = seqno;
+	h->n = n;
+	for (uint32_t i = 0; i < n; i++) {
+		h->iova[i] = iova[i];
+		h->dwords[i] = dwords[i];
+	}
+	sa_submit_next = (sa_submit_next + 1) % SA_SUBMIT_HISTORY;
 	sa_ring_packet(CP_EVENT_WRITE, 4);
 	sa_ring(EVENT_CACHE_FLUSH_TS);
 	sa_ring(CORE_FENCE_ADDRESS);
@@ -3047,11 +3068,104 @@ sweet_adreno_submit_v2(const uint64_t *iova, const uint32_t *dwords, uint32_t n,
 	return seqno;
 }
 
+/*
+ * A fence that will not signal: after 2 s of failed waits, the core's state is dumped once per
+ * fence (IOLog, so it reaches the live log): how far the command processor has read the ring,
+ * whether the core is busy, its fault and interrupt state, the SMMU's fault registers, what the
+ * last submissions sent, and the words the SQE is stuck on - read through context 0's page
+ * tables, from the kernel's map of the same pages. A faulted core shows up as a fault register
+ * or an SMMU status; a bad opcode as CP_INTERRUPT_STATUS's CP_OPCODE_ERROR with the SQE stopped
+ * inside one of the submissions' buffers.
+ */
+static uint32_t sa_hang_fence = ~0u;
+static uint64_t sa_hang_first;
+static bool sa_hang_dumped;
+
+extern void IOLog(const char *, ...);
+
+/* The page of a GPU address of context 0 as the kernel maps it (NULL: unmapped, or a page the
+ * kernel cannot reach - the low bank is outside its physmap on this highmem kernel). */
+static uint32_t *
+sa_gpu_page(uint64_t va)
+{
+	extern unsigned long gPhysBase, gVirtBase;
+	uint64_t *pte = sa_space_pte(&sa_core_space, va & ~0xfffull);
+
+	if (pte == NULL) {
+		return NULL;
+	}
+	uint64_t pa = *pte & PTE_ADDRESS;
+	if (pa < (uint64_t)gPhysBase || pa - (uint64_t)gPhysBase >= 0x200000000ull) {
+		return NULL;
+	}
+	uintptr_t page = (uintptr_t)(pa - (uint64_t)gPhysBase) + (uintptr_t)gVirtBase;
+
+	flush_dcache64((addr64_t)page, 4096, FALSE);
+	return (uint32_t *)page;
+}
+
+static void
+sa_hang_dump(uint32_t fence)
+{
+	uint32_t fsr = sa_rd(sa_smmu_cb0.base + SMMU_CB_FSR);
+	uint64_t far = (uint64_t)sa_rd(sa_smmu_cb0.base + SMMU_CB_FAR + 4) << 32 |
+	    sa_rd(sa_smmu_cb0.base + SMMU_CB_FAR);
+	uint64_t pc = (uint64_t)sa_rd(sa_gpu.base + CP_SQE_INSTR_BASE) |
+	    (uint64_t)sa_rd(sa_gpu.base + CP_SQE_INSTR_BASE + 4) << 32;
+
+	IOLog("SWEET ADRENO: fence %u does not signal: the core read the ring to %u of %u, fence word %#x; "
+	    "RBBM status %#x / interrupts %#x; CP fault %#x, interrupts %#x, protection %#x, status 1 %#x, "
+	    "SQE instruction at %#llx; SMMU status %#x, address %#llx, syndrome %#x\n", fence,
+	    sa_rd(sa_gpu.base + CP_RB_RPTR), sa_ring_sent, sa_fence_read(), sa_rd(sa_gpu.base + RBBM_STATUS),
+	    sa_rd(sa_gpu.base + RBBM_INT_0_STATUS), sa_rd(sa_gpu.base + CP_HW_FAULT),
+	    sa_rd(sa_gpu.base + CP_INTERRUPT_STATUS), sa_rd(sa_gpu.base + CP_PROTECT_STATUS),
+	    sa_rd(sa_gpu.base + CP_STATUS_1), (unsigned long long)pc, fsr, (unsigned long long)far,
+	    sa_rd(sa_smmu_cb0.base + SMMU_CB_FSYNR0));
+	for (uint32_t s = 0; s < SA_SUBMIT_HISTORY; s++) {
+		uint32_t at = (sa_submit_next + s) % SA_SUBMIT_HISTORY;       /* oldest first */
+		struct sa_submit *h = &sa_submit_hist[at];
+
+		for (uint32_t i = 0; i < h->n; i++) {
+			uint64_t bytes = 4ull * h->dwords[i];
+			bool stuck = pc >= h->iova[i] && pc < h->iova[i] + bytes;
+
+			IOLog("SWEET ADRENO: submission (fence %u): IB %u at %#llx, %u dwords%s\n", h->fence, i,
+			    (unsigned long long)h->iova[i], h->dwords[i], stuck ? " <- the SQE is here" : "");
+			if (stuck && h->dwords[i] >= 8) {
+				uint32_t *p = sa_gpu_page(h->iova[i]);
+
+				if (p != NULL) {
+					IOLog("SWEET ADRENO: that IB's head: %#x %#x %#x %#x / %#x %#x %#x %#x\n",
+					    p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+				}
+			}
+		}
+	}
+	uint32_t *page = sa_gpu_page(pc);
+
+	if (page == NULL) {
+		IOLog("SWEET ADRENO: the SQE's page at %#llx is not mapped for the kernel\n",
+		    (unsigned long long)(pc & ~0xfffull));
+		return;
+	}
+	uint32_t dw = (uint32_t)((pc >> 2) & 0x3ff);
+	uint32_t from = dw > 3 ? dw - 3 : 0;
+
+	for (uint32_t i = from; i < dw + 4 && i < 1024; i += 4) {
+		IOLog("SWEET ADRENO: SQE words at %#llx: %#x %#x %#x %#x\n",
+		    (unsigned long long)((pc & ~3ull) + 4ull * (i - from)), page[i], page[i + 1],
+		    page[i + 2], page[i + 3]);
+	}
+}
+
 bool
 sweet_adreno_wait_fence_ns(uint32_t fence, uint64_t timeout_ns)
 {
 	uint64_t deadline;
 
+	if (timeout_ns > 120000000000ull) {
+		timeout_ns = 120000000000ull;     /* 120 s: an "infinite" client wait must fail, not hang */
+	}
 	nanoseconds_to_absolutetime(timeout_ns, &deadline);
 	deadline += mach_absolute_time();
 	do {
@@ -3060,7 +3174,24 @@ sweet_adreno_wait_fence_ns(uint32_t fence, uint64_t timeout_ns)
 		}
 		delay_for_interval(100, NSEC_PER_USEC);
 	} while (mach_absolute_time() < deadline);
-	return (int32_t)(sa_fence_read() - fence) >= 0;
+	if ((int32_t)(sa_fence_read() - fence) >= 0) {
+		return true;
+	}
+	uint64_t now = mach_absolute_time();
+	if (sa_hang_fence != fence) {
+		sa_hang_fence = fence;
+		sa_hang_first = now;
+		sa_hang_dumped = false;
+	} else if (!sa_hang_dumped) {
+		uint64_t two_seconds;
+
+		nanoseconds_to_absolutetime(2000000000ull, &two_seconds);
+		if (now - sa_hang_first > two_seconds) {
+			sa_hang_dumped = true;
+			sa_hang_dump(fence);
+		}
+	}
+	return false;
 }
 
 /* The always-on counter (a6xx.xml CP 0x0980/0x0981, as flame's a6_timestamp reads it). */
@@ -3090,6 +3221,17 @@ sweet_adreno_clean(vm_offset_t kva, uint64_t len)
 	sa_to_memory(kva, len);
 }
 
+/* Wait for everything submitted so far (the present path reads GPU-written surfaces). */
+void
+sweet_adreno_finish(void)
+{
+	uint32_t seqno = sa_fence_seqno;
+
+	if (seqno != 0) {
+		(void)sa_fence_wait(seqno, 500);
+	}
+}
+
 static bool (*const sa_step_fn[])(void) = {
 	NULL, sa_step_outside, sa_step_fuses, sa_step_gpucc, sa_step_cx_power, sa_step_clocks, sa_step_gmu_read,
 	sa_step_rscc, sa_step_smmu, sa_step_smmu_context, sa_step_gmu_memory, sa_step_trustzone, sa_step_zap_signature,
