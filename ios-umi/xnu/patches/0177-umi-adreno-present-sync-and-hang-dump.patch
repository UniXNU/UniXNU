 OSDefineMetaClassAndStructors(SweetAdrenoUserClient, IOUserClient);
@@ -545,6 +547,7 @@ SweetAdrenoUserClient::v2Method(uint32_t method, const void *in, uint32_t inSize
 			return kIOReturnNoMemory;
 		}
 		bzero((void *)kmap->getVirtualAddress(), rq->bytes);
+		sweet_adreno_clean((vm_offset_t)kmap->getVirtualAddress(), rq->bytes);
 		uint64_t h = 0;
 		IOReturn r = v2NewSlot(md, kmap, rq->bytes, false, &h);
 		if (r != kIOReturnSuccess) {
@@ -647,6 +650,10 @@ SweetAdrenoUserClient::v2Method(uint32_t method, const void *in, uint32_t inSize
 		}
 		rp->token = (uint32_t)rq->handle;       /* clientMemoryForType type */
 		rp->bytes = bo->bytes;
+		if (fLogged++ < 8) {
+			IOLog("SWEET ADRENO: v2 BoCpuMap handle %llu -> token %u\n", (unsigned long long)rq->handle,
+			    rp->token);
+		}
 		return kIOReturnSuccess;
 	}
 	case NativeAdrenoMethodBoCpuUnmap:
@@ -690,16 +697,27 @@ SweetAdrenoUserClient::v2Method(uint32_t method, const void *in, uint32_t inSize
 		bool busy = false;
 		uint32_t fence = sweet_adreno_submit_v2(iova, dw, rq->buffer_count, &busy);
 		if (fence == 0) {
+			IOLog("SWEET ADRENO: v2 submit refused (%s), %u IBs\n", busy ? "ring busy" : "not ready",
+			    rq->buffer_count);
 			return busy ? kIOReturnBusy : kIOReturnNotReady;
 		}
 		fLastFence = fence;
+		if (fSubmitLogged++ < 8) {
+			IOLog("SWEET ADRENO: v2 submit ok: fence %u, %u IBs (first %llu bytes at %#llx)\n", fence,
+			    rq->buffer_count, (unsigned long long)rq->buffers[0].bytes,
+			    (unsigned long long)rq->buffers[0].iova);
+		}
 		rp->fence = fence;
 		return kIOReturnSuccess;
 	}
 	case NativeAdrenoMethodWaitFence: {
 		V2_IN(NativeAdrenoAbiWaitFence);
-		return sweet_adreno_wait_fence_ns((uint32_t)rq->fence, rq->timeout_ns) ?
-		    kIOReturnSuccess : kIOReturnTimeout;
+		bool signalled = sweet_adreno_wait_fence_ns((uint32_t)rq->fence, rq->timeout_ns);
+		if (!signalled || fLogged++ < 8) {
+			IOLog("SWEET ADRENO: v2 wait fence %llu (%llu ns) %s\n", (unsigned long long)rq->fence,
+			    (unsigned long long)rq->timeout_ns, signalled ? "signalled" : "TIMED OUT");
+		}
+		return signalled ? kIOReturnSuccess : kIOReturnTimeout;
 	}
 	case NativeAdrenoMethodGetTimestamp: {
 		V2_OUT(NativeAdrenoAbiTimestamp);
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
