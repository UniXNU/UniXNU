diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 2d05375..c0bdbf1 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -103,6 +103,8 @@ class AppleCLCD : public IOMobileFramebuffer {
 	uint64_t            fVsyncCount;
 
 	static void vsyncFired(OSObject *owner, IOTimerEventSource *sender);
+	static IOReturn gpuHoldBeginAction(OSObject *target, void *arg0, void *arg1, void *arg2, void *arg3);
+	static IOReturn gpuHoldExtendAction(OSObject *target, void *arg0, void *arg1, void *arg2, void *arg3);
 
 public:
 	uint64_t      fPhys;
@@ -138,6 +140,7 @@ public:
 	uint64_t      fLastOff;       /* its panel window: byte offset in the surface */
 	SweetSurface *fPendHold[SWEET_FB_LAYERS], *fShowHold[SWEET_FB_LAYERS], *fRetireHold[SWEET_FB_LAYERS];
 	uint64_t      fGpuHoldUntil;  /* sweet_fb_gpu_begin(): no frames shown before then (mach time), boot framebuffer scanned */
+	int           fGpuHoldConsoleMuted;     /* sweet_console_muted before the hold; put back when it ends */
 	void          setupScanout();
 	void          scanFrom(uint64_t pa, uint32_t stride);
 	void          scanBoot();
@@ -148,6 +151,8 @@ public:
 	void removeClient(IOMobileFramebufferUserClient *client);
 	void swap(const uint8_t *rec);
 	void present(const uint8_t *rec);
+	bool gpuHoldBegin(uint64_t until);     /* sweet_fb_gpu_begin: hold + cache clean in the workloop's gate */
+	void gpuHoldExtend(uint64_t until);   /* sweet_fb_gpu_show */
 };
 
 /*
@@ -328,6 +333,21 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		client->notify(SWEET_FB_NOTIFY_VSYNC, values, 6);
 	}
 	if (fb->fPowerOff) {
+		if (fb->fGpuHoldUntil != 0) {
+			if (now < fb->fGpuHoldUntil) {
+				/* the GPU's picture is held: nothing copied over it, no fade while it is shown */
+				if (fb->fDirect) {
+					fb->scanBoot();
+				}
+				IOLockUnlock(fb->fLock);
+				sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+				return;
+			}
+			/* the hold ended with the display off: end it, then fade from what the GPU drew */
+			fb->fGpuHoldUntil = 0;
+			sweet_console_muted = fb->fGpuHoldConsoleMuted;
+			IOLog("SWEET FB: the GPU's picture has been shown (display off) [t %llu]\n", now);
+		}
 		if (fb->fDirect && fb->fScanPhys != fb->fBootSrc) {
 			/* the fade works on the boot framebuffer: bring the last direct frame over */
 			SweetSurface *last = fb->fLastSurf;
@@ -363,8 +383,9 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		fb->scanBoot();
 	} else if (fb->fGpuHoldUntil != 0 && !gpuHold) {
 		fb->fGpuHoldUntil = 0;
+		sweet_console_muted = fb->fGpuHoldConsoleMuted;
 		fb->fDirty = true;
-		IOLog("SWEET FB: the GPU's picture has been shown; frames again\n");
+		IOLog("SWEET FB: the GPU's picture has been shown; frames again [t %llu]\n", now);
 	}
 	/* direct frames cost one cache clean: every vsync; copied frames every fFlushTicks */
 	bool flush = !gpuHold && fb->fDirty && ((fb->fDirect && fb->fLastDirect) || (count % fb->fFlushTicks) == 0);
@@ -767,31 +788,92 @@ sweet_dcache_flush(uintptr_t va, uint64_t len)
 }
 
 /*
- * For the GPU bring-up (bsd/dev/sweet_adreno.c step 22): the boot framebuffer's place and
+ * For the GPU bring-up (bsd/dev/sweet_adreno.c steps 22-23): the boot framebuffer's place and
  * size, cleaned out of the CPU's caches (so no dirty line lands on what the GPU writes), and
  * from the next vsync on shown alone on the panel for hold_ms at most: no frames presented,
- * direct scanout pointed back at it. sweet_fb_gpu_show() sets how long it stays once drawn.
- * Afterwards the latest frame is shown again.
+ * direct scanout pointed back at it. The hold is set and the caches cleaned inside the
+ * framebuffer's workloop gate, so no present() copies into the framebuffer at the same time,
+ * and the kernel text console is muted for the hold (it draws into the same framebuffer; the
+ * old value is put back when the hold ends, in vsyncFired). The power-off fade is skipped
+ * while the hold lasts. sweet_fb_gpu_show() sets how long it stays once drawn. Afterwards the
+ * latest frame is shown again.
  */
+struct sweet_fb_gpu_hold {
+	uint64_t until;
+	bool ok;
+};
+
+IOReturn
+AppleCLCD::gpuHoldBeginAction(OSObject *target, void *arg0, __unused void *arg1,
+    __unused void *arg2, __unused void *arg3)
+{
+	AppleCLCD *fb = (AppleCLCD *)target;
+	struct sweet_fb_gpu_hold *h = (struct sweet_fb_gpu_hold *)arg0;
+
+	if (fb->fPowerOff) {
+		h->ok = false;
+		return kIOReturnSuccess;
+	}
+	IOLockLock(fb->fLock);
+	if (fb->fGpuHoldUntil == 0) {           /* a hold already running keeps its saved value */
+		fb->fGpuHoldConsoleMuted = sweet_console_muted;
+	}
+	fb->fGpuHoldUntil = h->until;
+	IOLockUnlock(fb->fLock);
+	sweet_console_muted = 1;
+	sweet_dcache_flush(fb->fPixels, (uint64_t)fb->fRowBytes * fb->fHeight);
+	h->ok = true;
+	return kIOReturnSuccess;
+}
+
+bool
+AppleCLCD::gpuHoldBegin(uint64_t until)
+{
+	struct sweet_fb_gpu_hold h = { until, false };
+
+	fWorkLoop->runAction(&AppleCLCD::gpuHoldBeginAction, this, &h);
+	return h.ok;
+}
+
+IOReturn
+AppleCLCD::gpuHoldExtendAction(OSObject *target, void *arg0, __unused void *arg1,
+    __unused void *arg2, __unused void *arg3)
+{
+	AppleCLCD *fb = (AppleCLCD *)target;
+	struct sweet_fb_gpu_hold *h = (struct sweet_fb_gpu_hold *)arg0;
+
+	IOLockLock(fb->fLock);
+	fb->fGpuHoldUntil = h->until;
+	IOLockUnlock(fb->fLock);
+	return kIOReturnSuccess;
+}
+
+void
+AppleCLCD::gpuHoldExtend(uint64_t until)
+{
+	struct sweet_fb_gpu_hold h = { until, true };
+
+	fWorkLoop->runAction(&AppleCLCD::gpuHoldExtendAction, this, &h);
+}
+
 extern "C" bool
 sweet_fb_gpu_begin(uint64_t *phys, uint32_t *width, uint32_t *height, uint32_t *row_bytes, uint32_t hold_ms)
 {
 	AppleCLCD *fb = sweet_fb_main;
 	uint64_t hold;
 
-	if (fb == NULL || fb->fPowerOff) {
+	if (fb == NULL) {
 		return false;
 	}
 	*phys = fb->fPhys;
 	*width = fb->fWidth;
 	*height = fb->fHeight;
 	*row_bytes = fb->fRowBytes;
-	sweet_dcache_flush(fb->fPixels, (uint64_t)fb->fRowBytes * fb->fHeight);
 	nanoseconds_to_absolutetime((uint64_t)hold_ms * NSEC_PER_MSEC, &hold);
-	IOLockLock(fb->fLock);
-	fb->fGpuHoldUntil = mach_absolute_time() + hold;
-	IOLockUnlock(fb->fLock);
-	return true;
+	bool ok = fb->gpuHoldBegin(mach_absolute_time() + hold);
+	IOLog("SWEET FB: GPU hold %u ms: framebuffer cleaned, console muted%s [t %llu]\n", hold_ms,
+	    ok ? "" : " (display off: not held)", mach_absolute_time());
+	return ok;
 }
 
 /* The GPU's picture is in place: shown alone for hold_ms more. */
@@ -805,9 +887,8 @@ sweet_fb_gpu_show(uint32_t hold_ms)
 		return;
 	}
 	nanoseconds_to_absolutetime((uint64_t)hold_ms * NSEC_PER_MSEC, &hold);
-	IOLockLock(fb->fLock);
-	fb->fGpuHoldUntil = mach_absolute_time() + hold;
-	IOLockUnlock(fb->fLock);
+	fb->gpuHoldExtend(mach_absolute_time() + hold);
+	IOLog("SWEET FB: GPU hold extended %u ms [t %llu]\n", hold_ms, mach_absolute_time());
 }
 
 /* A pixel of the boot framebuffer as memory holds it (after the GPU wrote it). */
@@ -1119,7 +1200,7 @@ IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMetho
 				fFB->fDirty = true;     /* on: redraw the latest frame */
 			}
 			IOLockUnlock(fFB->fLock);
-			IOLog("SWEET FB: display %s\n", off ? "off" : "on");
+			IOLog("SWEET FB: display %s [t %llu]\n", off ? "off" : "on", mach_absolute_time());
 		}
 		break;
 	case kSweetFBSwapWait:
