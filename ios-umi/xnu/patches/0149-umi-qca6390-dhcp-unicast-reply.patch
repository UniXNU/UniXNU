From 467c0ec47d02524acffc2e7602bf9ab109fae9bb Mon Sep 17 00:00:00 2001
From: port <p@p>
Date: Sun, 25 Oct 2026 11:06:35 +0100
Subject: [PATCH] umi-0149

---
 bsd/dev/sweet_wlip.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/bsd/dev/sweet_wlip.c b/bsd/dev/sweet_wlip.c
index 7e5d709..9bbe96d 100644
--- a/bsd/dev/sweet_wlip.c
+++ b/bsd/dev/sweet_wlip.c
@@ -80,7 +80,11 @@ ip_hdr(uint8_t *f, const uint8_t *dst_mac, uint8_t proto, uint32_t src, uint32_t
 static const uint8_t bcast[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
 static const uint8_t *dhcp_dst = bcast;    /* Ethernet destination of DHCP requests (0144: once the AP's MAC) */
 
-/* BOOTP/DHCP from 0.0.0.0:68 to 255.255.255.255:67, broadcast flag set (we cannot take unicast yet). */
+/*
+ * BOOTP/DHCP from 0.0.0.0:68 to 255.255.255.255:67. 0149: broadcast flag clear, so the server
+ * unicasts OFFER/ACK to chaddr (RFC 2131 4.1). 0146-0148 showed that the AP's broadcast frames
+ * (the OFFERs among them) are decoded by the radio but never reach REO, while unicast does.
+ */
 static int
 dhcp_send(uint8_t type)
 {
@@ -95,7 +99,7 @@ dhcp_send(uint8_t type)
 	b[1] = 1;
 	b[2] = 6;
 	memcpy(b + 4, &ip.xid, 4);
-	put16(b + 10, 0x8000);                          /* broadcast reply */
+	put16(b + 10, 0);                               /* unicast reply (0141-0148: 0x8000, broadcast) */
 	memcpy(b + 28, ip.mac, 6);
 	uint8_t *opt = b + 236;
 	opt[0] = 99; opt[1] = 130; opt[2] = 83; opt[3] = 99;
