From 9029e0f8dc0f0cc5632603cc9c10f6e7a1948e50 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Fri, 6 Nov 2026 19:24:28 +0100
Subject: [PATCH] umi: GPU memory caps - 768 MB per app, 1536 MB all apps, 1 GB
 of RAM kept unwired; backboardd and SpringBoard uncapped (0251)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 iokit/Kernel/arm/SweetAdreno.cpp | 72 ++++++++++++++++++++++++++++++--
 1 file changed, 69 insertions(+), 3 deletions(-)

diff --git a/iokit/Kernel/arm/SweetAdreno.cpp b/iokit/Kernel/arm/SweetAdreno.cpp
index 73553f6..e48dd28 100644
--- a/iokit/Kernel/arm/SweetAdreno.cpp
+++ b/iokit/Kernel/arm/SweetAdreno.cpp
@@ -240,6 +240,7 @@ static struct sa_client_stat {
 	uint32_t alloc_n, import_n;
 } sa_clients[SA_CLIENTS];
 static uint32_t sa_alloc_failures;
+static uint32_t sa_cap_refusals;     /* (0251) */
 extern "C" unsigned int vm_page_wire_count, vm_page_free_count;
 
 static void
@@ -261,9 +262,11 @@ sa_memory_report(const char *why)
 			    c->peak_bytes >> 20);
 		}
 	}
-	IOLog("%s total %llu MB; wired %u MB, free %u MB, %u failed allocs\n", line, total >> 20,
-	    (unsigned)(((uint64_t)vm_page_wire_count * PAGE_SIZE) >> 20),
-	    (unsigned)(((uint64_t)vm_page_free_count * PAGE_SIZE) >> 20), sa_alloc_failures);
+	/* (0251) totals on a line of their own: with ten clients the per-client line is cut off in the log */
+	IOLog("SWEET ADRENO: GPU memory (%s) total %llu MB; wired %u MB, free %u MB, %u failed allocs, %u refused by caps\n",
+	    why, total >> 20, (unsigned)(((uint64_t)vm_page_wire_count * PAGE_SIZE) >> 20),
+	    (unsigned)(((uint64_t)vm_page_free_count * PAGE_SIZE) >> 20), sa_alloc_failures, sa_cap_refusals);
+	IOLog("%s\n", line);
 }
 
 static void
@@ -285,6 +288,55 @@ sa_stat_add(int slot, bool imported, int64_t bytes)
 	}
 }
 
+/*
+ * (0251) GPU memory caps. Every BO is wired (prepare() in BoAlloc), so GPU memory is RAM nothing can page out or
+ * jetsam can see: with Metal for every process, one app (a big page in WebKit.GPU, a game) could take the RAM the
+ * compositor needs - the 2026-11-05 freeze was backboardd's own BoAlloc refused. backboardd and SpringBoard draw the
+ * screen and are never capped; every other client is refused a BoAlloc that would take it past its own cap, take all
+ * capped clients together past theirs, or leave less than the reserve of RAM unwired. The app gets
+ * VK_ERROR_OUT_OF_DEVICE_MEMORY (a nil Metal buffer/texture) instead of the phone freezing. Imports are not capped:
+ * they are the process's own pages (IOSurfaces) already counted by the VM. Boot-args sweetgpucap / sweetgpuapps /
+ * sweetgpureserve in MB, 0 = no such limit.
+ */
+static uint32_t sa_cap_client_mb = 768, sa_cap_apps_mb = 1536, sa_cap_reserve_mb = 1024;
+
+static bool
+sa_client_exempt(const struct sa_client_stat *c)
+{
+	return strcmp(c->name, "backboardd") == 0 || strcmp(c->name, "SpringBoard") == 0;
+}
+
+/* NULL if slot may wire `bytes` more, else which limit it would cross */
+static const char *
+sa_cap_check(int slot, uint64_t bytes)
+{
+	if (slot < 0 || sa_client_exempt(&sa_clients[slot])) {
+		return NULL;
+	}
+	const struct sa_client_stat *me = &sa_clients[slot];
+	if (sa_cap_client_mb && me->alloc_bytes + bytes > ((uint64_t)sa_cap_client_mb << 20)) {
+		return "per-app cap";
+	}
+	if (sa_cap_apps_mb) {
+		uint64_t apps = 0;
+		for (int i = 0; i < SA_CLIENTS; i++) {
+			if (sa_clients[i].used && !sa_client_exempt(&sa_clients[i])) {
+				apps += sa_clients[i].alloc_bytes;
+			}
+		}
+		if (apps + bytes > ((uint64_t)sa_cap_apps_mb << 20)) {
+			return "all-apps cap";
+		}
+	}
+	if (sa_cap_reserve_mb) {
+		uint64_t wired = (uint64_t)vm_page_wire_count * PAGE_SIZE;
+		if (wired + bytes + ((uint64_t)sa_cap_reserve_mb << 20) > max_mem) {
+			return "RAM reserve";
+		}
+	}
+	return NULL;
+}
+
 OSDefineMetaClassAndStructors(SweetAdrenoUserClient, IOUserClient);
 
 /* v2 open types: Turnip's darwin backend opens with 0x4147 ('AG'), tests may use 2 */
@@ -707,6 +759,15 @@ SweetAdrenoUserClient::v2Method(uint32_t method, const void *in, uint32_t inSize
 		    rq->align_log2 < 12 || rq->align_log2 > 24 || rq->contiguous > 1) {
 			return kIOReturnBadArgument;
 		}
+		if (const char *why = sa_cap_check(fStat, rq->bytes)) {      /* (0251) */
+			uint32_t nref = OSIncrementAtomic((volatile SInt32 *)&sa_cap_refusals);
+			if (nref < 4 || nref % 100 == 0) {
+				IOLog("SWEET ADRENO: v2 BoAlloc of %llu bytes refused for %s[%d]: %s (refusal %u)\n", rq->bytes,
+				    sa_clients[fStat].name, sa_clients[fStat].pid, why, nref + 1);
+				sa_memory_report("cap");
+			}
+			return kIOReturnNoMemory;
+		}
 		/* Pageable with the write-combined cache mode: the buffer gets a VM object of its own
 		 * whose every mapping - this kernel view and Turnip's (clientMemoryForType, WC) - has
 		 * the same attributes (ios-flame 0115). A wired kernel buffer (kIOMemoryKernelUserShared)
@@ -1074,6 +1135,11 @@ sweet_adreno_publish(IOService *provider)
 		return;
 	}
 	service->setName("SweetAdreno");
+	(void)PE_parse_boot_argn("sweetgpucap", &sa_cap_client_mb, sizeof(sa_cap_client_mb));      /* (0251) */
+	(void)PE_parse_boot_argn("sweetgpuapps", &sa_cap_apps_mb, sizeof(sa_cap_apps_mb));
+	(void)PE_parse_boot_argn("sweetgpureserve", &sa_cap_reserve_mb, sizeof(sa_cap_reserve_mb));
+	IOLog("SWEET ADRENO: GPU memory caps: %u MB per app, %u MB all apps, %u MB of %llu MB RAM kept unwired "
+	    "(backboardd, SpringBoard uncapped)\n", sa_cap_client_mb, sa_cap_apps_mb, sa_cap_reserve_mb, max_mem >> 20);
 	/* The user client class must be a property before anything opens the service:
 	 * nothing matches it, so start() never runs, and the open path (newUserClient)
 	 * reads this property to build the connection (as the other SWEET stand-ins do). */
-- 
