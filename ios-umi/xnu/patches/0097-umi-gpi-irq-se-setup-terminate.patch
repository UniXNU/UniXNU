+/*
+ * Acknowledge the GPII's interrupt status as gpi_handle_irq does (the line itself stays
+ * unhandled: we poll). Global and GPII errors are logged with the error log, then cleared.
+ */
+static void
+gpi_ack(void)
+{
+	uint32_t type = gpi_rd(TYPE_IRQ(g.gpii));
+	if (type == 0) {
+		return;
+	}
+	uint32_t ch = gpi_rd(SRC_CH_IRQ(g.gpii)), ev = gpi_rd(SRC_EV_IRQ(g.gpii));
+	uint32_t ieob = gpi_rd(SRC_IEOB_IRQ(g.gpii)), glob = gpi_rd(GLOB_IRQ_STTS(g.gpii));
+	uint32_t gpii = gpi_rd(GPII_IRQ_STTS(g.gpii));
+	if ((glob | gpii) != 0 && g.irqlog++ < 16) {
+		printf("SWEET GPI: irq type %#x ch %#x ev %#x ieob %#x GLOB %#x GPII %#x error log %#x\n",
+		    type, ch, ev, ieob, glob, gpii, gpi_rd(ERROR_LOG(g.gpii)));
+	}
+	if (ch) {
+		gpi_wr(SRC_CH_IRQ_CLR(g.gpii), ch);
+	}
+	if (ev) {
+		gpi_wr(SRC_EV_IRQ_CLR(g.gpii), ev);
+	}
+	if (ieob) {
+		gpi_wr(SRC_IEOB_IRQ_CLR(g.gpii), ieob);
+	}
+	if (glob) {
+		gpi_wr(ERROR_LOG(g.gpii), 0);
+		gpi_wr(GLOB_IRQ_CLR(g.gpii), glob);
+	}
+	if (gpii) {
+		gpi_wr(GPII_IRQ_CLR(g.gpii), gpii);
+	}
+}
