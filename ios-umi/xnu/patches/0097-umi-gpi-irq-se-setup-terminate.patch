+/* gpi_alloc_chan(chan, false): the channel context, its doorbell MSB, scratch and QoS */
+static void
+ch_program(unsigned k)
+{
+	uint32_t c = CH_CNTXT(g.gpii, k), ring = DMA_PA + (k ? OFF_RX : OFF_TX);
+	gpi_wr(c + CNTXT_CONFIG, (TRE_SIZE << 24) | (0u << 14) | ((k ? 0u : 1u) << 3) | 2u);
+	gpi_wr(c + CNTXT_LEN, CH_RING_N * TRE_SIZE);
+	gpi_wr(c + CNTXT_BASE_LSB, ring);
+	gpi_wr(c + CNTXT_BASE_MSB, 0);
+	gpi_wr(CH_DB(g.gpii, k) + 4, 0);
+	gpi_wr(CH_SCRATCH(g.gpii, k, 0), ((k ? 0u : 1u) << 16) | (3u << 4) | g.seid);  /* pair, I2C, SE */
+	gpi_wr(CH_SCRATCH(g.gpii, k, 1), 0);
+	gpi_wr(CH_SCRATCH(g.gpii, k, 2), 0);
+	gpi_wr(CH_SCRATCH(g.gpii, k, 3), 0);
+	gpi_wr(CH_QOS(g.gpii, k), 1);
+}
