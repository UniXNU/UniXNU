+/*
+ * After an error: gpi_terminate_all (STOP both channels, RESET them, reprogram their
+ * contexts, START them) with the serial engine's primary command aborted in between
+ * (geni_abort_m_cmd), so neither the GPII nor the SE is left mid-transfer: a failed
+ * transfer left that way reset the phone 16 s later (0096 test stage 4).
+ */
+static void
+gpi_terminate(void)
+{
+	se_dump("error");
+	for (unsigned k = 0; k < 2; k++) {
+		if (ch_state(k) == CH_STATE_STARTED) {
+			(void)ch_cmd(k, CMD_STOP, CH_STATE_STOPPED);
+		}
+	}
+	if (se_rd(SE_STATUS) & 1u) {            /* M_GENI_CMD_ACTIVE */
+		se_wr(SE_M_CMD_CTRL, M_GENI_CMD_ABORT);
+		unsigned i = 0;
+		while (!(se_rd(SE_M_IRQ_STATUS) & M_CMD_ABORT_EN) && i++ < 1000) {
+			delay(10);
+		}
+		se_wr(SE_M_IRQ_CLEAR, 0xffffffffu);
+		printf("SWEET GPI: SE command aborted (%s), status %#x\n", i < 1000 ? "done" : "no ABORT_DONE",
+		    se_rd(SE_STATUS));
+	}
+	for (unsigned k = 0; k < 2; k++) {
+		(void)ch_cmd(k, CMD_RESET, CH_STATE_ALLOCATED);
+		ch_program(k);
+	}
+	for (unsigned k = 0; k < 2; k++) {
+		(void)ch_cmd(k, CMD_START, CH_STATE_STARTED);
+	}
+	gpi_ack();
+	g.tx_wp = g.rx_wp = 0;
+	g.cfg_sent = false;
+	printf("SWEET GPI: terminated: ch0 %#x ch1 %#x\n", gpi_rd(CH_CNTXT(g.gpii, 0)), gpi_rd(CH_CNTXT(g.gpii, 1)));
+}
