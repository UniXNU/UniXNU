+static uint32_t
+se_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(g.se + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+se_wr(uint32_t off, uint32_t val)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(g.se + off) = val;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
