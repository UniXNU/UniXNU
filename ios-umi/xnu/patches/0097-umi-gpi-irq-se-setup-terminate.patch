 		g.ready = false;
 	} else if (err != 0) {
-		/*
-		 * Stop, reset and restart both channels so the rings start empty again
-		 * (gpi_terminate_all); the next message re-sends CONFIG0.
-		 */
-		for (unsigned k = 0; k < 2; k++) {
-			if (ch_state(k) == CH_STATE_STARTED) {
-				(void)ch_cmd(k, CMD_STOP, CH_STATE_STOPPED);   /* may stay STOP_IN_PROC (4) */
-			}
-			(void)ch_cmd(k, CMD_RESET, CH_STATE_ALLOCATED);
-		}
-		for (unsigned k = 0; k < 2; k++) {
-			uint32_t c = CH_CNTXT(g.gpii, k);
-			gpi_wr(c + CNTXT_BASE_LSB, DMA_PA + (k ? OFF_RX : OFF_TX));
-			(void)ch_cmd(k, CMD_START, CH_STATE_STARTED);
-		}
