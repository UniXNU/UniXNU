+	    why, se_rd(SE_STATUS), se_rd(SE_M_IRQ_STATUS), se_rd(SE_CLK_SEL), se_rd(SE_M_CLK_CFG),
+	    se_rd(SE_I2C_SCL_COUNTERS), se_rd(SE_OUTPUT_CTRL), se_rd(SE_FORCE_DEFAULT), se_rd(SE_CGC_CTRL),
+	    se_rd(0x258), se_rd(0xe18));
+}
