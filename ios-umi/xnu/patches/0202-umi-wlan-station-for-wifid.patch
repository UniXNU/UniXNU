+	f[n++] = 3;
+	f[n++] = 0;
+	if (wmi_mgmt_tx(f, n, 3) == 0) {
+		(void)wlce_wait(&htc.tx_done, 500);
+	}
+	bzero(b, sizeof(b));
+	b[0] = WMI_TLV(0x5e, 4);
+	(void)wmi_cmd(0x5007u, b, 8, "VDEV_DOWN");
+	bzero(b, sizeof(b));
+	b[0] = WMI_TLV(0x62, 3 * 4);
+	memcpy(&b[2], htc.join_bssid, 6);
