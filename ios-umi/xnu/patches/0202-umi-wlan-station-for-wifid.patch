+/*
+ * umi Wi-Fi for iOS (0202): the station side of sys/redwood_sta.h and the link under en0
+ * (sys/redwood_net.h) on the QCA6390 radio in this kernel (sweet_wlce.c / sweet_wldp.c), as
+ * ios-flame's flame_sta.c does on its userland radio. Once bring-up has scanned (stage 8),
+ * sweet_wlce_htc calls sweet_wlsta_start instead of the kernel's own join + DHCP + en0
+ * (sweet_wlip.c / sweet_wlif.c, still there with boot-arg sweetwifid=0): en0 is made with the
+ * link down, the station is attached, and wifid scans and joins through Apple80211
+ * (bsd/dev/redwood_apple80211.c); configd's DHCP runs on en0 once the link is up.
+ * The boot line's network (sweetwlanssid=NAME, '_' = space) is a standing join request, so the
+ * phone is online without anybody tapping Settings, as with flame's wlan.conf.
+ *
+ * Open networks only (the data path sends with encrypt type OPEN): a WPA join is refused.
+ * 2.4 GHz channels 1-13 only (sweet_wlce.c's channel list).
+ *
+ * Locking: every call into sweet_wlce.c holds its lock (sweet_wlce_lock); the waits inside let
+ * go of it while they sleep, so the net thread's poll and transmit go on during a scan or a join.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include <sys/redwood_net.h>
+#include <sys/redwood_sta.h>
+
+extern void sweet_wlce_lock(bool on);
+extern unsigned sweet_wlce_poll(void);
+extern int sweet_wlce_scan(void);
+extern int sweet_wlce_join(const uint8_t *ssid, unsigned len, const uint8_t *bssid);
+extern int sweet_wlce_leave(void);
+extern bool sweet_wlce_joined(const uint8_t **bssid);
+extern uint32_t sweet_wlce_lost(void);
+extern bool sweet_wlce_heard(unsigned index, uint8_t bssid[6], uint8_t ssid[32], uint8_t *ssid_len, uint16_t *mhz,
+    int16_t *rssi, uint16_t *beacon_interval, uint16_t *capability, uint32_t *age_ms, uint8_t *ies, uint16_t *ies_len);
+extern void sweet_wlce_address(uint8_t mac[6]);
+extern int sweet_wldp_tx(const void *frame, uint32_t len);
+extern void sweet_wldp_set_rx_handler(void (*fn)(const uint8_t *frame, uint32_t len));
+bool sweet_wlsta_wanted(void);
+int sweet_wlsta_start(void);
+
+#define STA_RESCAN_MS   20000u          /* while joined: a real scan at most this often, else the last list */
+
+static struct redwood_sta_bss sta_joined;       /* the network joined (state() reads it on any thread) */
+static int sta_last_error;
+static uint64_t sta_last_scan_ms;
+static unsigned sta_rx_count;
+
+static uint64_t
+sta_now_ms(void)
+{
+	uint64_t t, ns;
+	clock_get_uptime(&t);
+	absolutetime_to_nanoseconds(t, &ns);
+	return ns / 1000000ull;
+}
+
+/* the index-th entry of the radio's table, as the station boundary has it (lock held) */
+static bool
+sta_entry(unsigned index, struct redwood_sta_bss *b)
+{
+	uint16_t ies_len = 0;
+	bzero(b, sizeof(*b));
+	if (!sweet_wlce_heard(index, b->bssid, b->ssid, &b->ssid_length, &b->frequency, &b->rssi, &b->beacon_interval,
+	    &b->capability, &b->age_ms, b->elements, &ies_len)) {
+		return false;
+	}
+	b->elements_length = ies_len;
+	return true;
+}
+
+static int
+sta_power(bool on)
+{
+	if (!on) {                      /* Settings' switch off: leave; the radio itself stays up */
+		sweet_wlce_lock(true);
+		(void)sweet_wlce_leave();
+		sweet_wlce_lock(false);
+		redwood_net_link_state(false);
+	}
+	return 0;
+}
+
+static int
+sta_scan(__unused const struct redwood_sta_scan *what)
+{
+	int r = 0;
+	sweet_wlce_lock(true);
+	if (!sweet_wlce_joined(NULL) || sta_now_ms() - sta_last_scan_ms >= STA_RESCAN_MS) {
+		r = sweet_wlce_scan();
+		sta_last_scan_ms = sta_now_ms();
+	}
+	sweet_wlce_lock(false);
+	return r;
+}
+
+static void
+sta_heard(void (*each)(const struct redwood_sta_bss *bss, void *context), void *context)
+{
+	static struct redwood_sta_bss b;        /* (the station thread only) */
+	for (unsigned i = 0;; i++) {
+		sweet_wlce_lock(true);
+		bool there = sta_entry(i, &b);
+		sweet_wlce_lock(false);
+		if (!there) {
+			break;
+		}
+		if (b.age_ms <= 60000 && b.ssid_length != 0) {  /* heard in the last minute; hidden ones are not listed */
+			each(&b, context);
+		}
+	}
+}
+
+/* the record of the network just joined, from the radio's table (lock held) */
+static void
+sta_note_joined(void)
+{
+	static struct redwood_sta_bss b;
+	const uint8_t *bssid;
+	bzero(&sta_joined, sizeof(sta_joined));
+	if (!sweet_wlce_joined(&bssid)) {
+		return;
+	}
+	for (unsigned i = 0; sta_entry(i, &b); i++) {
+		if (memcmp(b.bssid, bssid, 6) == 0) {
+			sta_joined = b;
+			return;
+		}
+	}
+	memcpy(sta_joined.bssid, bssid, 6);
+}
+
+static int
