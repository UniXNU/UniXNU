+/*
+ * 0202: once the station runs (sweet_wlsta.c), the net thread, the station thread and transmit
+ * share the copy engines and rings: all of them hold wlce_lock, and the waits below let go of it
+ * while they sleep, so frames keep moving during a scan or a join. Before that (bring-up) there
+ * is one thread and no lock.
+ */
+static LCK_GRP_DECLARE(wlce_lck_grp, "sweet-wlce");
+static LCK_MTX_DECLARE(wlce_lock, &wlce_lck_grp);
+static bool wlce_shared;
+
+static void
+wlce_tick(void)
+{
+	htc_poll();
+	if (wlce_shared) {
+		lck_mtx_unlock(&wlce_lock);
+		delay(1000);
+		lck_mtx_lock(&wlce_lock);
+	} else {
+		delay(1000);
+	}
+}
