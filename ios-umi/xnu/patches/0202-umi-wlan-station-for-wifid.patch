+			(void)sweet_wlce_leave();
+		}
+	}
+	switch (r) {
+	case 0:
+		return 0;
+	case 1:
+		return ENOENT;
+	case 6:
+		return htc.auth_rx ? ECONNREFUSED : ETIMEDOUT;
+	case 8:
+		return htc.assoc_rx ? ECONNREFUSED : ETIMEDOUT;
