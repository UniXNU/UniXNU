 #define SCAN_NCHAN      13
 
+/*
+ * START_SCAN of 2412-2472 MHz on vdev 0 and the wait for its end (0202: also the station's scan,
+ * while joined too: the firmware visits the other channels between beacons of the AP's).
+ * 0, 12 not sent, 13 not started; whether it completed is htc.scan_done.
+ */
+static int
+wmi_start_scan(unsigned active)
+{
+	static uint32_t b[64 + 7 * SCAN_NCHAN];
+	/* Probe request IEs (mac80211 adds these; the firmware adds the SSID): supported + extended rates */
+	static const uint8_t ies[] = { 1, 8, 0x82, 0x84, 0x8b, 0x96, 0x0c, 0x12, 0x18, 0x24, 50, 4, 0x30, 0x48, 0x60, 0x6c };
+	/*
+	 * ath11k_wmi_start_scan_init + hw_scan; 40-word fixed part. Active: one
+	 * wildcard SSID (as mac80211 asks), the rate IEs; passive: no SSIDs.
+	 */
+	bzero(b, sizeof(b));
+	b[0] = WMI_TLV(0x4d, 39 * 4);
+	b[1] = 0xa000;                  /* scan_id (ATH11K_SCAN_ID) */
+	b[2] = ++htc.scan_req;          /* scan_req_id */
+	b[3] = 0;                       /* vdev_id */
+	b[4] = 1;                       /* priority low */
+	b[5] = 0x1f | 0x40;             /* started, completed, bss chan, foreign chan, dequeued, start failed */
+	b[6] = 50;                      /* dwell active */
+	b[7] = 150;                     /* dwell passive */
+	b[8] = 50;                      /* min rest */
+	b[9] = 500;                     /* max rest */
+	b[13] = 20000;                  /* max scan time */
+	b[14] = 5;                      /* probe delay */
+	b[15] = (active ? 0 : 0x1) | 0x10;      /* PASSIVE, CHAN_STAT_EVENT */
+	b[17] = SCAN_NCHAN;
+	b[18] = 1;                      /* num_bssid */
+	b[19] = active ? 1 : 0;         /* num_ssids */
+	b[20] = active ? sizeof(ies) : 0;       /* ie_len */
+	b[37] = 40;                     /* dwell active 6G */
+	b[38] = 30;                     /* dwell passive 6G */
+	uint32_t *p = b + 40;
+	*p++ = WMI_TLV(0x10, SCAN_NCHAN * 4);
+	for (unsigned i = 0; i < SCAN_NCHAN; ++i) {
+		*p++ = 2412 + 5 * i;
+	}
+	if (active) {
+		*p++ = WMI_TLV(0x13, 36);       /* wmi_ssid: u32 length 0 (wildcard), 32 bytes */
+		bzero(p, 36);
+		p += 9;
+	} else {
+		*p++ = WMI_TLV(0x13, 0);
+	}
+	*p++ = WMI_TLV(0x13, 8);        /* one BSSID: broadcast */
+	*p++ = 0xffffffffu;
+	*p++ = 0x0000ffffu;
+	if (active) {
+		*p++ = WMI_TLV(0x11, (sizeof(ies) + 3) & ~3u);
+		bzero(p, (sizeof(ies) + 3) & ~3u);
+		memcpy(p, ies, sizeof(ies));
+		p += (sizeof(ies) + 3) / 4;
+	} else {
+		*p++ = WMI_TLV(0x11, 0);
+	}
+	printf("SWEET WMI: %s scan of 2412-2472 MHz from %02x:%02x:%02x:%02x:%02x:%02x\n", active ? "active" : "passive",
+	    wlce_mac[0], wlce_mac[1], wlce_mac[2], wlce_mac[3], wlce_mac[4], wlce_mac[5]);
+	htc.scan_started = htc.scan_done = false;
+	htc.scan_fail = 0;
+	if (wmi_cmd(0x3001u, b, (uint32_t)((uint8_t *)p - (uint8_t *)b), "START_SCAN") != 0) {
+		return 12;
+	}
+	for (unsigned t = 0; t < 3000 && !htc.scan_started && !htc.scan_fail; ++t) {
+		wlce_tick();
+	}
+	if (!htc.scan_started) {
+		printf("SWEET WMI: scan not started (start failed %u)\n", htc.scan_fail);
+		return 13;
+	}
+	for (unsigned t = 0; t < 15000 && !htc.scan_done; ++t) {
+		wlce_tick();
+	}
+	return 0;
+}
