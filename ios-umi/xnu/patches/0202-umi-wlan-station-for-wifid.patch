+{
+	static const uint8_t zero[6];
+	int r;
+	if (what->security != REDWOOD_STA_OPEN) {
+		printf("SWEET WLSTA: join refused: only open networks (the radio sends unencrypted)\n");
+		sta_last_error = EAUTH;
+		return EAUTH;
+	}
+	redwood_net_link_state(false);
+	sweet_wlce_lock(true);
+	r = sweet_wlce_join(what->ssid, what->ssid_length, memcmp(what->bssid, zero, 6) != 0 ? what->bssid : NULL);
+	if (r == ENOENT) {                      /* not in the table (yet): one scan, then again */
+		(void)sweet_wlce_scan();
+		sta_last_scan_ms = sta_now_ms();
+		r = sweet_wlce_join(what->ssid, what->ssid_length, memcmp(what->bssid, zero, 6) != 0 ? what->bssid : NULL);
+	}
+	if (r == 0) {
+		sta_note_joined();
+	}
+	sweet_wlce_lock(false);
+	sta_last_error = r;
+	printf("SWEET WLSTA: join (a name of %u bytes) -> %d\n", what->ssid_length, r);
+	if (r == 0) {
+		redwood_net_link_state(true);
+	}
+	return r;
+}
+
+static int
+sta_leave(void)
+{
+	sweet_wlce_lock(true);
+	(void)sweet_wlce_leave();
+	sweet_wlce_lock(false);
+	sta_last_error = 0;
+	redwood_net_link_state(false);
+	return 0;
+}
+
+static void
+sta_state(struct redwood_sta_state *state)
+{
+	bzero(state, sizeof(*state));
+	state->phase = sweet_wlce_joined(NULL) ? REDWOOD_STA_JOINED : REDWOOD_STA_IDLE;
+	if (state->phase == REDWOOD_STA_JOINED) {
+		state->bss = sta_joined;
+	}
+	state->last_error = sta_last_error;
+}
+
+static unsigned
+sta_channels(struct redwood_sta_channel *channels, unsigned most)
+{
+	unsigned n;
+	for (n = 0; n < most && n < 13; n++) {
+		channels[n].frequency = (uint16_t)(2412 + 5 * n);
+		channels[n].flags = 0;
+	}
+	return n;
+}
+
+static struct redwood_sta_ops sta_ops = {
+	.power = sta_power,
+	.scan = sta_scan,
+	.heard = sta_heard,
+	.join = sta_join,
+	.leave = sta_leave,
+	.state = sta_state,
+	.channels = sta_channels,
+};
+
+/* ---- the link under en0 ---- */
+
+static bool
+sta_transmit(mbuf_t packet, size_t length)
+{
+	static uint8_t frame[REDWOOD_NET_FRAME_MAX];   /* (one sender at a time: redwood_net's transmit lock) */
+	int r;
+	if (length > sizeof(frame) || mbuf_copydata(packet, 0, length, frame) != 0) {
+		return false;
+	}
+	sweet_wlce_lock(true);
+	r = sweet_wlce_joined(NULL) ? sweet_wldp_tx(frame, (uint32_t)length) : ENETDOWN;
+	sweet_wlce_lock(false);
+	return r == 0;
+}
+
+/* from the poll (lock held): one received Ethernet frame */
+static void
+sta_rx(const uint8_t *frame, uint32_t length)
+{
+	sta_rx_count++;
+	redwood_net_input(frame, length);
+}
+
+static unsigned
+sta_poll(void)
+{
+	unsigned before = sta_rx_count;
+	uint32_t lost;
+	sweet_wlce_lock(true);
+	(void)sweet_wlce_poll();
+	lost = sweet_wlce_lost();
+	if (lost != 0) {
+		(void)sweet_wlce_leave();       /* take peer and vdev down: the next join starts clean */
+	}
+	sweet_wlce_lock(false);
+	if (lost != 0) {
+		printf("SWEET WLSTA: the link is lost (%#x)\n", lost);
+		sta_last_error = ECONNRESET;
+		redwood_net_link_state(false);
+		redwood_sta_lost(ECONNRESET);
+	}
+	return sta_rx_count - before;
+}
+
+static struct redwood_net_link sta_link = {
+	.name = "qca6390",
+	.wireless = true,
+	.up = false,
+	.transmit = sta_transmit,
+	.poll = sta_poll,
+};
+
+/* boot-arg sweetwifid=0: the kernel's own join, DHCP and en0 (0140-0154) instead */
+bool
+sweet_wlsta_wanted(void)
+{
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("sweetwifid", &on, sizeof(on));
+	return on != 0;
+}
+
+/* From stage 8 after the first scan: 0, or 1 en0 could not be made. */
+int
+sweet_wlsta_start(void)
+{
+	char want[33] = {0};
+	sweet_wlce_address(sta_link.address);
+	memcpy(sta_ops.address, sta_link.address, 6);
+	sweet_wlce_lock(true);
+	sweet_wldp_set_rx_handler(sta_rx);
+	(void)sweet_wlce_poll();                /* from here every caller holds the lock */
+	sta_last_scan_ms = sta_now_ms();
+	sweet_wlce_lock(false);
+	if (!redwood_net_attach(&sta_link)) {
+		printf("SWEET WLSTA: en0 could not be made\n");
+		return 1;
+	}
+	redwood_sta_attach(&sta_ops);
+	printf("SWEET WLSTA: en0 and the station are up for wifid\n");
+	if (PE_parse_boot_argn("sweetwlanssid", want, sizeof(want)) && want[0] != 0) {
+		struct redwood_sta_join *j = kalloc_data(sizeof(*j), Z_WAITOK | Z_ZERO);
+		if (j != NULL) {
+			for (unsigned i = 0; want[i]; ++i) {
+				j->ssid[i] = want[i] == '_' ? ' ' : (uint8_t)want[i];
+			}
+			j->ssid_length = (uint8_t)strlen(want);
+			j->security = REDWOOD_STA_OPEN;
+			printf("SWEET WLSTA: the boot line's network is asked for (standing): %d\n",
+			    redwood_sta_ask_join_standing(j));
+			kfree_data(j, sizeof(*j));
+		}
+	}
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
