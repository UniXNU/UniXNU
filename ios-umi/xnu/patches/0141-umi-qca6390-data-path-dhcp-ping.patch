+++ b/bsd/dev/sweet_wlce.c
@@ -21,6 +21,10 @@ extern void sweet_wldp_rx_report(const char *when);
 extern int sweet_wldp_mon_filter(void);
 extern void sweet_wldp_mon_reap(void);
 extern void sweet_wldp_mon_report(void);
+extern int sweet_wldp_rx_tid_qdesc(unsigned tid, uint32_t *pa);
+extern void sweet_wldp_data_poll(void);
+extern void sweet_wldp_data_report(void);
