From 1abc78e720e8ed85b0f9d59a53cde8334498b6d6 Mon Sep 17 00:00:00 2001
From: qualcomm-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Date: Wed, 4 Nov 2026 22:44:32 +0100
Subject: [PATCH] umi: latency-critical threads on the big cores (sweetbig,
 0248)

The umi ADT describes SM8250's eight cores as one homogeneous cluster, so XNU has
no AMP: one pset and one shared run queue, and silver A55s (cpu 0-3) take UI and
CoreAnimation threads while gold/prime A77s (4-7) idle. For realtime threads and
user threads at UI priority and above (sweetbigpri, default 46): place on an idle
big core or displace a lesser thread there (1), move off silver when a big core
frees up (2), silver leaves them queued for free big cores (4), no handoff to
silver while a big core is idle (8). sweetbig=MASK (default 0xf), sweetbigmask,
sweetbigprime, sweetbigab=N (same-boot on/off comparison). SWEET BIG log lines
and per-thread silver/gold/prime shares in TOP thread lines.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/sweet_sample.c              |   2 +
 osfmk/arm/machine_routines_common.c |   7 +
 osfmk/kern/exception.c              |  24 +-
 osfmk/kern/sched_clutch.c           | 379 ++++++++++++++++++++++++++++
 osfmk/kern/sched_prim.c             |  15 ++
 osfmk/kern/sched_prim.h             |   9 +
 osfmk/kern/thread.h                 |   3 +
 7 files changed, 436 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index 59c2d12..b03e70f 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -101,6 +101,7 @@ static unsigned top_nprev, top_ncur;
 static uint32_t top_threads = 8;        /* sweettopthreads=N: the N busiest threads each round too (0239); 0 = off */
 extern void sweet_top_threads(uint64_t window_ns, unsigned count);     /* osfmk/kern/exception.c */
 extern void sweet_adreno_top(uint32_t secs);                           /* bsd/dev/sweet_adreno.c */
+extern void sweet_big_log(uint32_t secs);                              /* osfmk/kern/sched_clutch.c (0248) */
 
 static int
 sweet_top_proc(proc_t p, __unused void *arg)
@@ -180,6 +181,7 @@ sweet_top_thread(void *arg, __unused wait_result_t wr)
 			sweet_top_threads(window_ns, top_threads);
 		}
 		sweet_adreno_top(secs);
+		sweet_big_log(secs);
 	}
 }
 
diff --git a/osfmk/arm/machine_routines_common.c b/osfmk/arm/machine_routines_common.c
index a6af1b9..25a776b 100644
--- a/osfmk/arm/machine_routines_common.c
+++ b/osfmk/arm/machine_routines_common.c
@@ -37,6 +37,7 @@
 #include <arm/machine_routines.h>
 #include <arm/rtclock.h>
 #include <kern/machine.h>
+#include <kern/sched_prim.h>
 #include <kern/thread.h>
 #include <kern/thread_group.h>
 #include <kern/policy_internal.h>
@@ -504,6 +505,9 @@ machine_thread_going_on_core(thread_t   new_thread,
     uint64_t   same_pri_latency,
     uint64_t   timestamp)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_big_on_core(new_thread, sched_latency);
+#endif
 	if (sched_perfcontrol_oncore == sched_perfcontrol_oncore_default) {
 		return;
 	}
@@ -541,6 +545,9 @@ void
 machine_thread_going_off_core(thread_t old_thread, boolean_t thread_terminating,
     uint64_t last_dispatch, __unused boolean_t thread_runnable)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_big_off_core(old_thread, last_dispatch);
+#endif
 	if (sched_perfcontrol_offcore == sched_perfcontrol_offcore_default) {
 		return;
 	}
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 2211dbe..cc508ba 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1043,7 +1043,7 @@ sweet_user_bt_current(const char *tag)
 #define SWEET_TT_SLOTS 2048
 #define SWEET_TT_BEST 12
 static struct sweet_tt_slot {
-	uint64_t tid, user, sys;
+	uint64_t tid, user, sys, cl[3];
 	uint32_t gen;
 } sweet_tt[SWEET_TT_SLOTS];
 static uint32_t sweet_tt_gen;
@@ -1054,7 +1054,8 @@ void
 sweet_top_threads(uint64_t window_ns, unsigned count)
 {
 	struct {
-		uint64_t du, ds;
+		uint64_t du, ds, dc[3];
+		int base_pri, sched_pri;
 		char who[64];
 	} best[SWEET_TT_BEST];
 	unsigned nbest = 0, seen = 0;
@@ -1085,14 +1086,21 @@ sweet_top_threads(uint64_t window_ns, unsigned count)
 			}
 		}
 		uint64_t du = t.rtm_user, ds = t.rtm_system;
+		uint64_t dc[3] = { thread->sweet_cluster_abs[0], thread->sweet_cluster_abs[1], thread->sweet_cluster_abs[2] };
 		if (slot != NULL && slot->gen != 0 && slot->tid == thread->thread_id) {
 			du = t.rtm_user >= slot->user ? t.rtm_user - slot->user : 0;
 			ds = t.rtm_system >= slot->sys ? t.rtm_system - slot->sys : 0;
+			for (int c = 0; c < 3; c++) {
+				dc[c] -= slot->cl[c];
+			}
 		}
 		if (slot != NULL) {
 			slot->tid = thread->thread_id;
 			slot->user = t.rtm_user;
 			slot->sys = t.rtm_system;
+			for (int c = 0; c < 3; c++) {
+				slot->cl[c] = thread->sweet_cluster_abs[c];
+			}
 			slot->gen = sweet_tt_gen;
 		}
 		/* keep the `count` busiest, by insertion */
@@ -1111,6 +1119,9 @@ sweet_top_threads(uint64_t window_ns, unsigned count)
 		}
 		best[at].du = du;
 		best[at].ds = ds;
+		memcpy(best[at].dc, dc, sizeof(dc));
+		best[at].base_pri = thread->base_pri;
+		best[at].sched_pri = thread->sched_pri;
 		task_t task = get_threadtask(thread);
 		void *bsd = task != TASK_NULL ? get_bsdtask_info(task) : NULL;
 		const char *pname = task == kernel_task ? "kernel_task" : bsd != NULL ? proc_name_address(bsd) : "?";
@@ -1128,7 +1139,14 @@ sweet_top_threads(uint64_t window_ns, unsigned count)
 		if ((un + sn) * 100 / window_ns == 0) {
 			break;
 		}
-		printf("TOP thread %s %llu%% (sys %llu%%)\n", best[k].who, (un + sn) * 100 / window_ns, sn * 100 / window_ns);
+		/* (0248) priority base/current; % of one core on silver, gold, prime (sched_clutch.c) */
+		uint64_t cn[3];
+		for (int c = 0; c < 3; c++) {
+			absolutetime_to_nanoseconds(best[k].dc[c], &cn[c]);
+		}
+		printf("TOP thread %s %llu%% (sys %llu%%) pri %d/%d on %llu/%llu/%llu\n", best[k].who, (un + sn) * 100 / window_ns,
+		    sn * 100 / window_ns, best[k].base_pri, best[k].sched_pri, cn[0] * 100 / window_ns, cn[1] * 100 / window_ns,
+		    cn[2] * 100 / window_ns);
 	}
 	(void)seen;
 }
diff --git a/osfmk/kern/sched_clutch.c b/osfmk/kern/sched_clutch.c
index 3657d83..3d319ae 100644
--- a/osfmk/kern/sched_clutch.c
+++ b/osfmk/kern/sched_clutch.c
@@ -2766,6 +2766,14 @@ sched_clutch_run_decr(thread_t thread);
 static void
 sched_clutch_update_thread_bucket(thread_t thread);
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+static thread_t sweet_big_choose_thread(processor_t processor, int priority, ast_t reason);
+static processor_t sweet_big_choose_processor(processor_set_t pset, processor_t hint, thread_t thread);
+static void sweet_big_balance(processor_t cprocessor, processor_set_t cpset);
+static bool sweet_big_avoid(processor_t processor, thread_t thread);
+static void sweet_big_init(void);
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 const struct sched_dispatch_table sched_clutch_dispatch = {
 	.sched_name                                     = "clutch",
 	.init                                           = sched_clutch_init,
@@ -2773,12 +2781,20 @@ const struct sched_dispatch_table sched_clutch_dispatch = {
 	.processor_init                                 = sched_clutch_processor_init,
 	.pset_init                                      = sched_clutch_pset_init,
 	.maintenance_continuation                       = sched_timeshare_maintenance_continue,
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	.choose_thread                                  = sweet_big_choose_thread,
+#else
 	.choose_thread                                  = sched_clutch_choose_thread,
+#endif
 	.steal_thread_enabled                           = sched_steal_thread_enabled,
 	.steal_thread                                   = sched_clutch_steal_thread,
 	.compute_timeshare_priority                     = sched_compute_timeshare_priority,
 	.choose_node                                    = sched_choose_node,
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	.choose_processor                               = sweet_big_choose_processor,
+#else
 	.choose_processor                               = choose_processor,
+#endif
 	.processor_enqueue                              = sched_clutch_processor_enqueue,
 	.processor_queue_shutdown                       = sched_clutch_processor_queue_shutdown,
 	.processor_queue_remove                         = sched_clutch_processor_queue_remove,
@@ -2800,7 +2816,11 @@ const struct sched_dispatch_table sched_clutch_dispatch = {
 	.sched_groups_enabled                           = FALSE,
 	.avoid_processor_enabled                        = TRUE,
 	.thread_avoid_processor                         = sched_clutch_thread_avoid_processor,
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	.processor_balance                              = sweet_big_balance,
+#else
 	.processor_balance                              = sched_SMT_balance,
+#endif
 
 	.rt_runq                                        = sched_rtlocal_runq,
 	.rt_init                                        = sched_rtlocal_init,
@@ -2895,6 +2915,9 @@ sched_clutch_init(void)
 	}
 	sched_timeshare_init();
 	sched_clutch_tunables_init();
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_big_init();
+#endif
 }
 
 static thread_t
@@ -3214,8 +3237,364 @@ sched_clutch_thread_avoid_processor(processor_t processor, thread_t thread)
 		}
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	return sweet_big_avoid(processor, thread);
+#else
 	return false;
+#endif
+}
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * (0248) Latency-critical threads on the big cores. XNU does not know SM8250's cores differ: mkadt.py describes one
+ * cluster (cluster-type 0) and board_config.h has MAX_CPU_CLUSTERS 1, so there is no __AMP__: one pset, one realtime
+ * queue and one clutch root shared by all eight. A wake-up only picks a core to signal. The thread waits on the shared
+ * queue and whichever core schedules first takes it, silver included (often the waker's own core, blocking right after
+ * the wake-up); a busy last processor keeps a realtime thread; nothing moves a running thread to a core that came free.
+ * ios-s9's fast-core hints (sweetfast, sched_prim.c) only steer the choice of an idle core.
+ *
+ * So for realtime threads and user threads of UI priority and above (sweetbigpri, default 46 = QoS user-interactive;
+ * the higher of base and current priority, as a timeshare thread's current one decays under load), sweetbig=MASK,
+ * default 0xf:
+ *   1 PLACE    A wake-up takes an idle big core (its last one, else prime, else gold), else displaces the lowest
+ *              priority thread of a lesser class from a big core. Only when every big core runs this class does it go
+ *              to silver, through the ordinary choose_processor().
+ *   2 MIGRATE  On silver, it leaves at its next scheduling check once a big core can take it; a big core going idle
+ *              sends that check (what sched_SMT_balance does for SMT).
+ *   4 QUEUE    Silver leaves it on the queue while free big cores can drain the queue, and realtime threads too unless
+ *              one has waited SWEET_BIG_RT_WAIT_US. Needs PLACE, which is what signals the big core.
+ *   8 HANDOFF  No direct handoff from silver to it while a big core is idle.
+ * sweetbigmask=CPUS (default 0xf0, gold 4-6 + prime 7), sweetbigprime=CPUS (default 0x80). Other kernel threads are
+ * left as they were. sweetbigab=N, a same-boot comparison: for the first SWEET_BIG_AB_ROUNDS sweettop rounds, N rounds
+ * on and N rounds off (off = stock + ios-s9), then on. sweet_big_log() gives the numbers each sweettop round.
+ */
+#define SWEET_BIG_PLACE         0x1
+#define SWEET_BIG_MIGRATE       0x2
+#define SWEET_BIG_QUEUE         0x4
+#define SWEET_BIG_HANDOFF       0x8
+#define SWEET_BIG_RT_WAIT_US    500
+#define SWEET_BIG_AB_ROUNDS     90
+
+enum { SWEET_BIG_RT, SWEET_BIG_UI, SWEET_BIG_DEFAULT, SWEET_BIG_LOW, SWEET_BIG_KERNEL, SWEET_BIG_CLASSES };
+
+static uint32_t sweet_big_mode = 0xf;   /* sweetbig= */
+static uint32_t sweet_big_flags;        /* on right now: sweet_big_mode, or 0 in a sweetbigab off round */
+static uint32_t sweet_big_ab;
+static uint64_t sweet_big_map = 0xf0, sweet_prime_map = 0x80;
+static int sweet_big_pri = BASEPRI_BACKGROUND;
+static uint64_t sweet_big_rt_wait;
+
+/* Written only by their own core, at splsched; the log adds them up racily. */
+static struct sweet_big_cpu {
+	uint64_t run[SWEET_BIG_CLASSES];        /* mach time run here */
+	uint64_t waits[2], wait_sum[2], wait_max[2];    /* [RT, UI]: runnable -> on core */
+	uint64_t wrong[2];                      /* [RT, UI]: started here, on silver, with a big core idle */
+	uint64_t left, balanced, handoffs;
+	bool critical_on;                       /* a critical thread is running here */
+} sweet_big_cpu[MAX_SCHED_CPUS];
+
+static inline bool
+sweet_big_critical(thread_t thread)
+{
+	int pri = MAX(thread->base_pri, thread->sched_pri);
+
+	return pri >= BASEPRI_RTQUEUES || (pri >= sweet_big_pri && get_threadtask(thread) != kernel_task);
+}
+
+static inline unsigned
+sweet_big_cluster(int cpu)
+{
+	return bit_test(sweet_prime_map, cpu) ? 2 : bit_test(sweet_big_map, cpu) ? 1 : 0;
+}
+
+/* Where a critical thread should go now: an idle big core, or one running a lesser thread; NULL if neither. */
+static processor_t
+sweet_big_target(processor_set_t pset, thread_t thread, processor_t hint)
+{
+	cpumap_t big = pset->cpu_available_map & pset->recommended_bitmask & sweet_big_map &
+	    ~pset->pending_AST_URGENT_cpu_mask;
+	cpumap_t idle = big & pset->cpu_state_map[PROCESSOR_IDLE];
+
+	if (idle != 0) {
+		if (hint != PROCESSOR_NULL && bit_test(idle, hint->cpu_id)) {
+			return hint;
+		}
+		cpumap_t prime = idle & sweet_prime_map;
+		return processor_array[lsb_first(prime != 0 ? prime : idle)];
+	}
+
+	int limit = thread->sched_pri >= BASEPRI_RTQUEUES ? BASEPRI_RTQUEUES : MIN(sweet_big_pri, thread->sched_pri);
+	cpumap_t running = big & pset->cpu_state_map[PROCESSOR_RUNNING] & ~pset->pending_AST_PREEMPT_cpu_mask;
+	processor_t victim = PROCESSOR_NULL;
+
+	for (int cpuid = lsb_first(running); cpuid >= 0; cpuid = lsb_next(running, cpuid)) {
+		processor_t processor = processor_array[cpuid];
+		if (processor->current_pri < limit &&
+		    (victim == PROCESSOR_NULL || processor->current_pri < victim->current_pri)) {
+			victim = processor;
+		}
+	}
+	return victim;
+}
+
+static processor_t
+sweet_big_choose_processor(processor_set_t pset, processor_t hint, thread_t thread)
+{
+	if ((sweet_big_flags & SWEET_BIG_PLACE) && sweet_big_critical(thread)) {
+		processor_t processor = sweet_big_target(pset, thread, hint);
+		if (processor != PROCESSOR_NULL) {
+			return processor;
+		}
+	}
+	return choose_processor(pset, hint, thread);
+}
+
+/* processor_setrun(): really displace the lesser thread, even for a thread that would not preempt by itself. */
+bool
+sweet_big_must_preempt(processor_t processor, thread_t thread)
+{
+	return (sweet_big_flags & SWEET_BIG_PLACE) && bit_test(sweet_big_map, processor->cpu_id) &&
+	       sweet_big_critical(thread) && processor->current_pri < MIN(sweet_big_pri, thread->sched_pri);
+}
+
+static bool
+sweet_big_avoid(processor_t processor, thread_t thread)
+{
+	return (sweet_big_flags & SWEET_BIG_MIGRATE) && !bit_test(sweet_big_map, processor->cpu_id) &&
+	       thread->bound_processor == PROCESSOR_NULL && sweet_big_critical(thread) &&
+	       sweet_big_target(processor->processor_set, thread, PROCESSOR_NULL) != PROCESSOR_NULL;
+}
+
+/* SCHED(processor_balance): sched_SMT_balance's contract, pset locked on entry, unlocked on return. No SMT here. */
+static void
+sweet_big_balance(processor_t cprocessor, processor_set_t cpset)
+{
+	processor_t ast_processor = PROCESSOR_NULL;
+	sched_ipi_type_t ipi_type = SCHED_IPI_NONE;
+
+	if ((sweet_big_flags & SWEET_BIG_MIGRATE) && bit_test(sweet_big_map, cprocessor->cpu_id)) {
+		cpumap_t silver = cpset->cpu_state_map[PROCESSOR_RUNNING] & ~sweet_big_map &
+		    ~cpset->pending_AST_URGENT_cpu_mask;
+		for (int cpuid = lsb_first(silver); cpuid >= 0; cpuid = lsb_next(silver, cpuid)) {
+			if (sweet_big_cpu[cpuid].critical_on) {
+				ast_processor = processor_array[cpuid];
+				ipi_type = sched_ipi_action(ast_processor, NULL, SCHED_IPI_EVENT_SMT_REBAL);
+				sweet_big_cpu[cprocessor->cpu_id].balanced++;
+				break;
+			}
+		}
+	}
+	pset_unlock(cpset);
+
+	if (ast_processor != PROCESSOR_NULL) {
+		sched_ipi_perform(ast_processor, ipi_type);
+	}
+}
+
+/*
+ * SCHED(choose_thread), pset locked. A silver core leaves a critical thread for the free big cores when they can drain
+ * the queue; with more queued than that it takes the top one rather than strand work. A big core still idle (no signal
+ * on its way) is signalled from here, so a left thread never waits for a core that does not know about it.
+ */
+static thread_t
+sweet_big_choose_thread(processor_t processor, int priority, ast_t reason)
+{
+	if ((sweet_big_flags & SWEET_BIG_QUEUE) && !bit_test(sweet_big_map, processor->cpu_id)) {
+		processor_set_t pset = processor->processor_set;
+		sched_clutch_root_t root = sched_clutch_processor_root_clutch(processor);
+		uint32_t queued = sched_clutch_root_count(root);
+
+		if (queued != 0 && sched_clutch_root_priority(root) >= sweet_big_pri) {
+			cpumap_t usable = pset->cpu_available_map & pset->recommended_bitmask & sweet_big_map;
+			cpumap_t idle = usable & pset->cpu_state_map[PROCESSOR_IDLE];
+			cpumap_t waking = usable & pset->cpu_state_map[PROCESSOR_DISPATCHING];
+			uint32_t work = queued + (uint32_t)rt_runq_count(pset);
+
+			if ((uint32_t)(bit_count(idle) + bit_count(waking)) >= work) {
+				if ((uint32_t)bit_count(waking) < work) {
+					processor_t big = processor_array[lsb_first(idle)];
+					sched_ipi_perform(big, sched_ipi_action(big, NULL, SCHED_IPI_EVENT_REBALANCE));
+				}
+				sweet_big_cpu[processor->cpu_id].left++;
+				run_queue_t bound_runq = sched_clutch_bound_runq(processor);
+				if (bound_runq->count != 0 && bound_runq->highq >= priority) {
+					return run_queue_dequeue(bound_runq, SCHED_HEADQ);
+				}
+				return THREAD_NULL;
+			}
+		}
+	}
+	return sched_clutch_choose_thread(processor, priority, reason);
+}
+
+/* sched_ok_to_run_realtime_thread(), pset locked; next = the first queued realtime thread, if any. */
+bool
+sweet_big_rt_ok(processor_set_t pset, processor_t processor, thread_t next)
+{
+	if (!(sweet_big_flags & SWEET_BIG_QUEUE) || next == THREAD_NULL || bit_test(sweet_big_map, processor->cpu_id)) {
+		return true;
+	}
+	cpumap_t free_big = pset->cpu_available_map & pset->recommended_bitmask & sweet_big_map & ~pset->realtime_map;
+
+	return rt_runq_count(pset) > bit_count(free_big) ||
+	       mach_absolute_time() - next->last_made_runnable_time >= sweet_big_rt_wait;
+}
+
+/* thread_prepare_for_handoff(): no pset lock, a hint. */
+bool
+sweet_big_no_handoff(processor_t processor, thread_t thread)
+{
+	processor_set_t pset = processor->processor_set;
+
+	if (!(sweet_big_flags & SWEET_BIG_HANDOFF) || bit_test(sweet_big_map, processor->cpu_id) ||
+	    !sweet_big_critical(thread) ||
+	    (pset->cpu_state_map[PROCESSOR_IDLE] & pset->recommended_bitmask & sweet_big_map) == 0) {
+		return false;
+	}
+	sweet_big_cpu[processor->cpu_id].handoffs++;
+	return true;
+}
+
+/* machine_thread_going_on_core(); latency 0 = not a dispatch (an urgency update). */
+void
+sweet_big_on_core(thread_t thread, uint64_t latency)
+{
+	processor_t processor = current_processor();
+	struct sweet_big_cpu *c = &sweet_big_cpu[processor->cpu_id];
+	bool critical = sweet_big_critical(thread);
+
+	c->critical_on = critical;
+	if (!critical || latency == 0) {
+		return;
+	}
+	unsigned k = thread->sched_pri >= BASEPRI_RTQUEUES ? 0 : 1;
+	processor_set_t pset = processor->processor_set;
+
+	c->waits[k]++;
+	c->wait_sum[k] += latency;
+	if (latency > c->wait_max[k]) {
+		c->wait_max[k] = latency;
+	}
+	if (!bit_test(sweet_big_map, processor->cpu_id) &&
+	    (pset->cpu_state_map[PROCESSOR_IDLE] & pset->recommended_bitmask & sweet_big_map) != 0) {
+		c->wrong[k]++;
+	}
+}
+
+/* machine_thread_going_off_core() */
+void
+sweet_big_off_core(thread_t thread, uint64_t last_dispatch)
+{
+	int cpu = current_processor()->cpu_id;
+	int pri = MAX(thread->base_pri, thread->sched_pri);
+	uint64_t ran = last_dispatch - thread->computation_epoch;
+	unsigned k;
+
+	if (pri >= BASEPRI_RTQUEUES) {
+		k = SWEET_BIG_RT;
+	} else if (get_threadtask(thread) == kernel_task) {
+		k = SWEET_BIG_KERNEL;
+	} else {
+		k = pri >= sweet_big_pri ? SWEET_BIG_UI : pri >= BASEPRI_DEFAULT ? SWEET_BIG_DEFAULT : SWEET_BIG_LOW;
+	}
+	sweet_big_cpu[cpu].run[k] += ran;
+	thread->sweet_cluster_abs[sweet_big_cluster(cpu)] += ran;
+}
+
+static inline uint64_t
+sweet_big_abs_to(uint64_t abs, uint64_t unit_ns)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / unit_ns;
+}
+
+/* A round of sweettop (bsd/dev/sweet_sample.c). */
+void sweet_big_log(uint32_t secs);
+
+void
+sweet_big_log(uint32_t secs)
+{
+	static uint64_t prev_run[3][SWEET_BIG_CLASSES], prev_waits[2], prev_sum[2], prev_wrong[2];
+	static uint64_t prev_left, prev_balanced, prev_handoffs;
+	static uint32_t ab_rounds;
+	uint64_t run[3][SWEET_BIG_CLASSES] = {}, waits[2] = {}, sum[2] = {}, max[2] = {}, wrong[2] = {};
+	uint64_t left = 0, balanced = 0, handoffs = 0;
+
+	for (int cpu = 0; cpu < MAX_SCHED_CPUS; cpu++) {
+		struct sweet_big_cpu *c = &sweet_big_cpu[cpu];
+		for (int k = 0; k < SWEET_BIG_CLASSES; k++) {
+			run[sweet_big_cluster(cpu)][k] += c->run[k];
+		}
+		for (int k = 0; k < 2; k++) {
+			waits[k] += c->waits[k];
+			sum[k] += c->wait_sum[k];
+			wrong[k] += c->wrong[k];
+			if (c->wait_max[k] > max[k]) {
+				max[k] = c->wait_max[k];
+			}
+			c->wait_max[k] = 0;
+		}
+		left += c->left;
+		balanced += c->balanced;
+		handoffs += c->handoffs;
+	}
+
+	char line[160];
+	int at = 0;
+	static const char *const names[SWEET_BIG_CLASSES] = { "rt", "ui", "default", "low", "kernel" };
+	for (int k = 0; k < SWEET_BIG_CLASSES; k++) {
+		at += snprintf(line + at, sizeof(line) - at, " %s %llu/%llu/%llu", names[k],
+		    sweet_big_abs_to(run[0][k] - prev_run[0][k], NSEC_PER_MSEC),
+		    sweet_big_abs_to(run[1][k] - prev_run[1][k], NSEC_PER_MSEC),
+		    sweet_big_abs_to(run[2][k] - prev_run[2][k], NSEC_PER_MSEC));
+	}
+	printf("SWEET BIG (%s): %u s, ms on silver/gold/prime:%s\n", sweet_big_flags != 0 ? "on" : "off", secs, line);
+
+	uint64_t n[2] = { waits[0] - prev_waits[0], waits[1] - prev_waits[1] };
+	printf("SWEET BIG: runnable->on core rt %llu avg %llu max %llu us, ui %llu avg %llu max %llu us; "
+	    "started on silver with a big core idle: rt %llu ui %llu; left for big %llu, moved %llu, handoffs refused %llu\n",
+	    n[0], n[0] != 0 ? sweet_big_abs_to(sum[0] - prev_sum[0], NSEC_PER_USEC) / n[0] : 0,
+	    sweet_big_abs_to(max[0], NSEC_PER_USEC),
+	    n[1], n[1] != 0 ? sweet_big_abs_to(sum[1] - prev_sum[1], NSEC_PER_USEC) / n[1] : 0,
+	    sweet_big_abs_to(max[1], NSEC_PER_USEC),
+	    wrong[0] - prev_wrong[0], wrong[1] - prev_wrong[1],
+	    left - prev_left, balanced - prev_balanced, handoffs - prev_handoffs);
+
+	memcpy(prev_run, run, sizeof(prev_run));
+	memcpy(prev_waits, waits, sizeof(prev_waits));
+	memcpy(prev_sum, sum, sizeof(prev_sum));
+	memcpy(prev_wrong, wrong, sizeof(prev_wrong));
+	prev_left = left;
+	prev_balanced = balanced;
+	prev_handoffs = handoffs;
+
+	if (sweet_big_ab != 0 && ab_rounds < SWEET_BIG_AB_ROUNDS) {
+		ab_rounds++;
+		if (ab_rounds == SWEET_BIG_AB_ROUNDS) {
+			sweet_big_flags = sweet_big_mode;
+		} else if (ab_rounds % sweet_big_ab == 0) {
+			sweet_big_flags = sweet_big_flags != 0 ? 0 : sweet_big_mode;
+		}
+	}
+}
+
+static void
+sweet_big_init(void)
+{
+	(void)PE_parse_boot_argn("sweetbig", &sweet_big_mode, sizeof(sweet_big_mode));
+	(void)PE_parse_boot_argn("sweetbigmask", &sweet_big_map, sizeof(sweet_big_map));
+	(void)PE_parse_boot_argn("sweetbigprime", &sweet_prime_map, sizeof(sweet_prime_map));
+	(void)PE_parse_boot_argn("sweetbigpri", &sweet_big_pri, sizeof(sweet_big_pri));
+	(void)PE_parse_boot_argn("sweetbigab", &sweet_big_ab, sizeof(sweet_big_ab));
+	if (!(sweet_big_mode & SWEET_BIG_PLACE)) {
+		sweet_big_mode &= ~SWEET_BIG_QUEUE;
+	}
+	nanoseconds_to_absolutetime(SWEET_BIG_RT_WAIT_US * NSEC_PER_USEC, &sweet_big_rt_wait);
+	sweet_big_flags = sweet_big_mode;
 }
