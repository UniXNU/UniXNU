+static int
+fr_open(const char *path)
+{
+	for (int i = 1; i < FR_FDS; i++) {
+		if (!fr_fd[i].used) {
+			uint8_t *data = NULL;
+			uint32_t len = 0;
+			bool dir = false;
+			int err = fr_load(path, &data, &len, &dir);
+			if (err) {
+				if (data) {
+					kfree_data(data, dir ? 16384 : (len ? len : 1));
+				}
+				return -err;
+			}
+			fr_fd[i].used = true;
+			fr_fd[i].dir = dir;
+			fr_fd[i].data = data;
+			fr_fd[i].len = len;
+			fr_fd[i].pos = 0;
+			return i;
+		}
+	}
+	return -EMFILE;
+}
+
+static void
+fr_close(uint32_t fd)
+{
+	if (fd < FR_FDS && fr_fd[fd].used) {
+		kfree_data(fr_fd[fd].data, fr_fd[fd].dir ? 16384 : (fr_fd[fd].len ? fr_fd[fd].len : 1));
+		fr_fd[fd].used = false;
+	}
+}
