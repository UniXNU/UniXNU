+/* A string argument: in-buffer i, NUL-terminated within its length. */
+static const char *
+fr_str(struct fr_buf *b)
+{
+	return b->len > 0 && ((const char *)b->p)[b->len - 1] == 0 ? (const char *)b->p : NULL;
+}
