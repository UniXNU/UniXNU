+/* Attach to the sensors PD, register the default listener, then answer its calls. */
+static void
+fr_run(unsigned seconds)
+{
+	struct fr_buf in[4], out[4];
+	uint32_t prim[8], oprim[8];
+	char err[256];
+	(void)sweet_smmu_route_sid(0x541);
+	(void)sweet_smmu_route_sid(0x542);
+	(void)sweet_smmu_route_sid(0x543);
+	int32_t tgid = FR_TGID;
+	in[0] = (struct fr_buf){ &tgid, 4 };
+	int r = fr_invoke(0, FR_HANDLE_INIT, FR_SC(0, 1, 0), in, out, 3000);
+	printf("SWEET SLPI: FastRPC INIT_ATTACH (sensors PD) -> %d\n", r);
+	if (r != 0) {
+		return;
+	}
+	static const char lname[] = "adsp_default_listener";
+	prim[0] = sizeof(lname);
+	prim[1] = sizeof(err);
+	in[0] = (struct fr_buf){ prim, 8 };
+	in[1] = (struct fr_buf){ (void *)(uintptr_t)lname, sizeof(lname) };
+	out[0] = (struct fr_buf){ oprim, 8 };
+	out[1] = (struct fr_buf){ err, sizeof(err) };
+	r = fr_invoke(FR_TGID, FR_HANDLE_REMOTECTL, FR_SC(0, 2, 2), in, out, 3000);
+	uint32_t lh = oprim[0];
+	printf("SWEET SLPI: FastRPC remotectl open adsp_default_listener -> %d, handle %u, dl error %d\n", r, lh, oprim[1]);
+	if (r != 0) {
+		return;
+	}
+	r = fr_invoke(FR_TGID, lh, FR_SC(0, 0, 0), in, out, 3000);
+	printf("SWEET SLPI: FastRPC adsp_default_listener register -> %d\n", r);
+	r = fr_invoke(FR_TGID, FR_HANDLE_LISTENER, FR_SC(3, 0, 0), in, out, 3000);
+	printf("SWEET SLPI: FastRPC adsp_listener init2 -> %d\n", r);
+	if (r != 0) {
+		return;
+	}
+	static uint8_t reply_enc[0x10200], nested[256], outmem[0x10400];
+	struct fr_buf rq_in[FR_MAX_BUFS], rq_out[FR_MAX_BUFS];
+	uint8_t inmem[256];
+	uint32_t rctx = 0, result = 0xffffffff, enc_len = 0, calls = 0;
+	(void)seconds;
+	for (;;) {
+		uint32_t np[4] = { rctx, result, enc_len, sizeof(nested) }, rp[4] = { 0 };
+		in[0] = (struct fr_buf){ np, 16 };
+		in[1] = (struct fr_buf){ reply_enc, enc_len };
+		out[0] = (struct fr_buf){ rp, 16 };
+		out[1] = (struct fr_buf){ nested, sizeof(nested) };
+		r = fr_invoke(FR_TGID, FR_HANDLE_LISTENER, FR_SC(4, 2, 2), in, out, 0);    /* the next call, whenever */
+		if (r != 0) {
+			printf("SWEET SLPI: FastRPC adsp_listener next2 -> %d after %u calls\n", r, calls);
+			return;
+		}
+		rctx = rp[0];
+		uint32_t handle = rp[1], sc = rp[2], ilen = MIN(rp[3], (uint32_t)sizeof(nested));
+		/* nested in-buffers: per buffer u32 size, padding to 8, data (hexagonrpcd iobuffer.c) */
+		uint32_t nin = MIN(FR_SC_IN(sc), (uint32_t)FR_MAX_BUFS), nout = MIN(FR_SC_OUT(sc), (uint32_t)FR_MAX_BUFS);
+		uint32_t pos = 0, used = 0;
+		bool ok = true;
+		for (uint32_t i = 0; i < nin; i++) {
+			uint32_t sz = 0;
+			if (pos + 4 > ilen) {
+				ok = false;
+				break;
+			}
+			memcpy(&sz, nested + pos, 4);
+			pos += 4;
+			if (sz && (pos & 7)) {
+				pos = (pos + 7) & ~7u;
+			}
+			if (pos + sz > ilen || used + sz > sizeof(inmem)) {
+				ok = false;
+				break;
+			}
+			memcpy(inmem + used, nested + pos, sz);
+			rq_in[i] = (struct fr_buf){ inmem + used, sz };
+			used += sz;
+			pos += sz;
+		}
+		calls++;
+		result = ok ? fr_serve(handle, sc, rq_in, nin, outmem, rq_out, nout) : AEE_EBADPARM;
+		/* the out-buffers back: per buffer u32 size, padding to 8, data */
+		enc_len = 0;
+		for (uint32_t i = 0; i < nout; i++) {
+			uint32_t sz = rq_out[i].len;
+			memcpy(reply_enc + enc_len, &sz, 4);
+			enc_len += 4;
+			if (sz && (enc_len & 7)) {
+				memset(reply_enc + enc_len, 0, 8 - (enc_len & 7));
+				enc_len = (enc_len + 7) & ~7u;
+			}
+			if (sz) {
+				memcpy(reply_enc + enc_len, rq_out[i].p, sz);
+				enc_len += sz;
+			}
+		}
+	}
+}
