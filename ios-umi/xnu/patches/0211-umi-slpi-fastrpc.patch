+
+/* ---- FastRPC (Linux drivers/misc/fastrpc.c message format) ---- */
+
+/*
+ * The sensor user PD (sensor_process) reads its configuration through reverse calls
+ * to an APPS process: Android's sscrpcd, postmarketOS's hexagonrpcd (linux-msm/hexagonrpc,
+ * whose behaviour this follows; no code taken). Here the kernel is that process:
+ * INIT_ATTACH to the sensors PD, open + register "adsp_default_listener", then
+ * adsp_listener next2 in a loop, answering remotectl (handle 0) and apps_std
+ * (handle 1: files from /private/var/sweet/sensors/).
+ *
+ * Argument buffers are read by the SLPI through APPS SMMU stream 0x541 (dt
+ * sdsprpc-smd compute cb, upstream reg 1 = sid in address bits 32+), routed to the
+ * display's non-translating context like the other DSP streams here
+ * (sweet_smmu_route_sid). The SLPI takes 32-bit physical addresses, so the buffer
+ * is low RAM that highmem XNU does not manage: 1 MiB at 0xd3000000 (after the
+ * Wi-Fi pools, sweet_wlan.c / sweet_wlfw.c).
+ */
+#define FR_POOL_PA              0xd3000000u
+#define FR_POOL_SIZE            0x100000u
+#define FR_SID                  1ull
+#define FR_TGID                 0x100
+#define FR_PD_SENSORS           2
+#define FR_HANDLE_REMOTECTL     0
+#define FR_HANDLE_INIT          1
+#define FR_HANDLE_LISTENER      3
+#define FR_SC(m, in, out)       ((((uint32_t)(m) & 0x1f) << 24) | (((in) & 0xff) << 16) | (((out) & 0xff) << 8))
+#define FR_SC_METHOD(sc)        (((sc) >> 24) & 0x1f)
+#define FR_SC_IN(sc)            (((sc) >> 16) & 0xff)
+#define FR_SC_OUT(sc)           (((sc) >> 8) & 0xff)
+#define FR_MAX_BUFS             8
+#define AEE_EFAILED             1
+#define AEE_EBADPARM            14
+#define AEE_EUNSUPPORTED        20
+#define FR_DIR                  "/private/var/sweet/sensors/"
+
+extern bool sweet_smmu_route_sid(uint32_t sid);
+extern kern_return_t pmap_enter(pmap_t, vm_map_offset_t, ppnum_t, vm_prot_t, vm_prot_t, unsigned int, boolean_t);
+static bool gl_rx_one(void);
+#define FR_WIMG_WCOMB           0x6     /* arm/memory_types.h VM_WIMG_WCOMB */
+
+static volatile uint8_t *fr_pool;
+static uint32_t fr_ctxid;
+static uint64_t fr_reply_ctx;
+static int32_t fr_reply_ret;
+static bool fr_reply;
+static unsigned fr_logged;
+
+struct fr_buf {
+	void *p;
+	uint32_t len;
+};
+
+static void
+fr_rx(const uint8_t *m, uint32_t len)
+{
+	if (len < 12) {
+		return;
+	}
+	memcpy(&fr_reply_ctx, m, 8);
+	memcpy(&fr_reply_ret, m + 8, 4);
+	fr_reply = true;
+}
+
+static bool
+fr_map_pool(void)
+{
+	if (fr_pool != NULL) {
+		return true;
+	}
+	vm_offset_t va = 0;
+	if (kmem_alloc(kernel_map, &va, FR_POOL_SIZE, KMA_VAONLY | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	for (uint32_t o = 0; o < FR_POOL_SIZE; o += PAGE_SIZE) {
+		if (pmap_enter(kernel_pmap, va + o, (ppnum_t)atop_64((uint64_t)FR_POOL_PA + o), VM_PROT_READ | VM_PROT_WRITE,
+		    VM_PROT_NONE, FR_WIMG_WCOMB, TRUE) != KERN_SUCCESS) {
+			return false;
+		}
+	}
+	fr_pool = (volatile uint8_t *)va;
+	return true;
+}
+
+static void
+fr_put(uint32_t off, const void *src, uint32_t len)
+{
+	for (uint32_t i = 0; i < len; i++) {
+		fr_pool[off + i] = ((const uint8_t *)src)[i];
+	}
+}
+
+static void
+fr_get(void *dst, uint32_t off, uint32_t len)
+{
+	for (uint32_t i = 0; i < len; i++) {
+		((uint8_t *)dst)[i] = fr_pool[off + i];
+	}
+}
+
+static void
+fr_put64(uint32_t off, uint64_t v)
+{
+	fr_put(off, &v, 8);
+}
+
+static void
+fr_put32(uint32_t off, uint32_t v)
+{
+	fr_put(off, &v, 4);
+}
+
+/*
+ * One synchronous invoke: the payload (remote_arg / invoke_buf / phy_page lists, fd and
+ * crc lists, then each buffer 128-byte aligned) at the pool's start, the 40-byte message
+ * on the GLINK channel, then GLINK is pumped until the reply {ctx, retval} comes.
+ */
+static int
+fr_invoke(uint32_t pid, uint32_t handle, uint32_t sc, struct fr_buf *in, struct fr_buf *out, unsigned wait_ms)
+{
+	uint32_t nin = FR_SC_IN(sc), nout = FR_SC_OUT(sc), n = nin + nout;
+	if (n > FR_MAX_BUFS || !fr_map_pool()) {
+		return -1;
+	}
+	uint32_t meta = (16 + 8 + 16) * n + 8 * 16 + 4 * 64;
+	uint32_t at = (meta + 127) & ~127u, off[FR_MAX_BUFS];
+	for (uint32_t i = 0; i < meta; i += 4) {
+		fr_put32(i, 0);
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		struct fr_buf *b = i < nin ? &in[i] : &out[i - nin];
+		at = (at + 127) & ~127u;
+		off[i] = at;
+		uint64_t pa = (uint64_t)FR_POOL_PA + at;
+		if (at + b->len > FR_POOL_SIZE) {
+			return -1;
+		}
+		fr_put64(16 * i, b->len ? pa : 0);                              /* remote_arg.pv */
+		fr_put64(16 * i + 8, b->len);                                   /* remote_arg.len */
+		fr_put32(16 * n + 8 * i, b->len ? 1 : 0);                       /* invoke_buf.num */
+		fr_put32(16 * n + 8 * i + 4, i);                                /* invoke_buf.pgidx */
+		if (b->len) {
+			uint64_t first = pa & ~0xfffull, last = (pa + b->len - 1) & ~0xfffull;
+			fr_put64(24 * n + 16 * i, first | (FR_SID << 32));      /* phy_page.addr (4K pages) */
+			fr_put64(24 * n + 16 * i + 8, last - first + 0x1000);   /* phy_page.size */
+		}
+		if (i < nin && b->len) {
+			fr_put(at, b->p, b->len);
+		} else if (b->len) {
+			for (uint32_t z = 0; z < b->len; z++) {
+				fr_pool[at + z] = 0;
+			}
+		}
+		at += b->len;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fr_ctxid = (fr_ctxid % 255) + 1;
+	uint64_t ctx = ((uint64_t)fr_ctxid << 4) | FR_PD_SENSORS;
+	uint8_t msg[40];
+	uint64_t addr = (uint64_t)FR_POOL_PA | (FR_SID << 32), size = (at + 0xfff) & ~0xfffull;
+	int32_t ipid = (int32_t)pid, itid = FR_TGID;
+	memcpy(msg, &ipid, 4);
+	memcpy(msg + 4, &itid, 4);
+	memcpy(msg + 8, &ctx, 8);
+	memcpy(msg + 16, &handle, 4);
+	memcpy(msg + 20, &sc, 4);
+	memcpy(msg + 24, &addr, 8);
+	memcpy(msg + 32, &size, 8);
+	fr_reply = false;
+	bool sent = false;
+	for (unsigned t = 0; t < 200 && !sent; t++) {
+		sent = gl_send(GL_LCID_RPC, msg, 40);
+		if (!sent) {
+			while (gl_rx_one()) {
+			}
+			sl_sleep_ms(5);
+		}
+	}
+	if (!sent) {
+		printf("SWEET SLPI: FastRPC: could not send (handle %u sc %#x)\n", handle, sc);
+		return -1;
+	}
+	for (unsigned t = 0; wait_ms == 0 || t < wait_ms; t++) {   /* 0: until the reply */
+		while (gl_rx_one()) {
+		}
+		if (fr_reply && fr_reply_ctx == ctx) {
+			for (uint32_t i = 0; i < nout; i++) {
+				if (out[i].len) {
+					fr_get(out[i].p, off[nin + i], out[i].len);
+				}
+			}
+			return fr_reply_ret;
+		}
+		if (fr_reply) {
+			printf("SWEET SLPI: FastRPC: reply for ctx %#llx, waiting for %#llx\n", fr_reply_ctx, ctx);
+			fr_reply = false;
+		}
+		sl_sleep_ms(t < 200 ? 1 : 10);  /* a listener call may wait for minutes */
+		if (t >= 200 && wait_ms != 0) {
+			t += 9;
+		}
+	}
+	printf("SWEET SLPI: FastRPC: no reply (handle %u sc %#x) in %u ms\n", handle, sc, wait_ms);
+	return -2;
+}
+
+/* ---- the files the sensor PD asks for (apps_std) ---- */
+
+#define FR_FDS                  16
+#define FR_FILE_MAX             (1024 * 1024)
+static struct {
+	bool used, dir;
+	uint8_t *data;          /* file contents, or "name\0name\0..." for a directory */
+	uint32_t len, pos;
+} fr_fd[FR_FDS];
+
+/* The SLPI's path -> ours (hexagonrpcd's virtual tree: rpcd_builder.c). */
+static bool
+fr_path(const char *dsp, const char *env, char *out, size_t outlen)
+{
+	static const struct {
+		const char *from, *to;
+	} map[] = {
+		{ "/mnt/vendor/persist/sensors", "persist-sensors" },  /* the phone's persist:/sensors */
+		{ "/persist/sensors", "persist-sensors" },
+		{ "/system/vendor/etc/sensors", "vendor-sensors" },    /* vendor:/etc/sensors */
+		{ "/vendor/etc/sensors", "vendor-sensors" },
+		{ "/system/vendor/etc/acdbdata", "acdb" },
+		{ "/vendor/etc/acdbdata", "acdb" },
+		{ "/sys/devices/soc0", "soc0" },                        /* sysfs soc0 as read in TWRP */
+		{ "/usr/lib/qcom/adsp", "adsp" },
+	};
+	char clean[256];
+	size_t j = 0;
+	for (size_t i = 0; dsp[i] && j + 1 < sizeof(clean); i++) {     /* collapse "//", drop a trailing "/" */
+		if (dsp[i] == '/' && j > 0 && clean[j - 1] == '/') {
+			continue;
+		}
+		clean[j++] = dsp[i];
+	}
+	while (j > 1 && clean[j - 1] == '/') {
+		j--;
+	}
+	clean[j] = 0;
+	if (clean[0] != '/') {          /* relative: in the search directory of the environment variable */
+		const char *dir = env != NULL && strcmp(env, "ADSP_AVS_CFG_PATH") == 0 ? "acdb" : "adsp";
+		snprintf(out, outlen, FR_DIR "%s/%s", dir, clean);
+		return true;
+	}
+	for (unsigned k = 0; k < sizeof(map) / sizeof(map[0]); k++) {
+		size_t n = strlen(map[k].from);
+		if (strncmp(clean, map[k].from, n) == 0 && (clean[n] == 0 || clean[n] == '/')) {
+			snprintf(out, outlen, FR_DIR "%s%s", map[k].to, clean + n);
+			return true;
+		}
+	}
+	return false;
+}
+
+static int
+fr_load(const char *path, uint8_t **data, uint32_t *len, bool *dir)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_lookup(path, 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	*dir = vnode_vtype(vp) == VDIR;
+	if (!*dir) {
+		off_t size = 0;
+		err = vnode_size(vp, &size, ctx);
+		if (!err && size > FR_FILE_MAX) {
+			err = EFBIG;
+		}
+		if (!err) {
+			*len = (uint32_t)size;
+			*data = kalloc_data(size ? (vm_size_t)size : 1, Z_WAITOK | Z_ZERO);
+			int resid = 0;
+			err = *data == NULL ? ENOMEM : (size ? vn_rdwr(UIO_READ, vp, (caddr_t)*data, (int)size, 0, UIO_SYSSPACE,
+			    IO_NODELOCKED, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx)) : 0);
+		}
+	} else {
+		uint8_t *names = kalloc_data(16384, Z_WAITOK | Z_ZERO), *buf = kalloc_data(8192, Z_WAITOK);
+		uint32_t used = 0;
+		int eof = 0;
+		off_t off = 0;
+		err = names && buf ? 0 : ENOMEM;
+		while (!err && !eof) {
+			int count = 0;
+			uio_t uio = uio_create(1, off, UIO_SYSSPACE, UIO_READ);
+			uio_addiov(uio, CAST_USER_ADDR_T(buf), 8192);
+			err = VNOP_READDIR(vp, uio, 0, &eof, &count, ctx);
+			size_t got = 8192 - (size_t)uio_resid(uio);
+			off = uio_offset(uio);
+			uio_free(uio);
+			if (err || got == 0) {
+				break;
+			}
+			for (size_t q = 0; q < got;) {
+				struct dirent *de = (struct dirent *)(void *)(buf + q);
+				if (de->d_reclen == 0) {
+					break;
+				}
+				q += de->d_reclen;
+				size_t nl = strlen(de->d_name);
+				if (de->d_ino == 0 || !strcmp(de->d_name, ".") || !strcmp(de->d_name, "..") ||
+				    used + nl + 1 > 16384) {
+					continue;
+				}
+				memcpy(names + used, de->d_name, nl + 1);
+				used += (uint32_t)nl + 1;
+			}
+		}
+		if (buf) {
+			kfree_data(buf, 8192);
+		}
+		*data = names;
+		*len = used;
+	}
+	vnode_put(vp);
+	return err;
+}
