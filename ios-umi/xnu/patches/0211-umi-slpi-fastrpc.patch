+/*
+ * One reverse call (handle, method) with its decoded in-buffers; fills out-buffer sizes
+ * and contents (out[0] = the primary out words). Returns the call's result.
+ */
+static uint32_t
+fr_serve(uint32_t handle, uint32_t sc, struct fr_buf *in, uint32_t nin, uint8_t *outmem, struct fr_buf *out,
+    uint32_t nout)
+{
+	uint32_t method = FR_SC_METHOD(sc), w[8] = { 0 };
+	if (nin > 0 && in[0].len >= 4) {
+		memcpy(w, in[0].p, MIN(in[0].len, (uint32_t)sizeof(w)));
+	}
+	if (method == 31 && nin > 0) {          /* extended method id: the first primary word */
+		method = w[0];
+		memmove(w, w + 1, sizeof(w) - 4);
+	}
+	for (uint32_t i = 0; i < nout; i++) {
+		out[i].p = NULL;
+		out[i].len = 0;
+	}
+	uint8_t *prim = outmem;
+	char path[200];
+	bool log = fr_logged++ < 200;
+	if (handle == FR_HANDLE_REMOTECTL && method == 0 && nin >= 2 && nout >= 2) {      /* open(name) */
+		const char *name = fr_str(&in[1]);
+		uint32_t h = 0, e = 0;
+		if (name != NULL && strcmp(name, "apps_std") == 0) {
+			h = 1;
+		} else {
+			e = (uint32_t)-5;
+		}
+		memcpy(prim, &h, 4);
+		memcpy(prim + 4, &e, 4);
+		out[0].p = prim;
+		out[0].len = 8;
+		out[1].p = outmem + 64;
+		out[1].len = MIN(w[1], 256u);
+		memset(out[1].p, 0, out[1].len);
+		printf("SWEET SLPI: FastRPC <- remotectl open \"%s\" -> %s\n", name ? name : "?", h ? "apps_std" : "refused");
+		return e;
+	}
+	if (handle == FR_HANDLE_REMOTECTL && method == 1 && nout >= 2) {                   /* close */
+		memset(prim, 0, 4);
+		out[0].p = prim;
+		out[0].len = 4;
+		out[1].p = outmem + 64;
+		out[1].len = MIN(w[1], 256u);
+		memset(out[1].p, 0, out[1].len);
+		return 0;
+	}
+	if (handle != 1) {
+		printf("SWEET SLPI: FastRPC <- handle %u method %u: unknown interface\n", handle, method);
+		return AEE_EUNSUPPORTED;
+	}
+	switch (method) {
+	case 2:                                 /* fflush */
+		return 0;
+	case 3:                                 /* fclose */
+		fr_close(w[0]);
+		return 0;
+	case 4: {                               /* fread(fd, size) -> written, eof, data */
+		uint32_t fd = w[0], want = MIN(w[1], 0x10000u), got = 0;
+		if (fd >= FR_FDS || !fr_fd[fd].used || fr_fd[fd].dir || nout < 2) {
+			return AEE_EFAILED;
+		}
+		got = MIN(want, fr_fd[fd].len - MIN(fr_fd[fd].pos, fr_fd[fd].len));
+		out[1].p = outmem + 1024;
+		out[1].len = w[1] <= 0x10000 ? w[1] : 0x10000;
+		memset(out[1].p, 0, out[1].len);
+		memcpy(out[1].p, fr_fd[fd].data + fr_fd[fd].pos, got);
+		fr_fd[fd].pos += got;
+		uint32_t pw[2] = { got, got < w[1] };
+		memcpy(prim, pw, 8);
+		out[0].p = prim;
+		out[0].len = 8;
+		return 0;
+	}
+	case 9: {                               /* fseek(fd, pos, whence) */
+		uint32_t fd = w[0];
+		if (fd >= FR_FDS || !fr_fd[fd].used) {
+			return AEE_EFAILED;
+		}
+		int64_t base = w[2] == 0 ? 0 : w[2] == 1 ? fr_fd[fd].pos : fr_fd[fd].len;
+		int64_t np = base + (int32_t)w[1];
+		if (np < 0 || np > fr_fd[fd].len) {
+			return AEE_EFAILED;
+		}
+		fr_fd[fd].pos = (uint32_t)np;
+		return 0;
+	}
+	case 19: {                              /* fopen_with_env(env, delim, name, mode) -> fd */
+		const char *env = nin >= 5 ? fr_str(&in[1]) : NULL, *name = nin >= 5 ? fr_str(&in[3]) : NULL;
+		const char *mode = nin >= 5 ? fr_str(&in[4]) : NULL;
+		out[0].p = prim;
+		out[0].len = 4;
+		memset(prim, 0, 4);
+		if (name == NULL || mode == NULL) {
+			return AEE_EBADPARM;
+		}
+		if (mode[0] == 'w' || mode[0] == 'a') {
+			if (log) {
+				printf("SWEET SLPI: FastRPC <- fopen \"%s\" \"%s\": writing refused\n", name, mode);
+			}
+			return AEE_EUNSUPPORTED;
+		}
+		int fd = fr_path(name, env, path, sizeof(path)) ? fr_open(path) : -ENOENT;
+		if (log) {
+			printf("SWEET SLPI: FastRPC <- fopen \"%s\" -> %s %d (%u bytes)\n", name, path, fd,
+			    fd > 0 ? fr_fd[fd].len : 0);
+		}
+		if (fd <= 0) {
+			return AEE_EFAILED;
+		}
+		memcpy(prim, &fd, 4);
+		return 0;
+	}
+	case 26: {                              /* opendir(name) -> dir */
+		const char *name = nin >= 2 ? fr_str(&in[1]) : NULL;
+		out[0].p = prim;
+		out[0].len = 8;
+		memset(prim, 0, 8);
+		int fd = name && fr_path(name, NULL, path, sizeof(path)) ? fr_open(path) : -ENOENT;
+		if (log) {
+			printf("SWEET SLPI: FastRPC <- opendir \"%s\" -> %d\n", name ? name : "?", fd);
+		}
+		if (fd <= 0 || !fr_fd[fd].dir) {
+			if (fd > 0) {
+				fr_close((uint32_t)fd);
+			}
+			return AEE_EFAILED;
+		}
+		uint64_t d = (uint64_t)fd;
+		memcpy(prim, &d, 8);
+		return 0;
+	}
+	case 27: {                              /* closedir(dir) */
+		uint64_t d;
+		memcpy(&d, w, 8);
+		fr_close((uint32_t)d);
+		return 0;
+	}
+	case 28: {                              /* readdir(dir) -> inode, name[256], eof */
+		uint64_t d;
+		memcpy(&d, w, 8);
+		memset(prim, 0, 264);
+		out[0].p = prim;
+		out[0].len = 264;
+		if (d >= FR_FDS || !fr_fd[d].used || !fr_fd[d].dir) {
+			return AEE_EFAILED;
+		}
+		if (fr_fd[d].pos < fr_fd[d].len) {
+			const char *nm = (const char *)fr_fd[d].data + fr_fd[d].pos;
+			strlcpy((char *)prim + 4, nm, 256);
+			fr_fd[d].pos += (uint32_t)strlen(nm) + 1;
+		} else {
+			uint32_t one = 1;
+			memcpy(prim + 260, &one, 4);
+		}
+		return 0;
+	}
+	case 31: {                              /* stat(path) */
+		const char *name = nin >= 2 ? fr_str(&in[1]) : NULL;
+		memset(prim, 0, 96);
+		out[0].p = prim;
+		out[0].len = 96;
+		int fd = name && fr_path(name, "ADSP_LIBRARY_PATH", path, sizeof(path)) ? fr_open(path) : -ENOENT;
+		if (log) {
+			printf("SWEET SLPI: FastRPC <- stat \"%s\" -> %d\n", name ? name : "?", fd);
+		}
+		if (fd <= 0) {
+			return AEE_EFAILED;
+		}
+		uint32_t mode = fr_fd[fd].dir ? 0040755 : 0100644, nlink = 1;
+		uint64_t size = fr_fd[fd].dir ? 0 : fr_fd[fd].len;
+		memcpy(prim + 24, &mode, 4);
+		memcpy(prim + 28, &nlink, 4);
+		memcpy(prim + 40, &size, 8);
+		fr_close((uint32_t)fd);
+		return 0;
+	}
+	default:
+		printf("SWEET SLPI: FastRPC <- apps_std method %u (sc %#x): not implemented\n", method, sc);
+		return AEE_EUNSUPPORTED;
+	}
+}
