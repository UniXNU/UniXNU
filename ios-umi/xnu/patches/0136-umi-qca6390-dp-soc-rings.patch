diff --git a/bsd/dev/sweet_wldp.c b/bsd/dev/sweet_wldp.c
new file mode 100644
index 0000000..a1c413c
--- /dev/null
+++ b/bsd/dev/sweet_wldp.c
@@ -0,0 +1,281 @@
+/*
+ * umi QCA6390: SoC-level data-path rings (Linux ath11k v6.6 dp.c ath11k_dp_alloc +
+ * ath11k_dp_pdev_reo_setup, hal.c, hw.c qca6390_regs). Runs after the copy
+ * engines and before WLAN_CFG, as ath11k_core_qmi_firmware_ready does.
+ * Polled, no MSI, no shadow registers: HP/TP go straight to the ring registers.
+ * The table below was generated from the ath11k headers (scratch gen_dp.py):
+ * register groups R0/R2, HAL ring id, entry size in words, entries.
+ * Sizes that differ from ath11k (memory: the window has 8 MiB for everything):
+ * 8192 link descriptors (ath11k 32768), TX completion 1024 (32768),
+ * REO destination 1024 (2048), REO status 512 (2048).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+
+extern void sweet_mhi_info(vm_offset_t *bar0, vm_offset_t *mem, uint32_t *mem_pa, uint32_t *er0_rp);
+extern int sweet_wlfw_ce_mem(vm_offset_t *va, uint32_t *pa, uint32_t *size);
+int sweet_wldp_init(void);
+
+/* Layout in the copy-engine area (sweet_wlce.c uses 0-0x70000; M_RDP at 0 is shared, indexed by ring id) */
+#define M_RDP           0x000000u
+#define M_DP_RINGS      0x080000u       /* up to 0x100000 */
+#define M_DP_LINK       0x100000u       /* link descriptors, 128 bytes each, 1 MiB */
+#define LINK_N          8192u
+#define LINK_SZ         128u
+
+#define UMAC_REO        0x00a38000u
+#define UMAC_TCL        0x00a44000u
+#define RID_WBM_IDLE    104u
+
+/* ath11k_hal_srng_src_hw_init (TCL1 layout) / dst_hw_init (REO1 layout), offsets from R0 */
+#define SRC_BASE_MSB    0x04u
+#define SRC_ID          0x08u
+#define SRC_MISC        0x10u
+#define SRC_TP_ADDR_LSB 0x1cu
+#define SRC_TP_ADDR_MSB 0x20u
+#define SRC_INT_IX0     0x30u
+#define SRC_INT_IX1     0x34u
+#define DST_BASE_MSB    0x04u
+#define DST_ID          0x08u
+#define DST_MISC        0x10u
+#define DST_HP_ADDR_LSB 0x14u
+#define DST_HP_ADDR_MSB 0x18u
+#define DST_INT         0x24u
+#define MISC_LOOPCNT_DISABLE    (1u << 1)
+#define MISC_SRNG_ENABLE        (1u << 6)
+
+struct dpring {
+	const char *name;
+	uint32_t r0, r2, id, esz, n;
+	bool src;
+	uint32_t int0;                  /* interrupt setup word as ath11k_dp_srng_setup would program it */
+	uint32_t off, pa, hp;
+};
+
+/* generated by gen_dp.py from ath11k v6.6 hal.h/hal_desc.h/dp.h/hw.c (qca6390); sizes adjusted above */
+static struct dpring dp_rings[] = {
+	{ "wbm_idle", 0xa34860, 0xa370b0, 104, 2, LINK_N, true, 0x01000002 },
+	{ "sw2wbm_rel", 0xa341d8, 0xa37018, 105, 8, 64, true, 0x01000008 },
+	{ "tcl_cmd", 0xa4478c, 0xa46018, 24, 8, 32, true, 0x01000008 },
+	{ "tcl_status", 0xa44894, 0xa46030, 25, 9, 32, false, 0x00200009 },
+	{ "tcl_data0", 0xa44684, 0xa46000, 16, 8, 512, true, 0x01000008 },
+	{ "tx_comp0", 0xa34910, 0xa370c0, 106, 8, 1024, false, 0x007d0800 },
+	{ "reo_reinject", 0xa381ec, 0xa3b028, 5, 8, 32, true, 0x01000008 },
+	{ "rx_rel", 0xa34a18, 0xa370d8, 109, 8, 1024, false, 0x00200008 },
+	{ "reo_except", 0xa383a4, 0xa3b050, 4, 16, 128, false, 0x00200010 },
+	{ "reo_cmd", 0xa38194, 0xa3b020, 8, 10, 256, true, 0x0100000a },
+	{ "reo_status", 0xa384ac, 0xa3b068, 9, 26, 512, false, 0x0020001a },
+	{ "reo_dst0", 0xa38244, 0xa3b030, 0, 16, 1024, false, 0x003e0800 },
+	{ "reo_dst1", 0xa3829c, 0xa3b038, 1, 16, 1024, false, 0x003e0800 },
+	{ "reo_dst2", 0xa382f4, 0xa3b040, 2, 16, 1024, false, 0x003e0800 },
+	{ "reo_dst3", 0xa3834c, 0xa3b048, 3, 16, 1024, false, 0x003e0800 },
+};
+#define DP_NRING        (sizeof(dp_rings) / sizeof(dp_rings[0]))
+
+static struct {
+	vm_offset_t bar0, mem;
+	uint32_t pa;
+} dp;
+
+static uint32_t
+rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(dp.bar0 + off);
+}
+
+static void
+wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(dp.bar0 + off) = v;
+}
+
+/* PCIe register window (ath11k_pci_window_read32/write32), as sweet_wlce.c */
+static uint32_t
+reg_rd(uint32_t off)
+{
+	wr(0x310cu, 0x40000000u | ((off >> 19) & 0x3fu));
+	(void)rd(0x310cu);
+	return rd(0x80000u + (off & 0x7ffffu));
+}
+
+static void
+reg_wr(uint32_t off, uint32_t v)
+{
+	wr(0x310cu, 0x40000000u | ((off >> 19) & 0x3fu));
+	(void)rd(0x310cu);
+	wr(0x80000u + (off & 0x7ffffu), v);
+}
+
+static volatile uint32_t *
+mem32(uint32_t off)
+{
+	return (volatile uint32_t *)(dp.mem + off);
+}
+
+/*
+ * ath11k_hal_srng_setup + src/dst_hw_init. The WBM idle-link ring has no TP
+ * address (the hardware keeps its own); ath11k writes its base twice, which
+ * is the same as once.
+ */
+static void
+dp_ring_hw_init(struct dpring *r)
+{
+	uint32_t words = r->n * r->esz, rdp = dp.pa + M_RDP + r->id * 4;
+	bzero((void *)(dp.mem + r->off), words * 4);
+	*mem32(M_RDP + r->id * 4) = 0;
+	r->hp = 0;
+	reg_wr(r->r0, r->pa);
+	reg_wr(r->r0 + SRC_BASE_MSB, words << 8);       /* ring size in words, address bits 39:32 = 0 */
+	if (r->src) {
+		reg_wr(r->r0 + SRC_ID, r->esz);
+		reg_wr(r->r0 + SRC_INT_IX0, r->int0);
+		reg_wr(r->r0 + SRC_INT_IX1, 0);
+		if (r->id != RID_WBM_IDLE) {
+			reg_wr(r->r0 + SRC_TP_ADDR_LSB, rdp);
+			reg_wr(r->r0 + SRC_TP_ADDR_MSB, 0);
+		}
+		reg_wr(r->r2, 0);
+		reg_wr(r->r2 + 4, 0);
+		reg_wr(r->r0 + SRC_MISC, MISC_LOOPCNT_DISABLE | MISC_SRNG_ENABLE);
+	} else {
+		reg_wr(r->r0 + DST_ID, r->id << 8 | r->esz);
+		reg_wr(r->r0 + DST_INT, r->int0);
+		reg_wr(r->r0 + DST_HP_ADDR_LSB, rdp);
+		reg_wr(r->r0 + DST_HP_ADDR_MSB, 0);
+		reg_wr(r->r2, 0);
+		reg_wr(r->r2 + 4, 0);
+		reg_wr(r->r0 + DST_MISC, MISC_SRNG_ENABLE);
+	}
+}
+
+/*
+ * ath11k_dp_link_desc_setup, one bank (1 MiB < DP_LINK_DESC_ALLOC_SIZE_THRESH,
+ * and the idle list itself is small, so no scatter list): every link
+ * descriptor's address goes into the WBM idle ring as buffer_addr_info
+ * {info0 address 31:0; info1 39:32, return buffer manager 1 (bits 10:8),
+ * cookie = bank 0 (bits 31:11)} (ath11k_hal_set_link_desc_addr). A source
+ * ring takes n - 1 entries.
+ */
+static uint32_t
+dp_link_desc_fill(struct dpring *r)
+{
+	uint32_t i;
+	bzero((void *)(dp.mem + M_DP_LINK), LINK_N * LINK_SZ);
+	for (i = 0; i + 1 < r->n; ++i) {
+		volatile uint32_t *d = mem32(r->off + r->hp * 4);
+		d[0] = dp.pa + M_DP_LINK + i * LINK_SZ;
+		d[1] = 1u << 8;
+		r->hp = (r->hp + r->esz) % (r->n * r->esz);
+	}
+	reg_wr(r->r2, r->hp);
+	return i;
+}
+
+/* ath11k_hal_tx_init_data_ring: every TCL data entry starts with TLV tag HAL_TCL_DATA_CMD 0x144, length 28 */
+static void
+dp_tcl_data_init(struct dpring *r)
+{
+	for (uint32_t i = 0; i < r->n; ++i) {
+		*mem32(r->off + i * r->esz * 4) = 0x144u << 1 | 28u << 10;
+	}
+}
+
+/* ath11k_hal_reo_init_cmd_ring: command numbers 1..n in each entry's hal_reo_cmd_hdr (after the TLV) */
+static void
+dp_reo_cmd_init(struct dpring *r)
+{
+	for (uint32_t i = 0; i < r->n; ++i) {
+		*mem32(r->off + i * r->esz * 4 + 4) = (i + 1) & 0xffffu;
+	}
+}
+
+/*
+ * ath11k_hw_ipq8074_reo_setup (qca6390_ops.reo_setup): fragment destination
+ * REO2SW1, aging list + flush on, aging thresholds 40 ms, hash routing over
+ * SW1-SW4 in DEST_RING_CTRL_IX_0..3 (bits 31:8).
+ */
+static void
+dp_reo_setup(void)
+{
+	uint32_t map = 1u << 0 | 2u << 3 | 3u << 6 | 4u << 9 | 1u << 12 | 2u << 15 | 3u << 18 | 4u << 21;
+	uint32_t v = reg_rd(UMAC_REO + 0x0);
+	v &= ~0x3800000u;               /* FRAG_DST_RING = REO2SW1 (0) */
+	v |= 0x4u | 0x8u;               /* AGING_LIST_ENABLE, AGING_FLUSH_ENABLE */
+	reg_wr(UMAC_REO + 0x0, v);
+	for (uint32_t i = 0; i < 4; ++i) {
+		reg_wr(UMAC_REO + 0x50c + 4 * i, 40000);        /* hal_reo1_aging_thresh_ix_0..3 */
+		reg_wr(UMAC_REO + 0x4 + 4 * i, map << 8);       /* HAL_REO1_DEST_RING_CTRL_IX_0..3 */
+	}
+}
+
+/*
+ * ath11k_hal_tx_set_dscp_tid_map for all 48 tables: TID = DSCP >> 3, three
+ * bits per DSCP, 24 bytes per table at TCL + 0x2c, written with the CMN_CTRL
+ * (TCL + 0x14) bit 17 programming enable set.
+ */
+static void
+dp_dscp_tid_maps(void)
+{
+	uint8_t t[24];
+	for (unsigned g = 0; g < 8; ++g) {
+		uint32_t v = g * 0x249249u;     /* eight DSCPs of TID g, 3 bits each */
+		memcpy(&t[g * 3], &v, 3);
+	}
+	uint32_t ctrl = reg_rd(UMAC_TCL + 0x14);
+	reg_wr(UMAC_TCL + 0x14, ctrl | 0x20000u);
+	for (unsigned id = 0; id < 48; ++id) {
+		for (unsigned w = 0; w < 6; ++w) {
+			uint32_t x;
+			memcpy(&x, &t[w * 4], 4);
+			reg_wr(UMAC_TCL + 0x2c + id * 24 + w * 4, x);
+		}
+	}
+	reg_wr(UMAC_TCL + 0x14, reg_rd(UMAC_TCL + 0x14) & ~0x20000u);
+}
+
+/* Before WLAN_CFG: all SoC-level DP rings, link descriptors, REO setup, DSCP maps, REO destination rings. */
+int
+sweet_wldp_init(void)
+{
+	vm_offset_t mem;
+	uint32_t pa, size, er0, off = M_DP_RINGS, nlink = 0;
+	sweet_mhi_info(&dp.bar0, &mem, &pa, &er0);
+	if (dp.bar0 == 0 || sweet_wlfw_ce_mem(&dp.mem, &dp.pa, &size) != 0 || size < M_DP_LINK + LINK_N * LINK_SZ) {
+		return ENXIO;
+	}
+	for (unsigned i = 0; i < DP_NRING; ++i) {
+		struct dpring *r = &dp_rings[i];
+		r->off = off;
+		r->pa = dp.pa + off;
+		off = (off + r->n * r->esz * 4 + 0xffu) & ~0xffu;
+		if (off > M_DP_LINK) {
+			printf("SWEET WLDP: rings do not fit (%s ends at %#x)\n", r->name, off);
+			return ENOMEM;
+		}
+		dp_ring_hw_init(r);
+		if (r->id == RID_WBM_IDLE) {
+			nlink = dp_link_desc_fill(r);
+		} else if (r->id == 16) {
+			dp_tcl_data_init(r);
+		} else if (r->id == 8) {
+			dp_reo_cmd_init(r);
+		}
+	}
+	dp_reo_setup();
+	dp_dscp_tid_maps();
+	unsigned bad = 0;
+	for (unsigned i = 0; i < DP_NRING; ++i) {
+		uint32_t b = reg_rd(dp_rings[i].r0);
+		if (b != dp_rings[i].pa) {
+			printf("SWEET WLDP: %s base reads %#x, wrote %#x\n", dp_rings[i].name, b, dp_rings[i].pa);
+			bad++;
+		}
+	}
+	printf("SWEET WLDP: %u rings at %#x-%#x, %u link descriptors at %#x, idle HP %u, REO gen %#x, %u bad\n",
+	    (unsigned)DP_NRING, dp.pa + M_DP_RINGS, dp.pa + off, nlink, dp.pa + M_DP_LINK,
+	    reg_rd(dp_rings[0].r2), reg_rd(UMAC_REO + 0x0), bad);
+	return bad ? EIO : 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_wlfw.c b/bsd/dev/sweet_wlfw.c
index ced01cc..a06501f 100644
--- a/bsd/dev/sweet_wlfw.c
+++ b/bsd/dev/sweet_wlfw.c
@@ -23,6 +23,7 @@ extern void sweet_ipcr_service(unsigned ms);
 extern int sweet_wlan_read_file(const char *name, void *dst, uint32_t max, uint32_t *size);
 extern int sweet_wlce_init(void);
 extern int sweet_wlce_htc(void);
+extern int sweet_wldp_init(void);
 void sweet_wlfw_rx(const uint8_t *qmi, uint32_t len);
 int sweet_wlfw_run(void);
 
@@ -613,7 +614,7 @@ wf_firmware_start(void)
 	return 0;
 }
 
-/* Stage 8, after sweet_ipcr_start found WLFW. 0, or the step (1-29) that failed. */
+/* Stage 8, after sweet_ipcr_start found WLFW. 0, or the step (1-30) that failed (30 = DP rings). */
 int
 sweet_wlfw_run(void)
 {
@@ -652,6 +653,9 @@ sweet_wlfw_run(void)
 	if (sweet_wlce_init() != 0) {   /* copy-engine rings before WLAN_CFG, as ath11k */
 		return 13;
 	}
+	if (sweet_wldp_init() != 0) {   /* data-path rings: ath11k_dp_alloc, also before WLAN_CFG */
+		return 30;
+	}
 	int r = wf_firmware_start();
 	if (r != 0) {
 		return r;
