  */
 extern int sweet_rename_path(const char *from, const char *to);   /* vfs_syscalls.c */
+extern void sweet_ls_reset(void);                                  /* vfs_syscalls.c, sweetlsreset=1 */
 
 static void
 sweet_mg_reset(void)
