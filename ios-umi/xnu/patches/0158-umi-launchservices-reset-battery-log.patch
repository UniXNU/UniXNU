+	fLastState = ~0u;
 	return true;
 }
 
@@ -158,6 +160,12 @@ SweetBattery::publish(unsigned percent, unsigned mv, int ma, bool external,
 	}
 	updateStatus(); /* Flush PS properties and send 0xe0024100 on change. */
 	int mode = measured ? 1 : 0;
+	unsigned state = percent | (external ? 0x100u : 0) | (charging ? 0x200u : 0) | (full ? 0x400u : 0);
+	if (mode == fLastMode && state != fLastState) {
