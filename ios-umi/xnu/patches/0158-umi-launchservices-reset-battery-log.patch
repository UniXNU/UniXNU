diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
index bf1c467..842ea3b 100644
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -8936,6 +8936,122 @@ sweet_rename_path(const char *from, const char *to)
 	return renameat_internal(vfs_context_kernel(), AT_FDCWD, CAST_USER_ADDR_T(from),
 	           AT_FDCWD, CAST_USER_ADDR_T(to), UIO_SYSSPACE, 0);
 }
+
+/*
+ * Names in directory path (not "." / ".."), each at most len - 1 bytes, into out[max][len];
+ * only directories when dirs_only. Returns the count, or -errno.
+ */
+static int
+sweet_dir_names(const char *path, bool dirs_only, char *out, int max, int len)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	const size_t bufsize = 8192;
+	char uio_buf[UIO_SIZEOF(1)];
+	int count = 0, eof = 0, error;
+
+	if ((error = vnode_lookup(path, 0, &vp, ctx)) != 0) {
+		return -error;
+	}
+	if (!vnode_isdir(vp)) {
+		vnode_put(vp);
+		return -ENOTDIR;
+	}
+	char *buf = kalloc_data(bufsize, Z_WAITOK);
+	off_t off = 0;
+	while (buf != NULL && !eof && count < max) {
+		int n = 0;
+		uio_t auio = uio_createwithbuffer(1, off, UIO_SYSSPACE, UIO_READ, &uio_buf[0], sizeof(uio_buf));
+		uio_addiov(auio, CAST_USER_ADDR_T(buf), bufsize);
+		if ((error = VNOP_READDIR(vp, auio, 0, &eof, &n, ctx)) != 0) {
+			break;
+		}
+		size_t got = bufsize - (size_t)uio_resid(auio);
+		if (got == 0) {
+			break;
+		}
+		off = uio_offset(auio);
+		for (size_t at = 0; at + offsetof(struct dirent, d_name) < got && count < max;) {
+			struct dirent *dep = (struct dirent *)(void *)(buf + at);
+			if (dep->d_reclen == 0) {
+				break;
+			}
+			at += dep->d_reclen;
+			if (dep->d_ino == 0 || dep->d_namlen == 0 || dep->d_namlen >= len ||
+			    (dirs_only && dep->d_type != DT_DIR) ||
+			    strcmp(dep->d_name, ".") == 0 || strcmp(dep->d_name, "..") == 0) {
+				continue;
+			}
+			strlcpy(out + count * len, dep->d_name, len);
+			count++;
+		}
+	}
+	if (buf != NULL) {
+		kfree_data(buf, bufsize);
+	}
+	vnode_put(vp);
+	return error ? -error : count;
+}
+
+/*
+ * Boot-arg sweetlsreset=1 (kern_exec.c, when launchd starts): rename LaunchServices' database
+ * (InternalDaemon/<container>/Library/Caches/com.apple.LaunchServices*) to *.sweet-old, so lsd
+ * seeds a new one. A database seeded while app extensions failed validation is kept forever
+ * (flagged seeded + complete) and lists none of them: the wallpaper picker stays empty.
+ */
+void
+sweet_ls_reset(void)
+{
+	static const char base[] = "/private/var/mobile/Containers/Data/InternalDaemon";
+	static const char prefix[] = "com.apple.LaunchServices";
+	const int ndirs = 64, dlen = 64, nfiles = 16, flen = 128, plen = 512;
+	uint32_t on = 0;
+
+	if (!PE_parse_boot_argn("sweetlsreset", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	char *dirs = kalloc_data(ndirs * dlen, Z_WAITOK);
+	char *files = kalloc_data(nfiles * flen, Z_WAITOK);
+	char *from = kalloc_data(plen, Z_WAITOK);
+	char *to = kalloc_data(plen, Z_WAITOK);
+	if (dirs == NULL || files == NULL || from == NULL || to == NULL) {
+		goto out;
+	}
+	int nd = sweet_dir_names(base, true, dirs, ndirs, dlen);
+	printf("SWEET LS: %s: %d containers\n", base, nd);
+	int moved = 0;
+	for (int d = 0; d < nd; d++) {
+		snprintf(from, plen, "%s/%s/Library/Caches", base, dirs + d * dlen);
+		int nf = sweet_dir_names(from, false, files, nfiles, flen);
+		for (int f = 0; f < nf; f++) {
+			const char *name = files + f * flen;
+			size_t nl = strlen(name);
+			if (strncmp(name, prefix, sizeof(prefix) - 1) != 0 ||
+			    (nl > 10 && strcmp(name + nl - 10, ".sweet-old") == 0)) {
+				continue;
+			}
+			snprintf(from, plen, "%s/%s/Library/Caches/%s", base, dirs + d * dlen, name);
+			snprintf(to, plen, "%s.sweet-old", from);
+			int r = sweet_rename_path(from, to);
+			printf("SWEET LS: %s/.../%s moved aside: %d\n", dirs + d * dlen, name, r);
+			moved += r == 0;
+		}
+	}
+	printf("SWEET LS: %d LaunchServices files moved aside\n", moved);
+out:
+	if (dirs != NULL) {
+		kfree_data(dirs, ndirs * dlen);
+	}
+	if (files != NULL) {
+		kfree_data(files, nfiles * flen);
+	}
+	if (from != NULL) {
+		kfree_data(from, plen);
+	}
+	if (to != NULL) {
+		kfree_data(to, plen);
+	}
+}
 #endif
 
