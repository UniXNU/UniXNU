+		    external, charging, full);
+	}
+	fLastState = state;
 	if (mode != fLastMode) {
 		IOLog("SWEET BATTERY: %s, %u%% %umV external=%d charging=%d\n",
 		    measured ? (fUmi ? "PM8150B fuel gauge SOC" : "PM6150 / estimated SOC") : "static fallback",
@@ -310,7 +318,7 @@ SweetBattery::timerFired(OSObject *owner, IOTimerEventSource *sender)
 	SweetBattery *self = OSDynamicCast(SweetBattery, owner);
 	if (self && self->fRunning) {
 		self->poll();
-		sender->setTimeoutMS(30000);
+		sender->setTimeoutMS(self->fUmi ? 10000 : 30000);
 	}
 }
 
@@ -332,7 +340,7 @@ SweetBattery::start(IOService *provider)
 		if (fLoop && fTimer && fLoop->addEventSource(fTimer) == kIOReturnSuccess) {
 			fTimerAdded = true;
 			fRunning = true;
-			fTimer->setTimeoutMS(30000);
+			fTimer->setTimeoutMS(fUmi ? 10000 : 30000);
 		} else {
 			fReal = false;
 			poll();
