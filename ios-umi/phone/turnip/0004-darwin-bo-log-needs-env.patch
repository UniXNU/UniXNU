Gate the BO lifetime log (0002) behind TU_DARWIN_BO_LOG=1 as well as /var/local/tu-bo: the kernel file server
cannot remove that directory, and the log's fprintf crashed com.apple.WebKit.GPU (SIGSEGV, darwin_bo_finish+216,
2026-11-05). Also stops an fflush per BO allocation/free in backboardd.

--- a/src/freedreno/vulkan/tu_knl_darwin.cc
+++ b/src/freedreno/vulkan/tu_knl_darwin.cc
@@ -62,7 +62,9 @@
 static void
 dw_bo_open(void)
 {
-   if (access("/var/local/tu-bo", F_OK) == 0) {
+   /* (2026-11-05) also needs TU_DARWIN_BO_LOG=1 (/var/local/mtl2-env): /var/local/tu-bo cannot be removed by the
+    * kernel file server, and this log's fprintf crashed com.apple.WebKit.GPU (SIGSEGV in darwin_bo_finish+216). */
+   if (debug_get_bool_option("TU_DARWIN_BO_LOG", false) && access("/var/local/tu-bo", F_OK) == 0) {
       char path[64];
       snprintf(path, sizeof(path), "/var/local/tu-bo-%d.log", (int)getpid());
       dw_bo_file = fopen(path, "a");
