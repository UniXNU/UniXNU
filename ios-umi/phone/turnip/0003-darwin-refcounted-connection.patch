+
+/* One connection per process, shared by every tu_device in it and counted (umi 0196). The kernel
+ * client owns the BOs: closing it frees and unmaps all of them. The enumeration probe used to open
+ * and close the connection unconditionally and every device_finish closed it, so a second Vulkan
+ * instance or a short-lived device in backboardd/SpringBoard closed the connection under a live
+ * device; the reopened client got the same window and handles from 1 again, the live device's old
+ * handles then named the new client's BOs (BoFree/BoMap on the wrong BO: GPU page tables pointing
+ * at another BO's pages, the CP_OPCODE_ERROR hangs). Now the probe reuses an open connection, and
+ * only the last device's finish closes it. */
+static pthread_mutex_t dw_conn_lock = PTHREAD_MUTEX_INITIALIZER;
+static unsigned dw_devices;
+
+static VkResult
+dw_open_connection(struct tu_instance *instance)
+{
+   pthread_mutex_lock(&dw_conn_lock);
+   VkResult result = dw.open ? VK_SUCCESS : dw_open_connection_raw(instance);
+   pthread_mutex_unlock(&dw_conn_lock);
+   return result;
+}
+
+/* The probe's close: only when no device uses the connection. */
+static void
+dw_close_connection(void)
+{
+   pthread_mutex_lock(&dw_conn_lock);
+   if (dw_devices == 0)
+      dw_close_connection_raw();
+   pthread_mutex_unlock(&dw_conn_lock);
+}
+
+static VkResult
+dw_device_acquire(struct tu_instance *instance)
+{
+   pthread_mutex_lock(&dw_conn_lock);
+   VkResult result = dw.open ? VK_SUCCESS : dw_open_connection_raw(instance);
+   if (result == VK_SUCCESS)
+      dw_devices++;
+   pthread_mutex_unlock(&dw_conn_lock);
+   return result;
 }
 
+static void
+dw_device_release(void)
+{
+   pthread_mutex_lock(&dw_conn_lock);
+   if (dw_devices > 0 && --dw_devices == 0)
+      dw_close_connection_raw();
+   pthread_mutex_unlock(&dw_conn_lock);
+}
 
