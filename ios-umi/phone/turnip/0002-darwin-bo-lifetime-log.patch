+/* BO lifetime log (umi hang hunt): /var/local/tu-bo-<pid>.log, one line per allocation and per
+ * release, with the newest fence this process submitted then. A hang's freed range (the kernel's
+ * free history) maps to the BO's name here: which object was freed while a command buffer still
+ * called into it. Only when /var/local/tu-bo exists. */
+static FILE *dw_bo_file;
+static once_flag dw_bo_once = ONCE_FLAG_INIT;
+
+static void
+dw_bo_open(void)
+{
+   if (access("/var/local/tu-bo", F_OK) == 0) {
+      char path[64];
+      snprintf(path, sizeof(path), "/var/local/tu-bo-%d.log", (int)getpid());
+      dw_bo_file = fopen(path, "a");
+   }
+}
+
+static void
+dw_bo_log(const char *what, const char *name, uint64_t handle, uint64_t iova, uint64_t size)
+{
+   call_once(&dw_bo_once, dw_bo_open);
+   if (!dw_bo_file)
+      return;
+   fprintf(dw_bo_file, "%llu %s %s h%llu %#llx+%#llx fence %u\n",
+           (unsigned long long)(os_time_get_nano() / 1000000), what, name ? name : "?",
+           (unsigned long long)handle, (unsigned long long)iova, (unsigned long long)size,
+           dw.last_fence);
+   fflush(dw_bo_file);
+}
+
 /* Preserve the native handle, CPU view and IOVA until the captured ring fence
  * actually completed. An unrelated later submission never extends this lease.
  * The queue is bounded; pressure may wait, but ordinary destruction does not. */
