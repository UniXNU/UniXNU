+// Board bring-up: a system service the original AMFI gates on a platform binary is refused with "Launch Constraint
+// Violation" when the binary is an App cryptex daemon or an owner-trusted one, although its signature and trust-cache
+// entry are valid: the constraint category of an owner or cryptex binary is not the platform one. The original release
+// AMFI ignores its own amfi_* boot arguments, so the check is cleared here when the board asks for it. An option of the
+// instrumented board only: the boot argument, not the default, decides.
 int
 mac_proc_check_launch_constraints(proc_t curp, struct image_params *imgp, os_reason_t *reasonp)
 {
+	uint32_t skip = 0;
+	if (PE_parse_boot_argn("no-lc", &skip, sizeof(skip)) && skip != 0) {
+		return 0;
+	}
 	char *fatal_failure_desc = NULL;
 	size_t fatal_failure_desc_len = 0;
 
