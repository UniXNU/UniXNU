+
+/* How render passes were rendered, for the process's telemetry (tu_render_mode_stats): [0] GMEM passes, [1] their thousands of
+ * pixels, [2] SYSMEM passes the autotuner chose, [3] their thousands of pixels, [4] SYSMEM passes for any other reason, [5] their
+ * thousands of pixels, [6] GMEM passes with an attachment loaded or stored over its texels alone (tu_attachment_unpadded).
+ */
+static uint64_t tu_render_mode_counts[8];
+
+static void
+tu_note_render_mode(struct tu_cmd_buffer *cmd, bool sysmem)
+{
+   const VkExtent2D extent = cmd->state.render_areas[0].extent;
+   const uint64_t kpx = (uint64_t) extent.width * extent.height / 1000;
+   const char *reason = cmd->state.rp.gmem_disable_reason;
+   const unsigned slot =
+      !sysmem ? 0 : reason && !strcmp(reason, "Autotune selected sysmem") ? 2 : 4;
+   p_atomic_inc(&tu_render_mode_counts[slot]);
+   p_atomic_add(&tu_render_mode_counts[slot + 1], kpx);
+   if (sysmem)
+      return;
+   for (unsigned i = 0; i < cmd->state.pass->attachment_count; i++) {
+      const struct tu_image_view *iview = cmd->state.attachments[i];
+      if (iview && tu_attachment_unpadded(cmd, iview)) {
+         p_atomic_inc(&tu_render_mode_counts[6]);
+         break;
+      }
+   }
+}
+
+extern "C" __attribute__((visibility("default"))) void tu_render_mode_stats(uint64_t out[8]);
+extern "C" __attribute__((visibility("default"))) void
+tu_render_mode_stats(uint64_t out[8])
+{
+   for (unsigned i = 0; i < 8; i++)
+      out[i] = p_atomic_read(&tu_render_mode_counts[i]);
 }
 
