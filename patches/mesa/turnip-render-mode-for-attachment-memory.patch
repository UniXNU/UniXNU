+
+/* A linear attachment over memory imported from a host pointer (an IOSurface's pages) or laid out by its owner (an explicit DRM
+ * format modifier layout, whose pitch fdl6_layout aligns to 64 bytes alone) has no padding past its edges: its rows are as tight
+ * as their owner made them and its last row may end the memory. GMEM loads and stores by blit events move whole gmem_align_w x
+ * gmem_align_h blocks, so such an attachment whose size is not whole blocks is loaded and stored by draws and 2D blits over its
+ * texels alone, and still renders in GMEM.
+ */
+bool
+tu_attachment_unpadded(struct tu_cmd_buffer *cmd, const struct tu_image_view *iview)
+{
+   const struct fd_dev_info *info = cmd->device->physical_device->info;
+   const struct fdl_layout *layout = &iview->image->layout[0];
+   if (layout->tile_mode != TILE6_LINEAR ||
+       !(iview->image->vk.tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT ||
+         (iview->image->vk.external_handle_types &
+          (VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT |
+           VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_MAPPED_FOREIGN_MEMORY_BIT_EXT))))
+      return false;
+   /* A blit event's blocks reach up to gmem_align_w - 1 texels past a row's last one and up to gmem_align_h - 1 rows past
+    * the last row. Rows whose pitch holds the width rounded up to a block take that reach in their own padding (a surface
+    * 3048 texels wide with 64-byte rows has 8 texels of it), so only a height that is not whole blocks, or a pitch tighter
+    * than that, needs the draws and 2D blits: a screen-size surface otherwise paid a shaded load and a 2D store per pass.
+    */
+   const uint32_t level = iview->vk.base_mip_level;
+   const uint32_t reach = ALIGN_POT(iview->view.width, info->gmem_align_w) * layout->cpp;
+   return iview->view.height % info->gmem_align_h || reach > fdl_pitch(layout, level);
 }
 
