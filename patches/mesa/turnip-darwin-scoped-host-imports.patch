+struct darwin_host_import_entry {
+   struct tu_device *dev;
+   uintptr_t base;
+   uint64_t size;
+   uint64_t handle;
+   uint32_t permissions;
+};
+static pthread_mutex_t darwin_host_imports_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct darwin_host_import_entry *darwin_host_imports;
+static unsigned darwin_host_import_count, darwin_host_import_capacity;
+
+static void
+darwin_host_import_register(struct tu_device *dev, void *pointer, uint64_t size, uint64_t handle, uint32_t permissions)
+{
+   pthread_mutex_lock(&darwin_host_imports_lock);
+   if (darwin_host_import_count == darwin_host_import_capacity) {
+      const unsigned cap = darwin_host_import_capacity ? darwin_host_import_capacity * 2 : 64;
+      struct darwin_host_import_entry *grown = (struct darwin_host_import_entry *)
+         realloc(darwin_host_imports, cap * sizeof(*grown));
+      if (grown) {
+         darwin_host_imports = grown;
+         darwin_host_import_capacity = cap;
+      }
+   }
+   if (darwin_host_import_count < darwin_host_import_capacity) {
+      darwin_host_imports[darwin_host_import_count++] = {
+         dev, (uintptr_t)pointer, size, handle, permissions,
+      };
+   }
+   pthread_mutex_unlock(&darwin_host_imports_lock);
+}
+
+static void
+darwin_host_import_unregister(struct tu_device *dev, uint64_t handle)
+{
+   pthread_mutex_lock(&darwin_host_imports_lock);
+   for (unsigned i = darwin_host_import_count; i-- > 0;) {
+      if (darwin_host_imports[i].dev == dev && darwin_host_imports[i].handle == handle) {
+         darwin_host_imports[i] = darwin_host_imports[--darwin_host_import_count];
+         break;
+      }
+   }
+   pthread_mutex_unlock(&darwin_host_imports_lock);
+}
+
+static void
+darwin_host_import_purge_device(struct tu_device *dev)
+{
+   pthread_mutex_lock(&darwin_host_imports_lock);
+   for (unsigned i = darwin_host_import_count; i-- > 0;) {
+      if (darwin_host_imports[i].dev == dev)
+         darwin_host_imports[i] = darwin_host_imports[--darwin_host_import_count];
+   }
+   pthread_mutex_unlock(&darwin_host_imports_lock);
+}
