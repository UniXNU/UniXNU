+static thread_local char tu_thread_render_mode;
+extern "C" __attribute__((visibility("default"))) void tu_sheng_set_thread_render_mode(char mode);
+extern "C" __attribute__((visibility("default"))) void
+tu_sheng_set_thread_render_mode(char mode)
+{
+   tu_thread_render_mode = mode;
+}
