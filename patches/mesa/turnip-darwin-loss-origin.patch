-dw_status_to_vk(struct tu_device *dev, kern_return_t kr, const char *what)
+/* The first failing operation must survive logical-device recovery and the
+ * render server's exit. This uses the existing text transport, not another GPU
+ * query while the failing path may hold a retirement or submission lock. */
+static VkResult
+dw_device_lost_at(struct tu_device *dev, unsigned line, const char *format, ...)
+{
+   char reason[224];
+   va_list args;
+   va_start(args, format);
+   vsnprintf(reason, sizeof(reason), format, args);
+   va_end(args);
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   if (retire && p_atomic_cmpxchg(&retire->loss_reported, 0, 1) == 0) {
+      char text[352];
+      snprintf(text, sizeof(text), "darwin first-loss pid=%d dev=%p line=%u: %s",
+               getpid(), (void *)dev, line, reason);
+      os_log_error(OS_LOG_DEFAULT, "%{public}s", text);
+      if (getenv("SHENG_GPU_TRACE")) {
+         struct { uint64_t sequence, us; uint32_t event, pid; uint64_t value[12]; } record = {};
+         static_assert(sizeof(record) == 120, "GPU trace record ABI");
+         record.event = 65;
+         /* Each part is zero-padded and bounded by the existing text-record ABI. */
+         for (size_t part = 0; part * 88 < strlen(text); ++part) {
+            record.value[0] = part;
+            memset(&record.value[1], 0, 88);
+            memcpy(&record.value[1], text + part * 88, MIN2(strlen(text) - part * 88, 88));
+            (void)tu_darwin_frame_diagnostic(0x7102, &record, sizeof(record));
+         }
+      }
+   }
+   return vk_device_set_lost(&dev->vk, "%s", reason);
+}
+#define dw_device_lost(dev, ...) dw_device_lost_at(dev, __LINE__, __VA_ARGS__)
+
+static VkResult
