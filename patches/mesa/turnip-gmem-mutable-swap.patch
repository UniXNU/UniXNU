+static uint32_t
+tu_note_pass(struct tu_cmd_buffer *cmd, bool sysmem, unsigned slot, uint64_t kpx)
+{
+   struct tu_pass_rec rec = {};
+   const VkExtent2D extent = cmd->state.render_areas[0].extent;
+   rec.ns = tu_trace_clock_ns();
+   rec.width = extent.width;
+   rec.height = extent.height;
+   rec.mode = !sysmem ? 0 : slot == 2 ? 1 : 2;
+   rec.draws = MIN2(cmd->state.rp.drawcall_count, 0xffff);
+   rec.kpx = kpx;
+   rec.flags = cmd->state.pass->has_fdm ? 32 : 0;
+   const struct tu_subpass *subpass = &cmd->state.pass->subpasses[0];
+   rec.colors = subpass->color_count;
+   for (uint32_t i = 0; i < subpass->color_count; i++) {
+      const uint32_t a = subpass->color_attachments[i].attachment;
+      if (a == VK_ATTACHMENT_UNUSED || !cmd->state.attachments[a])
+         continue;
+      const struct tu_image_view *iview = cmd->state.attachments[a];
+      const struct tu_render_pass_attachment *att = &cmd->state.pass->attachments[a];
+      rec.format = (uint16_t) iview->vk.format;
+      rec.swap = iview->view.color_swap;
+      rec.flags |= (iview->view.is_mutable ? 1 : 0) | (iview->image->layout[0].tile_mode == TILE6_LINEAR ? 2 : 0) |
+                   (tu_attachment_unpadded(cmd, iview) ? 4 : 0) | (att->load ? 8 : 0) | (att->store ? 16 : 0);
+      break;
+   }
+   const uint32_t seq = p_atomic_inc_return(&tu_pass_seq);
+   rec.seq = seq;
+   tu_pass_ring[seq % 512] = rec;
+   return seq;
+}
