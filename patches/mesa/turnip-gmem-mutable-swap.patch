+/* The last 512 render passes (tu_pass_ring_read), for the process's telemetry: when, how it was rendered and what its first colour
+ * attachment is, so the passes of one frame and the byte order they write can be read back. gpu_begin/gpu_end: when the GPU began and
+ * ended the pass's commands (ns of the GPU's always-on counter; 0 until it ran it), from timestamps the pass writes around itself into
+ * a slot of the first device's pass timestamp buffer (u_trace's RB_DONE_TS write, as tu_trace_record_ts emits it).
+ */
+struct tu_pass_rec {
+   uint64_t ns;           /* os_time_get_nano() when the pass was recorded */
+   uint32_t seq;
+   uint16_t width, height;
+   uint8_t mode;          /* 0 GMEM, 1 SYSMEM chosen by the autotuner, 2 SYSMEM for another reason */
+   uint8_t colors;        /* colour attachments of the first subpass */
+   uint8_t flags;         /* 1 mutable view, 2 linear image, 4 unpadded (loaded and stored over its texels), 8 loaded, 16 stored, 32 FDM */
+   uint8_t swap;          /* the colour swap of the first colour attachment's view */
+   uint16_t draws;
+   uint16_t format;       /* VkFormat of the first colour attachment */
+   uint32_t kpx;
+   uint64_t gpu_begin, gpu_end;
+};
+static_assert(sizeof(struct tu_pass_rec) == 48, "pass record");
+static struct tu_pass_rec tu_pass_ring[512];
+
+/* The host's diagnostics switch (SHENG_DIAG, set by the plugin from sheng-diag=1): without it no pass is stamped or kept in the ring. */
+static bool
+tu_pass_trace_on(void)
+{
+   static int on = -1;
+   if (on < 0)
+      on = getenv("SHENG_DIAG") != NULL;
+   return on;
+}
+static uint32_t tu_pass_seq;
+static struct tu_device *tu_pass_ts_dev;
+static struct tu_bo *tu_pass_ts_bo;
+static simple_mtx_t tu_pass_ts_lock = SIMPLE_MTX_INITIALIZER;
+
+/* The GPU address of the pass timestamp slot of seq (two 64-bit words), its words cleared; 0 when cmd's device has no buffer (only
+ * the first device that records a pass gets one).
+ */
+static uint64_t
+tu_pass_ts_slot(struct tu_cmd_buffer *cmd, uint32_t seq)
+{
+   struct tu_device *dev = cmd->device;
+   if (!p_atomic_read(&tu_pass_ts_bo)) {
+      simple_mtx_lock(&tu_pass_ts_lock);
+      if (!tu_pass_ts_bo && !tu_pass_ts_dev) {
+         tu_pass_ts_dev = dev;
+         struct tu_bo *bo = NULL;
+         if (tu_bo_init_new(dev, NULL, &bo, 512 * 16, TU_BO_ALLOC_INTERNAL_RESOURCE, "pass timestamps") == VK_SUCCESS) {
+            if (tu_bo_map(dev, bo, NULL) == VK_SUCCESS) {
+               memset(bo->map, 0, 512 * 16);
+               p_atomic_set(&tu_pass_ts_bo, bo);
+            } else {
+               tu_bo_finish(dev, bo);
+            }
+         }
+      }
+      simple_mtx_unlock(&tu_pass_ts_lock);
+   }
+   struct tu_bo *bo = p_atomic_read(&tu_pass_ts_bo);
+   if (!bo || tu_pass_ts_dev != dev)
+      return 0;
+   uint64_t *words = (uint64_t *) bo->map + (seq % 512) * 2;
+   words[0] = words[1] = 0;
+   return bo->iova + (seq % 512) * 16;
+}
