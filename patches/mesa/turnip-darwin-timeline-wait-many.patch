+static VkResult
+vk_darwin_timeline_signal(struct vk_device *_device, struct vk_sync *sync, uint64_t value)
+{
+   VkResult res = darwin_timeline_signal_orig(_device, sync, value);
+   if (res == VK_SUCCESS)
+      vk_darwin_timeline_notify(_device);
+   return res;
+}
