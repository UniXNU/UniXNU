+                                                   waits[fence_wait_index].wait_value,
+                                                   (enum vk_sync_wait_flags)(wait_flags & ~VK_SYNC_WAIT_ANY), 0);
+            if (r != VK_TIMEOUT)
+               return r;
+         }
+         return VK_TIMEOUT;
+      }
+
+      if (abs_timeout_ns != UINT64_MAX && os_time_get_nano() >= abs_timeout_ns)
+         return VK_TIMEOUT;
+
+      if (has_fence && !has_unsubmitted) {
+         VkResult r = dw_wait_fence_locked_free(device, min_fence, abs_timeout_ns);
+         if (r == VK_SUCCESS) {
+            pthread_mutex_lock(&device->submit_mutex);
+            if (!retire->fence_watcher_has_done ||
+                (int32_t)(min_fence - retire->fence_watcher_done) > 0) {
+               retire->fence_watcher_done = min_fence;
+               retire->fence_watcher_has_done = true;
+            }
+            pthread_mutex_unlock(&device->submit_mutex);
+            continue;
+         }
+         return r;
+      }
+
+      pthread_mutex_lock(&device->submit_mutex);
+      if (retire->timeline_seq != seq) {
+         pthread_mutex_unlock(&device->submit_mutex);
+         continue;
+      }
+      if (has_fence) {
+         if (retire->fence_watcher_has_done &&
+             (int32_t)(retire->fence_watcher_done - min_fence) >= 0) {
+            pthread_mutex_unlock(&device->submit_mutex);
+            continue;
+         }
+         if (!retire->fence_watcher_started && !retire->fence_watcher_stop) {
+            if (pthread_create(&retire->fence_watcher_thread, NULL,
+                               darwin_fence_watcher_main, retire) == 0)
+               retire->fence_watcher_started = true;
+         }
+         if (retire->fence_watcher_started) {
+            if (!retire->fence_watcher_target ||
