+      for (uint32_t i = 0; i < wait_count; i++) {
+         VkResult result = darwin_timeline_wait_orig(_device, waits[i].sync, waits[i].wait_value,
+                                                     (enum vk_sync_wait_flags)(wait_flags & ~VK_SYNC_WAIT_ANY), abs_timeout_ns);
+         if (result != VK_SUCCESS)
+            return result;
+      }
+      return VK_SUCCESS;
