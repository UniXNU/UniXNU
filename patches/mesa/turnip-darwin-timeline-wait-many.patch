+               found_fence_val = max_fence;
+               if (has_done && (int32_t)(done_fence - found_fence_val) >= 0)
+                  check_fence_now = true;
+            }
+         }
+         mtx_unlock(&state->mutex);
+
+         if (ready_now)
+            return VK_SUCCESS;
+         if (check_fence_now) {
+            VkResult r = darwin_timeline_wait_orig(_device, waits[i].sync, waits[i].wait_value,
+                                                   (enum vk_sync_wait_flags)(wait_flags & ~VK_SYNC_WAIT_ANY), 0);
+            if (r != VK_TIMEOUT)
+               return r;
+         }
+         if (found_fence && (!has_fence || (int32_t)(found_fence_val - min_fence) < 0)) {
+            has_fence = true;
+            min_fence = found_fence_val;
+            fence_wait_index = i;
+         }
+      }
