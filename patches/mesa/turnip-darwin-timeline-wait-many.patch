+static void
+vk_darwin_timeline_notify(struct vk_device *_device)
+{
+   struct tu_device *dev = container_of(_device, struct tu_device, vk);
+   pthread_mutex_lock(&dev->submit_mutex);
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   if (retire)
+      retire->timeline_seq++;
+   pthread_cond_broadcast(&dev->timeline_cond);
+   pthread_mutex_unlock(&dev->submit_mutex);
+}
