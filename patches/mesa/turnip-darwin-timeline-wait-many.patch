+               if (pt->value >= waits[i].wait_value) {
+                  matched = true;
+                  break;
+               }
+            }
+            if (!matched || blocked_unsubmitted) {
+               has_unsubmitted = true;
+            } else if (!need_fence) {
+               check_fence_now = true;
+            } else {
