+static VkResult (*darwin_timeline_signal_orig)(struct vk_device *, struct vk_sync *, uint64_t);
+static VkResult (*darwin_timeline_wait_orig)(struct vk_device *, struct vk_sync *, uint64_t,
+                                             enum vk_sync_wait_flags, uint64_t);
