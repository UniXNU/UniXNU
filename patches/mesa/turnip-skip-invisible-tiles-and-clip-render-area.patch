+   if (rp->scissor_bounds_valid) {
+      ix1 = MAX2(rp->scissor_min_x, orig_x1);
+      iy1 = MAX2(rp->scissor_min_y, orig_y1);
+      ix2 = MIN2(rp->scissor_max_x, orig_x2);
+      iy2 = MIN2(rp->scissor_max_y, orig_y2);
+   }
+
+   int32_t ax1, ay1, ax2, ay2;
