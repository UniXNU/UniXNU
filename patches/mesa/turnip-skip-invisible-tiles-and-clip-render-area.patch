+   const uint32_t align_h = MAX2(cmd->device->physical_device->info->gmem_align_h, 1u);
+   const int32_t orig_x1 = orig.offset.x;
+   const int32_t orig_y1 = orig.offset.y;
+   const int32_t orig_x2 = (int32_t) MIN2((int64_t) orig_x1 + orig.extent.width, (int64_t) INT32_MAX);
+   const int32_t orig_y2 = (int32_t) MIN2((int64_t) orig_y1 + orig.extent.height, (int64_t) INT32_MAX);
+   if (orig_x1 >= orig_x2 || orig_y1 >= orig_y2)
+      return;
+
