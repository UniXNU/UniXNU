+static void
+tu_record_draw_scissor(struct tu_cmd_buffer *cmd)
+{
+   struct tu_render_pass_state *rp = &cmd->state.rp;
+   if (rp->scissor_bounds_disabled)
+      return;
+
+   /* Static pipeline scissors leave dynamic_graphics_state.vp unpopulated, and FDM/per-layer viewports transform bins per view. */
+   if ((cmd->state.pipeline_draw_states & (1u << TU_DYNAMIC_STATE_SCISSOR)) ||
+       cmd->state.has_fdm || cmd->state.per_layer_viewport ||
+       cmd->vk.dynamic_graphics_state.vp.scissor_count != 1) {
+      rp->scissor_bounds_disabled = true;
+      return;
+   }
+
+   const VkRect2D &sc = cmd->vk.dynamic_graphics_state.vp.scissors[0];
+   const int64_t sx1 = sc.offset.x;
+   const int64_t sy1 = sc.offset.y;
+   const int64_t sx2 = sx1 + (int64_t) sc.extent.width;
+   const int64_t sy2 = sy1 + (int64_t) sc.extent.height;
+   tu_union_scissor_bounds(rp,
+                           (int32_t) CLAMP(sx1, 0, (int64_t) INT32_MAX),
+                           (int32_t) CLAMP(sy1, 0, (int64_t) INT32_MAX),
+                           (int32_t) CLAMP(sx2, 0, (int64_t) INT32_MAX),
+                           (int32_t) CLAMP(sy2, 0, (int64_t) INT32_MAX));
+}
