+static void
+tu_union_scissor_bounds(struct tu_render_pass_state *rp,
+                        int32_t x1, int32_t y1, int32_t x2, int32_t y2)
+{
+   if (rp->scissor_bounds_disabled || x1 >= x2 || y1 >= y2)
+      return;
+
+   if (!rp->scissor_bounds_valid) {
+      rp->scissor_min_x = x1;
+      rp->scissor_min_y = y1;
+      rp->scissor_max_x = x2;
+      rp->scissor_max_y = y2;
+      rp->scissor_bounds_valid = true;
+   } else {
+      rp->scissor_min_x = MIN2(rp->scissor_min_x, x1);
+      rp->scissor_min_y = MIN2(rp->scissor_min_y, y1);
+      rp->scissor_max_x = MAX2(rp->scissor_max_x, x2);
+      rp->scissor_max_y = MAX2(rp->scissor_max_y, y2);
+   }
+}
