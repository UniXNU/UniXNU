A union directory reports its end only after the directory below it.

getdirentries continues a union-mount directory in the covered directory on the call that returns no entries, but
getdirentries64 passed the upper directory's end on as GETDIRENTRIES64_EOF and libc's readdir stopped there, so subdirectories
listed the upper volume only (sheng macOS run33: QuartzCore.framework read as a flat bundle, WindowServer asserted
metallib_url != nil). getdirentriesattr already clears the end flag the same way. The switch to the lower directory also
reports its outcome for the first 48 switches (lookup error, failed step and error).

diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -11176,7 +11176,23 @@
 
 /*
  * Read a block of directory entries in a file system independent format.
+ */
+#if CONFIG_UNION_MOUNTS
+/*
+ * Measurement (sheng macOS run34): the outcome of continuing a union directory in the one below it, for the first 48 switches:
+ * the upper directory, lookup_traverse_union's error, the step that failed (1 not a directory, 2 MAC open check, 3 vnode_ref,
+ * 4 VNOP_OPEN) and its error. A step of 0 with errors 0 is a switch that happened.
  */
+static void
+native_union_readdir_report(vnode_t vp, int lookup, int step, int err)
+{
+	static _Atomic uint32_t reports;
+	if (os_atomic_inc_orig(&reports, relaxed) < 48) {
+		printf("union readdir: %s lookup %d step %d error %d\n", vp->v_name ? vp->v_name : "?", lookup, step, err);
+	}
+}
+#endif /* CONFIG_UNION_MOUNTS */
+
 static int
 getdirentries_common(int fd, user_addr_t bufp, user_size_t bufsize, ssize_t *bytesread,
     off_t *offset, int *eofflag, int flags)
@@ -11262,18 +11278,34 @@
 	if ((user_ssize_t)bufsize == uio_resid(auio) &&
 	    (vp->v_mount->mnt_flag & MNT_UNION)) {
 		vnode_t uvp;
+		int union_lookup = lookup_traverse_union(vp, &uvp, &context);
+		int union_step = 0;
 
-		if (lookup_traverse_union(vp, &uvp, &context) == 0) {
+		if (union_lookup == 0) {
 			if (vnode_isdir(uvp) == 0) {
 				error = EINVAL;
+				union_step = 1;
 			}
 #if CONFIG_MACF
 			if (error == 0) {
 				error = mac_vnode_check_open(&context, uvp, fp->fp_glob->fg_flag);
+				union_step = error ? 2 : 0;
 			}
 #endif /* CONFIG_MACF */
-			if (error == 0 && vnode_ref(uvp) == 0) {
-				if ((error = VNOP_OPEN(uvp, fp->fp_glob->fg_flag, &context)) == 0) {
+			int union_ref = error ? 0 : vnode_ref(uvp);
+			if (union_ref) {
+				union_step = 3;
+			}
+			if (error == 0 && union_ref == 0) {
+				error = VNOP_OPEN(uvp, fp->fp_glob->fg_flag, &context);
+				if (error) {
+					union_step = 4;
+					vnode_rele(uvp);        /* the reference taken above; the vnode_put below drops the iocount */
+				}
+			}
+			native_union_readdir_report(vp, union_lookup, union_step, error ? error : union_ref);
+			if (error == 0 && union_ref == 0) {
+				if (error == 0) {
 					fp_set_data(fp, uvp);
 					/* Close the old vnode to maintain proper lifecycle */
 					VNOP_CLOSE(vp, fp->fp_glob->fg_flag, &context);
@@ -11290,7 +11322,19 @@
 				/* can't replace in fd */
 				vnode_put(uvp);
 			}
+		} else {
+			native_union_readdir_report(vp, union_lookup, 0, 0);
 		}
+	}
+	/*
+	 * A directory of a union mount is continued in the directory below it on the call that finds no more entries (above).
+	 * Reporting the end of the upper directory with entries still to come let a caller stop before that call: getdirentries64
+	 * passes it on as GETDIRENTRIES64_EOF, which libc's readdir trusts, so a subdirectory listed only the upper volume's entries
+	 * (a macOS framework bundle on the SystemOS volume showed "Versions" and none of the root volume's "Resources", and CFBundle
+	 * took the framework for a flat bundle). The end is reported once the lower directory is read, or when there is none.
+	 */
+	if (*eofflag && (vp->v_mount->mnt_flag & MNT_UNION) && (user_ssize_t)bufsize != uio_resid(auio)) {
+		*eofflag = 0;
 	}
 #endif /* CONFIG_UNION_MOUNTS */
 
