+#define SRP_PART_UNKNOWN 0xFFFEu
+
+/* One source page of the shared cache, copied out (a part of a 16 KiB slide page that comes before the one being paged in). */
+static kern_return_t
+shared_region_pager_peek(
+	shared_region_pager_t           pager,
+	vm_object_offset_t              backing_offset,
+	void                            *buffer,
+	struct vm_object_fault_info     *fault_info)
+{
+	vm_object_t object = pager->srp_backing_object;
+	vm_page_t page, top_page;
+	vm_prot_t prot;
+	kern_return_t error_code;
+	vm_fault_return_t vmfr;
+
+retry:
+	vm_page_grab_prime();
+	vm_object_lock(object);
+	vm_object_paging_begin(object);
+	error_code = 0;
+	prot = VM_PROT_READ;
+	page = VM_PAGE_NULL;
+	vmfr = vm_fault_page(object, backing_offset, VM_PROT_READ, FALSE, FALSE, &prot, &page, &top_page, NULL,
+	    &error_code, FALSE, fault_info, NULL);
+	switch (vmfr) {
+	case VM_FAULT_SUCCESS:
+		break;
+	case VM_FAULT_RETRY:
+		goto retry;
+	case VM_FAULT_MEMORY_SHORTAGE:
+		if (vm_page_wait(fault_info->interruptible)) {
+			goto retry;
+		}
+		return KERN_RESOURCE_SHORTAGE;
+	case VM_FAULT_SUCCESS_NO_VM_PAGE:
+		vm_object_paging_end(object);
+		vm_object_unlock(object);
+		return KERN_MEMORY_ERROR;
+	default:
+		return KERN_MEMORY_ERROR;
+	}
+	vm_object_t page_object = VM_PAGE_OBJECT(page);
+	const void *source = (const void *)phystokv((pmap_paddr_t)VM_PAGE_GET_PHYS_PAGE(page) << PAGE_SHIFT);
+	if (page_object->code_signed) {
+		vm_page_validate_cs_mapped(page, PAGE_SIZE, 0, source);
+	}
+	const bool tainted = page->vmp_cs_tainted;
+	if (page->vmp_q_state != VM_PAGE_ON_SPECULATIVE_Q) {
+		/* As the source fault of a data request does: a page left on no queue is never reclaimed. */
+		vm_page_lockspin_queues();
+		if (page->vmp_q_state != VM_PAGE_ON_SPECULATIVE_Q) {
+			vm_page_speculate(page, FALSE);
+		}
+		vm_page_unlock_queues();
+	}
+	if (!tainted) {
+		bcopy(source, buffer, PAGE_SIZE);
+	}
+	vm_page_wakeup_done(page_object, page);
+	vm_object_paging_end(page_object);
+	vm_object_unlock(page_object);
+	if (top_page != VM_PAGE_NULL) {
+		vm_object_lock(object);
+		VM_PAGE_FREE(top_page);
+		vm_object_paging_end(object);
+		vm_object_unlock(object);
+	}
+	return tainted ? KERN_CODESIGN_ERROR : KERN_SUCCESS;
 }
 
 /*
+ * The v5 slide info of Darwin 26 caches has 16 KiB pages and one chain start per page; this kernel pages 4 KiB. A part slides on
+ * its own once the offset where the chain enters it is known: the page start resolves the parts up to the first rebase, and each
+ * walk of a part (a source copy for earlier parts, the destination for this one) resolves the parts up to the next rebase. The
+ * results are cached per pager, so every part is walked at most once more than it is paged in.
+ */
+static kern_return_t
+shared_region_pager_slide_part(
+	shared_region_pager_t           pager,
+	vm_offset_t                     dst_vaddr,
+	vm_object_offset_t              offset_in_backing_object,
+	mach_vm_offset_t                slide_start_address,
+	struct vm_object_fault_info     *fault_info)
+{
+	vm_shared_region_slide_info_t si = pager->srp_slide_info;
+	if (si->si_slide_info_entry->version != 5) {
+		return KERN_FAILURE;
+	}
+	vm_shared_region_slide_info_entry_v5_t v5 = &si->si_slide_info_entry->v5;
+	const uint32_t parts = (uint32_t)(v5->page_size / PAGE_SIZE);
+	const vm_object_offset_t offset_in_sliding_range = offset_in_backing_object - si->si_start;
+	const uint32_t page_index = (uint32_t)(offset_in_sliding_range / v5->page_size);
+	const uint32_t part = (uint32_t)((offset_in_sliding_range % v5->page_size) / PAGE_SIZE);
+	if (page_index >= v5->page_starts_count || parts > 4) {
+		return KERN_FAILURE;
+	}
+
+	uint16_t *starts = os_atomic_load(&pager->srp_part_starts, acquire);
+	if (starts == NULL) {
+		const vm_size_t bytes = (vm_size_t)v5->page_starts_count * parts * sizeof(uint16_t);
+		uint16_t *fresh = kalloc_data(bytes, Z_WAITOK);
+		if (fresh == NULL) {
+			return KERN_RESOURCE_SHORTAGE;
+		}
+		for (vm_size_t i = 0; i < bytes / sizeof(uint16_t); ++i) {
+			fresh[i] = SRP_PART_UNKNOWN;
+		}
+		pager->srp_part_bytes = bytes;
+		if (os_atomic_cmpxchg(&pager->srp_part_starts, NULL, fresh, acq_rel)) {
+			starts = fresh;
+		} else {
+			kfree_data(fresh, bytes);
+			starts = os_atomic_load(&pager->srp_part_starts, acquire);
+		}
+	}
+	uint16_t *mine = starts + (vm_size_t)page_index * parts;
+
+	/* Every walk resolves the parts from its own up to the one that holds the next rebase (or to the end of the page). */
+#define SRP_RESOLVE(from, next_start) do { \
+	const uint32_t __next = (next_start); \
+	const uint32_t __to = __next == VM_SR_PART_NONE ? parts : __next / PAGE_SIZE; \
+	for (uint32_t __p = (from); __p < parts && __p <= __to; ++__p) { \
+	        uint16_t __v = (__p == __to && __next != VM_SR_PART_NONE) ? (uint16_t)__next : VM_SR_PART_NONE; \
+	        os_atomic_store(&mine[__p], __v, relaxed); \
+	} \
+} while (0)
+
+	if (os_atomic_load(&mine[0], relaxed) == SRP_PART_UNKNOWN) {
+		const uint16_t first = v5->page_starts[page_index];
+		if (first != DYLD_CACHE_SLIDE_V5_PAGE_ATTR_NO_REBASE && (first >= v5->page_size || (first & 7))) {
+			return KERN_FAILURE;
+		}
+		SRP_RESOLVE(0, first == DYLD_CACHE_SLIDE_V5_PAGE_ATTR_NO_REBASE ? VM_SR_PART_NONE : first);
+	}
+	kern_return_t kr = KERN_SUCCESS;
+	if (os_atomic_load(&mine[part], relaxed) == SRP_PART_UNKNOWN) {
+		void *buffer = kalloc_data(PAGE_SIZE, Z_WAITOK);
+		if (buffer == NULL) {
+			return KERN_RESOURCE_SHORTAGE;
+		}
+		while (kr == KERN_SUCCESS && os_atomic_load(&mine[part], relaxed) == SRP_PART_UNKNOWN) {
+			/* The last resolved part before this one holds a rebase whose chain leads further. */
+			uint32_t known = part;
+			while (known > 0 && os_atomic_load(&mine[known], relaxed) == SRP_PART_UNKNOWN) {
+				--known;
+			}
+			const uint16_t start = os_atomic_load(&mine[known], relaxed);
+			if (start == VM_SR_PART_NONE || start == SRP_PART_UNKNOWN) {
+				kr = KERN_FAILURE;
+				break;
+			}
+			kr = shared_region_pager_peek(pager,
+			    si->si_start + (vm_object_offset_t)page_index * v5->page_size + (vm_object_offset_t)known * PAGE_SIZE,
+			    buffer, fault_info);
+			if (kr == KERN_SUCCESS) {
+				uint32_t next;
+				kr = vm_shared_region_slide_part_v5(si, (vm_offset_t)buffer, 0, known, start, false, &next, 0);
+				if (kr == KERN_SUCCESS) {
+					SRP_RESOLVE(known + 1, next);
+				}
+			}
+		}
+		kfree_data(buffer, PAGE_SIZE);
+		if (kr != KERN_SUCCESS) {
+			return kr;
+		}
+	}
+	const uint16_t start = os_atomic_load(&mine[part], relaxed);
+	if (start == VM_SR_PART_NONE) {
+		return KERN_SUCCESS;
+	}
+	uint32_t next;
+	kr = vm_shared_region_slide_part_v5(si, dst_vaddr, (mach_vm_offset_t)(offset_in_sliding_range + slide_start_address), part, start,
+	    true, &next,
+#if __has_feature(ptrauth_calls)
+	    si->si_ptrauth ? pager->srp_jop_key : 0
+#else /* __has_feature(ptrauth_calls) */
+	    0
+#endif /* __has_feature(ptrauth_calls) */
+	    );
+	if (kr == KERN_SUCCESS && part + 1 < parts && os_atomic_load(&mine[part + 1], relaxed) == SRP_PART_UNKNOWN) {
+		SRP_RESOLVE(part + 1, next);
+	}
+#undef SRP_RESOLVE
+	return kr;
+}
+#endif
